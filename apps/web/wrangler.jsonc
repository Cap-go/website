{
  "name": "capgo-website",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
  "dependencies_instrumentation": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "BUILDER_DB",
      "database_name": "capgo_builder",
      "database_id": "b5b45f7a-9129-441e-bca2-0aaf6f7f51f3",
    },
  ],
  "vars": {
    "CF_ACCOUNT_ANALYTICS_ID": "9ee3d7479a3c359681e3fab2c8cb22c0",
  },
  "routes": [
    {
      "pattern": "capgo.app",
      "custom_domain": true,
    },
    {
      "pattern": "mta-sts.capgo.app",
      "custom_domain": true,
    },
    {
      "pattern": "mta-sts.usecapgo.com",
      "custom_domain": true,
    },
  ],
  "env": {
    "development": {
      "d1_databases": [
        {
          "binding": "BUILDER_DB",
          "database_name": "capgo_builder_preprod",
          "database_id": "65fd13c8-1963-4a5b-8df0-a87ef4146a33",
        },
      ],
      "vars": {
        "CF_ACCOUNT_ANALYTICS_ID": "9ee3d7479a3c359681e3fab2c8cb22c0",
      },
      "routes": [
        {
          "pattern": "development.capgo.app",
          "custom_domain": true,
        },
      ],
    },
  },
}
