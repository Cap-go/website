{
  "name": "capgo-website",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": ["nodejs_compat", "disable_nodejs_process_v2"],
  "dependencies_instrumentation": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "workers_dev": false,
  "vars": {
    "CF_ACCOUNT_ANALYTICS_ID": "9ee3d7479a3c359681e3fab2c8cb22c0"
  },
  "routes": [
    {
      "pattern": "capgo.app",
      "custom_domain": true,
    },
  ],
  "env": {
    "development": {
      "vars": {
        "CF_ACCOUNT_ANALYTICS_ID": "9ee3d7479a3c359681e3fab2c8cb22c0"
      },
      "routes": [
        {
          "pattern": "development.capgo.app",
          "custom_domain": true,
        },
      ],
    },
  },
}
