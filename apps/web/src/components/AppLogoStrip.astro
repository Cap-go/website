---
import m from '@/copy/messages'
import { customerApps } from '@/config/customerApps'
import { getTotalStars } from '@/services/github'

const locale = Astro.locals.locale
const stats = m.app_strip_stats(
  {
    teams: m.companies_logo_stat_companies_value({}, { locale }),
    devices: m.companies_logo_stat_devices_value({}, { locale }),
    stars: `${Number(getTotalStars()).toLocaleString('en-US')}+`,
  },
  { locale },
)
---

<div class="app-strip mx-auto mt-12 w-full max-w-6xl px-4 sm:mt-14" role="group" aria-labelledby="app-strip-title">
  <p id="app-strip-title" class="text-center">
    <span class="block text-base font-semibold text-white sm:text-lg">{stats}</span>
    <span class="mt-1 block text-xs font-semibold tracking-widest text-slate-400 uppercase">{m.app_strip_title({}, { locale })}</span>
  </p>
  <div class="app-strip-viewport mt-6 overflow-hidden">
    <div class="app-strip-track flex w-max gap-3">
      {
        [0, 1].map((copy) => (
          <ul class="flex shrink-0 gap-3" aria-hidden={copy === 1 ? 'true' : undefined}>
            {customerApps.map((app) => (
              <li class="flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.04] py-2 pr-4 pl-2">
                <img src={app.icon} alt="" width="36" height="36" loading="lazy" decoding="async" class="h-9 w-9 rounded-xl object-cover" />
                <span class="leading-tight">
                  <span class="block text-sm font-semibold whitespace-nowrap text-white">{app.name}</span>
                  <span class="block text-xs whitespace-nowrap text-slate-400">{m.app_strip_installs({ count: app.installs }, { locale })}</span>
                </span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</div>

<style>
  .app-strip-viewport {
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .app-strip-track {
    animation: app-strip-scroll 50s linear infinite;
  }
  .app-strip:hover .app-strip-track,
  .app-strip:focus-within .app-strip-track {
    animation-play-state: paused;
  }
  @keyframes app-strip-scroll {
    to {
      /* each copy is followed by the 0.75rem gap, so half the track plus half a gap is one full cycle */
      transform: translateX(calc(-50% - 0.375rem));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .app-strip-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    .app-strip-track > ul {
      flex-wrap: wrap;
      justify-content: center;
    }
    .app-strip-track > ul[aria-hidden] {
      display: none;
    }
    .app-strip-viewport {
      mask-image: none;
    }
  }
</style>
