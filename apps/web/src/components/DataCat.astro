---
interface Props {
  caption?: string
}

const { caption = 'Thanks for reading the data. Here is a cat.' } = Astro.props
---

<section class="data-cat" aria-label="A cat">
  <figure>
    <svg class="data-cat-svg" viewBox="0 0 200 160" role="img" aria-label="A cartoon cat sitting with its tail swishing">
      <g class="data-cat-tail">
        <path d="M138 128 C 175 128, 185 95, 168 72" fill="none" stroke="#f5a65b" stroke-width="12" stroke-linecap="round"></path>
      </g>
      <ellipse cx="100" cy="118" rx="44" ry="34" fill="#f5a65b"></ellipse>
      <ellipse cx="100" cy="126" rx="24" ry="20" fill="#fde2c4"></ellipse>
      <path d="M62 62 L 66 22 L 90 46 Z" fill="#f5a65b"></path>
      <path d="M138 62 L 134 22 L 110 46 Z" fill="#f5a65b"></path>
      <path d="M68 52 L 70 32 L 84 46 Z" fill="#f9b8c4"></path>
      <path d="M132 52 L 130 32 L 116 46 Z" fill="#f9b8c4"></path>
      <circle cx="100" cy="70" r="40" fill="#f5a65b"></circle>
      <path d="M92 34 L 96 48 M100 32 L 100 48 M108 34 L 104 48" stroke="#d9823a" stroke-width="4" stroke-linecap="round"></path>
      <g class="data-cat-eyes">
        <ellipse cx="84" cy="68" rx="6" ry="8" fill="#1e293b"></ellipse>
        <ellipse cx="116" cy="68" rx="6" ry="8" fill="#1e293b"></ellipse>
        <circle cx="86" cy="65" r="2" fill="white"></circle>
        <circle cx="118" cy="65" r="2" fill="white"></circle>
      </g>
      <path d="M96 80 L 104 80 L 100 85 Z" fill="#f472b6"></path>
      <path d="M100 85 Q 94 92 88 88 M100 85 Q 106 92 112 88" fill="none" stroke="#1e293b" stroke-width="2.5" stroke-linecap="round"></path>
      <path d="M78 82 L 54 78 M78 87 L 54 90 M122 82 L 146 78 M122 87 L 146 90" stroke="#fde2c4" stroke-width="2" stroke-linecap="round"></path>
      <ellipse cx="82" cy="150" rx="12" ry="7" fill="#fde2c4"></ellipse>
      <ellipse cx="118" cy="150" rx="12" ry="7" fill="#fde2c4"></ellipse>
    </svg>
    <figcaption>{caption}</figcaption>
  </figure>
</section>

<style>
  .data-cat {
    display: flex;
    justify-content: center;
    padding: 48px 20px 72px;
  }
  .data-cat figure {
    margin: 0;
    text-align: center;
  }
  .data-cat-svg {
    width: 180px;
    height: auto;
  }
  .data-cat figcaption {
    margin-top: 12px;
    color: rgb(148 163 184);
    font-size: 0.9rem;
  }
  .data-cat-tail {
    transform-origin: 138px 128px;
    animation: data-cat-swish 2.4s ease-in-out infinite;
  }
  .data-cat-eyes {
    transform-origin: 100px 68px;
    animation: data-cat-blink 5s infinite;
  }
  @keyframes data-cat-swish {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(-18deg);
    }
  }
  @keyframes data-cat-blink {
    0%,
    94%,
    100% {
      transform: scaleY(1);
    }
    97% {
      transform: scaleY(0.1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .data-cat-tail,
    .data-cat-eyes {
      animation: none;
    }
  }
</style>
