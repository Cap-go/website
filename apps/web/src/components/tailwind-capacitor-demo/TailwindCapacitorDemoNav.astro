---
import { getRelativeLocaleUrl } from '@/services/links'

interface Item {
  name: string
  title: string
}

interface Props {
  items: Item[]
  registryItemCount: number
  catalogSectionCount: number
  locale: string
  activeSlug?: string
}

const { items, registryItemCount, catalogSectionCount, locale, activeSlug } = Astro.props
const demoBase = getRelativeLocaleUrl(locale, 'plugins/tailwind-capacitor/demo/')
---

<div class="sticky top-24 max-h-[calc(100dvh-8rem)] overflow-y-auto rounded-2xl border border-white/10 bg-gray-950/80 p-4 max-lg:top-20 max-lg:max-h-[55dvh]">
  <p class="text-[0.7rem] font-semibold tracking-[0.2em] text-blue-200/70 uppercase" id="tc-demo-sidebar-count">
    Components ({catalogSectionCount})
  </p>
  <p class="mt-1 text-[0.65rem] leading-snug text-gray-500" aria-describedby="tc-demo-registry-counts">
    {registryItemCount} registry items. One preview page per component.
  </p>
  <ul class="mt-3 flex flex-col gap-0.5 text-sm">
    {
      items.map((item) => {
        const href = `${demoBase}${encodeURIComponent(item.name)}/`
        const active = activeSlug === item.name
        return (
          <li>
            <a
              href={href}
              class:list={[
                'block rounded-md px-2 py-1.5 transition',
                active ? 'bg-blue-500/15 text-white' : 'text-gray-300 hover:bg-white/5 hover:text-white',
              ]}
              data-tc-nav={item.name}
              aria-current={active ? 'page' : undefined}
            >
              {item.title}
            </a>
          </li>
        )
      })
    }
  </ul>
</div>