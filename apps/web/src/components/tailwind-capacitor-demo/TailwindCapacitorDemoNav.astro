---
interface Item {
  name: string
  title: string
}

interface Props {
  items: Item[]
}

const { items } = Astro.props
---

<div class="sticky top-24 max-h-[calc(100dvh-8rem)] overflow-y-auto rounded-2xl border border-white/10 bg-gray-950/80 p-4">
  <p class="text-[0.7rem] font-semibold tracking-[0.2em] text-blue-200/70 uppercase">Registry ({items.length})</p>
  <ul class="mt-3 flex flex-col gap-1 text-sm">
    {
      items.map((item) => (
        <li>
          <a
            href={`#${item.name}`}
            class="block rounded-md px-2 py-1 text-gray-300 transition hover:bg-white/5 hover:text-white"
            data-tc-nav={item.name}
          >
            {item.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  const iframe = document.getElementById('tc-demo-iframe')
  const frame = iframe instanceof HTMLIFrameElement ? iframe : null
  document.querySelectorAll('[data-tc-nav]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault()
      const id = (link as HTMLAnchorElement).dataset.tcNav
      frame?.contentWindow?.postMessage({ type: 'tc-demo-scroll', id }, window.location.origin)
    })
  })
</script>
