---
import { getRelativeLocaleUrl } from '@/services/links'

interface Props {
  locale: string
  title: string
  description: string
  metaLine: string
  pluginHref: string
  indexHref?: string
  currentCrumb: string
  headingClass?: string
}

const {
  locale,
  title,
  description,
  metaLine,
  pluginHref,
  indexHref,
  currentCrumb,
  headingClass = 'mt-4 font-pj text-3xl font-bold text-white sm:text-4xl',
} = Astro.props
---

<section
  id="tc-demo-page-intro"
  class="border-b border-white/10 bg-gray-950 px-4 pt-3 pb-8 sm:px-6 sm:pt-[max(7.5rem,calc(env(safe-area-inset-top)+5.75rem))] lg:px-8 lg:pt-12"
>
  <div class="mx-auto max-w-6xl">
    <nav class="text-sm text-gray-400" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a class="text-blue-300 hover:text-blue-200" href={getRelativeLocaleUrl(locale, 'plugins/')}>Plugins</a></li>
        <li aria-hidden="true">/</li>
        <li><a class="text-blue-300 hover:text-blue-200" href={pluginHref}>Tailwind Capacitor</a></li>
        <li aria-hidden="true">/</li>
        {
          indexHref ? (
            <>
              <li>
                <a class="text-blue-300 hover:text-blue-200" href={indexHref}>
                  Demo
                </a>
              </li>
              <li aria-hidden="true">/</li>
              <li class="text-gray-200">{currentCrumb}</li>
            </>
          ) : (
            <li class="text-gray-200">{currentCrumb}</li>
          )
        }
      </ol>
    </nav>
    <h1 class={headingClass} data-tc-demo-intro>
      {title}
    </h1>
    <p class="mt-3 max-w-3xl text-sm leading-6 text-gray-300 sm:text-base sm:leading-7" data-tc-demo-intro>{description}</p>
    <p class="mt-2 text-xs leading-relaxed text-gray-500" id="tc-demo-registry-counts" data-tc-demo-intro set:html={metaLine} />
  </div>
</section>