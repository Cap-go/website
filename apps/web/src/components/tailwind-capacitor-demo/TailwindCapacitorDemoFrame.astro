---
import RegistryNav from '@/components/tailwind-capacitor-demo/TailwindCapacitorDemoNav.astro'
import { tailwindCapacitorDemoNavItems } from '@/lib/tailwindCapacitorDemoCatalog'
import stateManifest from '@/components/tailwind-capacitor-demo/state-manifest.json'
import manifest from '@/tailwind-capacitor-snapshot/registry-manifest.json'
import { getRelativeLocaleUrl } from '@/services/links'

interface Props {
  locale: string
  slug: string
  activeSlug: string
}

const { locale, slug, activeSlug } = Astro.props
const catalogSectionCount = tailwindCapacitorDemoNavItems.length
const shellBase = getRelativeLocaleUrl(locale, 'plugins/tailwind-capacitor/demo/shell/')
const states = stateManifest[slug as keyof typeof stateManifest] ?? [{ id: 'preview', label: 'Preview' }]
---

<div class="min-w-0 lg:col-start-2" data-tc-demo-slug={slug}>
  <div class="rounded-2xl border border-white/10 bg-black/40 p-3 sm:p-4">
    <div class="mb-3 flex flex-wrap items-center gap-2 sm:gap-3" data-tc-demo-controls>
      <fieldset class="flex flex-wrap gap-1.5 border-0 p-0 sm:gap-2">
        <legend class="sr-only">Platform style</legend>
        <button type="button" data-tc-platform="ios" class="tc-demo-toggle rounded-lg border border-white/15 px-2.5 py-1.5 text-xs sm:px-3 sm:text-sm text-white" aria-pressed="true">iOS</button>
        <button type="button" data-tc-platform="material" class="tc-demo-toggle rounded-lg border border-white/15 px-2.5 py-1.5 text-xs sm:px-3 sm:text-sm text-gray-300" aria-pressed="false">Material</button>
      </fieldset>
      <fieldset class="flex flex-wrap gap-1.5 border-0 p-0 sm:gap-2">
        <legend class="sr-only">Color mode</legend>
        <button type="button" data-tc-dark="0" class="tc-demo-toggle rounded-lg border border-white/15 px-2.5 py-1.5 text-xs sm:px-3 sm:text-sm text-white" aria-pressed="true">Light</button>
        <button type="button" data-tc-dark="1" class="tc-demo-toggle rounded-lg border border-white/15 px-2.5 py-1.5 text-xs sm:px-3 sm:text-sm text-gray-300" aria-pressed="false">Dark</button>
      </fieldset>
    </div>
  </div>

  <div class="mt-4 space-y-8" data-tc-demo-state-gallery>
    {
      states.map((state) => (
        <section class="min-w-0" data-tc-demo-state-section={state.id}>
          <h3 class="mb-2 text-sm font-semibold text-gray-200">
            <span class="text-gray-400">{state.id}</span>
            <span class="mx-2 text-gray-600" aria-hidden="true">
              ·
            </span>
            {state.label}
          </h3>
          <div
            class="tc-demo-phone-frame mx-auto w-full max-w-[390px] overflow-hidden rounded-[2rem] border border-white/20 bg-black shadow-2xl"
            style="height: min(70dvh, 720px);"
          >
            <iframe
              class="tc-demo-state-iframe block h-full w-full border-0 bg-neutral-950"
              title={`Tailwind Capacitor demo: ${slug} — ${state.label}`}
              data-tc-state={state.id}
              src={`${shellBase}?slug=${encodeURIComponent(slug)}&state=${encodeURIComponent(state.id)}&platform=ios&dark=0`}
              loading="lazy"
            />
          </div>
        </section>
      ))
    }
  </div>

  <div class="mt-6 lg:hidden">
    <RegistryNav
      items={tailwindCapacitorDemoNavItems}
      registryItemCount={manifest.itemCount}
      catalogSectionCount={catalogSectionCount}
      locale={locale}
      activeSlug={activeSlug}
    />
  </div>
</div>

<script define:vars={{ slug }}>
  import { bindTailwindCapacitorDemoTheme } from '@/scripts/tailwindCapacitorDemoTheme.client'

  const root = document.querySelector(`[data-tc-demo-slug="${slug}"]`)
  if (root instanceof HTMLElement) {
    bindTailwindCapacitorDemoTheme(root, slug)
  }
</script>