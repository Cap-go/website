---
import { Icon } from 'astro-icon/components'
import m from '@/copy/messages'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const highlights = [
  m.pricing_prepaid_no_subscription({}, { locale }),
  m.pricing_prepaid_usage({}, { locale }),
  m.pricing_prepaid_validity({}, { locale }),
  m.pricing_prepaid_top_up({}, { locale }),
]
---

<div class="flex min-w-0 flex-col bg-white p-6 lg:min-h-[580px] lg:p-7 xl:p-6" data-plan="Pay as you go">
  <div class="min-h-24">
    <h3 class="text-2xl font-semibold tracking-tight text-balance text-gray-950">{m.pricing_pay_as_you_go({}, { locale })}</h3>
    <p class="mt-3 text-base/6 text-pretty text-gray-600 sm:text-sm/6">{m.pricing_prepaid_description({}, { locale })}</p>
  </div>

  <div class="mt-6 lg:mt-8">
    <p class="flex flex-wrap items-baseline gap-x-2 text-4xl font-semibold tracking-tight text-gray-950 sm:text-5xl">
      <strong class="font-semibold" data-price-amount="5" data-price-format="currency" translate="no">
        $5
      </strong>
      <span class="text-sm font-medium tracking-normal text-gray-500">{m.pricing_prepaid_price_unit({}, { locale })}</span>
    </p>
    <p class="mt-2 min-h-10 text-base/5 font-medium text-pretty text-gray-600 sm:text-sm/5">{m.pricing_prepaid_annual_example({}, { locale })}</p>
  </div>

  <a
    href={getRelativeLocaleUrl(locale, 'register')}
    class="mt-6 inline-flex min-h-17 w-full items-center justify-center rounded-full border border-gray-950 bg-gray-950 px-5 py-3 text-sm font-semibold text-white hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
  >
    {m.pricing_prepaid_cta({}, { locale })}
  </a>

  <div class="mt-10 lg:mt-12">
    <p class="text-sm font-semibold text-gray-500">{m.pricing_prepaid_how_it_works({}, { locale })}</p>
    <ul class="mt-5 space-y-4 text-base/6 text-gray-700 sm:text-sm/6">
      {highlights.map((highlight) => (
        <li class="flex items-start gap-3">
          <Icon name="check" class="size-4 h-lh shrink-0 fill-gray-500" aria-hidden="true" />
          <span class="min-w-0">{highlight}</span>
        </li>
      ))}
    </ul>
  </div>

  <a
    href="#credit-pricing"
    class="mt-auto inline-flex min-h-11 items-center gap-2 pt-10 text-sm font-semibold text-gray-600 hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
  >
    {m.pricing_prepaid_see_rates({}, { locale })}
    <span aria-hidden="true">→</span>
  </a>
</div>
