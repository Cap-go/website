---
import { Icon } from 'astro-icon/components'
import m from '@/copy/messages'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const highlights = [
  m.pricing_prepaid_no_subscription({}, { locale }),
  m.pricing_prepaid_usage({}, { locale }),
  m.pricing_prepaid_validity({}, { locale }),
  m.pricing_prepaid_top_up({}, { locale }),
]
---

<div
  class="mt-4 grid min-w-0 gap-6 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm lg:grid-cols-[minmax(0,1.2fr)_auto_minmax(0,1.4fr)_auto] lg:items-center lg:gap-8 lg:px-8 lg:py-6"
  data-plan="Pay as you go"
>
  <div class="min-w-0">
    <h3 class="text-xl font-semibold tracking-tight text-balance text-gray-950">{m.pricing_pay_as_you_go({}, { locale })}</h3>
    <p class="mt-2 text-base/6 text-pretty text-gray-600 sm:text-sm/6">{m.pricing_prepaid_description({}, { locale })}</p>
  </div>

  <div class="min-w-0">
    <p class="flex flex-wrap items-baseline gap-x-2 text-3xl font-semibold tracking-tight whitespace-nowrap text-gray-950">
      <strong class="font-semibold" data-price-amount="5" data-price-format="currency" translate="no">
        $5
      </strong>
      <span class="text-sm font-medium tracking-normal text-gray-500">{m.pricing_prepaid_price_unit({}, { locale })}</span>
    </p>
    <p class="mt-1 text-sm/5 font-medium text-pretty text-gray-600">{m.pricing_prepaid_annual_example({}, { locale })}</p>
  </div>

  <ul class="grid min-w-0 gap-2 text-sm/6 text-gray-700 sm:grid-cols-2" aria-label={m.pricing_prepaid_how_it_works({}, { locale })}>
    {highlights.map((highlight) => (
      <li class="flex items-start gap-2">
        <Icon name="check" class="size-4 h-lh shrink-0 fill-gray-500" aria-hidden="true" />
        <span class="min-w-0">{highlight}</span>
      </li>
    ))}
  </ul>

  <div class="flex min-w-0 flex-col items-stretch gap-2 lg:items-center">
    <a
      href={getRelativeLocaleUrl(locale, 'register')}
      class="inline-flex min-h-11 items-center justify-center rounded-full border border-gray-950 bg-gray-950 px-5 py-2.5 text-center text-sm font-semibold whitespace-nowrap text-white hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
    >
      {m.pricing_prepaid_cta({}, { locale })}
    </a>
    <a
      href="#credit-pricing"
      class="inline-flex min-h-11 items-center justify-center gap-2 text-sm font-semibold text-gray-600 hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
    >
      {m.pricing_prepaid_see_rates({}, { locale })}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>
