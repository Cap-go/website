<!-- Fills and shows the footer currency picker (Footer.astro) on pages with prices. -->
<script>
  import { currencyName } from '@/lib/currency'
  import { getCurrencyState, hasManualCurrency, initCurrency, onCurrencyChange, setCurrency } from '@/scripts/currency'

  const OPTION_CLASS = 'flex w-full items-center gap-2 px-3 py-2 text-left text-sm text-zinc-300 hover:bg-white/5 hover:text-white aria-[current=true]:text-white'

  function initCurrencySelector() {
    const container = document.querySelector<HTMLElement>('[data-currency-selector]')
    const button = container?.querySelector<HTMLButtonElement>('#currency-dropdown-button')
    const list = container?.querySelector<HTMLElement>('[data-currency-options]')
    // The regional (Solo) price still depends on the visitor's location without the picker.
    if (!container || !button || !list) return void initCurrency()
    const autoOption = list.querySelector<HTMLButtonElement>('[data-currency-option="auto"]')
    const autoLabel = autoOption?.textContent?.trim() ?? ''
    const locale = document.documentElement.lang || 'en-US'

    const close = () => {
      list.classList.add('hidden')
      button.setAttribute('aria-expanded', 'false')
    }

    const sync = () => {
      const { currency, currencies, detected } = getCurrencyState()
      if (list.querySelectorAll('[data-currency-option]').length !== currencies.length + 1) {
        const options = currencies.map((code) => {
          const option = document.createElement('button')
          option.type = 'button'
          option.className = OPTION_CLASS
          option.dataset.currencyOption = code
          option.textContent = `${code.toUpperCase()} · ${currencyName(code, locale)}`
          return option
        })
        list.replaceChildren(...(autoOption ? [autoOption] : []), ...options)
      }
      if (autoOption) autoOption.textContent = `${autoLabel} (${detected.toUpperCase()})`
      const selected = hasManualCurrency() ? currency : 'auto'
      list.querySelectorAll<HTMLElement>('[data-currency-option]').forEach((option) => {
        if (option.dataset.currencyOption === selected) option.setAttribute('aria-current', 'true')
        else option.removeAttribute('aria-current')
      })
      const current = container.querySelector('[data-currency-current]')
      if (current) current.textContent = currency.toUpperCase()
      button.setAttribute('aria-label', `${currencyName(currency, locale)}, ${button.dataset.currencyLabel ?? ''}`)
      container.hidden = currencies.length < 2
    }

    list.addEventListener('click', (event) => {
      const option = (event.target as HTMLElement).closest<HTMLElement>('[data-currency-option]')
      if (!option) return
      setCurrency(option.dataset.currencyOption === 'auto' ? null : (option.dataset.currencyOption ?? null))
      close()
      button.focus()
    })
    onCurrencyChange(sync)
    initCurrency().then(sync)
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCurrencySelector)
  else initCurrencySelector()
</script>
