---
import { numberWithSpaces } from '@/services/misc'
import type { Database } from '@/services/supabase.types'
import { getRelativeLocaleUrl } from '@/services/links'
import m from '@/copy/messages'
import TeamAvatars from '@/components/TeamAvatars.astro'
import { planDescriptionToText } from '@/lib/planCopy'
import { ENTERPRISE_MAU_STOPS, formatMau, type CreditStep } from '@/lib/enterpriseScale'

interface Props {
  pricing: Database['public']['Tables']['plans']['Row'][]
  yearly: boolean
  credits?: CreditStep[]
}

const { pricing, yearly, credits = [] } = Astro.props

// Enterprise MAU slider needs the public MAU credit ladder to quote extra MAU.
const mauCredits = credits.filter((step) => step.type === 'mau')
const enterpriseScale = mauCredits.length > 0
const enterprisePlan = pricing.find((plan) => plan.name === 'Enterprise')
const enterpriseMauIndex = Math.max(
  0,
  ENTERPRISE_MAU_STOPS.findIndex((stop) => stop >= (enterprisePlan?.mau ?? 0)),
)

function planHighlights(plan: Database['public']['Tables']['plans']['Row']) {
  const highlights = [
    `${numberWithSpaces(plan.mau)}${plan.name === 'Enterprise' && !enterpriseScale ? '+' : ''} ${m.monthly_active_users({}, { locale: Astro.locals.locale })}`,
    `${numberWithSpaces(plan.bandwidth)}${plan.name === 'Enterprise' ? '+' : ''} GiB/${m.month({}, { locale: Astro.locals.locale })} ${m.of_bandwidth({}, { locale: Astro.locals.locale })}`,
    `${numberWithSpaces(plan.storage)}${plan.name === 'Enterprise' ? '+' : ''} GiB storage`,
    'Native notifications',
    'Capgo Observe',
    ...(plan.name === 'Enterprise'
      ? [m.soc2_compliance_short({}, { locale: Astro.locals.locale }), m.enterprise_uptime_sla({}, { locale: Astro.locals.locale })]
      : [m.unlimited_live_updates({}, { locale: Astro.locals.locale }), m.mcp_server({}, { locale: Astro.locals.locale })]),
  ]

  if (plan.build_time_unit && plan.build_time_unit > 0) {
    highlights.push(`${buildTimeDisplay(plan.build_time_unit)}${plan.name === 'Enterprise' ? '+' : ''}`)
  }

  if (plan.name === 'Enterprise') {
    highlights.push(m.security_questionnaires({}, { locale: Astro.locals.locale }))
  }

  return highlights
}

function priceDisplay(monthlyPrice: number, yearlyPrice: number, name: string) {
  if (yearly) {
    const price = (yearlyPrice / 12).toFixed(0)
    return name === 'Enterprise' && !enterpriseScale ? `$${price}+` : `$${price}`
  }
  return name === 'Enterprise' && !enterpriseScale ? `$${monthlyPrice}+` : `$${monthlyPrice}`
}

function buildTimeDisplay(buildTimeSeconds: number) {
  if (!buildTimeSeconds) return '0 build minutes'

  const buildTimeHours = Math.floor(buildTimeSeconds / 3600)
  const buildTimeMinutes = Math.floor(buildTimeSeconds / 60)

  if (buildTimeHours >= 1) {
    return buildTimeHours === 1 ? '1 build hour' : `${buildTimeHours} ${m.build_hours({}, { locale: Astro.locals.locale })}`
  } else {
    return `${buildTimeMinutes} ${m.build_minutes({}, { locale: Astro.locals.locale })}`
  }
}
---

<section id="plans" aria-labelledby="plans-heading">
  <h2 id="plans-heading" class="sr-only">
    {m.pricing_plans_heading({}, { locale: Astro.locals.locale })}
  </h2>
  <div class="grid grid-cols-1 overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm sm:grid-cols-2 lg:grid-cols-4">
    {pricing.map((plan) => (
      <div
        class:list={[
          'relative flex flex-col border-b border-gray-200 bg-white p-6 sm:border-r lg:min-h-[580px] lg:border-b-0 lg:p-7',
          plan.name === 'Maker' ? 'bg-blue-50/40' : '',
        ]}
        data-plan={plan.name}
        data-enterprise-scale={plan.name === 'Enterprise' && enterpriseScale ? '' : undefined}
      >
        <div class="min-h-24">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-2xl font-semibold tracking-tight text-gray-950">{plan.name}</h3>
            {plan.name === 'Maker' && (
              <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">{m.most_popular({}, { locale: Astro.locals.locale })}</span>
            )}
          </div>
          <p class="mt-3 text-sm leading-6 text-gray-600">{planDescriptionToText(plan.description, Astro.locals.locale)}</p>
        </div>

        <div class="mt-6 lg:mt-8">
          <div class="flex items-end gap-1">
            <p class="text-4xl font-semibold tracking-tight text-gray-950 sm:text-5xl" data-price aria-live="polite">
              {priceDisplay(plan.price_m, plan.price_y, plan.name)}
            </p>
            <p class="pb-1 text-xs font-semibold tracking-wide text-gray-500 uppercase">/{m.month({}, { locale: Astro.locals.locale })}</p>
          </div>
          <p class="mt-2 min-h-5 text-xs font-medium text-gray-500" data-yearly-price style={yearly ? '' : 'display: none'}>
            {m.billed_annually_at({}, { locale: Astro.locals.locale })} $<span data-yearly-total>{numberWithSpaces(plan.price_y)}</span>
          </p>
          <p class="mt-2 min-h-5 text-xs font-medium text-gray-500" data-monthly-price style={yearly ? 'display: none' : ''}>
            {m.billed_monthly({}, { locale: Astro.locals.locale })}
          </p>
        </div>

        <div class="mt-6 space-y-3">
          <a
            href={getRelativeLocaleUrl(Astro.locals.locale, 'register')}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Start ${plan.name} free trial`}
            class="inline-flex min-h-11 w-full items-center justify-center rounded-full border border-gray-950 bg-gray-950 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-gray-800 focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 focus:outline-none"
            role="button"
          >
            {m.days_free_trial({}, { locale: Astro.locals.locale })}
          </a>
          {plan.name === 'Enterprise' && (
            <a
              href="https://book.capgo.app/enterprise-inquiry/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Talk to our team"
              class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-full border border-gray-200 bg-gray-100 px-4 py-3 text-sm font-semibold whitespace-nowrap text-gray-900 transition-colors hover:bg-blue-50 hover:text-blue-700 focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 focus:outline-none"
              role="button"
            >
              <TeamAvatars />
              <span>Talk to our team</span>
            </a>
          )}
        </div>

        {plan.name === 'Enterprise' && enterpriseScale && (
          <div class="mt-6 rounded-xl border border-gray-200 bg-gray-50 p-3" data-enterprise-scale-box>
            <div class="mb-2 flex items-center justify-between gap-2">
              <label for="enterprise-mau-slider" class="text-xs font-medium text-gray-600">
                {m.monthly_active_users({}, { locale: Astro.locals.locale })}
              </label>
              <span class="text-sm font-bold text-blue-700 notranslate" translate="no" data-enterprise-mau>
                {formatMau(ENTERPRISE_MAU_STOPS[enterpriseMauIndex])} {m.mau({}, { locale: Astro.locals.locale })}
              </span>
            </div>
            <input
              id="enterprise-mau-slider"
              type="range"
              min="0"
              max={ENTERPRISE_MAU_STOPS.length - 1}
              step="1"
              value={enterpriseMauIndex}
              class="h-2 w-full cursor-pointer appearance-none rounded-full bg-gray-300 accent-blue-600 focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 focus:outline-none"
              aria-valuetext={`${formatMau(ENTERPRISE_MAU_STOPS[enterpriseMauIndex])} ${m.monthly_active_users({}, { locale: Astro.locals.locale })}`}
              data-enterprise-mau-slider
            />
            <div class="mt-1 flex justify-between text-[11px] text-gray-500 notranslate" translate="no" aria-hidden="true">
              <span>{formatMau(ENTERPRISE_MAU_STOPS[0])}</span>
              <span>{formatMau(ENTERPRISE_MAU_STOPS[ENTERPRISE_MAU_STOPS.length - 1])}+</span>
            </div>
          </div>
        )}

        <div class="mt-10 lg:mt-12">
          <p class="text-xs font-semibold tracking-wide text-gray-500 uppercase">Includes:</p>
          <ul class="mt-5 space-y-4 text-sm leading-6 text-gray-700">
            {planHighlights(plan).map((highlight, index) => (
              <li class="flex items-start gap-3">
                <svg
                  class="mt-1 h-4 w-4 shrink-0 text-gray-500"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                </svg>
                {plan.name === 'Enterprise' && enterpriseScale && index === 0 ? (
                  <span>
                    <span class="notranslate" translate="no" data-enterprise-mau-highlight>
                      {numberWithSpaces(plan.mau)}
                    </span>{' '}
                    {m.monthly_active_users({}, { locale: Astro.locals.locale })}
                  </span>
                ) : (
                  <span>{highlight}</span>
                )}
              </li>
            ))}
            <li class="flex items-start gap-3">
              <svg
                class="mt-1 h-4 w-4 shrink-0 text-gray-500"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              <span class="inline-flex items-center gap-1.5">
                {m.home_hero_human_support({}, { locale: Astro.locals.locale })}
                <img
                  src="/avatars/martin-96.webp"
                  alt=""
                  width="20"
                  height="20"
                  class="h-5 w-5 rounded-full object-cover ring-1 ring-gray-200"
                  loading="lazy"
                  decoding="async"
                  aria-hidden="true"
                />
              </span>
            </li>
          </ul>
        </div>

        <a
          href="#compare-plans"
          class="mt-auto inline-flex min-h-11 items-center gap-2 pt-10 text-sm font-semibold text-gray-600 transition-colors hover:text-blue-700 focus:text-blue-700 focus:outline-none"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m0 0 5.25-5.25M12 19l-5.25-5.25" />
          </svg>
          <span>View all features</span>
        </a>
      </div>
    ))}
  </div>
</section>

{enterpriseScale && enterprisePlan && (
  <script
    id="enterprise-scale-data"
    type="application/json"
    set:html={JSON.stringify({
      steps: mauCredits,
      includedMau: enterprisePlan.mau,
      priceMonthly: enterprisePlan.price_m,
      priceYearly: enterprisePlan.price_y,
    })}
  ></script>
)}

<script is:inline define:vars={{ pricing }}>
  document.addEventListener('DOMContentLoaded', () => {
    const yearlyRadio = document.getElementById('yearly')
    const monthlyRadio = document.getElementById('monthly')
    const planElements = document.querySelectorAll('[data-plan]')

    function updatePrices(isYearly) {
      planElements.forEach((planElement) => {
        // Enterprise price follows the MAU slider, see the script below.
        if (planElement.hasAttribute('data-enterprise-scale')) return
        const planName = planElement.getAttribute('data-plan')
        const plan = pricing.find((p) => p.name === planName)
        if (!plan) return

        const priceElement = planElement.querySelector('[data-price]')
        const yearlyPriceElement = planElement.querySelector('[data-yearly-price]')
        const monthlyPriceElement = planElement.querySelector('[data-monthly-price]')

        if (priceElement) {
          const price = isYearly ? (plan.price_y / 12).toFixed() : plan.price_m
          priceElement.textContent = planName === 'Enterprise' ? `$${price}+` : `$${price}`
        }

        if (yearlyPriceElement) {
          yearlyPriceElement.style.display = isYearly ? '' : 'none'
        }

        if (monthlyPriceElement) {
          monthlyPriceElement.style.display = isYearly ? 'none' : ''
        }
      })
    }

    // Handle FAQ info icon clicks
    document.querySelectorAll('a[href^="#faq-"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault()
        const targetId = link.getAttribute('href').substring(1)
        const targetElement = document.getElementById(targetId)

        if (targetElement) {
          // Smooth scroll to the FAQ section
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'center',
          })

          // Auto-open the details element after scrolling
          setTimeout(() => {
            if (!targetElement.open) {
              targetElement.open = true
            }

            // Add temporary highlight effect
            targetElement.style.boxShadow = '0 0 0 3px rgba(59, 130, 246, 0.5)'
            targetElement.style.borderRadius = '12px'
            targetElement.style.transition = 'box-shadow 0.3s ease'

            // Remove highlight after 2 seconds
            setTimeout(() => {
              targetElement.style.boxShadow = 'none'
            }, 2000)
          }, 500)
        }
      })
    })

    yearlyRadio?.addEventListener('change', () => updatePrices(true))
    monthlyRadio?.addEventListener('change', () => updatePrices(false))
  })
</script>

<script>
  import { ENTERPRISE_MAU_STOPS, enterpriseMonthlyCredits, formatMau, formatUsd, type CreditStep } from '@/lib/enterpriseScale'

  function initEnterpriseScale() {
    const card = document.querySelector<HTMLElement>('[data-enterprise-scale]')
    const slider = card?.querySelector<HTMLInputElement>('[data-enterprise-mau-slider]')
    const data = document.getElementById('enterprise-scale-data')?.textContent
    if (!card || !slider || !data) return

    const { steps, includedMau, priceMonthly, priceYearly } = JSON.parse(data) as {
      steps: CreditStep[]
      includedMau: number
      priceMonthly: number
      priceYearly: number
    }
    const yearlyRadio = document.getElementById('yearly') as HTMLInputElement | null
    const monthlyRadio = document.getElementById('monthly') as HTMLInputElement | null
    const query = <T extends HTMLElement>(selector: string) => card.querySelector<T>(selector)

    function update() {
      const targetMau = ENTERPRISE_MAU_STOPS[Number(slider!.value)] ?? includedMau
      const isYearly = yearlyRadio?.checked ?? true
      const base = isYearly ? Math.round(priceYearly / 12) : priceMonthly
      const credits = enterpriseMonthlyCredits(steps, includedMau, targetMau)
      const mauLabel = formatMau(targetMau)

      const price = query('[data-price]')
      if (price) price.textContent = formatUsd(base + credits)
      const mau = query('[data-enterprise-mau]')
      if (mau) mau.textContent = `${mauLabel} MAU`
      const highlight = query('[data-enterprise-mau-highlight]')
      if (highlight) highlight.textContent = new Intl.NumberFormat('en-US').format(targetMau).replaceAll(',', ' ')
      slider!.setAttribute('aria-valuetext', `${mauLabel} MAU`)

      const percent = (Number(slider!.value) / (ENTERPRISE_MAU_STOPS.length - 1)) * 100
      slider!.style.background = `linear-gradient(to right, rgb(37 99 235) ${percent}%, rgb(209 213 219) ${percent}%)`

      const yearlyLine = query('[data-yearly-price]')
      if (yearlyLine) yearlyLine.style.display = isYearly ? '' : 'none'
      const monthlyLine = query('[data-monthly-price]')
      if (monthlyLine) monthlyLine.style.display = isYearly ? 'none' : ''
    }

    slider.addEventListener('input', update)
    yearlyRadio?.addEventListener('change', update)
    monthlyRadio?.addEventListener('change', update)
    update()
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initEnterpriseScale)
  else initEnterpriseScale()
</script>
