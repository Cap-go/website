---
import m from '@/copy/messages'
import { getRelativeLocaleUrl } from '@/services/links'

interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props
const locale = Astro.locals.locale
const priceSlot = '\u0000'
const [beforePrice, afterPrice = ''] = m.pricing_prepaid_headline({ price: priceSlot }, { locale }).split(priceSlot)
const ratesUrl = `${getRelativeLocaleUrl(locale, 'pricing')}#credit-pricing`
---

<aside class:list={['rounded-2xl border border-[#44BCFF]/30 bg-[#44BCFF]/[0.06]', compact ? 'p-4' : 'p-6 text-center sm:p-8']}>
  <p class="text-xs font-semibold tracking-wide text-[#44BCFF] uppercase">{m.pricing_pay_as_you_go({}, { locale })}</p>
  <p class:list={['mt-2 font-bold tracking-tight text-white', compact ? 'text-lg' : 'text-2xl sm:text-3xl']}>
    {[beforePrice, <span data-price-amount="5" set:text="$5" />, afterPrice]}
  </p>
  <p class:list={['mt-3 text-gray-300', compact ? 'text-xs leading-5' : 'text-sm leading-6']}>{m.pricing_prepaid_details({}, { locale })}</p>
  <a href={ratesUrl} class="mt-3 inline-block text-sm font-semibold text-[#44BCFF]! underline underline-offset-4 hover:text-white!">
    {m.pricing_prepaid_rates({}, { locale })} <span aria-hidden="true">→</span>
  </a>
</aside>
