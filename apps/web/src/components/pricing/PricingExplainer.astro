---
import m from '@/copy/messages'
import { planMonthlyPrice } from '@/lib/planCopy'
import type { Database } from '@/services/supabase.types'

type PlanRow = Database['public']['Tables']['plans']['Row']

interface Props {
  plans: PlanRow[]
}

const { plans } = Astro.props
const locale = Astro.locals.locale

const questions = [
  { title: m.pricing_explainer_mau_title({}, { locale }), body: m.pricing_explainer_mau_body({}, { locale }) },
  { title: m.pricing_explainer_limit_title({}, { locale }), body: m.pricing_explainer_limit_body({}, { locale }) },
  { title: m.pricing_explainer_bandwidth_title({}, { locale }), body: m.pricing_explainer_bandwidth_body({}, { locale }) },
  { title: m.pricing_explainer_build_title({}, { locale }), body: m.pricing_explainer_build_body({}, { locale }) },
]

const highlights = [m.pricing_explainer_seats({}, { locale }), m.pricing_explainer_cancel({}, { locale }), m.pricing_explainer_trial({}, { locale })]

// EAS Update list prices from https://expo.dev/pricing (checked September 2026).
// Graduated overage is $0.005 per MAU up to 200,000 MAU on Starter and Production.
const easPlans = [
  { name: 'Starter', price: 19, includedMau: 3_000 },
  { name: 'Production', price: 199, includedMau: 50_000 },
]
const EAS_OVERAGE_PER_MAU = 0.005

function easMonthlyCost(mau: number) {
  return Math.min(...easPlans.map((plan) => plan.price + Math.max(0, mau - plan.includedMau) * EAS_OVERAGE_PER_MAU))
}

const paidPlans = plans.filter((plan) => plan.name !== 'Enterprise' && plan.mau > 0).sort((a, b) => a.mau - b.mau)
const rows = paidPlans
  .filter((plan) => plan.mau <= 200_000)
  .map((plan) => ({
    mau: plan.mau,
    capgoPlan: plan.name,
    capgo: planMonthlyPrice(plan),
    eas: Math.round(easMonthlyCost(plan.mau)),
  }))

const formatNumber = (value: number) => value.toLocaleString('en-US')
---

<section id="pricing-includes" class="mx-auto mt-10 max-w-6xl overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm" aria-labelledby="pricing-includes-heading">
  <div class="p-6 sm:p-8 lg:p-10">
    <p class="text-sm font-semibold tracking-wide text-blue-700 uppercase">{m.pricing_explainer_eyebrow({}, { locale })}</p>
    <h2 id="pricing-includes-heading" class="mt-3 max-w-3xl text-2xl leading-tight font-semibold tracking-tight text-gray-950 sm:text-3xl">
      {m.pricing_explainer_title({}, { locale })}
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-7 text-gray-600">{m.pricing_explainer_lead({}, { locale })}</p>

    <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
      {highlights.map((item) => (
        <li class="flex items-center gap-2 text-sm font-medium text-gray-800">
          <svg class="h-4 w-4 shrink-0 text-blue-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
          {item}
        </li>
      ))}
    </ul>

    <dl class="mt-8 grid gap-4 sm:grid-cols-2">
      {questions.map((question) => (
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-5">
          <dt class="text-sm font-semibold text-gray-950">{question.title}</dt>
          <dd class="mt-2 text-sm leading-6 text-gray-600">{question.body}</dd>
        </div>
      ))}
    </dl>
  </div>

  {rows.length > 0 && (
    <div class="border-t border-gray-200 bg-gray-50/60 p-6 sm:p-8 lg:p-10">
      <h3 class="text-lg font-semibold text-gray-950">{m.pricing_compare_title({}, { locale })}</h3>
      <p class="mt-1 text-sm leading-6 text-gray-600">{m.pricing_compare_lead({}, { locale })}</p>
      <div class="mt-5 overflow-x-auto rounded-xl border border-gray-200 bg-white">
        <table class="w-full min-w-[28rem] text-left text-sm">
          <thead class="bg-gray-50 text-xs font-semibold tracking-wide text-gray-500 uppercase">
            <tr>
              <th scope="col" class="px-4 py-3">
                {m.pricing_compare_col_mau({}, { locale })}
              </th>
              <th scope="col" class="px-4 py-3 text-blue-700">
                {m.pricing_compare_col_capgo({}, { locale })}
              </th>
              <th scope="col" class="px-4 py-3">
                {m.pricing_compare_col_eas({}, { locale })}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {rows.map((row) => (
              <tr>
                <th scope="row" class="px-4 py-3 font-medium text-gray-950">
                  {formatNumber(row.mau)}
                </th>
                <td class="px-4 py-3">
                  <span class="font-semibold text-gray-950">${formatNumber(row.capgo)}/mo</span>
                  <span class="ml-1 text-gray-500">
                    · {row.capgoPlan} {m.pricing_compare_plan_suffix({}, { locale })}
                  </span>
                </td>
                <td class="px-4 py-3 text-gray-700">${formatNumber(row.eas)}/mo</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs leading-5 text-gray-500">{m.pricing_compare_note({}, { locale })}</p>
    </div>
  )}
</section>
