---
import { HOSTED_MCP_URL, PUBLIC_MCP_URL } from '../../../../shared/agentDiscovery'

const servers = [
  {
    name: 'Hosted account',
    label: HOSTED_MCP_URL,
    copy: HOSTED_MCP_URL,
    body: 'Paste this URL into Claude, ChatGPT, Cursor, VS Code, Lovable, or any remote MCP client. Sign in with OAuth, or send a Capgo API key. Nothing to install.',
    fit: 'Apps, channels, rollouts, devices, Observe, build status, webhooks, push, docs search.',
  },
  {
    name: 'Local CLI',
    label: 'npx @capgo/cli@latest mcp',
    copy: 'npx @capgo/cli@latest mcp',
    body: 'Stdio server on your machine, after npx @capgo/cli@latest login. Desktop and terminal agents can start it. A chat app in the browser cannot.',
    fit: 'Upload a bundle from the project, request a native build, run doctor, probe, and compatibility checks.',
  },
  {
    name: 'Public docs',
    label: PUBLIC_MCP_URL,
    copy: PUBLIC_MCP_URL,
    body: 'No account and no API key. Search public docs, discover plugins, and find free browser tools. It cannot read or change a Capgo account.',
    fit: 'Use it when the agent only needs documentation.',
  },
]
---

<section class="section" id="servers" aria-labelledby="mcp-servers-title">
  <div class="shell">
    <div class="section-head">
      <div class="eyebrow eyebrow--blue">Three servers</div>
      <h2 id="mcp-servers-title" class="h2-section">
        Pick the server that can see the work
      </h2>
      <p class="lead">This page is the guide. The account server is on api.capgo.app. The public server is a different URL. Connecting the wrong one is the usual mistake.</p>
    </div>
    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {servers.map((server) => (
        <article class="flex flex-col rounded-lg border border-white/10 bg-white/[0.04] p-5">
          <h3 class="text-lg font-semibold text-white">{server.name}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-300">{server.body}</p>
          <p class="mt-3 text-sm leading-6 text-slate-400">{server.fit}</p>
          <div class="mt-4 rounded-lg bg-slate-950 p-3 font-mono text-xs leading-5 break-all text-emerald-200 ring-1 ring-white/10">{server.label}</div>
          <button
            type="button"
            class="mt-4 inline-flex min-h-11 w-fit items-center rounded-md border border-emerald-300/30 px-3 py-1.5 font-mono text-xs font-semibold text-emerald-100 hover:bg-emerald-300/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300"
            data-mcp-copy={server.copy}
            aria-label={`Copy ${server.name}`}
          >
            Copy
          </button>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-mcp-copy]').forEach((button) => {
    let resetTimer: number | undefined
    button.addEventListener('click', async () => {
      const value = button.dataset.mcpCopy
      if (!value) return
      const original = button.textContent || 'Copy'
      try {
        await navigator.clipboard.writeText(value)
        button.textContent = 'Copied'
      } catch {
        button.textContent = 'Copy failed'
      }
      if (resetTimer) window.clearTimeout(resetTimer)
      resetTimer = window.setTimeout(() => {
        button.textContent = original
      }, 1800)
    })
  })
</script>
