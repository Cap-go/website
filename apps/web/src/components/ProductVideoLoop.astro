---
// Short muted product loop recorded from the Capgo console demo app (fake data).
// Files live in public/landing-demos/videos/<name>.{mp4,webm} with <name>-poster.webp,
// regenerated by Cap-go/capgo.app `bun run screenshots:marketing -- --videos`.
// Autoplay only starts when the video is on screen and the visitor has not asked for reduced motion.
interface Props {
  name: 'observe-tour' | 'native-diff' | 'rollout-pause'
  label: string
  class?: string
}

const { name, label, class: className } = Astro.props
const base = `/landing-demos/videos/${name}`
---

<figure class:list={['video-loop', className]}>
  <video data-video-loop muted loop playsinline preload="none" poster={`${base}-poster.webp`} width="1280" height="800" aria-label={label}>
    <source src={`${base}.webm`} type="video/webm" />
    <source src={`${base}.mp4`} type="video/mp4" />
  </video>
</figure>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement
        if (entry.isIntersecting && !reduceMotion.matches) video.play().catch(() => {})
        else video.pause()
      }
    },
    { threshold: 0.35 },
  )
  document.querySelectorAll<HTMLVideoElement>('[data-video-loop]').forEach((video) => observer.observe(video))
</script>

<style>
  .video-loop {
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: #0f172a;
    box-shadow:
      0 30px 80px -30px rgba(37, 99, 235, 0.45),
      0 0 0 6px rgba(255, 255, 255, 0.025);
  }

  .video-loop video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1280 / 800;
  }
</style>
