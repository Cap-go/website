---
import m from '@/copy/messages'
import { productIconPaths as iconPaths } from '@/config/productIcons'
import { getRelativeLocaleUrl } from '@/services/links'

interface Props {
  background?: string
}

const { background = 'bg-[#1a1a1a]' } = Astro.props
const locale = Astro.locals.locale

const tools = [
  {
    icon: 'command-line',
    title: m.agent_ready_cli_title({}, { locale }),
    desc: m.agent_ready_cli_desc({}, { locale }),
    code: 'npx @capgo/cli@latest bundle upload',
    href: getRelativeLocaleUrl(locale, 'capgo-cli'),
  },
  {
    icon: 'arrows-right-left',
    title: m.agent_ready_mcp_title({}, { locale }),
    desc: m.agent_ready_mcp_desc({}, { locale }),
    code: 'npx @capgo/cli@latest mcp',
    href: getRelativeLocaleUrl(locale, 'docs/cli/reference/mcp'),
  },
  {
    icon: 'sparkles',
    title: m.agent_ready_skills_title({}, { locale }),
    desc: m.agent_ready_skills_desc({}, { locale }),
    code: 'npx skills add Cap-go/capgo-skills',
    href: getRelativeLocaleUrl(locale, 'skills'),
  },
  {
    icon: 'document-text',
    title: m.agent_ready_llms_title({}, { locale }),
    desc: m.agent_ready_llms_desc({}, { locale }),
    code: 'capgo.app/llms-full.txt',
    href: '/llms-full.txt',
  },
]
---

<section class:list={[background, 'py-24 sm:py-32']} aria-labelledby="agent-ready-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-mono text-base leading-7 font-semibold text-[#44BCFF]">{m.agent_ready_eyebrow({}, { locale })}</p>
      <h2 id="agent-ready-title" class="mt-2 text-3xl font-bold tracking-tight text-balance text-white sm:text-5xl">
        {m.agent_ready_title({}, { locale })}
      </h2>
      <p class="mt-6 text-lg leading-8 text-pretty text-gray-400">{m.agent_ready_subtitle({}, { locale })}</p>
    </div>

    <ul class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        tools.map((tool) => (
          <li>
            <a
              href={tool.href}
              class="group flex h-full flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition-[border-color,background-color] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF] [@media(hover:hover)]:hover:border-[#44BCFF]/40 [@media(hover:hover)]:hover:bg-white/[0.06]"
            >
              <span class="flex items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#44BCFF]/10 text-[#44BCFF] ring-1 ring-[#44BCFF]/20">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {iconPaths[tool.icon].map((d) => (
                      <path d={d} />
                    ))}
                  </svg>
                </span>
                <span class="text-base font-semibold text-white">{tool.title}</span>
                <span
                  class="ml-auto text-gray-600 transition-[color,transform] [@media(hover:hover)]:group-hover:translate-x-0.5 [@media(hover:hover)]:group-hover:text-[#44BCFF]"
                  aria-hidden="true"
                >
                  →
                </span>
              </span>
              <span class="mt-3 mb-5 text-sm leading-6 text-gray-400">{tool.desc}</span>
              <code class="mt-auto block rounded-lg border border-white/10 bg-black/40 px-3 py-2 pt-2 font-mono text-xs break-all text-gray-300">
                <span class="text-gray-600" aria-hidden="true">
                  {tool.code.startsWith('npx') ? '$ ' : ''}
                </span>
                {tool.code}
              </code>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 text-center">
      <a
        href={getRelativeLocaleUrl(locale, 'skills')}
        class="inline-flex items-center gap-1 text-sm font-semibold text-[#44BCFF]! focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF] [@media(hover:hover)]:hover:text-white!"
      >
        {m.agent_ready_cta({}, { locale })}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
