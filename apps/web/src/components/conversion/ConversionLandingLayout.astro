---
import Layout from '@/layouts/Layout.astro'
import HumanSupport from '@/components/HumanSupport.astro'
import ConversionRelatedLinks from '@/components/conversion/ConversionRelatedLinks.astro'
import type { ConversionLink } from '@/components/conversion/ConversionRelatedLinks.astro'
import { getRelativeLocaleUrl } from '@/services/links'
import m from '@/copy/messages'

export interface ConversionSection {
  title: string
  paragraphs: string[]
  listItems?: string[]
  htmlParagraphs?: string[]
}

interface Props {
  content: {
    title: string
    description: string
    keywords?: string
    ldJSON?: unknown
    image?: string
  }
  heroTitle: string
  heroSubtitle: string
  sections: ConversionSection[]
  relatedLinks: ConversionLink[]
  locale: string
}

const { content, heroTitle, heroSubtitle, sections, relatedLinks, locale } = Astro.props
---

<Layout content={content}>
  <section class="bg-gray-900 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-6 lg:px-8">
      <div class="mb-12 text-center">
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">{heroTitle}</h1>
        <p class="mx-auto max-w-2xl text-xl text-gray-300">{heroSubtitle}</p>
      </div>

      <div class="mb-12 space-y-8">
        {
          sections.map((section) => (
            <div class="rounded-lg border border-gray-700 bg-gray-800/50 p-6 sm:p-8">
              <h2 class="mb-4 text-2xl font-bold text-gray-100">{section.title}</h2>
              <div class="space-y-4 text-gray-300">
                {section.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
                {section.htmlParagraphs?.map((p) => (
                  <p set:html={p} />
                ))}
                {section.listItems?.length ? (
                  <ul class="ml-6 list-disc space-y-2 text-gray-400">
                    {section.listItems.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                ) : null}
              </div>
            </div>
          ))
        }
      </div>

      <ConversionRelatedLinks title={m.conversion_related_links_title({}, { locale })} links={relatedLinks} />

      <div class="mt-12 rounded-[1.45rem] bg-gray-800/80 px-8 py-10 text-center ring-1 ring-gray-700">
        <HumanSupport class="mb-4" size="sm" />
        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={getRelativeLocaleUrl(locale, 'register')}
            class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-8 py-4 text-lg font-bold text-white transition-all hover:bg-emerald-700"
          >
            {m.conversion_cta_register({}, { locale })}
          </a>
          <a
            href={getRelativeLocaleUrl(locale, 'alternatives')}
            class="inline-flex items-center justify-center rounded-xl border border-gray-600 px-8 py-4 text-lg font-semibold text-gray-300 hover:bg-gray-800 hover:text-white"
          >
            {m.alternatives({}, { locale })}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
