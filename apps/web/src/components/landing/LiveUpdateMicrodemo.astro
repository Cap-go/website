---
import { getRelativeLocaleUrl } from '@/services/links'

const registerUrl = getRelativeLocaleUrl(Astro.locals.locale, 'register')
---

<section class="microdemo-section" aria-labelledby="microdemo-heading">
  <div class="microdemo-wrap">
    <div class="microdemo-header">
      <h2 id="microdemo-heading">See the difference</h2>
    </div>
    <div class="microdemo-mount">
<div class="demo" id="capgo-microdemo" aria-label="Capgo live update micro-demo">
    <div class="demo__stage" id="stage">
      <div class="demo__sky" aria-hidden="true">
        <div class="cloud cloud--a"></div>
        <div class="cloud cloud--b"></div>
      </div>

      <button type="button" class="cue" id="pushCue" aria-label="Push to production">
        <span class="cue__bubble" id="cueLabel">push to prod v1</span>
        <span class="cue__arrow" aria-hidden="true"></span>
      </button>

      <div class="packet" id="packet" aria-hidden="true">
        <svg viewBox="0 0 36 28" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="4" width="32" height="20" rx="4" fill="#00D4FF" stroke="#1A1A2E" stroke-width="2.5"/>
          <path d="M2 8 L18 16 L34 8" fill="none" stroke="#1A1A2E" stroke-width="2.5" stroke-linecap="round"/>
          <circle cx="28" cy="18" r="3" fill="#FF8A5C" stroke="#1A1A2E" stroke-width="1.5"/>
        </svg>
      </div>

      <div class="crash-burst" id="crashBurst" aria-hidden="true">CRASH!</div>

      <div class="character" id="character" aria-hidden="true">
        <!-- Inline capybara (from character sheet, ~300px readable) -->
        <svg viewBox="0 0 200 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Capybara developer with phone">
          <!-- Hoodie torso -->
          <ellipse cx="90" cy="168" rx="52" ry="38" fill="#2B3A4A" stroke="#1A1A2E" stroke-width="4"/>
          <path d="M42,142 Q35,110 62,98 Q90,84 118,98 Q145,110 138,142 Z" fill="#2B3A4A" stroke="#1A1A2E" stroke-width="4"/>
          <path d="M54,138 Q50,112 72,102 Q90,94 108,102 Q130,112 126,138 Z" fill="#3D5166" stroke="#1A1A2E" stroke-width="2.5"/>
          <!-- Head -->
          <ellipse cx="90" cy="118" rx="40" ry="36" fill="#C4A574" stroke="#1A1A2E" stroke-width="4"/>
          <ellipse cx="90" cy="132" rx="22" ry="16" fill="#D4B896" stroke="#1A1A2E" stroke-width="3"/>
          <ellipse cx="90" cy="128" rx="8" ry="6" fill="#1A1A2E"/>
          <!-- Ears -->
          <ellipse cx="58" cy="98" rx="10" ry="8" fill="#C4A574" stroke="#1A1A2E" stroke-width="3"/>
          <ellipse cx="122" cy="98" rx="10" ry="8" fill="#C4A574" stroke="#1A1A2E" stroke-width="3"/>
          <ellipse cx="58" cy="99" rx="5" ry="4" fill="#FF8A5C"/>
          <ellipse cx="122" cy="99" rx="5" ry="4" fill="#FF8A5C"/>
          <!-- Arms -->
          <ellipse cx="42" cy="162" rx="14" ry="22" fill="#2B3A4A" stroke="#1A1A2E" stroke-width="3.5" transform="rotate(-18 42 162)"/>
          <ellipse cx="138" cy="162" rx="14" ry="22" fill="#2B3A4A" stroke="#1A1A2E" stroke-width="3.5" transform="rotate(18 138 162)"/>
          <ellipse cx="36" cy="180" rx="12" ry="9" fill="#C4A574" stroke="#1A1A2E" stroke-width="3"/>
          <ellipse cx="144" cy="180" rx="12" ry="9" fill="#C4A574" stroke="#1A1A2E" stroke-width="3"/>

          <!-- Faces -->
          <g class="face is-active" id="faceIdle" data-face="idle">
            <circle cx="76" cy="112" r="5" fill="#1A1A2E"/>
            <circle cx="104" cy="112" r="5" fill="#1A1A2E"/>
            <circle cx="78" cy="110" r="1.8" fill="#FFF8F0"/>
            <circle cx="106" cy="110" r="1.8" fill="#FFF8F0"/>
            <path d="M80,138 Q90,144 100,138" fill="none" stroke="#1A1A2E" stroke-width="3" stroke-linecap="round"/>
          </g>
          <g class="face" id="faceMad" data-face="mad">
            <path d="M70,106 L82,118 M82,106 L70,118" stroke="#1A1A2E" stroke-width="4" stroke-linecap="round"/>
            <path d="M98,106 L110,118 M110,106 L98,118" stroke="#1A1A2E" stroke-width="4" stroke-linecap="round"/>
            <path d="M78,142 Q90,134 102,142" fill="none" stroke="#1A1A2E" stroke-width="3.5" stroke-linecap="round"/>
            <path d="M128,88 L132,78 L136,88 L142,90 L136,94 L132,102 L128,94 L122,90 Z" fill="#FF8A5C" stroke="#1A1A2E" stroke-width="2"/>
            <path d="M50,108 Q42,118 50,124 Q58,118 50,108 Z" fill="#00D4FF" stroke="#1A1A2E" stroke-width="2"/>
          </g>
          <g class="face" id="faceSheepish" data-face="sheepish">
            <ellipse cx="76" cy="114" rx="7" ry="5" fill="#1A1A2E"/>
            <ellipse cx="104" cy="114" rx="7" ry="5" fill="#1A1A2E"/>
            <circle cx="79" cy="112" r="2" fill="#FFF8F0"/>
            <circle cx="107" cy="112" r="2" fill="#FFF8F0"/>
            <ellipse cx="64" cy="126" rx="8" ry="4" fill="#FF8A5C" opacity="0.55"/>
            <ellipse cx="116" cy="126" rx="8" ry="4" fill="#FF8A5C" opacity="0.55"/>
            <path d="M82,138 Q90,146 98,138" fill="none" stroke="#1A1A2E" stroke-width="3" stroke-linecap="round"/>
            <path d="M138,96 L140,102 L146,104 L140,106 L138,112 L136,106 L130,104 L136,102 Z" fill="#00D4FF" stroke="#1A1A2E" stroke-width="1.5"/>
          </g>

          <!-- Phone (held in right paw area) -->
          <g transform="translate(152, 128) rotate(12)">
            <g class="phone-state is-active" id="phoneIdle">
              <rect x="-22" y="-40" width="44" height="72" rx="8" fill="#1A1A2E" stroke="#1A1A2E" stroke-width="3"/>
              <rect x="-18" y="-36" width="36" height="58" rx="4" fill="#FFF8F0"/>
              <rect x="-14" y="-32" width="18" height="3" rx="1.5" fill="#00D4FF"/>
              <circle cx="12" cy="-30.5" r="2.5" fill="#2B3A4A"/>
              <rect x="-12" y="-22" width="10" height="10" rx="2" fill="#00D4FF"/>
              <rect x="2" y="-22" width="10" height="10" rx="2" fill="#FF8A5C"/>
              <rect x="-12" y="-8" width="10" height="10" rx="2" fill="#2B3A4A"/>
              <rect x="2" y="-8" width="10" height="10" rx="2" fill="#00D4FF" opacity="0.6"/>
              <rect x="-8" y="22" width="16" height="3" rx="1.5" fill="#1A1A2E"/>
            </g>
            <g class="phone-state" id="phoneCrash">
              <rect x="-22" y="-40" width="44" height="72" rx="8" fill="#1A1A2E" stroke="#1A1A2E" stroke-width="3"/>
              <rect x="-18" y="-36" width="36" height="58" rx="4" fill="#FFF8F0"/>
              <path d="M-10,-18 L10,10 M10,-18 L-10,10" stroke="#FF8A5C" stroke-width="5" stroke-linecap="round"/>
              <text x="0" y="22" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" font-weight="700" fill="#1A1A2E">crash</text>
            </g>
            <g class="phone-state" id="phoneOk">
              <rect x="-22" y="-40" width="44" height="72" rx="8" fill="#1A1A2E" stroke="#1A1A2E" stroke-width="3"/>
              <rect x="-18" y="-36" width="36" height="58" rx="4" fill="#FFF8F0"/>
              <circle cx="0" cy="-8" r="12" fill="none" stroke="#00D4FF" stroke-width="4"/>
              <path d="M-6,-8 L-1,-2 L8,-14" fill="none" stroke="#00D4FF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="-8" y="22" width="16" height="3" rx="1.5" fill="#1A1A2E"/>
            </g>
          </g>
        </svg>
      </div>
    </div>

    <div class="demo__ui">
      <p class="narration" id="narration" aria-live="polite">Tap the cue to ship a bad build.</p>

      <div class="choices" id="choices" role="group" aria-label="How do you fix it?">
        <button type="button" class="choice choice--store" id="choiceStore">
          New build → Apple
          <span class="choice__sub">takes a week</span>
        </button>
        <button type="button" class="choice choice--capgo" id="choiceCapgo">
          Fix + send to Capgo
          <span class="choice__sub">fixed now</span>
        </button>
      </div>

      <div class="ending" id="endingStore">
        <div class="review-card">
          <div class="review-card__stars" aria-label="1 star">★☆☆☆☆</div>
          <p class="review-card__text">“app is broken”</p>
          <p class="review-card__meta">App Store review · still waiting on that build</p>
        </div>
        <button type="button" class="restart" id="restartStore">Restart</button>
      </div>

      <div class="ending" id="endingCapgo">
        <p class="sheepish-line" id="sheepishLine">“oh, my phone was…”</p>
        <a class="cta" id="registerCta" href={registerUrl}>Try Capgo free</a>
        <button type="button" class="restart" id="restartCapgo">Restart</button>
      </div>
    </div>

    <p class="sr-only" id="statusLive" aria-live="assertive"></p>
  </div>
    </div>
  </div>
</section>

<style>

    .microdemo-section {
      background: #1a1a1a;
      padding: 6rem 0;
    }
    @media (min-width: 640px) {
      .microdemo-section { padding: 8rem 0; }
    }
    .microdemo-wrap {
      margin: 0 auto;
      max-width: 80rem;
      padding: 0 1.5rem;
    }
    @media (min-width: 1024px) {
      .microdemo-wrap { padding: 0 2rem; }
    }
    .microdemo-header {
      margin: 0 auto 2.5rem;
      max-width: 42rem;
      text-align: center;
    }
    .microdemo-header h2 {
      margin: 0;
      font-size: 1.875rem;
      font-weight: 700;
      letter-spacing: -0.025em;
      color: #fff;
      line-height: 1.2;
    }
    @media (min-width: 640px) {
      .microdemo-header h2 { font-size: 2.25rem; }
    }
    .microdemo-mount {
      margin: 0 auto;
      display: flex;
      justify-content: center;
    }


    .microdemo-section {
      --ink: #1A1A2E;
      --cyan: #00D4FF;
      --warm: #FF8A5C;
      --cream: #FFF8F0;
      --hoodie: #2B3A4A;
      --fur: #C4A574;
      --snout: #D4B896;
      --bg: #F0FBFF;
      --card: #FFFFFF;
      --radius: 20px;
    }



    .demo {
      width: min(100%, 420px);
      background: var(--card);
      border: 3px solid var(--ink);
      border-radius: var(--radius);
      box-shadow: 6px 6px 0 var(--ink);
      overflow: hidden;
      position: relative;
    }

    .demo__stage {
      position: relative;
      width: 100%;
      aspect-ratio: 1 / 1.05;
      background: linear-gradient(180deg, #E8F9FF 0%, var(--cream) 70%);
      border-bottom: 3px solid var(--ink);
      overflow: hidden;
    }

    .demo__sky {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .cloud {
      position: absolute;
      background: #fff;
      border: 2.5px solid var(--ink);
      border-radius: 40px;
      opacity: 0.85;
    }
    .cloud--a { width: 70px; height: 28px; top: 12%; left: 8%; }
    .cloud--b { width: 50px; height: 22px; top: 8%; right: 14%; }

    .character {
      position: absolute;
      left: 50%;
      bottom: 6%;
      width: min(72%, 300px);
      transform: translateX(-50%);
      z-index: 2;
    }

    .character svg { width: 100%; height: auto; display: block; }

    .face { display: none; }
    .face.is-active { display: block; }

    .phone-state { display: none; }
    .phone-state.is-active { display: block; }

    .packet {
      position: absolute;
      width: 36px;
      height: 28px;
      left: 50%;
      top: 62%;
      margin-left: -18px;
      z-index: 5;
      opacity: 0;
      pointer-events: none;
    }
    .packet svg { width: 100%; height: 100%; display: block; filter: drop-shadow(2px 2px 0 rgba(26,26,46,0.25)); }

    .cue {
      position: absolute;
      left: 50%;
      top: 18%;
      transform: translateX(-50%);
      z-index: 4;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      border: none;
      background: transparent;
      font: inherit;
      color: inherit;
      padding: 8px;
      -webkit-tap-highlight-color: transparent;
    }
    .cue[hidden] { display: none !important; }
    .cue__bubble {
      background: var(--ink);
      color: #fff;
      padding: 10px 16px;
      border-radius: 14px;
      font-size: 0.95rem;
      font-weight: 700;
      white-space: nowrap;
      box-shadow: 3px 3px 0 var(--cyan);
      animation: cue-blink 1.4s ease-in-out infinite;
    }
    .cue__arrow {
      width: 0; height: 0;
      border-left: 10px solid transparent;
      border-right: 10px solid transparent;
      border-top: 12px solid var(--ink);
      animation: cue-bob 1.4s ease-in-out infinite;
    }
    @keyframes cue-blink {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.72; transform: scale(0.98); }
    }
    @keyframes cue-bob {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(4px); }
    }

    .crash-burst {
      position: absolute;
      left: 68%;
      top: 48%;
      z-index: 6;
      font-size: 1.35rem;
      font-weight: 900;
      color: var(--warm);
      text-shadow: 2px 2px 0 var(--ink);
      opacity: 0;
      pointer-events: none;
      transform: translate(-50%, -50%) rotate(-8deg);
    }

    .demo__ui {
      padding: 16px 18px 20px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 148px;
    }

    .narration {
      font-size: 0.95rem;
      font-weight: 600;
      text-align: center;
      min-height: 2.6em;
    }

    .choices {
      display: none;
      flex-direction: column;
      gap: 10px;
    }
    .choices.is-visible { display: flex; }

    .choice {
      appearance: none;
      border: 3px solid var(--ink);
      border-radius: 14px;
      padding: 14px 16px;
      font: inherit;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      text-align: left;
      background: var(--cream);
      color: var(--ink);
      box-shadow: 3px 3px 0 var(--ink);
      transition: transform 0.12s ease, box-shadow 0.12s ease;
      min-height: 56px;
      -webkit-tap-highlight-color: transparent;
    }
    .choice:hover, .choice:focus-visible {
      transform: translate(-1px, -1px);
      box-shadow: 4px 4px 0 var(--ink);
      outline: none;
    }
    .choice:active {
      transform: translate(2px, 2px);
      box-shadow: 1px 1px 0 var(--ink);
    }
    .choice--store { background: #FFE8E0; }
    .choice--capgo {
      background: var(--cyan);
      color: var(--ink);
    }
    .choice__sub {
      display: block;
      font-size: 0.78rem;
      font-weight: 600;
      opacity: 0.75;
      margin-top: 2px;
    }

    .ending {
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      text-align: center;
    }
    .ending.is-visible { display: flex; }

    .review-card {
      width: 100%;
      border: 3px solid var(--ink);
      border-radius: 12px;
      padding: 12px 14px;
      background: #FFF5F2;
      text-align: left;
    }
    .review-card__stars {
      color: var(--warm);
      font-weight: 900;
      letter-spacing: 2px;
      font-size: 1.1rem;
    }
    .review-card__text {
      font-size: 0.9rem;
      font-weight: 600;
      margin-top: 4px;
    }
    .review-card__meta {
      font-size: 0.75rem;
      opacity: 0.65;
      margin-top: 6px;
    }

    .sheepish-line {
      font-size: 0.95rem;
      font-weight: 700;
      font-style: italic;
    }

    .cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 12px 20px;
      border-radius: 999px;
      background: var(--cyan);
      color: var(--ink);
      font-weight: 800;
      text-decoration: none;
      border: 3px solid var(--ink);
      box-shadow: 3px 3px 0 var(--ink);
      font-size: 0.95rem;
    }
    .cta:hover, .cta:focus-visible {
      transform: translate(-1px, -1px);
      box-shadow: 4px 4px 0 var(--ink);
      outline: none;
    }

    .restart {
      appearance: none;
      background: transparent;
      border: 2px dashed var(--hoodie);
      color: var(--hoodie);
      font: inherit;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 8px 14px;
      border-radius: 10px;
      cursor: pointer;
      margin-top: 4px;
    }
    .restart:hover, .restart:focus-visible {
      border-style: solid;
      color: var(--ink);
      outline: none;
    }

    .sr-only {
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      border: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .cue__bubble, .cue__arrow { animation: none; }
    }
  
</style>

<script>
  import gsap from 'gsap'

  type MicrodemoEvent = 'push' | 'choice_store' | 'choice_capgo' | 'restart' | 'cta_click'

  function track(event: MicrodemoEvent) {
    ;(window as any).posthog?.capture('capgo_microdemo', { event })
    window.dispatchEvent(new CustomEvent('capgo-microdemo', { detail: { event } }))
  }

  const VERSIONS = ['v1', 'v2', 'v3']
  let versionIndex = 0
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  let busy = false
  let cueTimer: number | null = null

  const root = document.getElementById('capgo-microdemo')
  if (!root) {
    // Component not on page
  } else {
    const el = {
      cue: document.getElementById('pushCue') as HTMLButtonElement,
      cueLabel: document.getElementById('cueLabel') as HTMLElement,
      packet: document.getElementById('packet') as HTMLElement,
      crashBurst: document.getElementById('crashBurst') as HTMLElement,
      narration: document.getElementById('narration') as HTMLElement,
      choices: document.getElementById('choices') as HTMLElement,
      endingStore: document.getElementById('endingStore') as HTMLElement,
      endingCapgo: document.getElementById('endingCapgo') as HTMLElement,
      sheepishLine: document.getElementById('sheepishLine') as HTMLElement,
      statusLive: document.getElementById('statusLive') as HTMLElement,
      faceIdle: document.getElementById('faceIdle') as HTMLElement,
      faceMad: document.getElementById('faceMad') as HTMLElement,
      faceSheepish: document.getElementById('faceSheepish') as HTMLElement,
      phoneIdle: document.getElementById('phoneIdle') as HTMLElement,
      phoneCrash: document.getElementById('phoneCrash') as HTMLElement,
      phoneOk: document.getElementById('phoneOk') as HTMLElement,
      character: document.getElementById('character') as HTMLElement,
      choiceStore: document.getElementById('choiceStore') as HTMLButtonElement,
      choiceCapgo: document.getElementById('choiceCapgo') as HTMLButtonElement,
      restartStore: document.getElementById('restartStore') as HTMLButtonElement,
      restartCapgo: document.getElementById('restartCapgo') as HTMLButtonElement,
      registerCta: document.getElementById('registerCta') as HTMLAnchorElement,
    }

    function setFace(name: string) {
      ;[el.faceIdle, el.faceMad, el.faceSheepish].forEach((f) => {
        f.classList.toggle('is-active', f.dataset.face === name)
      })
    }

    function setPhone(name: string) {
      const map: Record<string, HTMLElement> = { idle: el.phoneIdle, crash: el.phoneCrash, ok: el.phoneOk }
      Object.keys(map).forEach((k) => {
        map[k].classList.toggle('is-active', k === name)
      })
    }

    function setNarration(text: string) {
      el.narration.textContent = text
    }

    function announce(text: string) {
      el.statusLive.textContent = text
    }

    function hideEndings() {
      el.endingStore.classList.remove('is-visible')
      el.endingCapgo.classList.remove('is-visible')
    }

    function hideChoices() {
      el.choices.classList.remove('is-visible')
    }

    function showChoices() {
      el.choices.classList.add('is-visible')
    }

    function updateCueLabel() {
      el.cueLabel.textContent = 'push to prod ' + VERSIONS[versionIndex % VERSIONS.length]
    }

    function startCueCycle() {
      stopCueCycle()
      updateCueLabel()
      cueTimer = window.setInterval(() => {
        versionIndex = (versionIndex + 1) % VERSIONS.length
        updateCueLabel()
      }, 1600)
    }

    function stopCueCycle() {
      if (cueTimer) {
        window.clearInterval(cueTimer)
        cueTimer = null
      }
    }

    function resetToIdle() {
      busy = false
      gsap.killTweensOf([el.packet, el.crashBurst, el.character, el.sheepishLine])
      gsap.set(el.packet, { opacity: 0, x: 0, y: 0, scale: 1, rotation: 0 })
      gsap.set(el.crashBurst, { opacity: 0, scale: 0.5 })
      gsap.set(el.character, { x: 0, rotation: 0 })
      setFace('idle')
      setPhone('idle')
      hideChoices()
      hideEndings()
      el.cue.hidden = false
      setNarration('Tap the cue to ship a bad build.')
      announce('')
      startCueCycle()
    }

    function flyPacketThenCrash() {
      busy = true
      stopCueCycle()
      el.cue.hidden = true
      hideChoices()
      hideEndings()
      setNarration('Shipping…')
      announce('Update packet flying to the phone.')
      track('push')

      const onArrive = () => {
        setPhone('crash')
        setFace('mad')
        setNarration('It crashed. Users are stuck.')
        announce('App crashed. Choose how to fix it.')
        gsap.fromTo(
          el.crashBurst,
          { opacity: 0, scale: 0.4 },
          { opacity: 1, scale: 1.15, duration: reduceMotion ? 0.01 : 0.35, ease: 'back.out(2)' },
        )
        gsap.to(el.character, {
          x: reduceMotion ? 0 : 6,
          duration: reduceMotion ? 0.01 : 0.08,
          yoyo: true,
          repeat: reduceMotion ? 0 : 5,
          ease: 'power1.inOut',
          onComplete: () => {
            gsap.set(el.character, { x: 0 })
            gsap.to(el.crashBurst, {
              opacity: 0,
              delay: reduceMotion ? 0 : 0.45,
              duration: reduceMotion ? 0.01 : 0.25,
              onComplete: () => {
                showChoices()
                busy = false
              },
            })
          },
        })
      }

      if (reduceMotion) {
        gsap.set(el.packet, { opacity: 0 })
        onArrive()
        return
      }

      gsap.set(el.packet, { opacity: 1, x: 40, y: 20, scale: 0.85, rotation: -10 })
      const tl = gsap.timeline({ onComplete: onArrive })
      tl.to(el.packet, {
        x: -20,
        y: -140,
        scale: 1.15,
        rotation: 12,
        duration: 0.55,
        ease: 'power2.out',
      })
      tl.to(el.packet, {
        x: 48,
        y: 10,
        scale: 0.9,
        rotation: -6,
        duration: 0.65,
        ease: 'power2.in',
      })
      tl.to(el.packet, { opacity: 0, duration: 0.12 }, '-=0.05')
    }

    function playStoreEnding() {
      if (busy) return
      busy = true
      hideChoices()
      setFace('mad')
      setPhone('crash')
      setNarration('A week later…')
      announce('App Store path. Bad one star review.')
      track('choice_store')

      const reveal = () => {
        el.endingStore.classList.add('is-visible')
        setNarration('Still broken in the wild.')
        busy = false
      }

      if (reduceMotion) {
        reveal()
        return
      }

      gsap.fromTo(
        el.endingStore,
        { opacity: 0, y: 8 },
        {
          opacity: 1,
          y: 0,
          duration: 0.4,
          ease: 'power2.out',
          onStart: () => {
            el.endingStore.classList.add('is-visible')
          },
          onComplete: () => {
            setNarration('Still broken in the wild.')
            busy = false
          },
        },
      )
    }

    function playCapgoEnding() {
      if (busy) return
      busy = true
      hideChoices()
      setNarration('Hotfix on the way…')
      announce('Capgo path. Fix arrives now.')
      track('choice_capgo')

      const showSuccess = () => {
        setPhone('ok')
        setFace('sheepish')
        el.sheepishLine.textContent = '\u201Coh, my phone was\u2026\u201D'
        el.endingCapgo.classList.add('is-visible')
        setNarration('Works again. No store wait.')
        busy = false
      }

      if (reduceMotion) {
        setFace('mad')
        setPhone('crash')
        window.setTimeout(showSuccess, 120)
        return
      }

      setFace('mad')
      setPhone('crash')
      gsap.set(el.packet, { opacity: 1, x: -30, y: -160, scale: 1, rotation: 0 })
      const tl = gsap.timeline({ onComplete: showSuccess })
      tl.to(el.packet, {
        x: 48,
        y: 10,
        duration: 0.7,
        ease: 'power2.inOut',
      })
      tl.to(el.packet, { opacity: 0, scale: 0.6, duration: 0.15 })
      tl.add(() => {
        setPhone('ok')
        setFace('sheepish')
      })
      tl.fromTo(
        el.endingCapgo,
        { opacity: 0, y: 10 },
        {
          opacity: 1,
          y: 0,
          duration: 0.45,
          ease: 'power2.out',
          onStart: () => {
            el.endingCapgo.classList.add('is-visible')
          },
        },
      )
    }

    el.cue.addEventListener('click', () => {
      if (busy) return
      flyPacketThenCrash()
    })

    el.choiceStore.addEventListener('click', playStoreEnding)
    el.choiceCapgo.addEventListener('click', playCapgoEnding)
    el.restartStore.addEventListener('click', () => {
      track('restart')
      resetToIdle()
    })
    el.restartCapgo.addEventListener('click', () => {
      track('restart')
      resetToIdle()
    })
    el.registerCta.addEventListener('click', () => {
      track('cta_click')
    })

    resetToIdle()
  }
</script>
