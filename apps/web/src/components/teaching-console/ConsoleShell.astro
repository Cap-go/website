---
import '@/styles/teaching-console.css'

export type TeachStep = { id: string; label: string; hint: string }
export type ConsoleTab = { id: string; label: string; badge?: string }
type NavItem = {
  label: string
  paths: string[]
  stroke?: boolean
  filled?: boolean
  external?: boolean
}

interface Props {
  demoId: string
  steps: TeachStep[]
  breadcrumbs: string
  activeTab: string
  tabs?: ConsoleTab[]
  title: string
  subtitle?: string
  badge?: string
  status: string
  actionLabel: string
  hint?: string
  showRange?: boolean
  activeRange?: string
  activeNav?: string
  hideFootAction?: boolean
}

const {
  demoId,
  steps,
  breadcrumbs,
  activeTab,
  tabs = [
    { id: 'dashboard', label: 'Dashboard' },
    { id: 'observe', label: 'Observe', badge: 'BETA' },
    { id: 'information', label: 'Information' },
    { id: 'bundles', label: 'Bundles' },
    { id: 'channels', label: 'Channels' },
    { id: 'devices', label: 'Devices' },
    { id: 'notifications', label: 'Notifications', badge: 'BETA' },
    { id: 'logs', label: 'Logs' },
    { id: 'builds', label: 'Builds' },
  ],
  title,
  subtitle,
  badge,
  status,
  actionLabel,
  hint = 'Teaching flow auto-advances once. Prefer-reduced-motion shows the end state.',
  showRange = false,
  activeRange = '7 days',
  activeNav = 'Apps',
  hideFootAction = false,
} = Astro.props

const nav: NavItem[] = [
  {
    label: 'Dashboard',
    // Lucide-like bar chart (real console)
    paths: ['M4 20V10', 'M10 20V4', 'M16 20v-7', 'M22 20H2'],
    stroke: true,
  },
  {
    label: 'Apps',
    // Capgo webapp uses the App Store "A" mark for Apps
    paths: ['M12 3.5L16.8 20h-2.4l-1-3.2H10.6l-1 3.2H7.2L12 3.5z', 'M11.05 14.2h1.9L12 11.1z'],
    stroke: true,
  },
  {
    label: 'API Keys',
    // Shield with keyhole
    paths: ['M12 3l7 3v5c0 4.5-3.1 8.4-7 9.5C8.1 19.4 5 15.5 5 11V6l7-3z', 'M12 11a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm0 0v3.5'],
    stroke: true,
  },
  {
    label: 'Documentation',
    paths: ['M7 3.5h7.5L19 8v12.5a1 1 0 01-1 1H7a1 1 0 01-1-1V4.5a1 1 0 011-1z', 'M14 3.5V8h4.5', 'M9 12h6', 'M9 15.5h6'],
    stroke: true,
    external: true,
  },
  {
    label: 'Discord',
    paths: [
      'M19.3 5.8A16.4 16.4 0 0015.2 4l-.3.6a14.7 14.7 0 00-5.8 0L8.8 4A16.4 16.4 0 004.7 5.8C2.3 9.7 1.7 13.5 2 17.2a16.5 16.5 0 005.1 2.6l1-.9a10.7 10.7 0 01-1.5-.7l.1-.1c1.9.9 4 1.3 6.1 1.3s4.2-.4 6.1-1.3l.1.1c-.5.3-1 .5-1.5.7l1 .9a16.5 16.5 0 005.1-2.6c.4-3.7-.2-7.5-2.6-11.4zM9.5 14.6c-.8 0-1.5-.8-1.5-1.7S8.7 11.2 9.5 11.2s1.5.8 1.5 1.7-.7 1.7-1.5 1.7zm5 0c-.8 0-1.5-.8-1.5-1.7s.7-1.7 1.5-1.7 1.5.8 1.5 1.7-.7 1.7-1.5 1.7z',
    ],
    stroke: false,
    filled: true,
    external: true,
  },
]
const ranges = ['1 day', '3 days', '7 days', '30 days']
---

<div class="tc tc-root" data-tc-demo={demoId} data-tc-step={steps[0]?.id}>
  <div class="tc-teachbar">
    <ol class="tc-steps" role="list" aria-label="Teaching steps">
      {
        steps.map((step, index) => (
          <li>
            <button type="button" class:list={['tc-step', index === 0 && 'is-active']} data-tc-step-btn={step.id} aria-current={index === 0 ? 'step' : 'false'}>
              <span class="tc-step-num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="tc-step-copy">
                <strong>{step.label}</strong>
                <small>{step.hint}</small>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
    <p class="tc-status" data-tc-status aria-live="polite">{status}</p>
  </div>

  <div class="tc-shell">
    <aside class="tc-sidebar" aria-hidden="true">
      <div class="tc-brand">
        <span class="tc-brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.5L20.5 7v10L12 21.5 3.5 17V7L12 2.5z" />
            <path d="M9 9.5l6 5M15 9.5l-6 5" />
          </svg>
        </span>
        Capgo
      </div>
      <div class="tc-org">
        <span class="tc-avatar">DO</span>
        <div class="tc-org-copy">
          <strong>Demo org</strong>
          <span>Demo app</span>
        </div>
      </div>
      <p class="tc-pages-label">Pages</p>
      <nav class="tc-nav">
        {
          nav.map((item) => (
            <div class:list={['tc-nav-item', item.label === activeNav && 'is-active']}>
              <svg
                class:list={['tc-nav-ico', item.filled && 'is-filled']}
                viewBox="0 0 24 24"
                fill={item.filled ? 'currentColor' : 'none'}
                stroke={item.stroke === false || item.filled ? 'none' : 'currentColor'}
                stroke-width={item.filled || item.stroke === false ? undefined : '1.5'}
                aria-hidden="true"
              >
                {item.paths.map((d) => (
                  <path stroke-linecap="round" stroke-linejoin="round" d={d} />
                ))}
              </svg>
              <span class:list={['tc-nav-label', item.external && 'is-external']}>{item.label}</span>
              {item.external ? (
                <svg class="tc-nav-ext" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 4h6v6M10 14L20 4M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5" />
                </svg>
              ) : null}
            </div>
          ))
        }
      </nav>
      <div class="tc-sidebar-foot">
        <div class="tc-user">
          <span class="tc-avatar">TC</span>
          <div>
            <strong>test Capgo</strong>
            <span>test@capgo.app</span>
          </div>
        </div>
        <div class="tc-side-links">
          <span>Settings</span>
          <span>Support</span>
          <span>Sign Out</span>
        </div>
      </div>
    </aside>

    <div class="tc-main">
      <div class="tc-top">
        <p class="tc-crumb" set:html={breadcrumbs} />
        <div class="tc-tabs" aria-hidden="true">
          {
            tabs.map((tab) => (
              <span
                class:list={['tc-tab', tab.id === activeTab && 'is-active']}
                data-tc-chrome-tab={tab.id}
              >
                {tab.label}
                {tab.badge ? <span class="tc-tab-badge">{tab.badge}</span> : null}
              </span>
            ))
          }
        </div>
      </div>

      <div class="tc-body">
        <header class="tc-panel-head">
          <div>
            <div class="tc-title-row">
              <h2 class="tc-title">{title}</h2>
              {badge ? <span class="tc-badge">{badge}</span> : null}
            </div>
            {subtitle ? <p class="tc-sub">{subtitle}</p> : null}
          </div>
          {
            showRange ? (
              <div class="tc-range" aria-hidden="true">
                {ranges.map((range) => (
                  <span class:list={[range === activeRange && 'is-active']}>{range}</span>
                ))}
              </div>
            ) : null
          }
        </header>

        <slot />
      </div>
    </div>
  </div>

  <div class="tc-foot">
    {
      hideFootAction ? (
        <span></span>
      ) : (
        <button type="button" class="tc-btn tc-btn-primary" data-tc-action>
          {actionLabel}
        </button>
      )
    }
    <p class="tc-hint">{hint}</p>
  </div>
</div>
