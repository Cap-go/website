---
import ConsoleShell from './ConsoleShell.astro'

const steps = [
  { id: 'policy', label: 'Policy', hint: 'Org release policy' },
  { id: 'sso', label: 'SSO', hint: 'IdP connected' },
  { id: 'roles', label: 'Roles', hint: 'Gate deploy rights' },
]
---

<div class="tc-embed">
  <ConsoleShell
    demoId="enterprise"
    steps={steps}
    breadcrumbs={'org / Demo org / <strong>Access</strong>'}
    activeTab="access"
    title="Enterprise access"
    subtitle="Org policy, SSO, and role gates for production deploys."
    status="Review the org release policy before enabling SSO."
    actionLabel="Open org policy"
    activeNav="Dashboard"
    tabs={[
      { id: 'dashboard', label: 'Dashboard' },
      { id: 'access', label: 'Access' },
      { id: 'apps', label: 'Apps' },
      { id: 'audit', label: 'Audit' },
    ]}
  >
    <div class="tc-grid-2" aria-live="polite">
      <div class="tc-card tc-card-pad">
        <h3 class="tc-card-title">Org policy</h3>
        <ul class="tc-list">
          <li><span>Require 2 reviewers on production</span><strong class="tc-pill is-muted" data-ent-p1>off</strong></li>
          <li><span>Block unsigned bundles</span><strong class="tc-pill is-muted" data-ent-p2>off</strong></li>
          <li><span>SSO required for console</span><strong class="tc-pill is-muted" data-ent-p3>off</strong></li>
        </ul>
      </div>
      <div class="tc-card tc-card-pad">
        <h3 class="tc-card-title">Role gate</h3>
        <dl class="tc-rows" style="margin:0 -12px">
          <div class="tc-row"><dt>IdP</dt><dd data-ent-idp>Not connected</dd></div>
          <div class="tc-row"><dt>Deploy role</dt><dd data-ent-role>Anyone in org</dd></div>
          <div class="tc-row"><dt>Last audit</dt><dd data-ent-audit>—</dd></div>
        </dl>
      </div>
    </div>
  </ConsoleShell>
</div>

<script>
  import { setupTeachingConsole } from './teaching-console.client.ts'

  document.querySelectorAll<HTMLElement>('[data-tc-demo="enterprise"]').forEach((root) => {
    const pill = (sel: string, text: string, ok = false) => {
      const el = root.querySelector(sel)
      if (!el) return
      el.className = `tc-pill${ok ? '' : ' is-muted'}`
      el.textContent = text
    }

    const setText = (sel: string, text: string) => {
      const el = root.querySelector(sel)
      if (el) el.textContent = text
    }

    /** Paint cumulative org state so re-entering earlier steps clears later fields. */
    function paintEnterprise(step: 'policy' | 'sso' | 'roles') {
      pill('[data-ent-p1]', 'on', true)
      pill('[data-ent-p2]', 'on', true)
      if (step === 'policy') {
        pill('[data-ent-p3]', 'off', false)
        setText('[data-ent-idp]', 'Not connected')
        setText('[data-ent-role]', 'Anyone in org')
        setText('[data-ent-audit]', '—')
        return
      }
      pill('[data-ent-p3]', 'on', true)
      setText('[data-ent-idp]', 'Okta · SAML · connected')
      if (step === 'sso') {
        setText('[data-ent-role]', 'Anyone in org')
        setText('[data-ent-audit]', '—')
        return
      }
      setText('[data-ent-role]', 'release-manager')
      setText('[data-ent-audit]', 'Policy enforced · 2m ago')
    }

    setupTeachingConsole(
      root,
      [
        {
          id: 'policy',
          actionLabel: 'Open org policy',
          status: 'Review the org release policy before enabling SSO.',
          enter() {
            paintEnterprise('policy')
          },
        },
        {
          id: 'sso',
          actionLabel: 'Connect SSO',
          status: 'SSO connected — Okta / SAML enforced for console login.',
          enter() {
            paintEnterprise('sso')
          },
        },
        {
          id: 'roles',
          actionLabel: 'Enforce deploy role',
          status: 'Only release-managers can ship production channels.',
          enter(ctx) {
            paintEnterprise('roles')
            ctx.setActionDisabled(true)
          },
        },
      ],
      { startWhenVisible: true },
    )
  })
</script>
