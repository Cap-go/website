---
import m from '@/copy/messages'

const locale = Astro.locals.locale
---

<div class="stage" data-stage aria-hidden="true">
  <div class="inner">
    <!-- Row A: web change -->
    <div class="commit ca">
      <span class="commit-dot"></span>
      <div>
        <p class="commit-title">fix: payment total</p>
        <p class="commit-file">src/cart.ts <span class="add">+3</span> <span class="del">−1</span></p>
      </div>
    </div>
    <div class="verdict va">
      <p class="verdict-cmd">$ capgo bundle upload</p>
      <p class="verdict-checking"><span class="spinner"></span> checking</p>
      <p class="verdict-result good">✓ {m.explainer_ota_safe({}, { locale })}</p>
    </div>
    <div class="transit ta">
      <span class="track"></span>
      <span class="packet packet-a">JS</span>
      <span class="arrival">{m.explainer_ota_live_minutes({}, { locale })}</span>
    </div>

    <!-- Row B: native change -->
    <div class="commit cb">
      <span class="commit-dot"></span>
      <div>
        <p class="commit-title">chore: bump camera plugin</p>
        <p class="commit-file">@capacitor/camera <span class="del">6.1</span> → <span class="add">6.2</span></p>
      </div>
    </div>
    <div class="verdict vb">
      <p class="verdict-cmd">$ capgo bundle upload</p>
      <p class="verdict-checking"><span class="spinner"></span> checking</p>
      <p class="verdict-result bad">✕ {m.explainer_ota_needs_build({}, { locale })}</p>
    </div>
    <div class="transit tb">
      <span class="track"></span>
      <span class="store">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="8.5"></circle>
          <path class="clock-hand" d="M12 12V7.5"></path>
          <path d="M12 12l3 2"></path>
        </svg>
        <span>
          <span class="store-title">{m.explainer_ota_store_review({}, { locale })}</span>
          <span class="store-days">{m.explainer_ota_days({}, { locale })}</span>
        </span>
      </span>
      <span class="packet packet-b">.ipa · .aab</span>
    </div>

    <!-- The app: two layers -->
    <div class="app">
      <p class="app-label">{m.explainer_ota_your_app({}, { locale })}</p>
      <div class="plate plate-web">
        <p class="plate-title">{m.explainer_ota_web_layer({}, { locale })}</p>
        <p class="chips"><span>JS</span><span>CSS</span><span>HTML</span><span>assets</span></p>
        <span class="plate-flash"></span>
      </div>
      <div class="plate plate-native">
        <p class="plate-title">{m.explainer_ota_native_shell({}, { locale })}</p>
        <p class="chips"><span>Swift</span><span>Kotlin</span><span>plugins</span><span>config</span></p>
        <span class="plate-flash"></span>
      </div>
    </div>

    <div class="summary">
      <p><span class="swatch web"></span>{m.explainer_ota_web_layer({}, { locale })} <span class="arrow">→</span> <strong>Capgo</strong></p>
      <p><span class="swatch native"></span>{m.explainer_ota_native_shell({}, { locale })} <span class="arrow">→</span> <strong>App Store · Google Play</strong></p>
    </div>
  </div>
</div>

<style>
  .stage {
    container-type: inline-size;
  }
  .inner {
    --blue: #44bcff;
    --green: #4ade80;
    --red: #f87171;
    --amber: #fbbf24;
    display: grid;
    grid-template-columns: 14em 14em minmax(8em, 1fr) 15em;
    grid-template-rows: auto auto auto;
    align-items: center;
    column-gap: 1.2em;
    row-gap: 2.2em;
    padding: 3em 3em 2.4em;
    min-height: 38em;
    font-size: clamp(9px, 1.45cqw, 14px);
    color: #e5e7eb;
    background:
      radial-gradient(50% 60% at 90% 45%, rgb(68 188 255 / 0.1), transparent 70%),
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.06) 1px, transparent 0) 0 0 / 2em 2em;
  }
  .ca,
  .va,
  .ta {
    grid-row: 1;
  }
  .cb,
  .vb,
  .tb {
    grid-row: 2;
  }
  .app {
    grid-column: 4;
    grid-row: 1 / span 2;
  }
  .summary {
    grid-column: 1 / -1;
    grid-row: 3;
  }

  /* Commit cards */
  .commit {
    display: flex;
    gap: 0.8em;
    align-items: flex-start;
    padding: 1em 1.1em;
    border-radius: 1em;
    background: #16181d;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    opacity: 0;
    transform: translateX(-1.2em);
    transition:
      opacity 0.4s,
      transform 0.4s;
  }
  .commit-dot {
    flex: none;
    width: 0.9em;
    height: 0.9em;
    margin-top: 0.3em;
    border-radius: 50%;
    box-shadow: inset 0 0 0 0.2em #9ca3af;
  }
  .commit-title {
    font:
      600 1em/1.35 ui-monospace,
      monospace;
    color: #fff;
  }
  .commit-file {
    margin-top: 0.35em;
    font:
      0.85em/1.3 ui-monospace,
      monospace;
    color: #9ca3af;
  }
  .add {
    color: var(--green);
  }
  .del {
    color: var(--red);
  }
  .s1 .ca,
  .s2 .cb {
    opacity: 1;
    transform: none;
  }

  /* CLI verdict */
  .verdict {
    position: relative;
    display: grid;
    min-height: 5.2em;
    align-content: center;
    padding: 0.9em 1em;
    border-radius: 1em;
    background: #0a0b0e;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    font:
      0.9em/1.4 ui-monospace,
      monospace;
    opacity: 0.35;
    transition:
      opacity 0.3s,
      box-shadow 0.4s;
  }
  .verdict-cmd {
    color: #6b7280;
    white-space: nowrap;
  }
  .verdict-checking,
  .verdict-result {
    grid-area: 2 / 1;
    display: flex;
    align-items: center;
    gap: 0.45em;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .verdict-result {
    font-weight: 700;
  }
  .good {
    color: var(--green);
  }
  .bad {
    color: var(--red);
  }
  .spinner {
    width: 0.9em;
    height: 0.9em;
    border-radius: 50%;
    border: 0.15em solid rgb(255 255 255 / 0.2);
    border-top-color: var(--blue);
    animation: spin 0.8s linear infinite;
  }
  .s1 .va,
  .s2 .vb {
    opacity: 1;
    transition-delay: 0.3s;
  }
  .s1 .va .verdict-checking,
  .s2 .vb .verdict-checking {
    opacity: 1;
    transition-delay: 0.5s;
  }
  .s1 .va .verdict-checking {
    animation: hide 0s 1.3s forwards;
  }
  .s2 .vb .verdict-checking {
    animation: hide 0s 1.3s forwards;
  }
  .s1 .va .verdict-result,
  .s2 .vb .verdict-result {
    opacity: 1;
    transition-delay: 1.3s;
  }
  .s1 .va {
    box-shadow: inset 0 0 0 1px rgb(74 222 128 / 0.45);
    transition-delay: 0.3s, 1.3s;
  }
  .s2 .vb {
    box-shadow: inset 0 0 0 1px rgb(248 113 113 / 0.5);
    transition-delay: 0.3s, 1.3s;
  }

  /* Transit lanes */
  .transit {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 5.2em;
  }
  .track {
    position: absolute;
    inset: 50% 0 auto;
    border-top: 2px dashed rgb(255 255 255 / 0.14);
  }
  .packet {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 2;
    padding: 0.35em 0.7em;
    border-radius: 999px;
    font:
      700 0.85em/1 ui-monospace,
      monospace;
    white-space: nowrap;
    opacity: 0;
    translate: 0 -50%;
  }
  .packet-a {
    background: var(--blue);
    color: #04121c;
    box-shadow: 0 0 1.4em rgb(68 188 255 / 0.7);
  }
  .packet-b {
    background: var(--amber);
    color: #2a1a00;
    box-shadow: 0 0 1.4em rgb(251 191 36 / 0.5);
  }
  .s1 .packet-a {
    animation: fly-a 1s cubic-bezier(0.5, 0, 0.3, 1) 1.6s forwards;
  }
  @keyframes fly-a {
    0% {
      left: 0;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 2em);
      opacity: 0;
    }
  }
  .s2 .packet-b {
    animation: fly-b 2.4s ease-in-out 1.6s forwards;
  }
  @keyframes fly-b {
    0% {
      left: 0;
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    30% {
      left: calc(50% - 3em);
      opacity: 1;
    }
    36%,
    70% {
      left: calc(50% - 3em);
      opacity: 0;
    }
    76% {
      opacity: 1;
    }
    92% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 5em);
      opacity: 0;
    }
  }
  .arrival {
    position: absolute;
    right: 0;
    bottom: -0.4em;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    background: rgb(74 222 128 / 0.12);
    color: var(--green);
    font-size: 0.85em;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.4em);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .s1 .arrival {
    opacity: 1;
    transform: none;
    transition-delay: 2.6s;
  }
  .store {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.6em 0.9em;
    border-radius: 0.9em;
    background: #1c1a14;
    box-shadow: inset 0 0 0 1px rgb(251 191 36 / 0.25);
    opacity: 0.35;
    transition:
      opacity 0.3s,
      box-shadow 0.3s;
  }
  .store svg {
    width: 1.7em;
    height: 1.7em;
    color: var(--amber);
  }
  .clock-hand {
    transform-origin: 12px 12px;
  }
  .s2 .clock-hand {
    animation: spin 0.6s linear 2.4s 3;
  }
  .store-title {
    display: block;
    font-weight: 600;
    font-size: 0.9em;
    color: #fff;
    white-space: nowrap;
  }
  .store-days {
    display: block;
    font:
      0.8em/1.3 ui-monospace,
      monospace;
    color: var(--amber);
  }
  .s2 .store {
    opacity: 1;
    box-shadow:
      inset 0 0 0 1px rgb(251 191 36 / 0.6),
      0 0 2em rgb(251 191 36 / 0.15);
    transition-delay: 2.2s;
  }

  /* App plates */
  .app {
    display: grid;
    gap: 1em;
    padding: 1em;
    border-radius: 1.4em;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    background: rgb(255 255 255 / 0.02);
  }
  .app-label {
    font-size: 0.8em;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9ca3af;
  }
  .plate {
    position: relative;
    padding: 1.1em;
    border-radius: 1em;
    overflow: hidden;
    transition:
      box-shadow 0.4s,
      transform 0.4s;
  }
  .plate-web {
    background: linear-gradient(135deg, rgb(68 188 255 / 0.22), rgb(37 99 235 / 0.18));
    box-shadow: inset 0 0 0 1px rgb(68 188 255 / 0.35);
  }
  .plate-native {
    background: linear-gradient(135deg, rgb(148 163 184 / 0.16), rgb(71 85 105 / 0.14));
    box-shadow: inset 0 0 0 1px rgb(148 163 184 / 0.3);
  }
  .plate-title {
    font-weight: 700;
    color: #fff;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
    margin-top: 0.6em;
  }
  .chips span {
    padding: 0.15em 0.5em;
    border-radius: 0.4em;
    background: rgb(0 0 0 / 0.3);
    font:
      0.78em/1.4 ui-monospace,
      monospace;
    color: #d1d5db;
  }
  .plate-flash {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }
  .plate-web .plate-flash {
    background: radial-gradient(circle at 0% 50%, rgb(74 222 128 / 0.45), transparent 70%);
  }
  .plate-native .plate-flash {
    background: radial-gradient(circle at 0% 50%, rgb(251 191 36 / 0.4), transparent 70%);
  }

  .s0:not(.s1) .plate-web {
    animation: pulse 1.6s ease 0.3s;
  }
  .s0:not(.s1) .plate-native {
    animation: pulse 1.6s ease 1.5s;
  }
  @keyframes pulse {
    40% {
      transform: scale(1.04);
      box-shadow:
        inset 0 0 0 1px rgb(255 255 255 / 0.6),
        0 0 2.4em rgb(68 188 255 / 0.3);
    }
  }
  .s1 .plate-web .plate-flash {
    animation: flash 1.2s ease 2.5s;
  }
  .s1 .plate-web {
    box-shadow: inset 0 0 0 1px rgb(74 222 128 / 0.7);
    transition-delay: 2.5s;
  }
  .s2 .plate-native .plate-flash {
    animation: flash 1.2s ease 3.8s;
  }
  .s2 .plate-native {
    box-shadow: inset 0 0 0 1px rgb(251 191 36 / 0.7);
    transition-delay: 3.8s;
  }
  @keyframes flash {
    30% {
      opacity: 1;
    }
  }

  /* Summary */
  .summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8em 2.4em;
    padding-top: 1.6em;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    color: #d1d5db;
    opacity: 0;
    transform: translateY(0.6em);
    transition:
      opacity 0.45s,
      transform 0.45s;
  }
  .summary p {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .summary strong {
    color: #fff;
  }
  .arrow {
    color: #6b7280;
  }
  .swatch {
    width: 0.8em;
    height: 0.8em;
    border-radius: 0.25em;
  }
  .swatch.web {
    background: var(--blue);
  }
  .swatch.native {
    background: #94a3b8;
  }
  .s3 .summary {
    opacity: 1;
    transform: none;
    transition-delay: 0.3s;
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  @keyframes hide {
    to {
      visibility: hidden;
    }
  }

  @container (max-width: 560px) {
    .inner {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: 1em;
      padding: 2em 1.5em;
      font-size: clamp(9px, 2.7cqw, 12px);
    }
    .app {
      grid-column: 1 / -1;
      grid-row: 1;
      grid-template-columns: 1fr 1fr;
      margin-bottom: 1em;
    }
    .app-label {
      grid-column: 1 / -1;
    }
    .ca,
    .cb {
      grid-column: 1 / -1;
    }
    .ca {
      grid-row: 2;
    }
    .va {
      grid-row: 3;
    }
    .ta {
      grid-row: 3;
    }
    .cb {
      grid-row: 4;
      margin-top: 1em;
    }
    .vb {
      grid-row: 5;
    }
    .tb {
      grid-row: 5;
    }
    .va,
    .vb {
      grid-column: 1;
    }
    .ta,
    .tb {
      grid-column: 2;
    }
    .summary {
      grid-row: 6;
      flex-direction: column;
      align-items: flex-start;
      margin-top: 1em;
    }
    .store span {
      display: none;
    }
  }
</style>
