---
import m from '@/copy/messages'

const locale = Astro.locals.locale
const homeIcons = ['#f97316', '#22c55e', '#eab308', '#ec4899', '#8b5cf6', 'app', '#06b6d4', '#ef4444', '#64748b', '#14b8a6', '#f43f5e', '#6366f1']
---

<div class="stage" data-stage aria-hidden="true">
  <div class="inner">
    <div class="left">
      <div class="term">
        <div class="term-bar"><i></i><i></i><i></i></div>
        <div class="term-body">
          <p class="dim"><span class="prompt">$</span> git commit -m "fix: payment total"</p>
          <p>
            <span class="prompt">$</span>
            <span class="cmd">npx @capgo/cli bundle upload</span><span class="caret"></span>
          </p>
          <p class="out o1"><span class="ok">✔</span> bundle 1.0.1 signed</p>
          <p class="out o2"><span class="ok">✔</span> live on channel production</p>
        </div>
      </div>
      <div class="safety">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z"></path>
          <path d="M8.5 12.2 11 14.6l4.6-4.8"></path>
        </svg>
        <div>
          <p class="safety-title">{m.explainer_next_launch_safety_title({}, { locale })}</p>
          <p class="safety-desc">{m.explainer_next_launch_safety_desc({}, { locale })}</p>
        </div>
      </div>
    </div>

    <div class="lane">
      <span class="lane-track"></span>
      <span class="packet">1.0.1</span>
    </div>

    <div class="phone">
      <div class="screen">
        <div class="statusbar"><span>9:41</span><span class="notch"></span><span class="signal"><i></i><i></i><i></i></span></div>

        {
          ['old', 'new'].map((version) => (
            <div class={`app app-${version}`}>
              <div class="app-header">
                <span class="back">‹</span>
                <span class="app-title">{m.explainer_next_launch_checkout({}, { locale })}</span>
                <span class="version">{version === 'old' ? 'v1.0.0' : 'v1.0.1'}</span>
              </div>
              <div class="item">
                <span class="thumb" style="background:#fde68a" />
                <span class="lines">
                  <i style="width:70%" />
                  <i style="width:40%" />
                </span>
                <span class="price">$16.00</span>
              </div>
              <div class="item">
                <span class="thumb" style="background:#bfdbfe" />
                <span class="lines">
                  <i style="width:60%" />
                  <i style="width:35%" />
                </span>
                <span class="price">$8.00</span>
              </div>
              <div class="total">
                <span>Total</span>
                <span>$24.00</span>
              </div>
              <span class="pay">
                {m.explainer_next_launch_pay({}, { locale })}
                <span class="tap" />
              </span>
              <span class={`toast ${version === 'old' ? 'toast-bad' : 'toast-good'}`}>
                <span class="toast-icon">{version === 'old' ? '!' : '✓'}</span>
                {version === 'old' ? m.explainer_next_launch_failed({}, { locale }) : m.explainer_next_launch_confirmed({}, { locale })}
              </span>
            </div>
          ))
        }

        <div class="home">
          {
            homeIcons.map((color) =>
              color === 'app' ? (
                <span class="home-icon home-app">
                  <span class="staged">1.0.1</span>
                  <span class="tap" />
                </span>
              ) : (
                <span class="home-icon" style={`background:${color}`} />
              ),
            )
          }
        </div>

        <div class="splash"><span class="splash-icon"></span></div>

        <div class="pill dl-pill">
          <span class="dl-label">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M8 2.5v8m0 0 3-3m-3 3-3-3M3 13.5h10"></path></svg>
            {m.explainer_next_launch_downloading({}, { locale })}
          </span>
          <span class="dl-done">✓ 1.0.1</span>
          <span class="bar"><i></i></span>
        </div>

        <div class="pill ready-pill"><span class="ok">✓</span> notifyAppReady()</div>
      </div>
    </div>
  </div>
</div>

<style>
  .stage {
    container-type: inline-size;
  }
  .inner {
    --blue: #44bcff;
    --green: #4ade80;
    --red: #f87171;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9em auto;
    align-items: center;
    padding: 3em 3.5em;
    font-size: clamp(9px, 1.55cqw, 14px);
    min-height: 38em;
    background:
      radial-gradient(60% 70% at 78% 50%, rgb(68 188 255 / 0.12), transparent 70%),
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.06) 1px, transparent 0) 0 0 / 2em 2em;
  }
  .left {
    display: grid;
    gap: 1.4em;
  }

  /* Terminal */
  .term {
    border-radius: 1em;
    background: #0a0b0e;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 1.5em 3em rgb(0 0 0 / 0.45);
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    gap: 0.45em;
    padding: 0.9em 1.1em;
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
  }
  .term-bar i {
    width: 0.75em;
    height: 0.75em;
    border-radius: 50%;
    background: #ef4444;
  }
  .term-bar i:nth-child(2) {
    background: #eab308;
  }
  .term-bar i:nth-child(3) {
    background: #22c55e;
  }
  .term-body {
    display: grid;
    gap: 0.55em;
    padding: 1.2em 1.3em 1.5em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.05em;
    color: #e5e7eb;
    white-space: nowrap;
  }
  .dim {
    color: #6b7280;
  }
  .prompt {
    color: var(--green);
  }
  .cmd {
    display: inline-block;
    width: 0;
    overflow: hidden;
    vertical-align: bottom;
  }
  .s1 .cmd {
    width: 28ch;
    transition: width 1.1s steps(28, end) 0.2s;
  }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.15em;
    vertical-align: -0.15em;
    background: #e5e7eb;
    animation: blink 1s steps(1) infinite;
  }
  .out {
    opacity: 0;
    transform: translateY(0.3em);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .ok {
    color: var(--green);
  }
  .s1 .o1 {
    opacity: 1;
    transform: none;
    transition-delay: 1.5s;
  }
  .s1 .o2 {
    opacity: 1;
    transform: none;
    transition-delay: 1.9s;
  }

  /* Safety net card */
  .safety {
    display: flex;
    gap: 0.9em;
    align-items: flex-start;
    padding: 1.1em 1.2em;
    border-radius: 1em;
    background: rgb(74 222 128 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(74 222 128 / 0.3);
    opacity: 0;
    transform: translateY(0.8em);
    transition:
      opacity 0.45s,
      transform 0.45s;
  }
  .safety svg {
    flex: none;
    width: 1.9em;
    height: 1.9em;
    color: var(--green);
  }
  .safety-title {
    font-weight: 600;
    color: #fff;
    font-size: 1.05em;
  }
  .safety-desc {
    margin-top: 0.2em;
    color: #9ca3af;
    line-height: 1.45;
  }
  .s5 .safety {
    opacity: 1;
    transform: none;
    transition-delay: 1s;
  }

  /* Lane + packet */
  .lane {
    position: relative;
    height: 2.4em;
  }
  .lane-track {
    position: absolute;
    inset: 50% 0.6em auto;
    border-top: 2px dashed rgb(255 255 255 / 0.14);
  }
  .packet {
    position: absolute;
    top: 50%;
    left: -2em;
    padding: 0.35em 0.75em;
    border-radius: 999px;
    background: var(--blue);
    color: #04121c;
    font:
      700 0.95em/1 ui-monospace,
      monospace;
    box-shadow: 0 0 1.6em rgb(68 188 255 / 0.7);
    opacity: 0;
    translate: 0 -50%;
  }
  .s1 .packet {
    animation: fly-x 1.1s cubic-bezier(0.5, 0, 0.3, 1) 2.2s forwards;
  }
  @keyframes fly-x {
    0% {
      left: -2em;
      opacity: 0;
    }
    15%,
    80% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 2em);
      opacity: 0;
    }
  }

  /* Phone */
  .phone {
    width: 16.5em;
    height: 32em;
    padding: 0.5em;
    border-radius: 2.8em;
    background: #25282e;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.12),
      0 2em 4em rgb(0 0 0 / 0.55);
    transition: box-shadow 0.6s;
  }
  .s5 .phone {
    box-shadow:
      0 0 0 1px rgb(74 222 128 / 0.5),
      0 0 3em rgb(74 222 128 / 0.25),
      0 2em 4em rgb(0 0 0 / 0.55);
  }
  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 2.35em;
    background: #f8fafc;
    color: #0f172a;
    transition: background 0.4s;
  }
  .statusbar {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9em 1.5em 0.4em;
    font-size: 0.8em;
    font-weight: 600;
  }
  .notch {
    width: 5.5em;
    height: 1.6em;
    border-radius: 999px;
    background: #0b0c0f;
  }
  .signal {
    display: flex;
    gap: 0.15em;
    align-items: flex-end;
  }
  .signal i {
    width: 0.3em;
    background: currentColor;
    border-radius: 1px;
  }
  .signal i:nth-child(1) {
    height: 0.45em;
  }
  .signal i:nth-child(2) {
    height: 0.7em;
  }
  .signal i:nth-child(3) {
    height: 0.95em;
  }

  /* App screens */
  .app {
    position: absolute;
    inset: 3em 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.8em;
    padding: 0.6em 1.1em 1.2em;
    transition:
      opacity 0.45s,
      transform 0.45s;
  }
  .app-header {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin-bottom: 0.4em;
  }
  .back {
    font-size: 1.6em;
    line-height: 1;
    color: #94a3b8;
  }
  .app-title {
    flex: 1;
    font-weight: 700;
    font-size: 1.15em;
  }
  .version {
    padding: 0.2em 0.55em;
    border-radius: 999px;
    background: #e2e8f0;
    font:
      600 0.75em/1.2 ui-monospace,
      monospace;
    color: #475569;
  }
  .app-new .version {
    background: #dcfce7;
    color: #15803d;
  }
  .item {
    display: flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.7em;
    border-radius: 0.9em;
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.08);
  }
  .thumb {
    width: 2.4em;
    height: 2.4em;
    border-radius: 0.6em;
  }
  .lines {
    flex: 1;
    display: grid;
    gap: 0.35em;
  }
  .lines i {
    height: 0.5em;
    border-radius: 999px;
    background: #e2e8f0;
  }
  .price,
  .total {
    font-weight: 600;
    font-size: 0.9em;
  }
  .total {
    display: flex;
    justify-content: space-between;
    padding: 0.4em 0.3em;
    border-top: 1px dashed #cbd5e1;
  }
  .pay {
    position: relative;
    margin-top: auto;
    padding: 0.85em;
    border-radius: 0.9em;
    background: #0f172a;
    color: #fff;
    text-align: center;
    font-weight: 600;
  }
  .tap {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.4em;
    height: 2.4em;
    margin: -1.2em 0 0 -1.2em;
    border-radius: 50%;
    background: rgb(68 188 255 / 0.55);
    box-shadow: 0 0 0 0.25em rgb(68 188 255 / 0.25);
    opacity: 0;
    pointer-events: none;
  }
  .s0 .app-old .tap {
    animation: tap 0.7s ease-out 0.4s both;
  }
  .s4 .app-new .tap {
    animation: tap 0.7s ease-out 1.5s both;
  }
  @keyframes tap {
    0% {
      opacity: 0;
      transform: scale(1.6);
    }
    40% {
      opacity: 1;
      transform: scale(0.8);
    }
    100% {
      opacity: 0;
      transform: scale(1.3);
    }
  }
  .toast {
    position: absolute;
    left: 1.1em;
    right: 1.1em;
    bottom: 5.2em;
    display: flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.7em 0.8em;
    border-radius: 0.9em;
    font-weight: 600;
    font-size: 0.9em;
    opacity: 0;
    transform: translateY(0.6em) scale(0.97);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .toast-icon {
    display: grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    color: #fff;
    font-size: 0.9em;
  }
  .toast-bad {
    background: #fef2f2;
    color: #b91c1c;
    box-shadow: inset 0 0 0 1px #fecaca;
  }
  .toast-bad .toast-icon {
    background: #ef4444;
  }
  .toast-good {
    background: #f0fdf4;
    color: #15803d;
    box-shadow: inset 0 0 0 1px #bbf7d0;
  }
  .toast-good .toast-icon {
    background: #22c55e;
  }
  .s0 .toast-bad {
    opacity: 1;
    transform: none;
    transition-delay: 0.8s;
    animation: shake 0.45s 1.1s;
  }
  .s4 .toast-good {
    opacity: 1;
    transform: none;
    transition-delay: 1.9s;
  }
  @keyframes shake {
    25% {
      translate: -0.35em 0;
    }
    50% {
      translate: 0.35em 0;
    }
    75% {
      translate: -0.2em 0;
    }
  }
  .app-new {
    opacity: 0;
  }
  .s3 .app-old {
    opacity: 0;
    transform: scale(0.82) translateY(2em);
  }
  .s4 .app-new {
    opacity: 1;
    transition-delay: 0.85s;
  }

  /* Home screen */
  .home {
    position: absolute;
    inset: 3.5em 1.4em auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1em 0.9em;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 0.4s,
      transform 0.4s;
  }
  .s3 .screen {
    background: linear-gradient(165deg, #1e3a8a, #0f172a 70%);
  }
  .s4 .screen {
    background: #f8fafc;
    transition: background 0.3s 0.85s;
  }
  .s3 .home {
    opacity: 1;
    transform: none;
    transition-delay: 0.25s;
  }
  .s4 .home {
    opacity: 0;
    transition-delay: 0s;
  }
  .home-icon {
    position: relative;
    aspect-ratio: 1;
    border-radius: 0.8em;
    opacity: 0.85;
  }
  .home-app,
  .splash-icon {
    background: radial-gradient(circle at 50% 50%, #fff 0 18%, transparent 19%), conic-gradient(from 45deg, #44bcff, #2563eb, #44bcff);
    opacity: 1;
    box-shadow: 0 0 0 0.15em rgb(255 255 255 / 0.6);
  }
  .staged {
    position: absolute;
    top: -0.9em;
    right: -1.4em;
    padding: 0.15em 0.45em;
    border-radius: 999px;
    background: var(--green);
    color: #052e16;
    font:
      700 0.7em/1.3 ui-monospace,
      monospace;
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .s3 .staged {
    opacity: 1;
    transform: none;
    transition-delay: 0.8s;
  }
  .s3 .home-app .tap {
    animation: tap 0.7s ease-out 1.9s both;
  }

  /* Splash */
  .splash {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: grid;
    place-items: center;
    background: linear-gradient(165deg, #1d4ed8, #0f172a);
    opacity: 0;
    pointer-events: none;
  }
  .splash-icon {
    width: 4.5em;
    height: 4.5em;
    border-radius: 1.2em;
  }
  .s4 .splash {
    animation: splash 1.2s ease forwards;
  }
  @keyframes splash {
    0% {
      opacity: 0;
    }
    20%,
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* Pills */
  .pill {
    position: absolute;
    left: 50%;
    top: 16.5em;
    z-index: 6;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45em;
    padding: 0.6em 1em;
    border-radius: 1.2em;
    background: #0f172a;
    color: #fff;
    font-size: 0.8em;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 0.8em 1.6em rgb(15 23 42 / 0.3);
    opacity: 0;
    transform: translateY(-1em) scale(0.9);
    transition:
      opacity 0.35s,
      transform 0.35s;
  }
  .dl-label,
  .dl-done {
    display: flex;
    align-items: center;
    gap: 0.4em;
    transition: opacity 0.25s;
  }
  .dl-label svg {
    width: 1.1em;
    height: 1.1em;
    color: var(--blue);
  }
  .dl-done {
    position: absolute;
    top: 0.6em;
    color: var(--green);
    opacity: 0;
  }
  .bar {
    width: 11em;
    height: 0.35em;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.15);
    overflow: hidden;
  }
  .bar i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--blue);
  }
  .s2 .dl-pill {
    opacity: 1;
    transform: none;
    transition-delay: 0.1s;
  }
  .s2 .bar i {
    width: 100%;
    transition: width 2.3s cubic-bezier(0.45, 0, 0.25, 1) 0.4s;
  }
  .s2 .dl-label {
    opacity: 0;
    transition-delay: 2.8s;
  }
  .s2 .dl-done {
    opacity: 1;
    transition-delay: 2.8s;
  }
  .s3 .dl-pill {
    opacity: 0;
    transition-delay: 0s;
  }
  .ready-pill {
    flex-direction: row;
    font-family: ui-monospace, monospace;
  }
  .s5 .ready-pill {
    opacity: 1;
    transform: none;
    transition-delay: 0.2s;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @container (max-width: 560px) {
    .inner {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      padding: 2em 1.6em;
      font-size: clamp(9px, 2.9cqw, 12px);
    }
    .left {
      display: contents;
    }
    .term {
      width: 100%;
    }
    .safety {
      order: 4;
      margin-top: 1.4em;
      width: 100%;
    }
    .lane {
      width: 2.4em;
      height: 5em;
    }
    .lane-track {
      inset: 0.4em auto 0.4em 50%;
      border-top: 0;
      border-left: 2px dashed rgb(255 255 255 / 0.14);
    }
    .packet {
      left: 50%;
      top: -1.5em;
      translate: -50% 0;
    }
    .s1 .packet {
      animation-name: fly-y;
    }
  }
  @keyframes fly-y {
    0% {
      top: -1.5em;
      opacity: 0;
    }
    15%,
    80% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 1em);
      opacity: 0;
    }
  }
</style>
