---
import m from '@/copy/messages'
import { productIconPaths } from '@/config/productIcons'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const reasons = [
  { icon: 'arrow-path', title: m.home_hero_outcome_recover_title({}, { locale }), desc: m.home_hero_outcome_recover_desc({}, { locale }) },
  { icon: 'stores', title: m.home_hero_outcome_compliance_title({}, { locale }), desc: m.home_hero_outcome_compliance_desc({}, { locale }) },
  { icon: 'shield-check', title: m.home_hero_outcome_observe_title({}, { locale }), desc: m.home_hero_outcome_observe_desc({}, { locale }) },
]
const badges = [
  { src: '/soc2.svg', label: m.soc2_enterprise_badge({}, { locale }) },
  { src: '/soc3.svg', label: m.compliance_soc3({}, { locale }) },
  { src: '/iso27001.svg', label: m.compliance_iso27001({}, { locale }) },
  { src: '/gdpr.svg', label: m.compliance_gdpr({}, { locale }) },
]
---

<section class="bg-[#1a1a1a] py-24 sm:py-32" aria-labelledby="why-capgo-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-mono text-base leading-7 font-semibold text-[#44BCFF]">{m.why_capgo_eyebrow({}, { locale })}</p>
      <h2 id="why-capgo-title" class="mt-2 text-3xl font-bold tracking-tight text-balance text-white sm:text-5xl">{m.why_capgo_title({}, { locale })}</h2>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-3">
      {
        reasons.map((reason) => (
          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-7">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#44BCFF]/10 text-[#44BCFF] ring-1 ring-[#44BCFF]/20">
              {reason.icon === 'stores' ? (
                <span class="flex items-center gap-1" aria-hidden="true">
                  <svg class="h-4 w-4" viewBox="0 0 384 512" fill="currentColor">
                    <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
                  </svg>
                  <svg class="h-4 w-4" viewBox="0 0 488 512" fill="currentColor">
                    <path d="M488 261.8C488 403.3 391.1 504 248 504 110.8 504 0 393.2 0 256S110.8 8 248 8c66.8 0 123 24.5 166.3 64.9l-67.5 64.9C258.5 52.6 94.3 116.6 94.3 256c0 86.5 69.1 156.6 153.7 156.6 98.2 0 135-70.4 140.8-106.9H248v-85.3h236.1c2.3 12.7 3.9 24.9 3.9 41.4z" />
                  </svg>
                </span>
              ) : (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {productIconPaths[reason.icon].map((d) => (
                    <path d={d} />
                  ))}
                </svg>
              )}
            </span>
            <h3 class="mt-5 text-lg font-semibold text-white">{reason.title}</h3>
            <p class="mt-2 text-sm leading-6 text-slate-400">{reason.desc}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-4 flex flex-col gap-6 rounded-2xl border border-white/10 bg-white/[0.03] p-6 sm:p-7 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h3 class="text-lg font-semibold text-white">{m.why_capgo_security_title({}, { locale })}</h3>
        <a href={getRelativeLocaleUrl(locale, 'trust')} class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-[#44BCFF] transition-colors hover:text-white">
          {m.why_capgo_trust_link({}, { locale })}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <ul class="flex flex-wrap gap-3">
        {
          badges.map((badge) => (
            <li class="flex items-center gap-2.5 rounded-xl bg-white/[0.04] py-2 pr-4 pl-2 ring-1 ring-white/10">
              <img src={badge.src} alt="" width="32" height="32" loading="lazy" class="h-8 w-auto" />
              <span class="text-sm font-medium text-slate-200">{badge.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
