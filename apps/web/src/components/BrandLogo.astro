---
import { CAPGO_MARK_PATH } from '@/config/capgoMark'
import { CAPGO_LOCKUP_MARK_TRANSFORM, CAPGO_LOCKUP_TEXT_X, CAPGO_LOCKUP_VIEWBOX_ATTR, CAPGO_WORDTYPE_PATH, CAPGO_WORDTYPE_TRANSFORM } from '@/config/capgoWordtype'
const { class: className = 'h-9 w-auto text-white' } = Astro.props
---

<svg class={className} viewBox={CAPGO_LOCKUP_VIEWBOX_ATTR} width="144" height="36" role="img" aria-label="Capgo">
  <g fill="currentColor">
    <path fill-rule="evenodd" transform={CAPGO_LOCKUP_MARK_TRANSFORM} d={CAPGO_MARK_PATH}></path>
    <path transform={`translate(${CAPGO_LOCKUP_TEXT_X} 0) ${CAPGO_WORDTYPE_TRANSFORM}`} d={CAPGO_WORDTYPE_PATH}></path>
  </g>
</svg>
