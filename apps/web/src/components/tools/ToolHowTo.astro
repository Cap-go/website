---
interface Step {
  name: string
  text: string
}

interface Props {
  eyebrow?: string
  title: string
  intro?: string
  steps: Step[]
  accent?: 'cyan' | 'emerald' | 'fuchsia'
}

const { eyebrow = 'Step by step', title, intro = '', steps, accent = 'cyan' } = Astro.props as Props

const accentText = {
  cyan: 'text-cyan-300',
  emerald: 'text-emerald-300',
  fuchsia: 'text-fuchsia-300',
}[accent]
---

<section id="how-to" class="py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-3xl">
      <p class={`text-sm font-semibold tracking-[0.25em] uppercase ${accentText}`}>{eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">{title}</h2>
      {intro && <p class="mt-4 text-base leading-7 text-slate-300">{intro}</p>}
    </div>

    <ol class="grid gap-5 md:grid-cols-2">
      {
        steps.map((step, index) => (
          <li id={`step-${index + 1}`} class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <p class={`text-xs font-semibold tracking-[0.25em] uppercase ${accentText}`}>Step {index + 1}</p>
            <h3 class="mt-2 text-xl font-bold text-white">{step.name}</h3>
            <p class="mt-3 text-sm leading-7 text-slate-300">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
