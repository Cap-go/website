---
interface Props {
  label: string
  code: string
}

const { label, code } = Astro.props as Props
---

<figure class="mt-4 overflow-hidden rounded-2xl border border-white/10 bg-slate-950">
  <figcaption class="border-b border-white/10 px-4 py-2 text-xs font-semibold tracking-[0.2em] text-slate-400 uppercase">{label}</figcaption>
  <pre class="overflow-x-auto p-4 text-xs leading-6 text-slate-200" tabindex="0" aria-label={label}><code>{code}</code></pre>
</figure>
