---
import { getRelativeLocaleUrl } from '@/services/links'

interface RelatedLink {
  title: string
  description: string
  path: string
}

interface Props {
  title?: string
  links: RelatedLink[]
}

const { title = 'Related guides', links } = Astro.props as Props
---

<section class="border-t border-white/10 py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold tracking-[0.25em] text-cyan-300 uppercase">Keep going</p>
    <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">{title}</h2>
    <ul class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        links.map((link) => (
          <li>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, link.path)}
              class="block h-full rounded-3xl border border-white/10 bg-white/5 p-6 transition hover:-translate-y-1 hover:border-cyan-400/50 hover:bg-white/8 focus-visible:ring-2 focus-visible:ring-cyan-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 focus-visible:outline-none"
            >
              <span class="block text-lg font-semibold text-white">{link.title}</span>
              <span class="mt-3 block text-sm leading-7 text-slate-300">{link.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
