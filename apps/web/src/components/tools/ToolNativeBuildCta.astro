---
import { getRelativeLocaleUrl } from '@/services/links'

interface Props {
  accent?: 'cyan' | 'emerald' | 'fuchsia'
}

const { accent = 'cyan' } = Astro.props as Props

const borderClass =
  accent === 'emerald' ? 'border-emerald-400/25 bg-emerald-400/5' : accent === 'fuchsia' ? 'border-fuchsia-400/25 bg-fuchsia-400/5' : 'border-cyan-400/25 bg-cyan-400/5'
const labelClass =
  accent === 'emerald' ? 'text-emerald-300' : accent === 'fuchsia' ? 'text-fuchsia-300' : 'text-cyan-300'
const linkClass =
  accent === 'emerald'
    ? 'text-emerald-200 underline decoration-emerald-300/40 underline-offset-4 hover:text-emerald-100'
    : accent === 'fuchsia'
      ? 'text-fuchsia-200 underline decoration-fuchsia-300/40 underline-offset-4 hover:text-fuchsia-100'
      : 'text-cyan-200 underline decoration-cyan-300/40 underline-offset-4 hover:text-cyan-100'
const buttonClass =
  accent === 'emerald'
    ? 'border-emerald-300/40 hover:border-emerald-300/60 focus-visible:ring-emerald-300'
    : accent === 'fuchsia'
      ? 'border-fuchsia-300/40 hover:border-fuchsia-300/60 focus-visible:ring-fuchsia-300'
      : 'border-cyan-300/40 hover:border-cyan-300/60 focus-visible:ring-cyan-300'

const nativeBuildHref = getRelativeLocaleUrl(Astro.locals.locale, 'native-build')
---

<section class="border-y border-white/10 bg-slate-950 py-12 sm:py-16" aria-labelledby="tool-native-build-cta-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class={`rounded-3xl border p-8 sm:p-10 ${borderClass}`}>
      <p class={`text-sm font-semibold tracking-[0.25em] uppercase ${labelClass}`}>Capgo Native Build</p>
      <h2 id="tool-native-build-cta-heading" class="mt-3 text-2xl font-bold text-white sm:text-3xl">
        <a class={linkClass} href={nativeBuildHref}>Build and sign iOS and Android apps in the cloud with Capgo</a>
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-7 text-slate-300">
        Upload the signing assets you generated here, trigger release builds from CI, and ship to TestFlight, ad hoc testers, or Google Play without maintaining your own build farm.
      </p>
      <a
        href={nativeBuildHref}
        class={`mt-6 inline-flex items-center justify-center rounded-2xl border px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/5 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950 focus-visible:outline-none ${buttonClass}`}
      >
        Explore Native Build
      </a>
    </div>
  </div>
</section>
