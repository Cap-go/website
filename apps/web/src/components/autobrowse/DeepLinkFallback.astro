---
import Layout from '@/layouts/Layout.astro'
import AppStoreButton from '@/components/autobrowse/AppStoreButton.astro'
import { getRelativeLocaleUrl } from '@/services/links'

interface Props {
  action: 'run' | 'open'
}

const { action } = Astro.props
const isRun = action === 'run'

const content = {
  title: isRun ? 'Open this task in Auto Browse' : 'Open this page in Auto Browse',
  description: isRun
    ? 'This link starts a task in Auto Browse, the iPhone browser with an AI agent. Open it in the app or get Auto Browse on the App Store.'
    : 'This link opens a page in Auto Browse, the iPhone browser with an AI agent. Open it in the app or get Auto Browse on the App Store.',
  robots: 'noindex, nofollow',
  alternateVersions: [],
  ldJSON: undefined,
}

const docsHref = getRelativeLocaleUrl(Astro.locals.locale, 'autobrowse/deeplinks/')
---

<Layout content={content} disableThirdPartyScripts>
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-2xl px-6 lg:px-8">
      <div class="rounded-2xl border border-gray-700 bg-gray-800/50 p-6 sm:p-8" data-autobrowse-fallback data-action={action}>
        <p class="text-sm font-semibold tracking-widest text-emerald-300 uppercase">Auto Browse</p>
        <h1 class="mt-3 text-3xl font-bold text-white sm:text-4xl">{isRun ? 'Open this task in Auto Browse' : 'Open this page in Auto Browse'}</h1>
        <p class="mt-4 text-gray-300">
          {isRun ? 'Someone shared a task for the Auto Browse AI agent. Nothing runs until you read it and tap Start in the app.' : 'Someone shared a page to open in Auto Browse.'}
        </p>

        <div id="autobrowse-details" class="mt-8 space-y-4" aria-live="polite">
          {isRun && (
            <div id="autobrowse-prompt-block" hidden>
              <h2 class="text-xs font-semibold tracking-widest text-gray-400 uppercase">Task</h2>
              <p id="autobrowse-prompt" class="mt-2 rounded-lg bg-gray-950 p-4 break-words whitespace-pre-wrap text-white"></p>
            </div>
          )}
          <div id="autobrowse-url-block" hidden>
            <h2 class="text-xs font-semibold tracking-widest text-gray-400 uppercase">Page</h2>
            <p id="autobrowse-url" class="mt-2 rounded-lg bg-gray-950 p-4 font-mono text-sm break-all text-emerald-200"></p>
          </div>
          <p id="autobrowse-empty" class="rounded-lg border border-amber-400/30 bg-amber-400/10 p-4 text-sm text-amber-100" hidden>
            This link has no valid {isRun ? 'task or https page' : 'https page'}. Check the link, or read how Auto Browse links work.
          </p>
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            id="autobrowse-open"
            href={`autobrowse://${action}`}
            class="inline-flex items-center justify-center rounded-xl bg-emerald-400 px-6 py-3 text-sm font-semibold text-gray-950 transition-colors hover:bg-emerald-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300"
          >
            Open in Auto Browse
          </a>
          <AppStoreButton />
        </div>

        <p class="mt-8 text-sm text-gray-400">
          Don't have the app yet? Install it, then come back and tap "Open in Auto Browse".
          <a href={docsHref} class="text-emerald-400 hover:text-emerald-300">
            How Auto Browse links work
          </a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { AUTOBROWSE_MAX_PROMPT_LENGTH, AUTOBROWSE_SCHEME } from '@/config/autobrowse'

  function safeHttpsUrl(value: string | null): string | null {
    if (!value) return null
    try {
      const parsed = new URL(value.trim())
      return parsed.protocol === 'https:' ? parsed.toString() : null
    } catch {
      return null
    }
  }

  const root = document.querySelector<HTMLElement>('[data-autobrowse-fallback]')
  if (root) {
    const action = root.dataset.action === 'open' ? 'open' : 'run'
    const query = new URLSearchParams(window.location.search)
    const prompt = action === 'run' ? query.get('prompt')?.trim().slice(0, AUTOBROWSE_MAX_PROMPT_LENGTH) || null : null
    const url = safeHttpsUrl(query.get('url'))
    const tab = query.get('tab') === 'current' ? 'current' : null

    const promptBlock = document.getElementById('autobrowse-prompt-block')
    const promptEl = document.getElementById('autobrowse-prompt')
    if (prompt && promptBlock && promptEl) {
      promptEl.textContent = prompt
      promptBlock.hidden = false
    }

    const urlBlock = document.getElementById('autobrowse-url-block')
    const urlEl = document.getElementById('autobrowse-url')
    if (url && urlBlock && urlEl) {
      urlEl.textContent = url
      urlBlock.hidden = false
    }

    const valid = action === 'run' ? Boolean(prompt || url) : Boolean(url)
    const empty = document.getElementById('autobrowse-empty')
    if (!valid && empty) empty.hidden = false

    const params = new URLSearchParams()
    if (prompt) params.set('prompt', prompt)
    if (url) params.set('url', url)
    if (tab) params.set('tab', tab)
    const openLink = document.querySelector<HTMLAnchorElement>('#autobrowse-open')
    if (openLink) {
      const search = params.toString()
      openLink.href = `${AUTOBROWSE_SCHEME}://${action}${search ? `?${search}` : ''}`
    }
  }
</script>
