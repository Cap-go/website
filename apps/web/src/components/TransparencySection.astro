---
import m from '@/copy/messages'
import transparency from '@/data/transparency.json'
import { LIVE_UPDATE_METRICS_PATH } from '@/lib/publicLiveUpdateMetrics'
import { BUILDER_METRICS_PATH } from '@/lib/publicBuilderMetrics'
import { getGitHubCommunityStats } from '@/services/github'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const community = getGitHubCommunityStats()
const formatCount = (value: number) => value.toLocaleString('en-US')

const repoLabels: Record<string, string> = {
  'Cap-go/capgo': m.transparency_repo_capgo({}, { locale }),
  'Cap-go/CLI': m.transparency_repo_cli({}, { locale }),
  'Cap-go/capacitor-updater': m.transparency_repo_updater({}, { locale }),
}
const releases = transparency.releases.map((release) => ({
  label: release.tag.startsWith('cli-') ? repoLabels['Cap-go/CLI'] : (repoLabels[release.repo] ?? release.repo),
  version: `v${release.tag.replace(/^[a-z-]+-(?=\d)/i, '')}`,
  url: release.url,
  iso: release.publishedAt,
  date: new Date(release.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }),
}))

const metricRows = [
  { key: 'success_rate', source: 'live', label: m.transparency_metrics_update_success({}, { locale }) },
  { key: 'first_try_rate', source: 'live', label: m.transparency_metrics_first_try({}, { locale }) },
  { key: 'rollback_rate', source: 'live', label: m.transparency_metrics_rollback({}, { locale }) },
  { key: 'success_rate', source: 'builder', label: m.transparency_metrics_build_success({}, { locale }) },
]

const smallCards = [
  {
    title: m.transparency_code_title({}, { locale }),
    body: m.transparency_code_body(
      {
        repos: formatCount(community.repositoryCount),
        contributors: formatCount(community.contributorCount),
        prs: formatCount(community.mergedPullRequestCount),
      },
      { locale },
    ),
    link: m.transparency_code_link({}, { locale }),
    href: 'https://github.com/Cap-go',
    icon: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z',
    filled: true,
  },
  {
    title: m.transparency_security_title({ count: formatCount(transparency.advisories.total) }, { locale }),
    body: m.transparency_security_body({}, { locale }),
    link: m.transparency_security_link({}, { locale }),
    href: 'https://github.com/Cap-go/capgo/security/advisories',
    icon: 'M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z',
    filled: false,
  },
  {
    title: m.transparency_status_title({}, { locale }),
    body: m.transparency_status_body({}, { locale }),
    link: m.transparency_status_link({}, { locale }),
    href: 'https://status.capgo.app',
    icon: 'M3.75 13.5 8.25 9l3.75 3.75L20.25 4.5M20.25 4.5v5.25M20.25 4.5H15',
    filled: false,
  },
]
---

<section
  class="bg-[#1a1a1a] py-24 sm:py-32"
  aria-labelledby="transparency-title"
  data-transparency
  data-live-endpoint={LIVE_UPDATE_METRICS_PATH}
  data-builder-endpoint={BUILDER_METRICS_PATH}
  data-updated-template={m.transparency_metrics_updated({}, { locale })}
  data-unavailable={m.transparency_metrics_unavailable({}, { locale })}
>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-mono text-base leading-7 font-semibold text-[#44BCFF]">{m.transparency_eyebrow({}, { locale })}</p>
      <h2 id="transparency-title" class="mt-2 text-3xl font-bold tracking-tight text-balance text-white sm:text-5xl">
        {m.transparency_title({}, { locale })}
      </h2>
      <p class="mt-6 text-lg leading-8 text-pretty text-gray-400">{m.transparency_subtitle({}, { locale })}</p>
    </div>

    <div class="mt-16 grid gap-4 lg:grid-cols-2">
      <article class="flex flex-col rounded-3xl border border-white/10 bg-linear-to-b from-emerald-400/[0.06] to-white/[0.02] p-6 sm:p-8">
        <div class="flex items-start justify-between gap-4">
          <h3 class="text-xl font-semibold text-white sm:text-2xl">{m.transparency_metrics_title({}, { locale })}</h3>
          <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-emerald-400/10 px-2.5 py-1 text-xs font-medium text-emerald-300 ring-1 ring-emerald-400/20">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
            {m.transparency_metrics_live({}, { locale })}
          </span>
        </div>

        <div class="mt-6 rounded-2xl border border-white/10 bg-black/20 p-5">
          <svg class="h-16 w-full" viewBox="0 0 300 64" preserveAspectRatio="none" role="img" aria-label={m.transparency_metrics_aria({}, { locale })}>
            <path data-spark-area d="" fill="rgba(52,211,153,0.12)"></path>
            <path data-spark-line d="" fill="none" stroke="rgb(52,211,153)" stroke-width="2" vector-effect="non-scaling-stroke"></path>
          </svg>
          <dl class="mt-4 divide-y divide-white/10">
            {metricRows.map((row) => (
              <div class="flex items-center justify-between gap-4 py-3">
                <dt class="text-sm text-gray-400">{row.label}</dt>
                <dd class="font-mono text-sm font-semibold text-white tabular-nums" data-metric={row.key} data-source={row.source}>
                  —
                </dd>
              </div>
            ))}
          </dl>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-white/10 pt-3 text-xs">
            <span class="text-gray-400" data-metrics-status aria-live="polite">
              {m.transparency_metrics_loading({}, { locale })}
            </span>
            <a
              href={getRelativeLocaleUrl(locale, 'data')}
              class="font-medium text-[#44BCFF]! focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF] [@media(hover:hover)]:hover:text-white!"
            >
              {m.transparency_metrics_link({}, { locale })} <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>

      <article class="flex flex-col rounded-3xl border border-white/10 bg-linear-to-b from-[#44BCFF]/[0.07] to-white/[0.02] p-6 sm:p-8">
        <h3 class="text-xl font-semibold text-white sm:text-2xl">{m.transparency_shipped_title({}, { locale })}</h3>
        <ol class="mt-6 flex-1 rounded-2xl border border-white/10 bg-black/20 p-5">
          {releases.map((release, index) => (
            <li class:list={['relative flex gap-4 pb-5 pl-5', index === releases.length - 1 && 'pb-0']}>
              <span class="absolute top-1.5 left-0 h-2 w-2 rounded-full bg-[#44BCFF]" aria-hidden="true" />
              {index < releases.length - 1 && <span class="absolute top-4 bottom-0 left-[3px] w-px bg-white/10" aria-hidden="true" />}
              <div class="min-w-0">
                <p class="text-xs text-gray-400">
                  {release.label} · <time datetime={release.iso}>{release.date}</time>
                </p>
                <a
                  href={release.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 inline-block font-mono text-sm font-semibold text-white focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF] [@media(hover:hover)]:hover:text-[#44BCFF]"
                >
                  {release.version}
                </a>
              </div>
            </li>
          ))}
        </ol>
        <a
          href="https://github.com/Cap-go/capgo/releases"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 self-end text-xs font-medium text-[#44BCFF]! focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF] [@media(hover:hover)]:hover:text-white!"
        >
          {m.transparency_shipped_link({}, { locale })} <span aria-hidden="true">↗</span>
        </a>
      </article>
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {smallCards.map((card) => (
        <a
          href={card.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col rounded-3xl border border-white/10 bg-white/[0.03] p-6 transition-[border-color,background-color] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF] [@media(hover:hover)]:hover:border-[#44BCFF]/40 [@media(hover:hover)]:hover:bg-white/[0.06]"
        >
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/[0.06] text-white ring-1 ring-white/10" aria-hidden="true">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill={card.filled ? 'currentColor' : 'none'}
              stroke={card.filled ? 'none' : 'currentColor'}
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={card.icon} />
            </svg>
          </span>
          <h3 class="mt-5 text-lg font-semibold text-white">{card.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-6 text-gray-400">{card.body}</p>
          <span class="mt-5 text-sm font-medium text-[#44BCFF] [@media(hover:hover)]:group-hover:text-white">
            {card.link} <span aria-hidden="true">↗</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  type Metrics = { success_rate?: number; first_try_rate?: number | null; rollback_rate?: number | null; updated_at?: string; daily?: Array<{ success_rate: number }> }

  const section = document.querySelector<HTMLElement>('[data-transparency]')

  async function loadJson(path: string | undefined): Promise<Metrics | null> {
    if (!path) return null
    try {
      const response = await fetch(path, { headers: { Accept: 'application/json' } })
      if (!response.ok) return null
      return (await response.json()) as Metrics
    } catch {
      return null
    }
  }

  function formatPercent(value: number | null | undefined) {
    return typeof value === 'number' && Number.isFinite(value) ? `${value.toFixed(1)}%` : '—'
  }

  function relativeTime(iso: string | undefined) {
    const time = iso ? new Date(iso).getTime() : Number.NaN
    if (Number.isNaN(time)) return ''
    const minutes = Math.max(1, Math.round((Date.now() - time) / 60000))
    const format = new Intl.RelativeTimeFormat(document.documentElement.lang || 'en', { numeric: 'auto' })
    return minutes < 60 ? format.format(-minutes, 'minute') : format.format(-Math.round(minutes / 60), 'hour')
  }

  function drawSparkline(values: number[]) {
    if (!section || values.length < 2) return
    const min = Math.min(...values) - 2
    const max = Math.max(...values) + 2
    const points = values.map((value, index) => [(index / (values.length - 1)) * 300, 60 - ((value - min) / (max - min || 1)) * 52])
    const line = points.map(([x, y], index) => `${index === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ')
    section.querySelector('[data-spark-line]')?.setAttribute('d', line)
    section.querySelector('[data-spark-area]')?.setAttribute('d', `${line} L300 64 L0 64 Z`)
  }

  async function hydrate() {
    if (!section) return
    const [live, builder] = await Promise.all([loadJson(section.dataset.liveEndpoint), loadJson(section.dataset.builderEndpoint)])
    const status = section.querySelector<HTMLElement>('[data-metrics-status]')
    if (!live && !builder) {
      if (status) status.textContent = section.dataset.unavailable ?? ''
      return
    }
    section.querySelectorAll<HTMLElement>('[data-metric]').forEach((cell) => {
      const source = cell.dataset.source === 'builder' ? builder : live
      cell.textContent = formatPercent(source?.[cell.dataset.metric as keyof Metrics] as number | null | undefined)
    })
    drawSparkline((live?.daily ?? []).map((day) => day.success_rate).filter((value) => Number.isFinite(value)))
    const updated = relativeTime(live?.updated_at ?? builder?.updated_at)
    if (status && updated) status.textContent = (section.dataset.updatedTemplate ?? '{time}').replace('{time}', updated)
  }

  if (section) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect()
          hydrate()
        }
      },
      { rootMargin: '400px' },
    )
    observer.observe(section)
  }
</script>
