    id: 'claude',
    name: 'Claude',
    url: 'https://claude.ai/new?q=',
    path: 'm4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z',
  },
  {
    id: 'perplexity',
    name: 'Perplexity',
    url: 'https://www.perplexity.ai/search?q=',
    path: 'M22.3977 7.0896h-2.3106V.0676l-7.5094 6.3542V.1577h-1.1554v6.1966L4.4904 0v7.0896H1.6023v10.3976h2.8882V24l6.932-6.3591v6.2005h1.1554v-6.0469l6.9318 6.1807v-6.4879h2.8882V7.0896zm-3.4657-4.531v4.531h-5.355l5.355-4.531zm-13.2862.0676 4.8691 4.4634H5.6458V2.6262zM2.7576 16.332V8.245h7.8476l-6.1149 6.1147v1.9723H2.7576zm2.8882 5.0404v-3.8852h.0001v-2.6488l5.7763-5.7764v7.0111l-5.7764 5.2993zm12.7086.0248-5.7766-5.1509V9.0618l5.7766 5.7766v6.5588zm2.8882-5.0652h-1.733v-1.9723L13.3948 8.245h7.8478v8.087z',
  },
  {
    id: 'grok',
    name: 'Grok',
    url: 'https://grok.com/?q=',
    path: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z',
  },
  {
    id: 'lechat',
    name: 'Le Chat',
    url: 'https://chat.mistral.ai/chat?q=',
    path: 'M17.143 3.429v3.428h-3.429v3.429h-3.428V6.857H6.857V3.43H3.43v13.714H0v3.428h10.286v-3.428H6.857v-3.429h3.429v3.429h3.429v-3.429h3.428v3.429h-3.428v3.428H24v-3.428h-3.43V3.429z',
  },
]
const initialHref = providers[0].url + encodeURIComponent(defaultPrompt)
---

<section class="bg-[#1a1a1a] py-24 sm:py-32" aria-labelledby="ask-ai-title" data-ask-ai>
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 id="ask-ai-title" class="text-4xl font-bold tracking-tight text-white sm:text-5xl">{m.ask_ai_title({}, { locale })}</h2>
    <p class="mt-4 text-lg text-slate-400">{m.ask_ai_subtitle({}, { locale })}</p>

    <div class="mt-10 rounded-3xl border border-white/10 bg-[#101216] p-4 text-left shadow-2xl shadow-black/40 focus-within:border-[#44BCFF]/40 sm:p-5">
      <label for="ask-ai-prompt" class="sr-only">{m.ask_ai_prompt_label({}, { locale })}</label>
      <textarea
        id="ask-ai-prompt"
        rows="2"
        class="ask-ai-textarea block w-full resize-none border-0 bg-transparent px-2 py-1 text-lg leading-7 text-white placeholder-slate-500 focus:ring-0 focus:outline-none"
        data-ask-ai-prompt>{defaultPrompt}</textarea
      >
      <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center justify-center gap-1 sm:justify-start" role="radiogroup" aria-label={m.ask_ai_provider_label({}, { locale })}>
          {
            providers.map((provider, index) => (
              <button
                type="button"
                role="radio"
                aria-checked={index === 0 ? 'true' : 'false'}
                aria-label={provider.name}
                title={provider.name}
                data-ask-ai-provider={provider.id}
                data-name={provider.name}
                data-url={provider.url}
                class="ask-ai-provider flex h-11 w-11 items-center justify-center rounded-xl text-slate-500 transition-colors hover:bg-white/5 hover:text-slate-200 focus-visible:ring-2 focus-visible:ring-[#44BCFF] focus-visible:outline-none"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={provider.path} />
                </svg>
              </button>
            ))
          }
        </div>
        <a
          href={initialHref}
          target="_blank"
          rel="noopener noreferrer"
          data-ask-ai-submit
          class="inline-flex min-h-11 w-full items-center justify-between gap-3 rounded-xl bg-white py-1.5 pr-1.5 pl-4 sm:w-auto sm:justify-start text-[15px] font-semibold text-gray-950 transition-colors hover:bg-slate-200 focus-visible:ring-2 focus-visible:ring-[#44BCFF] focus-visible:ring-offset-2 focus-visible:ring-offset-[#101216] focus-visible:outline-none"
        >
          <span data-ask-ai-label>{m.ask_ai_button({ provider: providers[0].name }, { locale })}</span>
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gray-950 text-white" aria-hidden="true">
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"
              ><path
                fill-rule="evenodd"
                d="M10 17a.75.75 0 0 1-.75-.75V5.612L5.29 9.77a.75.75 0 0 1-1.08-1.04l5.25-5.5a.75.75 0 0 1 1.08 0l5.25 5.5a.75.75 0 1 1-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0 1 10 17Z"
                clip-rule="evenodd"></path></svg
            >
          </span>
        </a>
      </div>
    </div>

    <a
      href={teamUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-flex items-center gap-1 text-sm font-medium text-slate-400 underline underline-offset-4 transition-colors hover:text-white"
    >
      {m.ask_ai_talk_human({}, { locale })}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .ask-ai-textarea {
    field-sizing: content;
    min-height: 3.5rem;
  }

  .ask-ai-provider[aria-checked='true'] {
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ask-ai]').forEach((root) => {
    const prompt = root.querySelector<HTMLTextAreaElement>('[data-ask-ai-prompt]')
    const submit = root.querySelector<HTMLAnchorElement>('[data-ask-ai-submit]')
    const label = root.querySelector<HTMLElement>('[data-ask-ai-label]')
    const providers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ask-ai-provider]'))
    if (!prompt || !submit || !label) return
    const labelTemplate = label.textContent?.replace(providers[0]?.dataset.name ?? '', '{provider}') ?? '{provider}'
    let active = providers[0]

    const autosize = () => {
      // Fallback for browsers without `field-sizing: content`: never clip the default question.
      prompt.style.height = 'auto'
      prompt.style.height = `${prompt.scrollHeight}px`
    }
    const update = () => {
      autosize()
      submit.href = (active?.dataset.url ?? '') + encodeURIComponent(prompt.value.trim())
      label.textContent = labelTemplate.replace('{provider}', active?.dataset.name ?? '')
    }
    const select = (button: HTMLButtonElement) => {
      active = button
      providers.forEach((item) => item.setAttribute('aria-checked', String(item === button)))
      update()
    }

    providers.forEach((button, index) => {
      button.addEventListener('click', () => select(button))
      button.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0
        if (!step) return
        event.preventDefault()
        const next = providers[(index + step + providers.length) % providers.length]
        next.focus()
        select(next)
      })
    })
    prompt.addEventListener('input', update)
    autosize()
  })
</script>
