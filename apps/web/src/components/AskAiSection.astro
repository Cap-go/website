---
import m from '@/copy/messages'

const locale = Astro.locals.locale
const teamUrl = 'https://book.capgo.app/demo/'
const defaultPrompt = m.ask_ai_prompt({}, { locale })

// Each assistant opens a new chat with the question prefilled through its public query parameter.
