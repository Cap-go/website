---
import m from '@/copy/messages'
import ProductsMegaMenu from '@/components/ProductsMegaMenu.astro'
import SolutionsMegaMenu from '@/components/SolutionsMegaMenu.astro'
import { getRelativeLocaleUrl } from '@/services/links'
import { getTotalStars } from '@/services/github'

const brand = Astro.locals.runtimeConfig.public.brand
const totalStars = getTotalStars()
const locale = Astro.locals.locale

const productMenu = [
  {
    label: m.platform_group_ship({}, { locale: Astro.locals.locale }),
    items: [
      { href: 'live-update', label: m.platform_live_update_name({}, { locale: Astro.locals.locale }) },
      { href: 'native-build', label: m.platform_native_build_name({}, { locale: Astro.locals.locale }) },
    ],
  },
  {
    label: m.platform_group_operate({}, { locale: Astro.locals.locale }),
    items: [
      { href: 'observe', label: m.platform_observe_name({}, { locale: Astro.locals.locale }) },
      { href: 'notifications', label: m.platform_notifications_name({}, { locale: Astro.locals.locale }) },
      { href: 'data', label: m.nav_live_update_data({}, { locale: Astro.locals.locale }) },
      { href: 'builder-data', label: m.nav_native_build_data({}, { locale: Astro.locals.locale }) },
    ],
  },
  {
    label: m.platform_group_automate({}, { locale: Astro.locals.locale }),
    items: [
      { href: 'capgo-cli', label: m.nav_capgo_cli({}, { locale: Astro.locals.locale }) },
      { href: 'skills', label: m.platform_skills_name({}, { locale: Astro.locals.locale }) },
      { href: 'app_mobile', label: m.platform_app_name({}, { locale: Astro.locals.locale }) },
    ],
  },
  {
    label: m.platform_group_extend({}, { locale: Astro.locals.locale }),
    items: [
      { href: 'plugins', label: m.platform_plugins_name({}, { locale: Astro.locals.locale }) },
      { href: 'ionic-enterprise-plugins', label: m.solutions_ionic_plugins_short({}, { locale: Astro.locals.locale }) },
    ],
  },
]
---

<header class="relative z-50 py-2">
  <span id="header-auth-live" class="sr-only" aria-live="polite" aria-atomic="true"></span>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative flex items-center justify-between">
      <div class="flex shrink-0 items-center">
        <a href={getRelativeLocaleUrl(Astro.locals.locale)} aria-label={m.capgo_home({}, { locale: Astro.locals.locale })} class="font-prompt flex items-center pr-2 font-medium">
          <img class="h-8 w-auto pr-1 md:h-9 lg:h-10" loading="eager" height="40" width="144" alt={`${brand} logo`} src="/capgo_logo_header.webp" />
        </a>
      </div>
      <div class="flex md:hidden">
        <button
          type="button"
          class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-white transition-colors hover:bg-white/10 focus:ring-2 focus:ring-blue-400 focus:outline-none"
          aria-label={m.expand_menu({}, { locale: Astro.locals.locale })}
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="menu-toggle"
        >
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
      <div class="hidden md:flex md:flex-1 md:items-center md:gap-4 lg:gap-6 xl:gap-8">
        <nav class="flex items-center gap-1 lg:gap-2 xl:gap-4 2xl:gap-6">
          <!-- Docs -->
          <a
            href={getRelativeLocaleUrl(Astro.locals.locale, 'docs')}
            aria-label={m.docs({}, { locale: Astro.locals.locale })}
            class="flex h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none xl:px-2"
          >
            {m.docs({}, { locale: Astro.locals.locale })}
          </a>
          <!-- Products Dropdown -->
          <div class="group" data-mega-root>
            <button
              type="button"
              class="flex h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none xl:px-2"
              aria-label={m.products({}, { locale: Astro.locals.locale })}
            >
              {m.products({}, { locale: Astro.locals.locale })}
              <svg
                class="ml-1 h-4 w-4 transition-transform group-focus-within:rotate-180 group-hover:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div
              class="invisible absolute inset-x-0 top-full z-50 pt-3 opacity-0 transition-all duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
            >
              <ProductsMegaMenu />
            </div>
          </div>
          <!-- Solutions Dropdown -->
          <div class="group">
            <button
              type="button"
              class="flex h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none xl:px-2"
              aria-label={m.solutions({}, { locale: Astro.locals.locale })}
            >
              {m.solutions({}, { locale: Astro.locals.locale })}
              <svg
                class="ml-1 h-4 w-4 transition-transform group-focus-within:rotate-180 group-hover:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div
              class="invisible absolute inset-x-0 top-full z-50 pt-3 opacity-0 transition-all duration-200 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
            >
              <SolutionsMegaMenu />
            </div>
          </div>
          <a
            href={getRelativeLocaleUrl(Astro.locals.locale, 'enterprise')}
            aria-label={m.enterprise_title({}, { locale: Astro.locals.locale })}
            class="hidden h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none lg:flex xl:px-2"
          >
            {m.enterprise_title({}, { locale: Astro.locals.locale })}
          </a>
          <!-- Pricing -->
          <a
            href={getRelativeLocaleUrl(Astro.locals.locale, 'pricing')}
            aria-label={m.pricing({}, { locale: Astro.locals.locale })}
            class="flex h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none xl:px-2"
          >
            {m.pricing({}, { locale: Astro.locals.locale })}
          </a>
          <!-- Blog -->
          <a
            href={getRelativeLocaleUrl(Astro.locals.locale, 'blog')}
            aria-label={m.blog({}, { locale: Astro.locals.locale })}
            class="hidden h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none lg:flex xl:px-2"
          >
            {m.blog({}, { locale: Astro.locals.locale })}
          </a>
        </nav>
        <div class="ml-auto flex shrink-0 items-center gap-2 xl:gap-3">
          <a
            href={getRelativeLocaleUrl(Astro.locals.locale, 'plugins')}
            aria-label={m.github_stars({}, { locale: Astro.locals.locale })}
            class="hidden h-10 items-center gap-2 rounded-lg border border-slate-700 bg-slate-800/80 px-3 text-sm font-semibold text-slate-200 transition-colors hover:border-slate-500 hover:bg-slate-700 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none xl:flex"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path>
            </svg>
            <span>{totalStars}+</span>
          </a>
          <a
            data-guest-auth-link
            href="https://console.capgo.app/login/"
            aria-label={m.login({}, { locale: Astro.locals.locale })}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none xl:px-2"
          >
            {m.login({}, { locale: Astro.locals.locale })}
          </a>
          <a
            data-guest-auth-link
            href="https://book.capgo.app/demo/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={m.request_demo({}, { locale: Astro.locals.locale })}
            class="font-pj flex h-10 items-center rounded-xl bg-blue-500 px-3 text-sm font-semibold whitespace-nowrap text-white shadow-lg shadow-blue-600/25 transition-colors hover:bg-blue-400 focus:ring-2 focus:ring-blue-300 focus:ring-offset-2 focus:ring-offset-gray-950 focus:outline-none xl:px-4"
            role="button"
          >
            {m.request_demo({}, { locale: Astro.locals.locale })}
          </a>
          <a
            data-guest-auth-link
            href={getRelativeLocaleUrl(Astro.locals.locale, 'register')}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={m.register({}, { locale: Astro.locals.locale })}
            class="font-pj hidden h-10 items-center rounded-xl border border-slate-600 bg-slate-900/20 px-3 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:border-slate-400 hover:bg-slate-700 hover:text-white focus:ring-2 focus:ring-slate-300 focus:ring-offset-2 focus:outline-none lg:flex xl:px-4"
            role="button"
          >
            {m.register({}, { locale: Astro.locals.locale })}
          </a>
          <a
            data-console-auth-link
            hidden
            href="https://console.capgo.app/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={m.console({}, { locale: Astro.locals.locale })}
            class="font-pj flex h-10 items-center rounded-xl border border-slate-600 bg-slate-900/20 px-4 text-sm font-semibold text-slate-200 transition-colors hover:border-slate-400 hover:bg-slate-700 hover:text-white focus:ring-2 focus:ring-slate-300 focus:ring-offset-2 focus:outline-none"
            role="button"
          >
            {m.console({}, { locale: Astro.locals.locale })}
          </a>
        </div>
      </div>
    </div>
  </div>
  <div id="mobile-menu" class="absolute inset-x-0 top-full z-50 hidden md:hidden">
    <div class="mx-auto max-w-7xl px-4 pb-4 sm:px-6 lg:px-8">
      <div class="max-h-[calc(100dvh-6rem)] overflow-y-auto rounded-2xl border border-slate-500/40 bg-slate-800/95 p-3 shadow-2xl shadow-black/45 backdrop-blur-xl">
        <a
          data-guest-auth-link
          href="https://book.capgo.app/demo/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={m.request_demo({}, { locale: Astro.locals.locale })}
          class="font-pj flex min-h-12 items-center justify-center rounded-xl bg-blue-500 px-4 py-3 text-center text-base font-semibold text-white shadow-lg shadow-blue-600/30 transition-colors hover:bg-blue-400 focus:ring-2 focus:ring-blue-300 focus:outline-none"
        >
          {m.request_demo({}, { locale: Astro.locals.locale })}
        </a>
        <a
          data-guest-auth-link
          target="_blank"
          rel="noopener noreferrer"
          aria-label={m.register({}, { locale: Astro.locals.locale })}
          href={getRelativeLocaleUrl(Astro.locals.locale, 'register')}
          class="font-pj mt-2 flex min-h-12 items-center justify-center rounded-xl border border-slate-300/35 bg-slate-700/75 px-4 py-3 text-center text-base font-semibold text-white transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-slate-200 focus:outline-none"
        >
          {m.register({}, { locale: Astro.locals.locale })}
        </a>
        <a
          data-console-auth-link
          hidden
          href="https://console.capgo.app/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={m.console({}, { locale: Astro.locals.locale })}
          class="font-pj mt-2 flex min-h-12 items-center justify-center rounded-xl border border-slate-300/35 bg-slate-700/75 px-4 py-3 text-center text-base font-semibold text-white transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-slate-200 focus:outline-none"
        >
          {m.console({}, { locale: Astro.locals.locale })}
        </a>
        <!-- GitHub Stars -->
        <a
          href={getRelativeLocaleUrl(Astro.locals.locale, 'plugins')}
          aria-label={m.github_stars({}, { locale: Astro.locals.locale })}
          class="mt-3 flex min-h-11 items-center gap-2 rounded-xl border border-slate-400/35 bg-slate-700/70 px-3 py-2 text-sm font-semibold text-white transition-colors hover:bg-slate-700"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"></path>
          </svg>
          <span>{totalStars}+ Stars</span>
        </a>
        <!-- Docs -->
        <a
          href={getRelativeLocaleUrl(locale, 'docs')}
          aria-label={m.docs({}, { locale })}
          class="mt-3 flex min-h-12 items-center rounded-xl px-3 text-base font-semibold text-white transition-colors hover:bg-slate-700/80"
        >
          {m.docs({}, { locale })}
        </a>
        <!-- Products Section -->
        <div class="mt-1 border-t border-slate-500/45 pt-2">
          <button
            type="button"
            id="products-toggle"
            aria-expanded="false"
            aria-controls="products-submenu"
            class="flex min-h-12 w-full items-center justify-between rounded-xl px-3 text-left text-base font-semibold text-white transition-colors hover:bg-slate-700/80"
          >
            {m.products({}, { locale: Astro.locals.locale })}
            <svg
              id="products-chevron"
              class="h-4 w-4 transition-transform"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="products-submenu" class="mt-1 grid hidden gap-1 rounded-xl border border-slate-400/30 bg-slate-700/70 p-2">
            {
              productMenu.map((group) => (
                <>
                  <p class="px-3 pt-2 font-mono text-[11px] font-semibold tracking-widest text-slate-300 uppercase">{group.label}</p>
                  {group.items.map((item) => (
                    <a
                      href={getRelativeLocaleUrl(Astro.locals.locale, item.href)}
                      class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
                    >
                      {item.label}
                    </a>
                  ))}
                </>
              ))
            }
          </div>
        </div>
        <!-- Solutions Section -->
        <div class="mt-1 border-t border-slate-500/45 pt-2">
          <button
            type="button"
            id="solutions-toggle"
            aria-expanded="false"
            aria-controls="solutions-submenu"
            class="flex min-h-12 w-full items-center justify-between rounded-xl px-3 text-left text-base font-semibold text-white transition-colors hover:bg-slate-700/80"
          >
            {m.solutions({}, { locale: Astro.locals.locale })}
            <svg
              id="solutions-chevron"
              class="h-4 w-4 transition-transform"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="solutions-submenu" class="mt-1 grid hidden gap-1 rounded-xl border border-slate-400/30 bg-slate-700/70 p-2">
            <p class="px-3 py-1 text-xs font-semibold tracking-wider text-slate-200 uppercase">{m.solutions_by_team({}, { locale: Astro.locals.locale })}</p>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'enterprise')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_enterprise_short({}, { locale: Astro.locals.locale })}
            </a>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'solutions/startups')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_startups_short({}, { locale: Astro.locals.locale })}
            </a>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'solutions/solo-developers')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_solo_short({}, { locale: Astro.locals.locale })}
            </a>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'solutions/agencies')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_agencies_short({}, { locale: Astro.locals.locale })}
            </a>
            <p class="px-3 py-1 text-xs font-semibold tracking-wider text-slate-200 uppercase">{m.solutions_by_industry({}, { locale: Astro.locals.locale })}</p>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'solutions/fintech')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_fintech_short({}, { locale: Astro.locals.locale })}
            </a>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'solutions/ecommerce')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_ecommerce_short({}, { locale: Astro.locals.locale })}
            </a>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'solutions/healthcare')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_healthcare_short({}, { locale: Astro.locals.locale })}
            </a>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'solutions/qsr')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_qsr_short({}, { locale: Astro.locals.locale })}
            </a>
            <p class="px-3 py-1 text-xs font-semibold tracking-wider text-slate-200 uppercase">{m.solutions_by_use_case({}, { locale: Astro.locals.locale })}</p>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'solutions/production-updates')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_production_updates({}, { locale: Astro.locals.locale })}
            </a>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'solutions/direct-updates')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_direct_updates({}, { locale: Astro.locals.locale })}
            </a>
            <a
              href={getRelativeLocaleUrl(Astro.locals.locale, 'solutions/set-and-forget')}
              class="flex min-h-11 items-center rounded-lg px-3 text-sm font-semibold text-white hover:bg-slate-600/80"
            >
              {m.solutions_set_and_forget_short({}, { locale: Astro.locals.locale })}
            </a>
            <a
