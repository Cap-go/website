---
import m from '@/copy/messages'
import ProductsMegaMenu from '@/components/ProductsMegaMenu.astro'
import SolutionsMegaMenu from '@/components/SolutionsMegaMenu.astro'
import { productIconPaths } from '@/config/productIcons'
import { getRelativeLocaleUrl } from '@/services/links'

const brand = Astro.locals.runtimeConfig.public.brand
const locale = Astro.locals.locale

const mobileProducts = [
  {
    label: m.platform_group_ship({}, { locale: Astro.locals.locale }),
    items: [
      {
        href: 'live-update',
        icon: 'bolt',
        name: m.platform_live_update_name({}, { locale: Astro.locals.locale }),
        tagline: m.menu_live_update_tagline({}, { locale: Astro.locals.locale }),
      },
      {
        href: 'native-build',
        icon: 'cube',
        name: m.platform_native_build_name({}, { locale: Astro.locals.locale }),
        tagline: m.menu_native_build_tagline({}, { locale: Astro.locals.locale }),
      },
    ],
  },
  {
    label: m.platform_group_operate({}, { locale: Astro.locals.locale }),
    items: [
      {
        href: 'observe',
        icon: 'chart-bar',
        name: m.platform_observe_name({}, { locale: Astro.locals.locale }),
        tagline: m.menu_observe_tagline({}, { locale: Astro.locals.locale }),
      },
      {
        href: 'notifications',
        icon: 'bell',
        name: m.platform_notifications_name({}, { locale: Astro.locals.locale }),
        tagline: m.menu_notifications_tagline({}, { locale: Astro.locals.locale }),
      },
    ],
  },
  {
    label: m.platform_group_automate({}, { locale: Astro.locals.locale }),
    items: [
      { href: 'capgo-cli', icon: 'command-line', name: m.nav_capgo_cli({}, { locale: Astro.locals.locale }), tagline: m.menu_cli_tagline({}, { locale: Astro.locals.locale }) },
      { href: 'skills', icon: 'sparkles', name: m.platform_skills_name({}, { locale: Astro.locals.locale }), tagline: m.menu_skills_tagline({}, { locale: Astro.locals.locale }) },
      {
        href: 'app_mobile',
        icon: 'device-phone-mobile',
        name: m.platform_app_name({}, { locale: Astro.locals.locale }),
        tagline: m.menu_app_tagline({}, { locale: Astro.locals.locale }),
      },
    ],
  },
  {
    label: m.platform_group_extend({}, { locale: Astro.locals.locale }),
    items: [
      {
        href: 'plugins',
        icon: 'puzzle-piece',
        name: m.platform_plugins_name({}, { locale: Astro.locals.locale }),
        tagline: m.menu_plugins_tagline({}, { locale: Astro.locals.locale }),
      },
      {
        href: 'ionic-enterprise-plugins',
        icon: 'shield-check',
        name: m.solutions_ionic_plugins_short({}, { locale: Astro.locals.locale }),
        tagline: m.menu_ionic_tagline({}, { locale: Astro.locals.locale }),
      },
    ],
  },
]

const mobileSolutions = [
  {
    label: m.solutions_by_team({}, { locale: Astro.locals.locale }),
    items: [
      { href: 'enterprise', name: m.solutions_enterprise_short({}, { locale: Astro.locals.locale }), tagline: m.solnav_enterprise({}, { locale: Astro.locals.locale }) },
      { href: 'solutions/startups', name: m.solutions_startups_short({}, { locale: Astro.locals.locale }), tagline: m.solnav_startups({}, { locale: Astro.locals.locale }) },
      { href: 'solutions/solo-developers', name: m.solutions_solo_short({}, { locale: Astro.locals.locale }), tagline: m.solnav_solo({}, { locale: Astro.locals.locale }) },
      { href: 'solutions/agencies', name: m.solutions_agencies_short({}, { locale: Astro.locals.locale }), tagline: m.solnav_agencies({}, { locale: Astro.locals.locale }) },
    ],
  },
  {
    label: m.solutions_by_industry({}, { locale: Astro.locals.locale }),
    items: [
      { href: 'solutions/fintech', name: m.solutions_fintech_short({}, { locale: Astro.locals.locale }), tagline: m.solnav_fintech({}, { locale: Astro.locals.locale }) },
      { href: 'solutions/ecommerce', name: m.solutions_ecommerce_short({}, { locale: Astro.locals.locale }), tagline: m.solnav_ecommerce({}, { locale: Astro.locals.locale }) },
      { href: 'solutions/healthcare', name: m.solutions_healthcare_short({}, { locale: Astro.locals.locale }), tagline: m.solnav_healthcare({}, { locale: Astro.locals.locale }) },
      { href: 'solutions/qsr', name: m.solutions_qsr_short({}, { locale: Astro.locals.locale }), tagline: m.solnav_qsr({}, { locale: Astro.locals.locale }) },
    ],
  },
  {
    label: m.solnav_workflows({}, { locale: Astro.locals.locale }),
    items: [
      {
        href: 'solutions/production-updates',
        name: m.solutions_production_updates({}, { locale: Astro.locals.locale }),
        tagline: m.solnav_production_updates({}, { locale: Astro.locals.locale }),
      },
      {
        href: 'solutions/direct-updates',
        name: m.solutions_direct_updates({}, { locale: Astro.locals.locale }),
        tagline: m.solnav_direct_updates({}, { locale: Astro.locals.locale }),
      },
      { href: 'solutions/pr-preview', name: m.solutions_pr_preview({}, { locale: Astro.locals.locale }), tagline: m.solnav_pr_preview({}, { locale: Astro.locals.locale }) },
      { href: 'solutions/beta-testing', name: m.solutions_beta_testing({}, { locale: Astro.locals.locale }), tagline: m.solnav_beta_testing({}, { locale: Astro.locals.locale }) },
      {
        href: 'solutions/version-targeting',
        name: m.solutions_version_targeting({}, { locale: Astro.locals.locale }),
        tagline: m.solnav_version_targeting({}, { locale: Astro.locals.locale }),
      },
      { href: 'solutions/white-label', name: m.solutions_white_label({}, { locale: Astro.locals.locale }), tagline: m.solnav_white_label({}, { locale: Astro.locals.locale }) },
      {
        href: 'solutions/set-and-forget',
        name: m.solutions_set_and_forget_short({}, { locale: Astro.locals.locale }),
        tagline: m.solnav_set_and_forget({}, { locale: Astro.locals.locale }),
      },
    ],
  },
  {
    label: m.solnav_migrations({}, { locale: Astro.locals.locale }),
    items: [
      {
        href: 'solutions/build-without-mac',
        name: m.solutions_build_without_mac_short({}, { locale: Astro.locals.locale }),
        tagline: m.solnav_build_without_mac({}, { locale: Astro.locals.locale }),
      },
      {
        href: 'solutions/webapp-to-mobile',
        name: m.solutions_webapp_to_mobile_short({}, { locale: Astro.locals.locale }),
        tagline: m.solnav_webapp_to_mobile({}, { locale: Astro.locals.locale }),
      },
      {
        href: 'solutions/lovable-vibecoding-to-mobile',
        name: m.solutions_lovable_to_mobile_short({}, { locale: Astro.locals.locale }),
        tagline: m.solnav_lovable_to_mobile({}, { locale: Astro.locals.locale }),
      },
      {
        href: 'solutions/cordova-to-capacitor',
        name: m.solutions_cordova_to_capacitor_short({}, { locale: Astro.locals.locale }),
        tagline: m.solnav_cordova_to_capacitor({}, { locale: Astro.locals.locale }),
      },
      {
        href: 'solutions/cordova-to-capacitor-ai',
        name: m.solutions_cordova_to_capacitor_ai_short({}, { locale: Astro.locals.locale }),
        tagline: m.solnav_cordova_to_capacitor_ai({}, { locale: Astro.locals.locale }),
      },
      {
        href: 'solutions/ionic-enterprise-plugins',
        name: m.solutions_ionic_plugins_short({}, { locale: Astro.locals.locale }),
        tagline: m.solnav_ionic_plugins({}, { locale: Astro.locals.locale }),
      },
    ],
  },
]

const mobileLinks = [
  { href: 'docs', label: m.docs({}, { locale: Astro.locals.locale }) },
  { href: 'enterprise', label: m.enterprise_title({}, { locale: Astro.locals.locale }) },
  { href: 'pricing', label: m.pricing({}, { locale: Astro.locals.locale }) },
  { href: 'blog', label: m.blog({}, { locale: Astro.locals.locale }) },
]
---

<header class="sticky top-0 z-50 py-3">
  <span id="header-auth-live" class="sr-only" aria-live="polite" aria-atomic="true"></span>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="relative flex items-center justify-between gap-3 md:justify-center">
      <div class="header-pill relative flex min-w-0 items-center rounded-2xl border border-white/10 bg-[#101216]/80 py-1.5 pr-1.5 pl-3 shadow-lg shadow-black/30 backdrop-blur-xl">
        <a
          href={getRelativeLocaleUrl(Astro.locals.locale)}
          aria-label={m.capgo_home({}, { locale: Astro.locals.locale })}
          class="font-prompt flex shrink-0 items-center pr-2 font-medium md:pr-3"
        >
          <img class="h-7 w-auto pr-1 lg:h-8" loading="eager" height="40" width="144" alt={`${brand} logo`} src="/capgo_logo_header.webp" />
        </a>
        <nav class="hidden items-center gap-0.5 md:flex lg:gap-1">
          <!-- Docs -->
          <a
            href={getRelativeLocaleUrl(Astro.locals.locale, 'docs')}
            aria-label={m.docs({}, { locale: Astro.locals.locale })}
            class="flex h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none xl:px-2"
          >
            {m.docs({}, { locale: Astro.locals.locale })}
          </a>
          <!-- Products Dropdown -->
          <div class="group" data-mega-root>
            <button
              type="button"
              class="flex h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none xl:px-2"
              aria-label={m.products({}, { locale: Astro.locals.locale })}
            >
              {m.products({}, { locale: Astro.locals.locale })}
              <svg
                class="ml-1 h-4 w-4 transition-transform group-focus-within:rotate-180 group-hover:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div
              class="invisible absolute top-full left-0 z-50 pt-3 opacity-0 transition-[opacity,visibility] duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 group-hover:delay-100"
            >
              <ProductsMegaMenu />
            </div>
          </div>
          <!-- Solutions Dropdown -->
          <div class="group">
            <button
              type="button"
              class="flex h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none xl:px-2"
              aria-label={m.solutions({}, { locale: Astro.locals.locale })}
            >
              {m.solutions({}, { locale: Astro.locals.locale })}
              <svg
                class="ml-1 h-4 w-4 transition-transform group-focus-within:rotate-180 group-hover:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div
              class="invisible absolute top-full left-0 z-50 pt-3 opacity-0 transition-[opacity,visibility] duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 group-hover:delay-100"
            >
              <SolutionsMegaMenu />
            </div>
          </div>
          <a
            href={getRelativeLocaleUrl(Astro.locals.locale, 'enterprise')}
            aria-label={m.enterprise_title({}, { locale: Astro.locals.locale })}
            class="hidden h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none lg:flex xl:px-2"
          >
            {m.enterprise_title({}, { locale: Astro.locals.locale })}
          </a>
          <!-- Pricing -->
          <a
            href={getRelativeLocaleUrl(Astro.locals.locale, 'pricing')}
            aria-label={m.pricing({}, { locale: Astro.locals.locale })}
            class="flex h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none xl:px-2"
          >
            {m.pricing({}, { locale: Astro.locals.locale })}
          </a>
          <!-- Blog -->
          <a
            href={getRelativeLocaleUrl(Astro.locals.locale, 'blog')}
            aria-label={m.blog({}, { locale: Astro.locals.locale })}
            class="hidden h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-200 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none lg:flex xl:px-2"
          >
            {m.blog({}, { locale: Astro.locals.locale })}
          </a>
          <span class="mx-1 h-5 w-px bg-white/10" aria-hidden="true"></span>
          <a
            data-guest-auth-link
            href="https://console.capgo.app/login/"
            aria-label={m.login({}, { locale: Astro.locals.locale })}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-10 items-center rounded-lg px-1.5 text-sm font-semibold whitespace-nowrap text-slate-400 transition-colors hover:bg-white/10 hover:text-white focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:outline-none xl:px-2"
          >
            {m.login({}, { locale: Astro.locals.locale })}
          </a>
        </nav>
      </div>
      <div class="hidden shrink-0 items-center md:flex">
        <a
          data-guest-auth-link
          href={getRelativeLocaleUrl(Astro.locals.locale, 'register')}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={m.register({}, { locale: Astro.locals.locale })}
          class="font-pj flex h-11 items-center rounded-2xl bg-white px-4 text-sm font-semibold whitespace-nowrap text-gray-950 shadow-lg shadow-black/30 transition-colors hover:bg-slate-200 focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900 focus-visible:outline-none"
          role="button"
        >
          {m.register({}, { locale: Astro.locals.locale })}
        </a>
        <a
          data-console-auth-link
          hidden
          href="https://console.capgo.app/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={m.console({}, { locale: Astro.locals.locale })}
          class="font-pj flex h-11 items-center rounded-2xl bg-white px-4 text-sm font-semibold whitespace-nowrap text-gray-950 shadow-lg shadow-black/30 transition-colors hover:bg-slate-200 focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900 focus-visible:outline-none"
          role="button"
        >
          {m.console({}, { locale: Astro.locals.locale })}
        </a>
      </div>
      <div class="flex md:hidden">
        <button
          type="button"
          class="inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-[#101216]/80 text-white shadow-lg shadow-black/30 backdrop-blur-xl transition-colors hover:bg-white/10 focus:ring-2 focus:ring-blue-400 focus:outline-none"
          aria-label={m.expand_menu({}, { locale: Astro.locals.locale })}
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="menu-toggle"
        >
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div id="mobile-menu" class="absolute inset-x-0 top-full z-50 hidden md:hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="flex max-h-[calc(100dvh-5.5rem)] flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#101216]/95 shadow-2xl shadow-black/50 backdrop-blur-xl">
        <div class="flex-1 overflow-y-auto overscroll-contain p-2">
          <button
            type="button"
            id="products-toggle"
            aria-expanded="false"
            aria-controls="products-submenu"
            class="flex min-h-12 w-full items-center justify-between rounded-xl px-3 text-left text-[15px] font-semibold text-white transition-colors hover:bg-white/5 focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:outline-none"
          >
            {m.products({}, { locale: Astro.locals.locale })}
            <span id="products-chevron" class="inline-flex transition-transform"
              ><svg class="h-4 w-4 text-slate-400 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
                ><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg
              ></span
            >
          </button>
          <div id="products-submenu" class="hidden pb-2">
            {
              mobileProducts.map((group) => (
                <div class="px-1 pt-2">
                  <p class="px-2 pb-1 font-mono text-[10.5px] font-semibold tracking-widest text-slate-500 uppercase">{group.label}</p>
                  {group.items.map((item) => (
                    <a href={getRelativeLocaleUrl(Astro.locals.locale, item.href)} class="flex items-center gap-3 rounded-xl px-2 py-2 transition-colors hover:bg-white/5">
                      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/5 text-[#44BCFF] ring-1 ring-white/10">
                        <svg
                          class="h-4 w-4"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          {productIconPaths[item.icon].map((d) => (
                            <path d={d} />
                          ))}
                        </svg>
                      </span>
                      <span class="min-w-0">
                        <span class="block text-sm font-semibold text-white">{item.name}</span>
                        <span class="block truncate text-xs text-slate-400">{item.tagline}</span>
                      </span>
                    </a>
                  ))}
                </div>
              ))
            }
          </div>

          <button
            type="button"
            id="solutions-toggle"
            aria-expanded="false"
            aria-controls="solutions-submenu"
            class="flex min-h-12 w-full items-center justify-between rounded-xl px-3 text-left text-[15px] font-semibold text-white transition-colors hover:bg-white/5 focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:outline-none"
          >
            {m.solutions({}, { locale: Astro.locals.locale })}
            <span id="solutions-chevron" class="inline-flex transition-transform"
              ><svg class="h-4 w-4 text-slate-400 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
                ><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path></svg
              ></span
            >
          </button>
          <div id="solutions-submenu" class="hidden pb-2">
            {
              mobileSolutions.map((group) => (
                <div class="px-1 pt-2">
                  <p class="px-2 pb-1 font-mono text-[10.5px] font-semibold tracking-widest text-slate-500 uppercase">{group.label}</p>
                  {group.items.map((item) => (
                    <a href={getRelativeLocaleUrl(Astro.locals.locale, item.href)} class="block rounded-xl px-2 py-2 transition-colors hover:bg-white/5">
                      <span class="block text-sm font-semibold text-white">{item.name}</span>
                      <span class="block truncate text-xs text-slate-400">{item.tagline}</span>
                    </a>
                  ))}
                </div>
              ))
            }
          </div>

          <div class="my-1 border-t border-white/10"></div>
          {
            mobileLinks.map((link) => (
              <a
                href={getRelativeLocaleUrl(Astro.locals.locale, link.href)}
                class="flex min-h-12 w-full items-center justify-between rounded-xl px-3 text-left text-[15px] font-semibold text-white transition-colors hover:bg-white/5 focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:outline-none"
              >
                {link.label}
                <svg class="h-4 w-4 text-slate-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
            ))
          }
        </div>

        <div class="grid grid-cols-2 gap-2 border-t border-white/10 p-2">
          <a
            data-guest-auth-link
            href="https://console.capgo.app/login/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-12 items-center justify-center rounded-xl border border-white/10 text-[15px] font-semibold text-white transition-colors hover:bg-white/5"
          >
            {m.login({}, { locale: Astro.locals.locale })}
          </a>
          <a
            data-guest-auth-link
            href={getRelativeLocaleUrl(Astro.locals.locale, 'register')}
            target="_blank"
            rel="noopener noreferrer"
            class="font-pj flex min-h-12 items-center justify-center rounded-xl bg-white text-[15px] font-semibold text-gray-950 transition-colors hover:bg-slate-200"
          >
            {m.register({}, { locale: Astro.locals.locale })}
          </a>
          <a
            data-console-auth-link
            hidden
            href="https://console.capgo.app/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-pj col-span-2 flex min-h-12 items-center justify-center rounded-xl bg-white text-[15px] font-semibold text-gray-950 transition-colors hover:bg-slate-200"
          >
            {m.console({}, { locale: Astro.locals.locale })}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle')
  const mobileMenu = document.getElementById('mobile-menu')
  const productsToggle = document.getElementById('products-toggle')
  const productsSubmenu = document.getElementById('products-submenu')
  const productsChevron = document.getElementById('products-chevron')
  const solutionsToggle = document.getElementById('solutions-toggle')
  const solutionsSubmenu = document.getElementById('solutions-submenu')
  const solutionsChevron = document.getElementById('solutions-chevron')
  const headerAuthLive = document.getElementById('header-auth-live')
  const websitePaidUserCookieName = 'capgo_paid_user'
  let previousHeaderPaidAccess: boolean | undefined

  function safeHasWebsitePaidUserCookie(): boolean {
    try {
      return document.cookie.split(';').some((cookie) => cookie.trim() === `${websitePaidUserCookieName}=1`)
    } catch {
      return false
    }
  }

  function announceHeaderAuthLinks(hasPaidAccess: boolean) {
    if (!headerAuthLive || previousHeaderPaidAccess === hasPaidAccess) return

    headerAuthLive.textContent = hasPaidAccess ? 'Console link available' : 'Login and register links available'
    previousHeaderPaidAccess = hasPaidAccess
  }

  function syncHeaderAuthLinks() {
    try {
      const hasPaidAccess = safeHasWebsitePaidUserCookie()
      document.querySelectorAll('[data-guest-auth-link]').forEach((element) => {
        if (hasPaidAccess) element.setAttribute('hidden', '')
        else element.removeAttribute('hidden')
      })
      document.querySelectorAll('[data-console-auth-link]').forEach((element) => {
        if (hasPaidAccess) element.removeAttribute('hidden')
        else element.setAttribute('hidden', '')
      })
      announceHeaderAuthLinks(hasPaidAccess)
    } catch {
      // Best-effort: restricted browsing contexts can block cookie/DOM access.
    }
  }

  menuToggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.toggle('hidden')
    menuToggle.setAttribute('aria-expanded', String(isOpen))
  })

  const desktopNavQuery = window.matchMedia('(min-width: 768px)')
  function closeMobileMenuOnDesktop() {
    if (!desktopNavQuery.matches) return
    mobileMenu?.classList.add('hidden')
    menuToggle?.setAttribute('aria-expanded', 'false')
  }
  desktopNavQuery.addEventListener('change', closeMobileMenuOnDesktop)

  productsToggle?.addEventListener('click', () => {
    const isOpen = !productsSubmenu?.classList.toggle('hidden')
    productsToggle.setAttribute('aria-expanded', String(isOpen))
    productsChevron?.classList.toggle('rotate-180', isOpen)
  })

  solutionsToggle?.addEventListener('click', () => {
    const isOpen = !solutionsSubmenu?.classList.toggle('hidden')
    solutionsToggle.setAttribute('aria-expanded', String(isOpen))
    solutionsChevron?.classList.toggle('rotate-180', isOpen)
  })

  syncHeaderAuthLinks()
  window.addEventListener('focus', syncHeaderAuthLinks)
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) syncHeaderAuthLinks()
  })
</script>
