<script>
  // Agents expose WebMCP via navigator/document.modelContext (natively or from an extension that may inject it late).
  // Regular visitors never download the tool registry.
  const hasModelContext = () => 'modelContext' in navigator || 'modelContext' in document
  const load = () => import('@/webmcp/entry')
  if (hasModelContext()) void load()
  else
    addEventListener(
      'load',
      () => {
        // Extensions can inject the context after load: poll once a second for 10s, stopping as soon as it appears.
        let checks = 0
        const timer = setInterval(() => {
          if (hasModelContext()) void load()
          else if (++checks < 10) return
          clearInterval(timer)
        }, 1000)
      },
      { once: true },
    )
</script>
