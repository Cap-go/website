---
import CommandCode from '@/components/CommandCode.astro'
import { cliFeatures } from '@/data/cliFeatures'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
---

<section class="bg-[#1a1a1a] py-16 sm:py-20" id="features" aria-labelledby="cli-features-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="font-mono text-sm font-semibold tracking-wide text-cyan-300 uppercase">CLI surface</p>
      <h2 id="cli-features-title" class="mt-3 text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">
        Every release step has a command
      </h2>
      <p class="mt-5 text-base leading-7 text-pretty text-slate-300">
        Init, compatibility, upload, channels, encryption, native builds, and CI all go through <code class="font-mono text-cyan-100">npx @capgo/cli@latest</code>. The reference
        for each command is linked on the card.
      </p>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      {cliFeatures.map((feature) => (
        <article id={feature.id} class="scroll-mt-24 rounded-lg border border-white/10 bg-white/[0.04] p-5 sm:p-6">
          <p class="font-mono text-xs font-semibold tracking-wide text-cyan-300 uppercase">{feature.command}</p>
          <h3 class="mt-2 text-xl font-semibold tracking-tight text-white">{feature.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-300">{feature.body}</p>
          <ul class="mt-4 space-y-2 text-sm leading-6 text-slate-300">
            {feature.points.map((point) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-300" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
          <div class="mt-4 rounded-lg bg-slate-950 p-4 ring-1 ring-white/10">
            <CommandCode command={feature.example} />
          </div>
          <a
            href={getRelativeLocaleUrl(locale, feature.docsPath)}
            class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-cyan-200 underline decoration-cyan-300/40 underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300"
          >
            {feature.docsLabel}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
