---
import m from '@/copy/messages'
import { stackMarks } from '@/config/stackMarks'

const locale = Astro.locals.locale
---

<div class="flex flex-col items-center gap-3">
  <p class="text-sm text-slate-400">{m.works_with_stack({}, { locale })}</p>
  <ul class="flex flex-wrap justify-center gap-2">
    {stackMarks.map((item) => (
      <li class="flex items-center gap-2 rounded-full bg-white/[0.06] py-1.5 pr-3.5 pl-2.5 text-sm font-medium text-slate-200 ring-1 ring-white/10">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill={item.color} aria-hidden="true">
          <path d={item.path} />
        </svg>
        {item.name}
      </li>
    ))}
  </ul>
</div>
