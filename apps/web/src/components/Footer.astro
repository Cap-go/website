---
import BrandLogo from '@/components/BrandLogo.astro'
import m from '@/copy/messages'
import { getLocalizedPath } from '@/services/locale-path'
import { locales } from '@/services/locale'
import { getRelativeLocaleUrl } from '@/services/links'

const year = new Date().getFullYear()

// Map locale codes to flag emojis
const localeFlags: Record<string, string> = {
  de: '🇩🇪',
  en: '🇺🇸',
  es: '🇪🇸',
  fr: '🇫🇷',
  id: '🇮🇩',
  it: '🇮🇹',
  ja: '🇯🇵',
  ko: '🇰🇷',
  zh: '🇨🇳',
}

const currentFlag = localeFlags[Astro.locals.locale] || '🇺🇸'

interface FooterLink {
  name: string
  href: string
  external?: boolean
}

const localeNames: Record<string, string> = {
  de: 'Deutsch',
  en: 'English',
  es: 'Español',
  fr: 'Français',
  id: 'Bahasa Indonesia',
  it: 'Italiano',
  ja: '日本語',
  ko: '한국어',
  zh: '中文',
}

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: m.products({}, { locale: Astro.locals.locale }),
    links: [
      { name: m.live_update({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'live-update') },
      { name: m.native_build({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'native-build') },
      { name: 'Observe', href: getRelativeLocaleUrl(Astro.locals.locale, 'observe') },
      { name: 'Notifications', href: getRelativeLocaleUrl(Astro.locals.locale, 'notifications') },
      { name: m.app_mobile({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'app_mobile') },
      { name: m.plugins({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'plugins') },
      { name: m.integrations_badge({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'integrations') },
      { name: m.cli_and_api({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'docs/cli') },
      { name: m.footer_hosted_mcp_link({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'docs/ai/mcp') },
      { name: m.ci_cd_integration({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'ci_cd') },
      { name: m.pricing({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'pricing') },
      { name: m.enterprise_title({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'enterprise') },
    ],
  },
  {
    title: m.footer_col_resources({}, { locale: Astro.locals.locale }),
    links: [
      { name: m.documentation({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'docs') },
      { name: m.blog({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'blog') },
      { name: m.articles({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'articles') },
      { name: 'Capacitor Skills', href: getRelativeLocaleUrl(Astro.locals.locale, 'skills') },
      { name: m.footer_agents_link({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'agents') },
      { name: m.community({}, { locale: Astro.locals.locale }), href: 'https://discord.capgo.app', external: true },
      { name: m.chat({}, { locale: Astro.locals.locale }), href: 'https://support.capgo.app', external: true },
      { name: 'Premium Support', href: getRelativeLocaleUrl(Astro.locals.locale, 'premium-support') },
      { name: m.status({}, { locale: Astro.locals.locale }), href: 'https://status.capgo.app/', external: true },
      { name: 'App store publishing costs', href: getRelativeLocaleUrl(Astro.locals.locale, 'cost/cost-to-publish-app-on-app-store') },
      { name: 'App store refusal stories', href: getRelativeLocaleUrl(Astro.locals.locale, 'app-store-refusal-horror-story') },
      { name: m.awesome_capacitor({}, { locale: Astro.locals.locale }), href: 'https://github.com/riderx/awesome-capacitor/', external: true },
      { name: m.top_app_by_framework({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'top_app') },
    ],
  },
  {
    title: m.footer_col_tools({}, { locale: Astro.locals.locale }),
    links: [
      { name: m.free_mobile_tools({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'tools') },
      { name: 'Security Scanner', href: getRelativeLocaleUrl(Astro.locals.locale, 'security-scanner') },
      { name: m.aasa_tester({}, { locale: Astro.locals.locale }), href: 'https://aasa-tester.capgo.app/', external: true },
      { name: m.semver_tester({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'semver_tester') },
      { name: 'Live Update data', href: getRelativeLocaleUrl(Astro.locals.locale, 'data') },
      { name: 'Native Build data', href: getRelativeLocaleUrl(Astro.locals.locale, 'builder-data') },
      { name: 'Android distribution chart', href: getRelativeLocaleUrl(Astro.locals.locale, 'android-distribution-chart') },
      { name: 'iOS distribution chart', href: getRelativeLocaleUrl(Astro.locals.locale, 'ios-distribution-chart') },
    ],
  },
  {
    title: m.compare({}, { locale: Astro.locals.locale }),
    links: [
      { name: m.alternatives({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'alternatives') },
      { name: m.capflow_nav_label({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'alternatives/ionic-appflow') },
      { name: m.expo_nav_label({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'alternatives/expo') },
      { name: m.median_nav_label({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'alternatives/median') },
      { name: m.capwesome_nav_label({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'alternatives/capawesome') },
      { name: m.alternatives_hub_codepush_link({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'alternatives/codepush') },
      { name: m.footer_voltbuilder_link({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'alternatives/voltbuilder') },
      { name: m.footer_best_live_updates_link({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'best/capacitor-live-updates') },
      { name: m.footer_migrate_appflow_link({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'migrate/from-appflow') },
      { name: m.footer_mcp_link({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'mcp') },
      {
        name: m.solutions_cordova_to_capacitor_ai_short({}, { locale: Astro.locals.locale }),
        href: getRelativeLocaleUrl(Astro.locals.locale, 'solutions/cordova-to-capacitor-ai'),
      },
      { name: m.solutions_webapp_to_mobile_short({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'solutions/webapp-to-mobile') },
    ],
  },
  {
    title: m.company({}, { locale: Astro.locals.locale }),
    links: [
      { name: m.about({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'about') },
      { name: m.brand_footer_link({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'brand') },
      { name: m.contact({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'contact') },
      { name: m.trust({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'trust') },
      { name: m.security_questionnaires({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'security-questionnaire') },
      { name: 'HIPAA compliance', href: getRelativeLocaleUrl(Astro.locals.locale, 'hipaa-compliance') },
      { name: m.consulting({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'consulting') },
      { name: m.affiliate_kicker({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'affiliate') },
      { name: m.jobs({}, { locale: Astro.locals.locale }), href: 'https://console.algora.io/org/capgo/bounties?status=open/', external: true },
      { name: m.contributing({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'contributing') },
      { name: m.sponsor({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'sponsor') },
      { name: m.imprint({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'imprint') },
    ],
  },
  {
    title: m.legal({}, { locale: Astro.locals.locale }),
    links: [
      { name: m.privacy({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'privacy') },
      { name: m.terms({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'tos') },
      { name: m.sla({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'sla') },
      { name: m.support_policy({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'support-policy') },
      { name: m.aup({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'aup') },
      { name: m.security_txt({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'security') },
      { name: m.bug_bounty({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'bug-bounty') },
      { name: m.dp({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'dp') },
      { name: m.dpa({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'dpa') },
      { name: m.subprocessors({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'subprocessors') },
      { name: m.eula({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'eula') },
      { name: m.return_policy({}, { locale: Astro.locals.locale }), href: getRelativeLocaleUrl(Astro.locals.locale, 'return') },
    ],
  },
