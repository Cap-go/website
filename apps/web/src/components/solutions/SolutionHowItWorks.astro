---
export interface SolutionHowItWorksStep {
  title: string
  body: string
  code?: string
  href?: string
  linkLabel?: string
}

export interface SolutionDocLink {
  href: string
  label: string
}

interface Props {
  id?: string
  eyebrow: string
  title: string
  description?: string
  steps: SolutionHowItWorksStep[]
  docsTitle?: string
  docs?: SolutionDocLink[]
  class?: string
}

const { id = 'how-it-works', eyebrow, title, description, steps, docsTitle, docs = [], class: className = 'bg-gray-900' } = Astro.props
const headingId = `${id}-title`
---

<section id={id} aria-labelledby={headingId} class:list={['solution-how scroll-mt-20 py-16 sm:py-20', className]}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-wide text-[#44BCFF] uppercase">{eyebrow}</p>
      <h2 id={headingId} class="mt-3 text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">
        {title}
      </h2>
      {description && <p class="mt-5 text-base leading-7 text-pretty text-gray-400 sm:text-lg">{description}</p>}
    </div>

    <ol class="mt-10 grid gap-4 lg:grid-cols-2">
      {steps.map((step, index) => (
        <li class="flex min-w-0 flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <div class="flex items-start gap-4">
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#44BCFF]/10 font-mono text-sm font-semibold text-[#44BCFF] ring-1 ring-[#44BCFF]/30"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div class="min-w-0">
              <h3 class="text-lg leading-7 font-semibold text-white">{step.title}</h3>
              <p class="mt-2 text-sm leading-6 text-pretty text-gray-400">{step.body}</p>
            </div>
          </div>
          {step.code && <pre class="mt-5 overflow-x-auto rounded-lg border border-white/10 bg-black/40 p-4 text-left text-[13px] leading-6 whitespace-pre-wrap text-gray-200 [overflow-wrap:anywhere]"><code>{step.code}</code></pre>}
          {step.href && step.linkLabel && (
            <a
              href={step.href}
              class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-[#44BCFF] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#44BCFF]"
            >
              {step.linkLabel}
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          )}
        </li>
      ))}
    </ol>

    {docs.length > 0 && (
      <nav aria-label={docsTitle} class="mt-8 rounded-2xl border border-white/10 bg-white/[0.02] p-6">
        {docsTitle && <p class="text-sm font-semibold text-white">{docsTitle}</p>}
        <ul class="mt-3 flex flex-wrap gap-2">
          {docs.map((doc) => (
            <li>
              <a
                href={doc.href}
                class="inline-flex min-h-10 items-center rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-sm text-gray-200 transition-colors hover:border-[#44BCFF]/40 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF]"
              >
                {doc.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</section>
