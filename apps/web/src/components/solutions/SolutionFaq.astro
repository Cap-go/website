---
export interface SolutionFaqItem {
  question: string
  answer: string
  href?: string
  linkLabel?: string
}

interface Props {
  id?: string
  eyebrow: string
  title: string
  description?: string
  items: SolutionFaqItem[]
  class?: string
}

const { id = 'faq', eyebrow, title, description, items, class: className = 'bg-gray-900' } = Astro.props
const headingId = `${id}-title`
---

<section id={id} aria-labelledby={headingId} class:list={['solution-faq scroll-mt-20 py-16 sm:py-20', className]}>
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:px-8">
    <div class="max-w-xl">
      <p class="text-sm font-semibold tracking-wide text-[#44BCFF] uppercase">{eyebrow}</p>
      <h2 id={headingId} class="mt-3 text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">
        {title}
      </h2>
      {description && <p class="mt-5 text-base leading-7 text-pretty text-gray-400">{description}</p>}
    </div>

    <div class="divide-y divide-white/10 border-y border-white/10">
      {items.map((item, index) => (
        <details class="group py-2" open={index === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 rounded-lg py-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF] [&::-webkit-details-marker]:hidden">
            <h3 class="text-base leading-7 font-semibold text-white">{item.question}</h3>
            <svg class="mt-1 h-5 w-5 shrink-0 text-gray-400 transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
            </svg>
          </summary>
          <div class="pb-5">
            <p class="text-sm leading-7 text-pretty text-gray-400">{item.answer}</p>
            {item.href && item.linkLabel && (
              <a
                href={item.href}
                class="mt-3 inline-flex text-sm font-semibold text-[#44BCFF] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#44BCFF]"
              >
                {item.linkLabel}
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
