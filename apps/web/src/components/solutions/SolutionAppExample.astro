---
import m, { type MessageKey, type MessageValues } from '@/copy/messages'
import { solutionAppExamples, type SolutionAppExampleKey } from '@/config/solutionAppExamples'
import { solutionStoreApps } from '@/config/solutionStoreApps'
import { renameCat, shortNumber } from '@/services/misc'
import SignupCta from '@/components/SignupCta.astro'

interface Props {
  solution: SolutionAppExampleKey
  randomize?: boolean
}

const { solution, randomize = false } = Astro.props
const locale = Astro.locals.locale
const example = solutionAppExamples[solution]
const copy = (key: MessageKey, values?: MessageValues) => m[key](values, { locale })
const appExamples = example.apps.map((appReference) => ({
  ...appReference,
  app: solutionStoreApps[appReference.appId],
  note: copy(appReference.noteKey),
}))
const plays = example.playKeys.map((playKey) => copy(playKey))
const showExampleCtas = solution === 'enterprise'
---

{
  appExamples.length > 0 && (
    <section id="real-app-examples" data-solution-app-examples={solution} class="solution-app-examples border-y border-white/10 bg-[#1a1a1a] py-14 sm:py-16 lg:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="solution-app-examples-header max-w-3xl">
          <p class="text-sm font-semibold tracking-wide text-[#44BCFF] uppercase">{copy('solution_app_examples_eyebrow')}</p>
          <h2 class="mt-4 text-3xl leading-tight font-semibold tracking-tight text-balance text-white sm:text-5xl">{copy(example.headlineKey)}</h2>
          <p class="mt-5 text-base leading-7 text-pretty text-gray-400 sm:text-lg">{copy(example.useCaseKey)}</p>
          {showExampleCtas && <SignupCta id="solution-app-examples-signup-cta" enterprise align="start" class="mt-6" />}
        </div>

        <div class="solution-app-examples-body mt-12">
          <div
            class="solution-app-examples-list grid gap-4 md:grid-cols-3"
            data-randomize-app-examples={randomize ? 'true' : undefined}
            aria-live={randomize ? 'polite' : undefined}
            aria-atomic={randomize ? 'true' : undefined}
          >
            {appExamples.map(({ app, note }) => (
              <article class="solution-app-example-card group relative flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-b from-white/[0.06] to-white/[0.02] p-6 transition-[border-color,transform] duration-200 hover:border-[#44BCFF]/40 motion-safe:hover:-translate-y-0.5">
                <div class="flex items-start justify-between gap-4">
                  <img
                    class="h-16 w-16 shrink-0 rounded-2xl object-cover shadow-lg shadow-black/40 outline-1 -outline-offset-1 outline-white/10"
                    src={app.icon}
                    alt={copy('solution_app_examples_icon_alt', { title: app.title })}
                    width="64"
                    height="64"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="rounded-full bg-white/[0.06] px-2.5 py-1 text-[11px] font-semibold tracking-wide text-gray-300 uppercase ring-1 ring-white/10">
                    {renameCat(app.category)}
                  </span>
                </div>

                <h3 class="mt-5 text-lg leading-6 font-semibold tracking-tight break-words text-white">{app.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-6 text-pretty text-gray-400">{note}</p>

                <dl class="mt-6 grid grid-cols-2 border-t border-white/10 pt-5">
                  <div>
                    <dt class="sr-only">{copy('solution_app_examples_installs_label')}</dt>
                    <dd class="text-2xl font-semibold tracking-tight text-white">{shortNumber(app.installs)}</dd>
                    <dd class="mt-1 text-xs text-gray-500" aria-hidden="true">
                      {copy('solution_app_examples_installs_label')}
                    </dd>
                  </div>
                  <div class="border-l border-white/10 pl-5">
                    <dt class="sr-only">{copy('solution_app_examples_rating_label')}</dt>
                    <dd class="flex items-center gap-1.5 text-2xl font-semibold tracking-tight text-white">
                      {app.score.toFixed(1)}
                      <svg class="h-5 w-5 text-amber-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" />
                      </svg>
                    </dd>
                    <dd class="mt-1 text-xs text-gray-500" aria-hidden="true">
                      {copy('solution_app_examples_rating_label')}
                    </dd>
                  </div>
                </dl>
              </article>
            ))}
          </div>

          <aside
            id="app-examples-cta"
            class="solution-app-examples-cta mt-6 grid gap-8 overflow-hidden rounded-2xl border border-[#44BCFF]/20 bg-[radial-gradient(80%_120%_at_0%_0%,rgb(68_188_255/0.12),transparent_60%)] p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center"
          >
            <div>
              <p class="font-mono text-xs font-semibold tracking-wide text-[#44BCFF] uppercase">{copy('solution_app_examples_cta_kicker')}</p>
              <h3 class="mt-3 text-2xl leading-8 font-semibold tracking-tight text-balance text-white">{copy('solution_app_examples_cta_title')}</h3>
              <p class="mt-3 max-w-2xl text-base leading-7 text-pretty text-gray-400">{copy('solution_app_examples_cta_text')}</p>
              <ul class="solution-app-examples-plays mt-5 flex flex-wrap gap-x-6 gap-y-2">
                {plays.map((play) => (
                  <li class="flex items-center gap-2 text-sm text-gray-300">
                    <svg class="h-4 w-4 shrink-0 text-[#44BCFF]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    {play}
                  </li>
                ))}
              </ul>
            </div>

            <SignupCta id="solution-app-examples-cta-signup" align="start" class="lg:items-center lg:text-center" />
          </aside>
        </div>
      </div>
    </section>
  )
}

<script is:inline>
  for (const list of document.querySelectorAll('[data-randomize-app-examples="true"]')) {
    list.setAttribute('aria-busy', 'true')
    const cards = Array.from(list.children)

    for (let index = cards.length - 1; index > 0; index -= 1) {
      const swapIndex = Math.floor(Math.random() * (index + 1))
      const current = cards[index]
      cards[index] = cards[swapIndex]
      cards[swapIndex] = current
    }

    for (const card of cards) list.append(card)
    list.removeAttribute('aria-busy')
  }
</script>
