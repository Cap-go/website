---
import type { FeaturedDirectoryEntry } from '@/config/featuredDirectories'

interface Props {
  entry: FeaturedDirectoryEntry
}

const { entry } = Astro.props
const snippet = entry.snippet
---

<li class="flex flex-col items-center justify-between gap-4 rounded-xl border border-white/10 bg-white/5 p-6 text-center shadow-sm ring-1 ring-white/5">
  <div class="flex min-h-14 w-full items-center justify-center">
    {entry.variant === 'snippet' && snippet ? (
      <a href={snippet.href} target={snippet.target ?? '_blank'} rel={snippet.rel} class="inline-flex max-w-full items-center justify-center transition-opacity hover:opacity-90">
        <img
          src={snippet.imgSrc}
          alt={snippet.alt}
          width={snippet.width}
          height={snippet.height}
          loading="lazy"
          decoding="async"
          class="h-auto max-h-14 w-auto max-w-full object-contain"
        />
      </a>
    ) : (
      <a
        href={entry.homeUrl}
        target="_blank"
        rel="noopener"
        class="text-sm font-semibold text-blue-300 underline decoration-blue-400/50 underline-offset-4 transition-colors hover:text-blue-200"
      >
        {entry.name}
      </a>
    )}
  </div>
  <p class="text-xs text-slate-400">{entry.name}</p>
</li>
