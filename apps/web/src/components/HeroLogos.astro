---
import heroLogoSlotsData from '@/data/hero-logo-slots.json'
import { formatHeroUsers, type AssignedHeroApp, type HeroLogoSlotsFile } from '@/lib/heroClientApps'

const selectedApps = (heroLogoSlotsData as HeroLogoSlotsFile).apps as AssignedHeroApp[]
const rowSizes = [12, 10, 8, 6]
let logoIndex = 0
const rows = rowSizes.map((size) => {
  const slice = selectedApps.slice(logoIndex, logoIndex + size)
  logoIndex += size
  return slice
})
---

<div class="hero-logo-cloud relative z-0 mx-auto mt-5 w-full max-w-4xl px-3 sm:mt-6" aria-hidden="true">
  <div class="flex flex-col items-center gap-1">
    {
      rows.map((row) => (
        <div class="flex justify-center gap-1">
          {row.map((app) => {
            const usersLabel = formatHeroUsers(app.users)
            return (
              <div class="hero-logo-tile relative" data-hero-logo>
                <img src={app.icon} alt="" width="80" height="80" decoding="async" class="hero-logo-img" onerror="this.closest('[data-hero-logo]')?.replaceChildren()" />
                {usersLabel && <span class="hero-logo-users">{usersLabel}</span>}
              </div>
            )
          })}
        </div>
      ))
    }
  </div>
  <div class="hero-logo-blur"></div>
</div>

<style>
  .hero-logo-cloud {
    container-type: inline-size;
    --hero-logo-gap: 0.25rem;
    --hero-logo-cols: 12;
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.72) 0%, black 24%, black 100%);
    -webkit-mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.72) 0%, black 24%, black 100%);
  }

  .hero-logo-tile {
    width: calc((100cqi - (var(--hero-logo-cols) - 1) * var(--hero-logo-gap)) / var(--hero-logo-cols));
    aspect-ratio: 1;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 0.9rem;
  }

  .hero-logo-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hero-logo-blur {
    pointer-events: none;
    position: absolute;
    inset: 0;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    mask-image: radial-gradient(ellipse 85% 48% at 50% 0%, black 0%, rgb(0 0 0 / 0.4) 36%, transparent 68%);
    -webkit-mask-image: radial-gradient(ellipse 85% 48% at 50% 0%, black 0%, rgb(0 0 0 / 0.4) 36%, transparent 68%);
  }

  .hero-logo-users {
    position: absolute;
    top: 0.12rem;
    right: 0.12rem;
    z-index: 1;
    border-radius: 999px;
    background: rgb(4 6 12 / 0.32);
    padding: 0.08rem 0.22rem;
    font-size: 0.5rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: rgb(255 255 255 / 0.38);
    pointer-events: none;
  }

  @media (max-width: 639px) {
    .hero-logo-blur {
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
  }
</style>
