---
import m from '@/copy/messages'
import SignupCta from '@/components/SignupCta.astro'
import TransparencySection from '@/components/TransparencySection.astro'

const locale = Astro.locals.locale

const pillars = [
  {
    title: m.risk_debt_stack_title({}, { locale }),
    body: m.risk_debt_stack_body({}, { locale }),
    icon: 'M4 6h16M4 12h16M4 18h16',
  },
  {
    title: m.risk_debt_workflows_title({}, { locale }),
    body: m.risk_debt_workflows_body({}, { locale }),
    icon: 'M4 4v6h6M20 20v-6h-6M5.6 15A8 8 0 0 0 19 17.7M18.4 9A8 8 0 0 0 5 6.3',
  },
  {
    title: m.risk_debt_defaults_title({}, { locale }),
    body: m.risk_debt_defaults_body({}, { locale }),
    icon: 'M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3zM9 12l2 2 4-4',
  },
  {
    title: m.risk_debt_support_title({}, { locale }),
    body: m.risk_debt_support_body({}, { locale }),
    icon: 'M8 10h8M8 14h5M21 12a9 9 0 0 1-13.2 7.9L3 21l1.1-4.8A9 9 0 1 1 21 12z',
  },
]

// Edge network figures, formerly the standalone "Worldwide" section with the globe.
const infraStats = [
  { value: '300+', label: m.home_cities_worldwide({}, { locale }) },
  { value: '122+', label: m.home_countries_covered({}, { locale }) },
  { value: '13,000+', label: m.home_network_connections({}, { locale }) },
  { value: '~50ms', label: m.home_latency_from_users({}, { locale }) },
]
---

<!-- Risk, infrastructure and transparency answer the same "can we trust this in production?" objection, so they share one section. -->
<section class="bg-[#1a1a1a] py-20 sm:py-24" aria-labelledby="risk-debt-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div class="text-center lg:text-left">
        <p class="font-mono text-base leading-7 font-semibold text-[#44BCFF]">{m.risk_debt_eyebrow({}, { locale })}</p>
        <h2 id="risk-debt-title" class="mt-2 text-3xl font-bold tracking-tight text-balance text-white sm:text-5xl">
          {m.risk_debt_title({}, { locale })}
        </h2>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-pretty text-gray-300 lg:mx-0">{m.risk_debt_lead({}, { locale })}</p>
        <SignupCta id="risk-debt-signup-cta" enterprise class="mt-10 lg:items-start lg:text-left" />
      </div>

      <div class="grid content-start gap-4 sm:grid-cols-2">
        {
          pillars.map((pillar) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
              <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-white/[0.06] text-[#44BCFF] ring-1 ring-white/10">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={pillar.icon} />
                </svg>
              </span>
              <h3 class="mt-4 text-base font-semibold text-white">{pillar.title}</h3>
              <p class="mt-2 text-sm leading-6 text-gray-400">{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="mt-20 border-t border-white/10 pt-20">
      <div class="mx-auto max-w-2xl text-center">
        <p class="font-mono text-base leading-7 font-semibold text-[#44BCFF]">{m.home_global_network_label({}, { locale })}</p>
        <h3 class="mt-2 text-2xl font-bold tracking-tight text-balance text-white sm:text-4xl">{m.instant_updates({}, { locale })}</h3>
        <p class="mt-6 text-lg leading-8 text-pretty text-gray-400">{m.home_global_infrastructure_desc({}, { locale })}</p>
      </div>
      <dl class="mx-auto mt-12 grid max-w-5xl grid-cols-2 gap-4 lg:grid-cols-4">
        {
          infraStats.map((stat) => (
            <div class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-center">
              <dt class="text-sm text-gray-400">{stat.label}</dt>
              <dd class="order-first mb-2 font-mono text-3xl font-bold tracking-tight text-white tabular-nums">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="mt-6 flex flex-wrap justify-center gap-3 text-sm text-emerald-300" role="list">
        {
          [m.home_uptime({}, { locale }), m.home_multi_provider_resilience({}, { locale })].map((item) => (
            <li class="inline-flex items-center gap-2 rounded-full bg-emerald-400/10 px-3 py-1 ring-1 ring-emerald-400/20">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <TransparencySection />
  </div>
</section>
