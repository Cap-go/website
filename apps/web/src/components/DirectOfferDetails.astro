---
import m from '@/copy/messages'
import { formatStartingMonthlyPrice } from '@/lib/planCopy'
import { getPlans } from '@/lib/siteData'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const startingPrice = formatStartingMonthlyPrice(getPlans(), locale)
const pricingUrl = `${getRelativeLocaleUrl(locale, 'pricing')}?billing=monthly&offer=direct`
---

<div data-direct-copy class="max-w-md space-y-2 text-sm leading-6" data-testid="direct-offer-details">
  {startingPrice && <p class="font-semibold">{m.direct_offer_monthly_start({ price: startingPrice }, { locale })}</p>}
  <p>{m.direct_offer_payment_step({}, { locale })}</p>
  <a href={pricingUrl} class="font-semibold underline underline-offset-4">
    {m.direct_offer_monthly_plans({}, { locale })}
  </a>
</div>
