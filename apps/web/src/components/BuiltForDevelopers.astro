---
import m from '@/copy/messages'
import { getRelativeLocaleUrl } from '@/services/links'
import HumanSupport from '@/components/HumanSupport.astro'
---

<section class="bg-[#1a1a1a] py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-base leading-7 font-semibold text-blue-400">{m.built_for_devs_badge({}, { locale: Astro.locals.locale })}</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">{m.built_for_devs_title({}, { locale: Astro.locals.locale })}</h2>
      <p class="mt-6 text-lg leading-8 text-gray-400">
        {m.built_for_devs_subtitle({}, { locale: Astro.locals.locale })}
      </p>
    </div>

    <!-- Visual Section: Code + Phone -->
    <div class="mt-16 flex flex-col items-center justify-center lg:flex-row lg:gap-16">
      <!-- Code Block -->
      <div class="relative z-10 w-full max-w-lg rounded-xl bg-[#0d1117] p-8 shadow-2xl ring-1 ring-white/10">
        <div class="mb-6 flex items-center gap-2">
          <div class="h-3 w-3 rounded-full bg-[#ff5f56]"></div>
          <div class="h-3 w-3 rounded-full bg-[#ffbd2e]"></div>
          <div class="h-3 w-3 rounded-full bg-[#27c93f]"></div>
        </div>
        <div class="font-mono text-sm leading-relaxed">
          <div class="flex">
            <span class="w-8 pr-4 text-right text-gray-600 select-none">1</span>
            <span
              ><span class="text-blue-400">import</span>
              <span class="text-white">{'{'}</span>
              <span class="text-yellow-400">CapacitorUpdater</span>
              <span class="text-white">{'}'}</span>
              <span class="text-blue-400">from</span>
              <span class="text-green-400">'@capgo/capacitor-updater'</span></span
            >
          </div>
          <div class="flex">
            <span class="w-8 pr-4 text-right text-gray-600 select-none">2</span>
          </div>
          <div class="flex">
            <span class="w-8 pr-4 text-right text-gray-600 select-none">3</span>
            <span
              ><span class="text-yellow-400">CapacitorUpdater</span><span class="text-white">.</span><span class="text-blue-400">notifyAppReady</span><span class="text-white"
                >()</span
              ></span
            >
          </div>
          <div class="flex">
            <span class="w-8 pr-4 text-right text-gray-600 select-none">4</span>
          </div>
        </div>
      </div>

      <!-- Dotted Line (Hidden on mobile, visible on desktop) -->
      <div class="relative hidden h-32 w-px self-center border-l border-dashed border-gray-700 lg:block"></div>

      <!-- Phone Mockup -->
      <div class="relative mt-8 lg:mt-0">
        <!-- Phone Frame -->
        <div class="relative mx-auto flex h-[500px] w-[260px] flex-col overflow-hidden rounded-[3rem] border-12 border-gray-900 bg-gray-900 shadow-2xl">
          <!-- Dynamic Island / Notch -->
          <div class="absolute top-0 left-1/2 z-20 h-6 w-20 -translate-x-1/2 rounded-b-2xl bg-black"></div>

          <!-- Screen Content -->
          <div class="relative flex h-full w-full flex-1 flex-col items-center overflow-hidden bg-[#0d1117] pt-16">
            <!-- Text Content -->
            <div class="z-10 mb-8 text-xl font-medium text-white">{m.built_for_devs_code_comment({}, { locale: Astro.locals.locale })}</div>

            <div class="z-10 mt-auto mb-20 flex w-full flex-col items-center justify-center">
              <div class="mb-1 text-[10px] text-gray-400">{m.built_for_devs_phone_update({}, { locale: Astro.locals.locale })}</div>
              <div class="text-[9px] text-gray-600">{m.built_for_devs_phone_time({}, { locale: Astro.locals.locale })}</div>

              <!-- App Icon -->
              <div class="relative mt-8">
                <div class="relative z-10 flex h-16 w-16 items-center justify-center rounded-xl bg-linear-to-b from-blue-400 to-blue-600 text-white shadow-lg">
                  <img src="/app_update_logo.svg" alt="App Icon" class="w-full" />
                </div>
              </div>
            </div>

            <!-- Bottom Glow -->
            <div class="pointer-events-none absolute right-0 bottom-0 left-0 h-48 bg-linear-to-t from-blue-600/40 via-blue-900/10 to-transparent"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Features Grid -->
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2 lg:max-w-none lg:grid-cols-4">
        <!-- CLI -->
        <div
          class="group flex flex-col rounded-2xl border border-white/5 bg-[#1c1c1c] p-8 transition-all duration-300 hover:border-blue-500/30 hover:shadow-[0_0_30px_-10px_rgba(59,130,246,0.3)]"
        >
          <dt class="flex flex-col items-center gap-y-6 text-center text-base leading-7 font-semibold text-white">
            <div class="flex h-12 w-12 items-center justify-center transition-transform duration-300 group-hover:scale-110">
              <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 18"></path>
              </svg>
            </div>
            {m.built_for_devs_feature_cli({}, { locale: Astro.locals.locale })}
          </dt>
          <dd class="mt-2 flex flex-auto flex-col text-center text-sm leading-6 text-gray-400">
            <p class="flex-auto">{m.built_for_devs_feature_cli_desc({}, { locale: Astro.locals.locale })}</p>
          </dd>
        </div>

        <!-- Channels -->
        <div
          class="group flex flex-col rounded-2xl border border-white/5 bg-[#1c1c1c] p-8 transition-all duration-300 hover:border-blue-500/30 hover:shadow-[0_0_30px_-10px_rgba(59,130,246,0.3)]"
        >
          <dt class="flex flex-col items-center gap-y-6 text-center text-base leading-7 font-semibold text-white">
            <div class="flex h-12 w-12 items-center justify-center transition-transform duration-300 group-hover:scale-110">
              <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M6 13.5V3.75m0 9.75a1.5 1.5 0 010 3m0-3a1.5 1.5 0 000 3m0 3.75V16.5m12-3V3.75m0 9.75a1.5 1.5 0 010 3m0-3a1.5 1.5 0 000 3m0 3.75V16.5m-6-9V3.75m0 3.75a1.5 1.5 0 010 3m0-3a1.5 1.5 0 000 3m0 9.75V10.5"
                ></path>
              </svg>
            </div>
            {m.built_for_devs_feature_channels({}, { locale: Astro.locals.locale })}
          </dt>
          <dd class="mt-2 flex flex-auto flex-col text-center text-sm leading-6 text-gray-400">
            <p class="flex-auto">{m.built_for_devs_feature_channels_desc({}, { locale: Astro.locals.locale })}</p>
          </dd>
        </div>

        <!-- Rollback -->
        <div
          class="group flex flex-col rounded-2xl border border-white/5 bg-[#1c1c1c] p-8 transition-all duration-300 hover:border-blue-500/30 hover:shadow-[0_0_30px_-10px_rgba(59,130,246,0.3)]"
        >
          <dt class="flex flex-col items-center gap-y-6 text-center text-base leading-7 font-semibold text-white">
            <div class="flex h-12 w-12 items-center justify-center transition-transform duration-300 group-hover:scale-110">
              <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"></path>
              </svg>
            </div>
            {m.built_for_devs_feature_rollback({}, { locale: Astro.locals.locale })}
          </dt>
          <dd class="mt-2 flex flex-auto flex-col text-center text-sm leading-6 text-gray-400">
            <p class="flex-auto">{m.built_for_devs_feature_rollback_desc({}, { locale: Astro.locals.locale })}</p>
          </dd>
        </div>

        <!-- Open source -->
        <div
          class="group flex flex-col rounded-2xl border border-white/5 bg-[#1c1c1c] p-8 transition-all duration-300 hover:border-blue-500/30 hover:shadow-[0_0_30px_-10px_rgba(59,130,246,0.3)]"
        >
          <dt class="flex flex-col items-center gap-y-6 text-center text-base leading-7 font-semibold text-white">
            <div class="flex h-12 w-12 items-center justify-center transition-transform duration-300 group-hover:scale-110">
              <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"
                ></path>
              </svg>
            </div>
            {m.built_for_devs_feature_opensource({}, { locale: Astro.locals.locale })}
          </dt>
          <dd class="mt-2 flex flex-auto flex-col text-center text-sm leading-6 text-gray-400">
            <p class="flex-auto">{m.built_for_devs_feature_opensource_desc({}, { locale: Astro.locals.locale })}</p>
          </dd>
        </div>
      </dl>
    </div>

    <div class="mt-16 flex flex-col items-center gap-3">
      <HumanSupport size="sm" />
      <a
        href={getRelativeLocaleUrl(Astro.locals.locale, 'register')}
        class="rounded-md bg-[#44BCFF] px-8 py-3 text-base font-semibold text-white shadow-sm hover:bg-[#3a9fd6] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF]"
      >
        {m.built_for_devs_cta({}, { locale: Astro.locals.locale })}
      </a>
    </div>
  </div>
</section>
