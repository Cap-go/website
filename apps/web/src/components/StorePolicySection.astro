---
import m from '@/copy/messages'
import { siteMetrics } from '@/config/siteMetrics'
import { getRelativeLocaleUrl } from '@/services/links'

interface Props {
  background?: string
}

const { background = 'bg-[#1a1a1a]' } = Astro.props
const locale = Astro.locals.locale
const faqUrl = `${getRelativeLocaleUrl(locale, 'docs/faq')}#how-does-this-relate-to-the-appplay-store-review-process-or-policies`

const policies = [
  {
    store: 'Apple',
    label: m.store_policy_apple_label({}, { locale }),
    body: m.store_policy_apple_body({}, { locale }),
    href: 'https://developer.apple.com/support/terms/apple-developer-program-license-agreement/',
    icon: 'M16.365 1.43c0 1.14-.47 2.23-1.21 3.03-.8.86-2.08 1.52-3.12 1.44-.13-1.1.42-2.25 1.15-3.02.81-.87 2.2-1.51 3.18-1.45ZM20.5 17.14c-.55 1.27-.82 1.84-1.53 2.96-.99 1.56-2.39 3.5-4.12 3.51-1.54.02-1.94-1-4.03-.99-2.09.01-2.53 1.01-4.07.99-1.73-.02-3.05-1.77-4.04-3.33C-.06 16.03-.35 10.9 1.44 8.2c1.27-1.92 3.28-3.04 5.16-3.04 1.92 0 3.12 1.05 4.71 1.05 1.54 0 2.48-1.05 4.7-1.05 1.68 0 3.46.91 4.72 2.49-4.15 2.27-3.48 8.2.77 9.49Z',
  },
  {
    store: 'Google Play',
    label: m.store_policy_google_label({}, { locale }),
    body: m.store_policy_google_body({}, { locale }),
    href: 'https://support.google.com/googleplay/android-developer/answer/16559646',
    icon: 'M3.6 1.8 13.8 12 3.6 22.2c-.36-.2-.6-.6-.6-1.05V2.85c0-.45.24-.85.6-1.05Zm11.7 11.7 2.55 2.55-11.4 6.5 8.85-9.05Zm3.9-3.6 2.55 1.45c.8.46.8 1.64 0 2.1l-2.55 1.45L16.35 12l2.85-2.1ZM6.45 1.45l11.4 6.5L15.3 10.5 6.45 1.45Z',
  },
]

const rules = [
  { tone: 'ota', text: m.store_policy_rule_ota({}, { locale }) },
  { tone: 'store', text: m.store_policy_rule_native({}, { locale }) },
  { tone: 'ota', text: m.store_policy_rule_purpose({}, { locale }) },
]
---

<section class:list={[background, 'py-24 sm:py-32']} aria-labelledby="store-policy-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div>
        <p class="font-mono text-base leading-7 font-semibold text-[#44BCFF]">{m.store_policy_eyebrow({}, { locale })}</p>
        <h2 id="store-policy-title" class="mt-2 text-3xl font-bold tracking-tight text-balance text-white sm:text-5xl">
          {m.store_policy_title({}, { locale })}
        </h2>
        <p class="mt-6 text-lg leading-8 text-pretty text-gray-300">{m.store_policy_lead({}, { locale })}</p>

        <div class="mt-10 flex flex-col gap-3 rounded-2xl border border-emerald-400/20 bg-emerald-400/[0.06] p-6 sm:flex-row sm:items-start sm:gap-5">
          <div class="shrink-0">
            <p class="text-xs font-semibold tracking-widest text-emerald-300/80 uppercase">{m.store_policy_record_label({}, { locale })}</p>
            <p class="mt-1 text-3xl font-bold whitespace-nowrap text-white">{m.store_policy_record_value({}, { locale })}</p>
          </div>
          <p class="text-sm leading-6 text-gray-300">{m.store_policy_record_body({ apps: siteMetrics.apps }, { locale })}</p>
        </div>

        <details class="group/incident mt-4 rounded-2xl border border-white/10 bg-white/[0.03]">
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-2xl px-6 py-4 text-sm font-medium text-gray-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF] [&::-webkit-details-marker]:hidden [@media(hover:hover)]:hover:text-white"
          >
            {m.store_policy_incident_label({}, { locale })}
            <svg class="h-4 w-4 shrink-0 text-gray-500 transition-transform group-open/incident:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                clip-rule="evenodd"></path>
            </svg>
          </summary>
          <p class="px-6 pb-5 text-sm leading-6 text-gray-400">{m.store_policy_incident_body({}, { locale })}</p>
        </details>
      </div>

      <div class="grid content-start gap-4">
        {
          policies.map((policy) => (
            <article class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
              <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/[0.06] text-white ring-1 ring-white/10">
                  <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d={policy.icon} />
                  </svg>
                </span>
                <h3 class="text-sm font-semibold text-white">{policy.label}</h3>
              </div>
              <p class="mt-4 text-sm leading-6 text-gray-300">{policy.body}</p>
              <a
                href={policy.href}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[#44BCFF]! focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF] [@media(hover:hover)]:hover:text-white!"
              >
                {m.store_policy_official_link({}, { locale })}
                <span class="sr-only">: {policy.store}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))
        }

        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <h3 class="font-mono text-xs font-semibold tracking-widest text-gray-500 uppercase">{m.store_policy_rules_label({}, { locale })}</h3>
          <ul class="mt-4 grid gap-3">
            {
              rules.map((rule) => (
                <li class="flex gap-3 text-sm leading-6 text-gray-300">
                  <span
                    class:list={[
                      'mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full ring-1',
                      rule.tone === 'ota' ? 'bg-[#44BCFF]/15 text-[#44BCFF] ring-[#44BCFF]/30' : 'bg-amber-300/15 text-amber-300 ring-amber-300/30',
                    ]}
                    aria-hidden="true"
                  >
                    <span class="h-1.5 w-1.5 rounded-full bg-current" />
                  </span>
                  {rule.text}
                </li>
              ))
            }
          </ul>
          <p class="mt-5 border-t border-white/10 pt-4 text-xs leading-5 text-gray-500">{m.store_policy_note({}, { locale })}</p>
          <a
            href={faqUrl}
            class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-[#44BCFF]! focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF] [@media(hover:hover)]:hover:text-white!"
          >
            {m.store_policy_faq_cta({}, { locale })}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
