---
import demoStylesHref from '../tailwind-capacitor-snapshot/capacitor/styles/tailwind-capacitor.css?url'
import '../tailwind-capacitor-snapshot/capacitor/styles/demo-shell.css'

const { title = 'Tailwind Capacitor demo shell' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href={demoStylesHref} />
    <meta name="robots" content="noindex" />
  </head>
  <body class="tc-demo-shell-body">
    <slot />
  </body>
</html>
