---
import demoStylesHref from '../styles/tailwind-capacitor-registry-bundle.css?url'
import '../styles/tailwind-capacitor-demo-shell.css'

const { title = 'Tailwind Capacitor demo shell' } = Astro.props
---

<!doctype html>
<html lang="en" class="h-full overflow-hidden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="stylesheet" href={demoStylesHref} />
    <meta name="robots" content="noindex" />
  </head>
  <body class="tc-demo-shell-body h-full overflow-hidden">
    <slot />
  </body>
</html>
