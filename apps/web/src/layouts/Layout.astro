---
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import SEO from '../components/SEO.astro'
import Affonso from '../components/Affonso.astro'
import Attribution from '../components/Attribution.astro'
import OpenAIPixel from '../components/OpenAIPixel.astro'
import PostHog from '../components/posthog.astro'
import ThirdPartyLoader from '../components/ThirdPartyLoader.astro'
import WebMcpTools from '../components/WebMcpTools.astro'
import globalStylesHref from '../css/global.css?url'
import productSurfaceHref from '../styles/product-surface.css?url'

const content = Astro.props.content ?? {}
const disableThirdPartyScripts = Astro.props.disableThirdPartyScripts ?? false
const hideChrome = Astro.props.hideChrome ?? false

const isLocalhost = Astro.url.origin.includes('localhost:')
const enableThirdPartyScripts = !isLocalhost && !disableThirdPartyScripts
---

<!doctype html>
<html lang={Astro.locals.locale.toLowerCase()}>
  <head>
    <!-- No Satoshi preload: most text uses the system stack, and on slow links the 42 KB font delayed first paint. font-display: swap covers the few headings. -->
    <link rel="stylesheet" href={globalStylesHref} />
    <link rel="stylesheet" href={productSurfaceHref} />
    <SEO {...content} />
    <meta name="naver-site-verification" content="e6891f007259d77b20bd76a17d11404d83755855" />
    <slot name="head" />
    <Attribution />
    {enableThirdPartyScripts && <ThirdPartyLoader />}
    {enableThirdPartyScripts && <PostHog />}
    {enableThirdPartyScripts && <Affonso />}
    {enableThirdPartyScripts && <OpenAIPixel />}
  </head>
  <body class="bg-gray-900 text-pretty text-white antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-blue-600 focus:px-4 focus:py-2 focus:text-white focus:ring-2 focus:ring-blue-400 focus:outline-none"
    >
      Skip to main content
    </a>
    <div class="min-h-dvh overflow-x-clip">
      {!hideChrome && <Header />}
      <main id="main-content">
        <slot />
      </main>
      {!hideChrome && <Footer />}
    </div>
    <WebMcpTools />
    {enableThirdPartyScripts && <script is:inline>
      window.capgoThirdParty.load('https://pls.digitalshift-ee.workers.dev/js/script.outbound-links.js', {
        'data-domain': 'capgo.app',
        'data-api': 'https://pls.digitalshift-ee.workers.dev/api/event',
      })
      window.capgoThirdParty.load('https://dtf.capgo.app/js/script.js', {
        'data-website-id': 'dfid_hu0aLqOvk52g6hykzIZei',
        'data-domain': 'capgo.app',
        'data-api-url': 'https://dtf.capgo.app/api/events',
      })
    </script>}
  </body>
</html>
