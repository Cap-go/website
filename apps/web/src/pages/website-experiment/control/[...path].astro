---
import routes from '@/experiments/website-design/routes.json'

const pages = import.meta.glob('../../../experiments/website-design/legacy/pages/**/*.astro', { eager: true })

export function getStaticPaths() {
  return routes.map((route) => ({
    params: { path: route === '/' ? undefined : route.slice(1, -1) },
    props: { route },
  }))
}

const { route } = Astro.props
const filename = route === '/' ? 'index' : route.slice(1, -1)
const key = `../../../experiments/website-design/legacy/pages/${filename}.astro`
const Page = (pages[key] as { default: any }).default
---

<Page />
