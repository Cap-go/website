---
import ConversionLandingLayout from '@/components/conversion/ConversionLandingLayout.astro'
import { getRelativeLocaleUrl } from '@/services/links'
import m from '@/copy/messages'
import { createServiceLdJson, createLdJsonGraph } from '@/lib/ldJson'

const locale = Astro.locals.locale
const title = m.best_capacitor_live_updates_title({}, { locale })
const description = m.best_capacitor_live_updates_meta_description({}, { locale })

const serviceLdJson = createServiceLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description,
  url: Astro.url.href,
  serviceType: 'Software Development Service',
  areaServed: ['Worldwide'],
})

const ldJSON = createLdJsonGraph(Astro.locals.runtimeConfig.public, serviceLdJson, {
  includeOrganization: true,
})

const content = { title, description, ldJSON, image: `${Astro.locals.runtimeConfig.public.baseUrl}/capgo_social.png` }

const relatedLinks = [
  { label: m.live_update({}, { locale }), href: getRelativeLocaleUrl(locale, 'live-update') },
  { label: m.alternatives({}, { locale }), href: getRelativeLocaleUrl(locale, 'alternatives') },
  { label: 'Best Capacitor OTA updates (blog)', href: getRelativeLocaleUrl(locale, 'blog/best-capacitor-ota-updates') },
  { label: m.best_appflow_alternative_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'best/appflow-alternative') },
  { label: m.best_codepush_alternative_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'best/codepush-alternative') },
]
---

<ConversionLandingLayout
  locale={locale}
  content={content}
  heroTitle={m.best_capacitor_live_updates_hero_title({}, { locale })}
  heroSubtitle={m.best_capacitor_live_updates_hero_subtitle({}, { locale })}
  sections={[
    {
      title: m.best_capacitor_live_updates_body_title({}, { locale }),
      paragraphs: [m.best_capacitor_live_updates_body_p1({}, { locale })],
      listItems: [
        m.best_capacitor_live_updates_body_li1({}, { locale }),
        m.best_capacitor_live_updates_body_li2({}, { locale }),
        m.best_capacitor_live_updates_body_li3({}, { locale }),
      ],
    },
  ]}
  relatedLinks={relatedLinks}
/>
