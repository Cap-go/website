---
import Layout from '@/layouts/Layout.astro'
import CommandCode from '@/components/CommandCode.astro'
import ConversionRelatedLinks from '@/components/conversion/ConversionRelatedLinks.astro'
import SignupCta from '@/components/SignupCta.astro'
import AgentLogo from '@/components/agents/AgentLogo.astro'
import m, { type MessageKey, type MessageValues } from '@/copy/messages'
import { agents, type Agent } from '@/data/agents'
import { createItemListLdJson, createLdJsonGraph, createServiceLdJson } from '@/lib/ldJson'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const config = Astro.locals.runtimeConfig.public

function copy(key: MessageKey, values: MessageValues = {}) {
  return m[key](values, { locale })
}

const title = copy('agents_hub_title')
const description = copy('agents_hub_meta_description')

const typeLabels: Record<Agent['type'], MessageKey> = {
  cli: 'agents_type_cli',
  ide: 'agents_type_ide',
  'app-builder': 'agents_type_app_builder',
  chat: 'agents_type_chat',
}

const methodLabels: Record<Agent['methods'][number], MessageKey> = {
  'hosted-mcp': 'agents_method_hosted_mcp',
  'local-mcp': 'agents_method_local_mcp',
  skills: 'agents_method_skills',
  cli: 'agents_method_cli',
  export: 'agents_method_export',
}

const agentUrl = (slug: string) => getRelativeLocaleUrl(locale, `agents/${slug}`)

const methods = [
  {
    title: copy('agents_hub_method_hosted_title'),
    body: copy('agents_hub_method_hosted_body'),
    command: 'https://api.capgo.app/mcp',
    href: 'docs/ai/mcp',
    label: copy('agents_page_docs_hosted'),
  },
  {
    title: copy('agents_hub_method_local_title'),
    body: copy('agents_hub_method_local_body'),
    command: 'npx @capgo/cli@latest mcp',
    href: 'docs/cli/reference/mcp',
    label: copy('agents_page_docs_cli_mcp'),
  },
  {
    title: copy('agents_hub_method_skills_title'),
    body: copy('agents_hub_method_skills_body'),
    command: 'npx skills add Cap-go/capgo-skills',
    href: 'skills',
    label: copy('agents_page_related_skills'),
  },
  {
    title: copy('agents_hub_method_cli_title'),
    body: copy('agents_hub_method_cli_body'),
    command: 'npx @capgo/cli@latest bundle upload --channel production',
    href: 'capgo-cli',
    label: copy('agents_page_related_cli'),
  },
]

const serviceLdJson = createServiceLdJson(config, {
  name: title,
  description,
  url: Astro.url.href,
  serviceType: 'Mobile app build, publishing, and live update service for AI agents',
  areaServed: ['Worldwide'],
})

const ldJSON = createLdJsonGraph(config, serviceLdJson, {
  includeOrganization: true,
  additionalEntities: [
    createItemListLdJson(config, {
      url: Astro.url.href,
      name: copy('agents_hub_h1'),
      description,
      items: agents.map((agent) => ({
        name: m.agents_page_related_agent({ agent: agent.name }, { locale }),
        url: new URL(agentUrl(agent.slug), config.baseUrl).href,
        image: agent.logo ? `${config.baseUrl}${agent.logo}` : undefined,
        description: agent.summary,
      })),
    }),
  ],
})

const content = {
  title,
  description,
  ldJSON,
  keywords: 'AI agent mobile app, MCP mobile app, Claude Code mobile app, Cursor capacitor, Codex app store, vibe coding mobile app, Capgo MCP',
}

const relatedLinks = [
  { label: copy('agents_page_related_mcp'), href: getRelativeLocaleUrl(locale, 'mcp') },
  { label: copy('agents_page_related_skills'), href: getRelativeLocaleUrl(locale, 'skills') },
  { label: copy('agents_page_related_cli'), href: getRelativeLocaleUrl(locale, 'capgo-cli') },
  { label: copy('agents_page_related_lovable'), href: getRelativeLocaleUrl(locale, 'solutions/lovable-vibecoding-to-mobile') },
  { label: copy('agents_page_related_webapp'), href: getRelativeLocaleUrl(locale, 'solutions/webapp-to-mobile') },
]
---

<Layout content={content}>
  <div class="hero-wash text-gray-200">
    <section class="relative overflow-hidden bg-gray-900 py-16 sm:py-20">
      <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <h1 class="text-4xl font-bold tracking-tight text-balance text-white sm:text-5xl">{copy('agents_hub_h1')}</h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-pretty text-gray-300">{copy('agents_hub_subtitle')}</p>
        <div class="mt-10">
          <SignupCta id="agents-hub-hero-signup" />
        </div>
      </div>
    </section>

    <section id="agents" aria-labelledby="agents-grid-title" class="bg-gray-900 scroll-mt-20 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 id="agents-grid-title" class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          {copy('agents_hub_grid_title')}
        </h2>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {agents.map((agent) => (
            <li class="group relative flex flex-col rounded-xl border border-white/10 bg-white/[0.03] p-5 transition hover:border-[#44BCFF]/50 hover:bg-white/[0.05]">
              <div class="flex items-center gap-4">
                <AgentLogo agent={agent} alt={m.agents_page_logo_alt({ agent: agent.name }, { locale })} />
                <div>
                  <h3 class="text-lg font-semibold text-white">
                    <a
                      href={agentUrl(agent.slug)}
                      class="focus-visible:outline-none after:absolute after:inset-0 after:rounded-xl focus-visible:after:ring-2 focus-visible:after:ring-[#44BCFF]"
                    >
                      {agent.name}
                    </a>
                  </h3>
                  <p class="text-sm text-gray-400">{copy(typeLabels[agent.type])}</p>
                </div>
              </div>
              <p class="mt-4 flex-1 text-sm leading-6 text-gray-300">{agent.summary}</p>
              <ul class="mt-4 flex flex-wrap gap-2 text-xs">
                {agent.methods.map((method) => (
                  <li class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 font-medium text-gray-300">{copy(methodLabels[method])}</li>
                ))}
              </ul>
              <span class="mt-4 text-sm font-semibold text-[#44BCFF] group-hover:text-white" aria-hidden="true">
                {copy('agents_hub_card_cta', { agent: agent.name })} →
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="methods" aria-labelledby="methods-title" class="scroll-mt-20 border-t border-white/10 bg-gray-900 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 id="methods-title" class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          {copy('agents_hub_methods_title')}
        </h2>
        <p class="mt-3 max-w-3xl text-gray-400">{copy('agents_hub_methods_subtitle')}</p>
        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {methods.map((method) => (
            <div class="flex flex-col rounded-xl border border-white/10 bg-white/[0.03] p-6">
              <h3 class="text-xl font-semibold text-white">{method.title}</h3>
              <p class="mt-2 flex-1 leading-7 text-gray-300">{method.body}</p>
              <div class="mt-4 overflow-x-auto rounded-lg bg-black/40 p-3 ring-1 ring-white/10">
                <CommandCode command={method.command.startsWith('http') ? method.command : `$ ${method.command}`} class="block font-mono text-[13px] leading-6 break-words" />
              </div>
              <a href={getRelativeLocaleUrl(locale, method.href)} class="mt-4 text-sm font-semibold text-[#44BCFF] hover:text-white">
                {method.label}
              </a>
            </div>
          ))}
        </div>
        <div class="mt-10 rounded-xl border border-[#44BCFF]/30 bg-[#44BCFF]/5 p-6">
          <h3 class="text-xl font-semibold text-white">{copy('agents_hub_builders_title')}</h3>
          <p class="mt-2 leading-7 text-gray-300">{copy('agents_hub_builders_body')}</p>
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            <li>
              <a href={getRelativeLocaleUrl(locale, 'solutions/lovable-vibecoding-to-mobile')} class="font-semibold text-[#44BCFF] hover:text-white">
                {copy('agents_page_related_lovable')}
              </a>
            </li>
            <li>
              <a href={getRelativeLocaleUrl(locale, 'solutions/webapp-to-mobile')} class="font-semibold text-[#44BCFF] hover:text-white">
                {copy('agents_page_related_webapp')}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section aria-labelledby="hub-cta-title" class="bg-gray-900 py-16 sm:py-20">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <h2 id="hub-cta-title" class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          {copy('agents_hub_cta_title')}
        </h2>
        <div class="mt-10">
          <SignupCta id="agents-hub-closing-signup" humanSupport />
        </div>
      </div>
    </section>

    <section class="bg-gray-900 pb-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <ConversionRelatedLinks title={copy('agents_page_related_title')} links={relatedLinks} />
      </div>
    </section>
  </div>
</Layout>
