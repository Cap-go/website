---
import Layout from '@/layouts/Layout.astro'
import ToolCatalog from '@/components/tools/ToolCatalog.astro'
import ToolFaq from '@/components/tools/ToolFaq.astro'
import ToolCodeBlock from '@/components/tools/ToolCodeBlock.astro'
import ToolHowTo from '@/components/tools/ToolHowTo.astro'
import ToolRelatedLinks from '@/components/tools/ToolRelatedLinks.astro'
import { createFAQPageLdJson, createHowToLdJson, createLdJsonGraph, createSoftwareApplicationLdJson, createWebPageLdJson } from '@/lib/ldJson'
import { getRelativeLocaleUrl } from '@/services/links'
import SignupCta from '@/components/SignupCta.astro'

const title = 'iOS Certificate Generator: CSR and .p12 Without a Mac'
const description =
  'Free iOS certificate generator. Create an Apple CSR and private key, then convert the .cer to .p12 in your browser. No Mac or Keychain Access needed.'

const faqItems = [
  {
    question: 'What does this iOS certificate generator create?',
    answer:
      'It creates a Certificate Signing Request (.csr) and the matching RSA 2048-bit private key (.pem). Upload the CSR to Apple Developer to get your Apple Distribution or Apple Development certificate (.cer), then combine the .cer with the private key into a .p12 file for Xcode, fastlane, CI, or Capgo Cloud Build.',
  },
  {
    question: 'What is a Certificate Signing Request (CSR)?',
    answer:
      'A CSR is a small file that contains your public key and identity details (name, email, country), signed with your private key. Apple uses it to issue a signing certificate bound to that key. The private key never goes to Apple, which is why you must keep the .pem file this tool gives you.',
  },
  {
    question: 'Can I create an iOS distribution certificate without a Mac?',
    answer:
      'Yes. Generate the CSR and private key here, upload the CSR in the Apple Developer portal from any browser, download the .cer, and convert it to .p12 with the converter in step 2 of this page. Everything works from Windows, Linux, or macOS, so Keychain Access is not required at any step.',
  },
  {
    question: 'Which certificate type should I choose in Apple Developer?',
    answer:
      'Choose Apple Development to run builds on registered test devices from Xcode. Choose Apple Distribution to sign builds for the App Store, TestFlight, and ad hoc distribution. The same CSR works for either type; the type is selected in Apple Developer, not in this tool.',
  },
  {
    question: 'Is the private key stored on the server?',
    answer:
      'No. In step 1, the CSR and private key are generated on demand by a stateless Capgo endpoint over HTTPS and returned straight to your browser with Cache-Control: no-store; they are never written to a database or kept after the response. Step 2, the .cer to .p12 converter, runs entirely in your browser and uploads nothing. If your policy requires local key generation, use the equivalent OpenSSL command on this page.',
  },
  {
    question: 'Why do I need to convert the .cer file to .p12?',
    answer:
      'The .cer file Apple gives you only contains the public certificate. Signing an app also requires the private key, so build tools expect a .p12 file that bundles the certificate and private key behind a password.',
  },
  {
    question: 'How do I convert a .cer to .p12?',
    answer:
      'Use step 2 on this page: select the .cer from Apple (DER or PEM), select the private key .pem used to create the CSR, enter a password, and select Build .p12 file. The browser checks that the certificate matches the key and builds a 3DES-encrypted .p12 that macOS Keychain, Xcode, and fastlane accept. Nothing is uploaded. You can also copy the .p12 as base64 for CI secrets.',
  },
  {
    question: 'Do I need an Apple Developer account?',
    answer:
      'Yes. Uploading a CSR and issuing signing certificates requires a paid Apple Developer Program membership (99 USD per year, or the Enterprise program for in-house distribution). The CSR itself can be generated without an account.',
  },
  {
    question: 'How long is an iOS signing certificate valid?',
    answer:
      'Apple Development and Apple Distribution certificates are valid for one year. Apps already live on the App Store keep working after the certificate expires or is revoked, but you need a new certificate and provisioning profile to sign the next build.',
  },
  {
    question: 'Can I reuse the same CSR or private key?',
    answer:
      'You can, but a fresh key pair per certificate is safer and easier to rotate. What you must not do is mix them: a .cer only works with the exact private key that created its CSR. If the key is lost, revoke the certificate and generate a new CSR.',
  },
  {
    question: 'Can I use this CSR for push notification (APNs) certificates?',
    answer:
      'Yes. Apple asks for a CSR when you create an APNs SSL certificate too. For new apps, an APNs authentication key (.p8) is usually simpler because it never expires and works for all your apps.',
  },
]

const howToSteps = [
  {
    name: 'Generate the CSR and private key',
    text: 'Enter your name, email, and two-letter country code in the form above and select Generate CSR and private key. Download both files and keep the private key safe.',
  },
  {
    name: 'Create the certificate in Apple Developer',
    text: 'Sign in to developer.apple.com, open Certificates, Identifiers & Profiles, select the plus button, and choose Apple Distribution or Apple Development.',
  },
  {
    name: 'Upload the CSR and download the .cer',
    text: 'Upload the ios-certificate-request.csr file, continue, and download the issued certificate, usually named distribution.cer or development.cer.',
  },
  {
    name: 'Convert the .cer to a .p12 file',
    text: 'Use the .cer to .p12 converter in step 2 of this page: select the .cer and the private key, set a password, and download the .p12. It runs in your browser, or use the OpenSSL command instead.',
  },
  {
    name: 'Create a provisioning profile',
    text: 'In Apple Developer, create an App Store, ad hoc, or development provisioning profile for your App ID and select the new certificate.',
  },
  {
    name: 'Sign and ship your app',
    text: 'Import the .p12 and profile into Xcode, fastlane, your CI secrets, or Capgo Cloud Build, then build and upload your app to TestFlight or the App Store.',
  },
]

const opensslCsrCommand = `openssl req -new -newkey rsa:2048 -nodes \\
  -keyout ios-private-key.pem \\
  -out ios-certificate-request.csr \\
  -subj "/emailAddress=jane@company.com/CN=Jane Doe/C=US"`

const p12Snippet = `# 1. Convert Apple's DER .cer to PEM
openssl x509 -inform DER -in distribution.cer -out distribution.pem

# 2. Bundle the certificate and private key into a .p12
#    -legacy (OpenSSL 3) keeps the file compatible with macOS Keychain.
#    Drop it on OpenSSL 1.1 or LibreSSL, which do not support the flag.
openssl pkcs12 -export -legacy \\
  -inkey ios-private-key.pem \\
  -in distribution.pem \\
  -name "Apple Distribution" \\
  -out distribution.p12`

const capgoSnippet = `bunx @capgo/cli@latest build credentials save \\
  --platform ios \\
  --certificate ./distribution.p12 \\
  --p12-password "your-p12-password" \\
  --ios-provisioning-profile "com.example.app=./profile.mobileprovision" \\
  --apple-team-id "TEAM123456"`

const fastlaneSnippet = `import_certificate(
  certificate_path: "distribution.p12",
  certificate_password: ENV["P12_PASSWORD"],
  keychain_name: "build.keychain",
  keychain_password: ENV["KEYCHAIN_PASSWORD"]
)`

const ciSnippet = `# Encode the .p12 and profile for CI secrets
base64 -i distribution.p12 | tr -d '\\n' > p12.base64
base64 -i profile.mobileprovision | tr -d '\\n' > profile.base64

# Check that the certificate and key match (both hashes must be equal)
openssl x509 -noout -modulus -in distribution.pem | openssl md5
openssl rsa -noout -modulus -in ios-private-key.pem | openssl md5`

const troubleshooting = [
  {
    error: 'The password you entered is incorrect (Keychain import)',
    fix: 'OpenSSL 3 encrypts .p12 files with algorithms that macOS Keychain can reject. Re-export the .p12 with OpenSSL 3 and the -legacy flag shown above.',
  },
  {
    error: 'No certificate matches private key',
    fix: 'The .cer was issued for a different CSR. Use the private key downloaded with that exact CSR, or revoke the certificate and start again with a new CSR.',
  },
  {
    error: 'unable to load certificates',
    fix: 'Apple delivers .cer files in DER format. Add -inform DER when converting the .cer with openssl x509.',
  },
  {
    error: 'Provisioning profile does not include signing certificate',
    fix: 'Profiles are tied to specific certificates. Edit or regenerate the provisioning profile after creating the new certificate, then download it again.',
  },
  {
    error: 'You have reached the maximum number of certificates',
    fix: 'Apple limits how many distribution certificates a team can hold. Revoke an unused one in Apple Developer. Live App Store apps are not affected.',
  },
  {
    error: 'Certificate is not trusted in Keychain',
    fix: 'Install the current Apple Worldwide Developer Relations (WWDR) intermediate certificate from Apple PKI, then import the .p12 again.',
  },
]

const relatedLinks = [
  {
    title: 'Capgo Cloud Build for iOS',
    description: 'Build, sign, and upload iOS apps to TestFlight from any operating system using your .p12 and provisioning profile.',
    path: 'native-build',
  },
  {
    title: 'iOS signing credentials and provisioning profiles',
    description: 'Step-by-step setup of certificates, profiles, and App Store Connect API keys for cloud builds.',
    path: 'docs/builder/ios',
  },
  {
    title: 'Build an iOS app from Windows',
    description: 'Ship a Capacitor iOS app to the App Store without owning a Mac.',
    path: 'blog/build-ios-app-from-windows-capacitor-capgo-build',
  },
  {
    title: 'Automatic Capacitor iOS build with GitHub Actions',
    description: 'Store the .p12 and provisioning profile as secrets and sign every release in CI.',
    path: 'blog/automatic-capacitor-ios-build-github-action',
  },
  {
    title: 'Certificate management for app development',
    description: 'Track expirations and rotate signing certificates before they block a release.',
    path: 'blog/certificate-management',
  },
  {
    title: 'Manage Apple Push Notification service certificates',
    description: 'Create and renew APNs certificates, or switch to token-based .p8 keys.',
    path: 'blog/apple-push-notification-service-certificates',
  },
]

const softwareApplication = createSoftwareApplicationLdJson(Astro.locals.runtimeConfig.public, {
  name: 'Capgo iOS Certificate Generator',
  description,
  url: Astro.url.href,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  offers: {
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
})

const faqLdJson = createFAQPageLdJson(Astro.locals.runtimeConfig.public, {
  url: Astro.url.href,
  questions: faqItems,
})

const webPage = createWebPageLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description,
  url: Astro.url.href,
})

const howToLdJson = createHowToLdJson(Astro.locals.runtimeConfig.public, {
  url: Astro.url.href,
  name: 'How to create an iOS distribution certificate without a Mac',
  description: 'Generate a CSR and private key, issue an Apple certificate, and convert it to a .p12 file for Xcode, fastlane, CI, or cloud builds.',
  totalTime: 'PT10M',
  tools: ['Web browser', 'Apple Developer account', 'OpenSSL'],
  steps: howToSteps,
})

const ldJSON = createLdJsonGraph(Astro.locals.runtimeConfig.public, softwareApplication, {
  includeOrganization: true,
  includeBreadcrumbs: true,
  breadcrumbs: [
    { name: 'Home', url: Astro.locals.runtimeConfig.public.baseUrl },
    { name: 'Tools', url: new URL('/tools/', Astro.locals.runtimeConfig.public.baseUrl).toString() },
    { name: 'iOS Certificate Generator', url: Astro.url.href },
  ],
  additionalEntities: [faqLdJson, howToLdJson, webPage],
})

const content = {
  title,
  description,
  keywords:
    'ios certificate generator, create ios distribution certificate without mac, convert cer to p12, cer to p12 converter, ios csr generator, apple csr generator, generate p12 certificate, ios p12 without mac, apple distribution certificate, certificate signing request online, ios signing certificate windows',
  ldJSON,
}

const benefits = [
  'Create an Apple-ready CSR without Keychain Access or a Mac, from Windows, Linux, or macOS.',
  'Works for Apple Distribution (App Store, TestFlight, ad hoc) and Apple Development certificates.',
  'Convert the issued .cer to .p12 right on this page, in your browser, for Xcode, fastlane, CI, or Capgo Cloud Build.',
]
---

<Layout content={content}>
  <div class="hero-wash">
  <section class="relative overflow-hidden border-b border-white/10 bg-linear-to-b from-slate-950 via-slate-900 to-slate-950 py-16 sm:py-20">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute top-10 left-0 h-72 w-72 rounded-full bg-cyan-500/10 blur-3xl"></div>
      <div class="absolute top-0 right-0 h-80 w-80 rounded-full bg-blue-500/10 blur-3xl"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <p class="text-sm font-semibold tracking-[0.3em] text-cyan-300 uppercase">Apple signing</p>
          <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">iOS Certificate Generator</h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300">
            Create an iOS distribution or development certificate without a Mac. Generate the Certificate Signing Request (CSR) and private key here, upload the CSR to Apple,
            and turn the issued certificate into a .p12 file for signing.
          </p>

          <ul class="mt-8 space-y-3 text-sm leading-7 text-slate-200">
            {
              benefits.map((benefit) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-2 w-2 rounded-full bg-cyan-300" />
                  <span>{benefit}</span>
                </li>
              ))
            }
          </ul>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row">
            <a
              href="#generator"
              class="inline-flex items-center justify-center rounded-2xl bg-cyan-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
            >
              Generate CSR now
            </a>
            <a
              href="#how-to"
              class="inline-flex items-center justify-center rounded-2xl border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:border-cyan-300/60 hover:bg-white/5"
            >
              See the step-by-step guide
            </a>
          </div>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/5 p-8">
          <p class="text-sm font-semibold tracking-[0.25em] text-cyan-300 uppercase">Workflow</p>
          <ol class="mt-6 space-y-5 text-sm leading-7 text-slate-300">
            <li><strong class="text-white">1.</strong> Enter the certificate subject details you want attached to the signing request.</li>
            <li><strong class="text-white">2.</strong> Download the CSR and matching private key.</li>
            <li><strong class="text-white">3.</strong> Upload the CSR in Apple Developer when creating your certificate.</li>
            <li><strong class="text-white">4.</strong> Convert the issued .cer and the private key into a password-protected .p12 in step 2 below.</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section id="generator" class="py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-8">
          <p class="text-sm font-semibold tracking-[0.25em] text-cyan-300 uppercase">Step 1</p>
          <h2 class="mt-3 text-3xl font-bold text-white">Generate the CSR and private key</h2>
          <p class="mt-4 text-sm leading-7 text-slate-300">Use the same person or organization identity you want represented in the Apple certificate request.</p>

          <form id="ios-certificate-form" class="mt-8 space-y-5">
            <div>
              <label class="mb-2 block text-sm font-medium text-slate-200" for="ios-common-name">Full name</label>
              <input
                id="ios-common-name"
                name="commonName"
                required
                class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white transition outline-none focus:border-cyan-300/60"
                placeholder="Jane Doe"
              />
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-200" for="ios-email">Email</label>
                <input
                  id="ios-email"
                  name="emailAddress"
                  type="email"
                  required
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white transition outline-none focus:border-cyan-300/60"
                  placeholder="jane@company.com"
                />
              </div>
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-200" for="ios-country">Country code</label>
                <input
                  id="ios-country"
                  name="countryName"
                  required
                  maxlength="2"
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white uppercase transition outline-none focus:border-cyan-300/60"
                  placeholder="US"
                />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-200" for="ios-organization">Organization</label>
                <input
                  id="ios-organization"
                  name="organization"
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white transition outline-none focus:border-cyan-300/60"
                  placeholder="Acme Mobile"
                />
              </div>
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-200" for="ios-organizational-unit">Organizational unit</label>
                <input
                  id="ios-organizational-unit"
                  name="organizationalUnit"
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white transition outline-none focus:border-cyan-300/60"
                  placeholder="Release Engineering"
                />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-200" for="ios-city">City</label>
                <input
                  id="ios-city"
                  name="localityName"
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white transition outline-none focus:border-cyan-300/60"
                  placeholder="Paris"
                />
              </div>
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-200" for="ios-state">State or province</label>
                <input
                  id="ios-state"
                  name="stateOrProvinceName"
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white transition outline-none focus:border-cyan-300/60"
                  placeholder="Ile-de-France"
                />
              </div>
            </div>

            <button
              type="submit"
              class="inline-flex w-full items-center justify-center rounded-2xl bg-cyan-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300"
            >
              Generate CSR and private key
            </button>
          </form>
        </div>

        <div class="rounded-3xl border border-white/10 bg-slate-950/80 p-8">
          <p class="text-sm font-semibold tracking-[0.25em] text-cyan-300 uppercase">Output</p>
          <h2 class="mt-3 text-3xl font-bold text-white">Your generated signing request</h2>
          <p class="mt-4 text-sm leading-7 text-slate-300">Nothing is shown until the CSR is generated. Once ready, download both files and store the private key securely.</p>

          <div id="ios-certificate-error" class="mt-6 hidden rounded-2xl border border-rose-400/30 bg-rose-400/10 px-4 py-3 text-sm text-rose-200"></div>
          <div id="ios-certificate-empty" class="mt-8 rounded-3xl border border-dashed border-white/10 px-6 py-12 text-center text-sm text-slate-400">
            Generate a certificate request to see the subject summary and download buttons here.
          </div>

          <div id="ios-certificate-result" class="mt-8 hidden">
            <div id="ios-certificate-summary" class="rounded-3xl border border-white/10 bg-white/5 p-6"></div>
            <div id="ios-certificate-downloads" class="mt-6 grid gap-4 sm:grid-cols-2"></div>
            <div class="mt-6 rounded-3xl border border-cyan-400/20 bg-cyan-400/5 p-6 text-sm leading-7 text-slate-300">
              Upload the CSR to Apple Developer and keep the private key outside Git. When Apple issues the <code class="text-cyan-200">.cer</code>,
              <a class="text-cyan-200 underline decoration-cyan-300/40 underline-offset-4" href="#cer-to-p12">convert it to a .p12</a> in step 2.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="cer-to-p12" class="border-t border-white/10 py-16 sm:py-20" aria-labelledby="cer-to-p12-title">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-8">
          <p class="text-sm font-semibold tracking-[0.25em] text-cyan-300 uppercase">Step 2</p>
          <h2 id="cer-to-p12-title" class="mt-3 text-3xl font-bold text-white">Convert your Apple .cer to .p12</h2>
          <p class="mt-4 text-sm leading-7 text-slate-300">
            After Apple issues your certificate, combine the <code class="text-cyan-200">.cer</code> with the private key from step 1 to get a password-protected
            <code class="text-cyan-200">.p12</code> for Xcode, fastlane, CI, or Capgo Cloud Build.
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            <strong class="text-white">Runs entirely in your browser.</strong> Your certificate, private key, and password are read locally and never uploaded to any server.
          </p>

          <form id="p12-form" class="mt-8 space-y-5" method="dialog" novalidate>
            <div>
              <label class="mb-2 block text-sm font-medium text-slate-200" for="p12-certificate">Apple certificate (.cer)</label>
              <input
                id="p12-certificate"
                name="certificate"
                type="file"
                accept=".cer,.crt,.der,.pem,application/x-x509-ca-cert,application/pkix-cert"
                required
                aria-describedby="p12-certificate-hint"
                class="block w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-sm text-slate-200 file:mr-4 file:rounded-xl file:border-0 file:bg-cyan-400 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-slate-950 focus:border-cyan-300/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300"
              />
              <p id="p12-certificate-hint" class="mt-2 text-xs text-slate-400">The distribution.cer or development.cer file from Apple Developer. DER and PEM are both accepted.</p>
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-slate-200" for="p12-private-key">Private key (.pem or .key)</label>
              <input
                id="p12-private-key"
                name="privateKey"
                type="file"
                accept=".pem,.key,.txt,application/x-pem-file"
                required
                aria-describedby="p12-private-key-hint"
                class="block w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-sm text-slate-200 file:mr-4 file:rounded-xl file:border-0 file:bg-cyan-400 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-slate-950 focus:border-cyan-300/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300"
              />
              <p id="p12-private-key-hint" class="mt-2 text-xs text-slate-400">The ios-private-key.pem file downloaded with the CSR you uploaded to Apple.</p>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-200" for="p12-password">.p12 password</label>
                <input
                  id="p12-password"
                  name="password"
                  type="password"
                  autocomplete="new-password"
                  required
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white transition outline-none focus:border-cyan-300/60"
                />
              </div>
              <div>
                <label class="mb-2 block text-sm font-medium text-slate-200" for="p12-password-confirm">Confirm password</label>
                <input
                  id="p12-password-confirm"
                  name="passwordConfirm"
                  type="password"
                  autocomplete="new-password"
                  required
                  class="w-full rounded-2xl border border-white/10 bg-slate-950 px-4 py-3 text-white transition outline-none focus:border-cyan-300/60"
                />
              </div>
            </div>

            <button
              type="submit"
              class="inline-flex w-full items-center justify-center rounded-2xl bg-cyan-400 px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-cyan-300 disabled:cursor-wait disabled:opacity-70"
            >
              Build .p12 file
            </button>
          </form>
        </div>

