---
import Layout from '@/layouts/Layout.astro'
import m from '@/copy/messages'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const title = m.page_not_found_title({}, { locale })
const description = m.page_not_found_description({}, { locale })
const homeHref = getRelativeLocaleUrl(locale, '/')
const docsHref = getRelativeLocaleUrl(locale, 'docs')
const pluginsHref = getRelativeLocaleUrl(locale, 'plugins')
---

<Layout content={{ title, description, robots: 'noindex, follow' }}>
  <section class="relative overflow-hidden px-6 py-24 sm:py-32">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(59,130,246,0.18),_transparent_55%)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold tracking-[0.2em] text-blue-300 uppercase">404</p>
      <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg text-gray-300">{description}</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={homeHref}
          class="rounded-md bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
        >
          {m.go_back_home({}, { locale })}
        </a>
        <a href={docsHref} class="rounded-md px-5 py-2.5 text-sm font-semibold text-gray-200 ring-1 ring-white/15 hover:bg-white/5">
          {m.docs({}, { locale })}
        </a>
        <a href={pluginsHref} class="rounded-md px-5 py-2.5 text-sm font-semibold text-gray-200 ring-1 ring-white/15 hover:bg-white/5">
          {m.plugins({}, { locale })}
        </a>
      </div>
    </div>
  </section>
</Layout>
