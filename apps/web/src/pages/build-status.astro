---
import Layout from '@/layouts/Layout.astro'
import { getBuilderFailureInfo } from '@/lib/builderFailureReasons'
import { jsonForInlineScript, resolveBuilderMetrics } from '@/lib/builderMetrics'
import { createLdJsonGraph, createWebPageLdJson } from '@/lib/ldJson'
import { getRelativeLocaleUrl } from '@/services/links'

const config = Astro.locals.runtimeConfig
const metrics = await resolveBuilderMetrics()
const title = 'Capgo Native Build status | Builder trends'
const description =
  'Global native iOS and Android build success, processing time, and failure mix for the last 30 days. Rates and minutes only — not queue counts and not realtime.'
const content = {
  title,
  description,
  image: `${config.public.baseUrl}/landing-demos/builder-status.webp`,
  ldJSON: createLdJsonGraph(config.public, createWebPageLdJson(config.public, { name: title, description, url: Astro.url.href }), { includeOrganization: true }),
}

const updatedLabel = (() => {
  const timestamp = new Date(metrics.updated_at)
  return Number.isNaN(timestamp.getTime())
    ? 'Updated moments ago'
    : `Updated ${new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(timestamp)} UTC`
})()

const topFailure = metrics.failures[0]
const topFailureInfo = topFailure ? getBuilderFailureInfo(topFailure.reason) : null
const topFailureLead = topFailureInfo
  ? `${topFailureInfo.label} accounts for ${Math.ceil(topFailure.share)}% of failed jobs in this window.`
  : 'Normalized categories across all apps.'

function formatRate(value: number | null) {
  return value === null ? '—' : `${Number(value.toFixed(1))}%`
}

function failureRate(success: number | null) {
  return success === null ? null : Number((100 - success).toFixed(1))
}

function formatDuration(seconds: number | null) {
  if (seconds === null) return '—'
  if (seconds < 90) return `${Math.round(seconds)}s`
  return `${(seconds / 60).toFixed(1)} min`
}

function platformOf(key: 'ios' | 'android') {
  return metrics.platforms.find((item) => item.key === key) ?? {
    key,
    share: 0,
    success_rate: null,
    avg_process_seconds: null,
    avg_queue_seconds: null,
    top_failure: null,
  }
}

function sparkTone(rate: number | null) {
  if (rate === null) return 'empty'
  return rate >= 70 ? 'good' : 'poor'
}

function sliceDays<T extends { date: string }>(rows: T[], days: number) {
  return rows.slice(Math.max(0, rows.length - days))
}

function chartScale(values: number[], kind: 'rate' | 'duration') {
  if (!values.length) return kind === 'rate' ? { min: 0, max: 100 } : { min: 0, max: 300 }
  const min = Math.min(...values)
  const max = Math.max(...values)
  const pad = Math.max(kind === 'rate' ? 3 : 20, (max - min) * 0.25)
  if (kind === 'rate') {
    return { min: Math.max(0, Number((min - pad).toFixed(1))), max: Math.min(100, Number((max + pad).toFixed(1))) }
  }
  return { min: Math.max(0, Number((min - pad).toFixed(1))), max: Number((max + pad).toFixed(1)) }
}

function chartPoints(values: Array<number | null>, scale: { min: number; max: number }, width = 800, height = 260) {
  const pad = { l: 44, r: 16, t: 16, b: 28 }
  const innerW = width - pad.l - pad.r
  const innerH = height - pad.t - pad.b
  const span = Math.max(scale.max - scale.min, 1)
  return values
    .map((value, index) => {
      if (value === null) return null
      const x = pad.l + (values.length <= 1 ? innerW / 2 : (index / (values.length - 1)) * innerW)
      const y = pad.t + (1 - (value - scale.min) / span) * innerH
      return `${x.toFixed(1)},${y.toFixed(1)}`
    })
    .filter((point): point is string => point !== null)
    .join(' ')
}

const ios = platformOf('ios')
const android = platformOf('android')
const chartRows = sliceDays(metrics.daily_platforms, 30)
const rateValues = chartRows.flatMap((row) => [row.ios, row.android]).filter((value): value is number => value !== null)
const chartRange = chartScale(rateValues, 'rate')
const iosChart = chartPoints(chartRows.map((row) => row.ios), chartRange)
const androidChart = chartPoints(chartRows.map((row) => row.android), chartRange)
const chartMid = Number(((chartRange.min + chartRange.max) / 2).toFixed(1))
const liveUpdateHref = getRelativeLocaleUrl(Astro.locals.locale, 'data')
const nativeBuildHref = getRelativeLocaleUrl(Astro.locals.locale, 'native-build')
---

<Layout content={content}>
  <script type="application/json" id="capgo-builder-metrics-bootstrap" is:inline set:html={jsonForInlineScript(metrics)} />
  <main class="data-page" aria-busy="false">
    <section class="data-hero">
      <div class="data-shell">
        <div class="data-title-row">
          <h1>Native Builds</h1>
          <p class="data-badge" data-status-badge><span aria-hidden="true"></span> Operational</p>
        </div>
        <p class="data-summary">
          Global iOS and Android builder success for the last 30 days. Each rate is finished jobs only — not a live queue, and not a build count.
        </p>
        <p class="data-updated" data-updated aria-live="polite" translate="no">{updatedLabel}</p>
        <p class="data-sr-only" data-kpi-status aria-live="polite"></p>
        <div class="data-kpis" aria-label="Global builder reliability">
          <div><p>Success</p><strong data-kpi="success-rate" translate="no">{formatRate(metrics.success_rate)}</strong></div>
          <div><p>Process</p><strong data-kpi="process" translate="no">{formatDuration(metrics.avg_process_seconds)}</strong></div>
          <div><p>Queue</p><strong data-kpi="queue" translate="no">{formatDuration(metrics.avg_queue_seconds)}</strong></div>
          <div><p>Window</p><strong>30 days</strong></div>
        </div>
      </div>
    </section>

    <section class="data-section" aria-labelledby="platforms-title">
      <div class="data-shell">
        <div class="data-heading">
          <div>
            <p class="data-eyebrow">Platforms</p>
            <h2 id="platforms-title">iOS and Android</h2>
          </div>
          <p>Success and failure over the last 30 days. The sparkline is one tick per UTC day — green at 70% or better.</p>
        </div>
        <div class="data-cards">
          <article class="data-card">
            <h3>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.7c0-2.4 2-3.4 2.1-3.5-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9s-1.9-.9-3.2-.8c-1.6.1-3.1.9-4 2.4-1.7 2.9-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2-.1 1.6-.8 3.1-.8s1.8.8 3.2.7c1.3 0 2.1-1.2 2.9-2.4.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.5-1-2.5-3.9zM14.3 5.9c.6-.8 1.1-1.9.9-3-1 .1-2.2.7-2.9 1.5-.6.7-1.2 1.8-.9 2.9 1.1.1 2.2-.5 2.9-1.4z"/></svg>
              iOS
            </h3>
            <div class="data-card-stats">
              <div>
                <p>Success</p>
                <strong translate="no">{formatRate(ios.success_rate)}</strong>
                <small>{formatDuration(ios.avg_process_seconds)} avg process</small>
              </div>
              <div>
                <p>Failure</p>
                <strong data-tone="poor" translate="no">{formatRate(failureRate(ios.success_rate))}</strong>
                <small>{ios.top_failure ? getBuilderFailureInfo(ios.top_failure.reason).label : 'No leading failure'}</small>
              </div>
            </div>
            <div class="data-spark" role="img" aria-label="iOS daily success">
              {metrics.daily_platforms.map((row) => (
                <i data-tone={sparkTone(row.ios)} title={`${row.date}: ${formatRate(row.ios)}`}></i>
              ))}
            </div>
          </article>
          <article class="data-card">
            <h3>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.6 9.5h.1c.8 0 1.4.6 1.4 1.4v6.4c0 .8-.6 1.4-1.4 1.4h-.1v2.2c0 .8-.6 1.4-1.4 1.4s-1.4-.6-1.4-1.4v-2.2H10.2v2.2c0 .8-.6 1.4-1.4 1.4s-1.4-.6-1.4-1.4v-2.2h-.1c-.8 0-1.4-.6-1.4-1.4v-6.4c0-.8.6-1.4 1.4-1.4h10.3zM7.4 4.8l.8 1.4c1.1-.6 2.4-.9 3.8-.9s2.7.3 3.8.9l.8-1.4c.2-.4.7-.5 1.1-.3.4.2.5.7.3 1.1l-.7 1.3C18.6 8 19.5 9.6 19.5 11.4H4.5c0-1.8.9-3.4 2.3-4.5l-.7-1.3c-.2-.4-.1-.9.3-1.1.4-.2.9-.1 1.1.3zM9 12.2a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm6 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/></svg>
              Android
            </h3>
            <div class="data-card-stats">
              <div>
                <p>Success</p>
                <strong translate="no">{formatRate(android.success_rate)}</strong>
                <small>{formatDuration(android.avg_process_seconds)} avg process</small>
              </div>
              <div>
                <p>Failure</p>
                <strong data-tone="poor" translate="no">{formatRate(failureRate(android.success_rate))}</strong>
                <small>{android.top_failure ? getBuilderFailureInfo(android.top_failure.reason).label : 'No leading failure'}</small>
              </div>
            </div>
            <div class="data-spark" role="img" aria-label="Android daily success">
              {metrics.daily_platforms.map((row) => (
                <i data-tone={sparkTone(row.android)} title={`${row.date}: ${formatRate(row.android)}`}></i>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="data-section data-section-muted" aria-labelledby="trend-title">
      <div class="data-shell">
        <div class="data-heading">
          <div>
            <p class="data-eyebrow">Trend</p>
            <h2 id="trend-title">Builder success over time</h2>
          </div>
          <p>Daily iOS and Android rates, plus average processing time. 7D and 30D read from the same 30-day window — this chart is not a live feed.</p>
        </div>
        <div class="data-trend" data-trend>
          <div class="data-trend-head">
            <p data-trend-label>Build success</p>
            <div class="data-trend-controls">
              <div class="data-periods" role="tablist" aria-label="Trend metric">
                <button type="button" data-metric="rate" aria-selected="true">Success</button>
                <button type="button" data-metric="duration">Process</button>
              </div>
              <div class="data-periods" role="tablist" aria-label="Trend window">
                <button type="button" data-period="7">7D</button>
                <button type="button" data-period="30" aria-selected="true">30D</button>
              </div>
            </div>
          </div>
          <div class="data-chart-skeleton" hidden={chartRows.length > 0}>
            <div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div>
          </div>
          <div translate="no">
            <svg class="data-trend-svg" data-trend-svg viewBox="0 0 800 260" role="img" aria-label="iOS and Android build success">
              <line x1="44" y1="16" x2="784" y2="16"></line>
              <line x1="44" y1="124" x2="784" y2="124"></line>
              <line x1="44" y1="232" x2="784" y2="232"></line>
              <text data-trend-max x="0" y="20">{formatRate(chartRange.max)}</text>
              <text data-trend-mid x="0" y="128">{formatRate(chartMid)}</text>
              <text data-trend-min x="0" y="236">{formatRate(chartRange.min)}</text>
              <polyline data-trend-line="ios" points={iosChart}></polyline>
              <polyline data-trend-line="android" points={androidChart}></polyline>
              <text data-trend-start x="44" y="256">{chartRows[0]?.date ?? ''}</text>
              <text data-trend-end x="784" y="256" text-anchor="end">{chartRows.at(-1)?.date ?? ''}</text>
            </svg>
          </div>
          <div class="data-legend">
            <span data-legend="ios">iOS</span>
            <span data-legend="android">Android</span>
          </div>
        </div>
      </div>
    </section>

    <section class="data-section" aria-labelledby="failures-title">
      <div class="data-shell data-split">
        <div>
          <p class="data-eyebrow">Failures</p>
          <h2 id="failures-title">Top failure reasons</h2>
          <p class="data-copy" translate="no">{topFailureLead}</p>
          <p class="data-copy data-copy-secondary">
            Script errors come from the app repo. Timeouts, host failures, and missing runners are builder-side. Shares only — no job counts.
          </p>
          <p class="data-copy data-copy-secondary">
            Need signed binaries? See <a class="data-inline-link" href={nativeBuildHref}>Native Builds</a>.
            Live Update install rates live on <a class="data-inline-link" href={liveUpdateHref}>Live Update status</a>.
          </p>
        </div>
        <ol class="data-failures" translate="no">
          {
            metrics.failures.length
              ? metrics.failures.map((item, index) => {
                  const info = getBuilderFailureInfo(item.reason)
                  return (
                    <li>
                      <span>{String(index + 1).padStart(2, '0')}</span>
                      <div class="data-failure-copy">
                        <strong>{info.label}</strong>
                        <p>{info.explanation}</p>
                      </div>
                      <b>{Math.ceil(item.share)}%</b>
                      <i aria-hidden="true">
                        <em style={`--share: ${item.share}%`} />
                      </i>
                    </li>
                  )
                })
              : [<li class="data-empty">No failures in this window.</li>]
          }
        </ol>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { normalizeBuilderMetrics, type BuilderMetrics } from '@/lib/builderMetrics'

  function boot() {
    const page = document.querySelector<HTMLElement>('.data-page')
    const trendLabel = page?.querySelector<HTMLElement>('[data-trend-label]')
    const trendSvg = page?.querySelector<SVGElement>('[data-trend-svg]')
    const trendIos = page?.querySelector<SVGPolylineElement>('[data-trend-line="ios"]')
    const trendAndroid = page?.querySelector<SVGPolylineElement>('[data-trend-line="android"]')
    const trendStart = page?.querySelector<SVGTextElement>('[data-trend-start]')
    const trendEnd = page?.querySelector<SVGTextElement>('[data-trend-end]')
    const trendMax = page?.querySelector<SVGTextElement>('[data-trend-max]')
    const trendMid = page?.querySelector<SVGTextElement>('[data-trend-mid]')
    const trendMin = page?.querySelector<SVGTextElement>('[data-trend-min]')
    const periodButtons = [...(page?.querySelectorAll<HTMLButtonElement>('[data-period]') ?? [])]
    const metricButtons = [...(page?.querySelectorAll<HTMLButtonElement>('[data-metric]') ?? [])]
    let periodDays = 30
    let metric: 'rate' | 'duration' = 'rate'

    function formatRate(value: number | null) {
      return value === null ? '—' : `${Number(value.toFixed(1))}%`
    }

    function formatDuration(seconds: number | null) {
      if (seconds === null) return '—'
      if (seconds < 90) return `${Math.round(seconds)}s`
      return `${(seconds / 60).toFixed(1)} min`
    }

    function sliceDays<T extends { date: string }>(rows: T[], days: number) {
      return rows.slice(Math.max(0, rows.length - days))
    }

    function chartScale(values: number[], kind: 'rate' | 'duration') {
      if (!values.length) return kind === 'rate' ? { min: 0, max: 100 } : { min: 0, max: 300 }
      const min = Math.min(...values)
      const max = Math.max(...values)
      const pad = Math.max(kind === 'rate' ? 3 : 20, (max - min) * 0.25)
      if (kind === 'rate') {
        return { min: Math.max(0, Number((min - pad).toFixed(1))), max: Math.min(100, Number((max + pad).toFixed(1))) }
      }
      return { min: Math.max(0, Number((min - pad).toFixed(1))), max: Number((max + pad).toFixed(1)) }
    }

    function chartPoints(values: Array<number | null>, scale: { min: number; max: number }, width = 800, height = 260) {
      const pad = { l: 44, r: 16, t: 16, b: 28 }
      const innerW = width - pad.l - pad.r
      const innerH = height - pad.t - pad.b
      const span = Math.max(scale.max - scale.min, 1)
      return values
        .map((value, index) => {
          if (value === null) return null
          const x = pad.l + (values.length <= 1 ? innerW / 2 : (index / (values.length - 1)) * innerW)
          const y = pad.t + (1 - (value - scale.min) / span) * innerH
          return `${x.toFixed(1)},${y.toFixed(1)}`
        })
        .filter((point): point is string => point !== null)
        .join(' ')
    }

    function formatTick(value: number) {
      return metric === 'rate' ? formatRate(value) : formatDuration(value)
    }

    function renderTrend(metrics: BuilderMetrics) {
      const rows = sliceDays(metrics.daily_platforms, periodDays)
      const iosValues = rows.map((row) => (metric === 'rate' ? row.ios : row.ios_process_seconds))
      const androidValues = rows.map((row) => (metric === 'rate' ? row.android : row.android_process_seconds))
      const values = [...iosValues, ...androidValues].filter((value): value is number => value !== null)
      const scale = chartScale(values, metric === 'rate' ? 'rate' : 'duration')
      const mid = Number(((scale.min + scale.max) / 2).toFixed(1))
      if (trendLabel) trendLabel.textContent = metric === 'rate' ? 'Build success' : 'Processing time'
      if (trendSvg) trendSvg.setAttribute('aria-label', metric === 'rate' ? 'iOS and Android build success' : 'iOS and Android processing time')
      if (trendIos) trendIos.setAttribute('points', chartPoints(iosValues, scale))
      if (trendAndroid) trendAndroid.setAttribute('points', chartPoints(androidValues, scale))
      if (trendMax) trendMax.textContent = formatTick(scale.max)
      if (trendMid) trendMid.textContent = formatTick(mid)
      if (trendMin) trendMin.textContent = formatTick(scale.min)
      if (trendStart) trendStart.textContent = rows[0]?.date ?? ''
      if (trendEnd) trendEnd.textContent = rows.at(-1)?.date ?? ''
    }

    function readBootstrap(): BuilderMetrics | null {
      try {
        const raw = document.getElementById('capgo-builder-metrics-bootstrap')?.textContent?.trim()
        if (!raw) return null
        return normalizeBuilderMetrics(JSON.parse(raw))
      } catch {
        return null
      }
    }

    const metrics = readBootstrap()
    if (metrics) renderTrend(metrics)

    for (const button of periodButtons) {
      button.addEventListener('click', () => {
        const next = Number(button.dataset.period)
        if (!Number.isFinite(next)) return
        periodDays = next
        for (const item of periodButtons) item.ariaSelected = item === button ? 'true' : 'false'
        if (metrics) renderTrend(metrics)
      })
    }

    for (const button of metricButtons) {
      button.addEventListener('click', () => {
        const next = button.dataset.metric
        if (next !== 'rate' && next !== 'duration') return
        metric = next
        for (const item of metricButtons) item.ariaSelected = item === button ? 'true' : 'false'
        if (metrics) renderTrend(metrics)
      })
    }
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true })
  else boot()
</script>

<style>
  .data-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .data-page {
    --line: rgb(255 255 255 / 11%);
    --muted: #bdc9da;
    color-scheme: only dark;
    background: transparent;
    color: white;
    overflow: clip;
  }
  .data-shell {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }
  .data-hero,
  .data-section {
    padding-block: 72px;
  }
  .data-hero {
    background: transparent;
    border-bottom: 1px solid var(--line);
  }
  .data-eyebrow {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: 0 0 16px;
    color: #8ec5ff;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  h1,
  h2 {
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  h1 {
    max-width: 20ch;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
  }
  h2 {
    max-width: 32ch;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }
  .data-summary {
    max-width: 58ch;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .data-updated {
    display: flex;
    gap: 9px;
    align-items: center;
    margin: 24px 0 0;
    color: #91a2ba;
    font-size: 0.875rem;
  }
  .data-title-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
  .data-badge {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin: 0;
    padding: 6px 12px;
    border: 1px solid rgb(52 211 153 / 28%);
    border-radius: 999px;
    background: rgb(52 211 153 / 8%);
    color: #86efac;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .data-badge span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #34d399;
    box-shadow: 0 0 0 4px rgb(52 211 153 / 12%);
  }
  .data-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .data-card {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: rgb(255 255 255 / 3%);
  }
  .data-card h3 {
    display: flex;
    gap: 10px;
    align-items: center;
    margin: 0 0 20px;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .data-card h3 svg {
    width: 18px;
    height: 18px;
  }
  .data-card-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 20px;
  }
  .data-card-stats p {
    margin: 0 0 6px;
    color: #91a2ba;
    font-size: 0.8rem;
  }
  .data-card-stats strong {
    display: block;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
  }
  .data-card-stats strong[data-tone='poor'] {
    color: #f0a0a0;
  }
  .data-card-stats small {
    display: block;
    margin-top: 6px;
    color: #6f819b;
    font-size: 0.75rem;
  }
  .data-spark {
    display: flex;
    gap: 3px;
    align-items: end;
    height: 28px;
  }
  .data-spark i {
    flex: 1;
    height: 100%;
    border-radius: 2px;
    background: #34d399;
  }
  .data-spark i[data-tone='poor'] {
    background: #f87171;
  }
  .data-spark i[data-tone='empty'] {
    background: rgb(255 255 255 / 12%);
  }
  .data-trend {
    padding: 20px 20px 12px;
