---
import Layout from '@/layouts/Layout.astro'
import m from '@/copy/messages'
import 'toastify-js/src/toastify.css'
import RatingSummary from '@/components/RatingSummary.astro'
import { allTestimonials, hasRealAvatar } from '@/config/productTestimonials'

const captchaKey = import.meta.env.CLOUDFLARE_TURNSTILE_SITE_KEY
const CLOUDFLARE_TURNSTILE_SITE_KEY = captchaKey
const enableCaptcha = !!CLOUDFLARE_TURNSTILE_SITE_KEY

const title = `${Astro.locals.runtimeConfig.public.brand} | ${m.register_title({}, { locale: Astro.locals.locale })}`
const description = m.register_description
  ? m.register_description({}, { locale: Astro.locals.locale })
  : 'Create your free Capgo account and start deploying live updates to your Capacitor apps in minutes.'
const benefits = [
  m.menu_live_update_tagline({}, { locale: Astro.locals.locale }),
  m.menu_native_build_tagline({}, { locale: Astro.locals.locale }),
  m.menu_observe_tagline({}, { locale: Astro.locals.locale }),
]
const initialsOf = (name: string) =>
  name
    .replace(/@.*/, '')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase() ?? '')
    .join('')
const content = {
  title,
  description,
  keywords: 'Capgo register, sign up, create account, Capacitor live updates, OTA updates',
}
---

{enableCaptcha && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<Layout content={content}>
  <div class="hero-wash">
    <section class="relative overflow-hidden px-4 pt-10 pb-24 sm:pt-16">
      <div class="relative mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-16">
        <div class="rounded-3xl border border-white/10 bg-[#101216]/90 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
          <h1 class="text-3xl font-bold tracking-tight text-white">{m.register_title({}, { locale: Astro.locals.locale })}</h1>
          <p class="mt-2 text-sm text-slate-400">
            {m.already_have_account({}, { locale: Astro.locals.locale })}
            <a
              href="https://console.capgo.app/login/"
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-[#44BCFF] underline-offset-4 hover:text-white hover:underline"
            >
              {m.sign_in({}, { locale: Astro.locals.locale })}
            </a>
          </p>
          <p class="mt-4 flex flex-wrap gap-2 text-xs font-medium text-slate-300">
            <span class="rounded-full bg-white/[0.06] px-2.5 py-1 ring-1 ring-white/10">{m.days_free_trial({}, { locale: Astro.locals.locale })}</span>
            <span class="rounded-full bg-white/[0.06] px-2.5 py-1 ring-1 ring-white/10">{m.no_credit_card_required({}, { locale: Astro.locals.locale })}</span>
          </p>

          <form id="registerForm" class="mt-6 space-y-4">
            <div>
              <label for="email" class="block text-sm font-medium text-slate-300">
                {m.email_label({}, { locale: Astro.locals.locale })}
              </label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="mt-1.5 block w-full rounded-xl border border-white/10 bg-white/[0.04] px-3.5 py-2.5 text-[15px] text-white placeholder-slate-500 transition-colors focus:border-[#44BCFF]/60 focus:bg-white/[0.06] focus:ring-2 focus:ring-[#44BCFF]/30 focus:outline-none"
                placeholder={m.email_placeholder({}, { locale: Astro.locals.locale })}
              />
            </div>
            <div>
              <label for="password" class="block text-sm font-medium text-slate-300">
                {m.password_label({}, { locale: Astro.locals.locale })}
              </label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                required
                class="mt-1.5 block w-full rounded-xl border border-white/10 bg-white/[0.04] px-3.5 py-2.5 text-[15px] text-white placeholder-slate-500 transition-colors focus:border-[#44BCFF]/60 focus:bg-white/[0.06] focus:ring-2 focus:ring-[#44BCFF]/30 focus:outline-none"
                placeholder={m.password_placeholder({}, { locale: Astro.locals.locale })}
              />
            </div>
            {enableCaptcha && <div class="cf-turnstile" data-sitekey={CLOUDFLARE_TURNSTILE_SITE_KEY} data-size="flexible" data-theme="dark" />}
            <button
              type="submit"
              class="flex min-h-12 w-full items-center justify-center rounded-xl bg-blue-600 px-4 text-[15px] font-semibold text-white shadow-lg shadow-blue-600/20 transition-colors hover:bg-blue-500 focus-visible:ring-2 focus-visible:ring-[#44BCFF] focus-visible:ring-offset-2 focus-visible:ring-offset-[#101216] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-60"
            >
              {m.sign_up_button({}, { locale: Astro.locals.locale })}
            </button>
            <p
              class="text-center text-xs text-slate-500 [&_a]:text-slate-300 [&_a]:underline [&_a]:underline-offset-2"
              set:html={m.register_tos_notice({}, { locale: Astro.locals.locale })}
            />
          </form>

          <div class="mt-6 flex items-center gap-3 text-xs text-slate-500">
            <span class="h-px flex-1 bg-white/10"></span>
            {m.need_help({}, { locale: Astro.locals.locale })}
            <span class="h-px flex-1 bg-white/10"></span>
          </div>
          <a
            href="https://support.capgo.app"
            class="mt-4 flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-white/10 text-sm font-semibold text-slate-200 transition-colors hover:bg-white/5"
          >
            {m.open_support({}, { locale: Astro.locals.locale })}
          </a>
        </div>

        <div class="text-white">
          <RatingSummary />
          <ul class="mt-6 space-y-3">
            {benefits.map((benefit) => (
              <li class="flex items-center gap-3 text-base text-slate-200">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#44BCFF]/15 text-[#44BCFF] ring-1 ring-[#44BCFF]/30">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
                {benefit}
              </li>
            ))}
          </ul>

          <div class="mt-10" data-review-carousel aria-roledescription="carousel" aria-label="Customer reviews">
            <div class="grid">
              {allTestimonials.map((item, index) => (
                <figure
                  class:list={['review-slide flex flex-col rounded-3xl border border-white/10 bg-white/[0.03] p-6 [grid-area:1/1] sm:p-8', { 'is-active': index === 0 }]}
                  data-review-slide={index}
                  aria-roledescription="slide"
                  aria-label={`${index + 1} / ${allTestimonials.length}`}
                  aria-hidden={index === 0 ? undefined : 'true'}
                >
                  <div class="flex gap-0.5 text-amber-300" role="img" aria-label={`${item.rating} out of 5 stars`}>
                    {Array.from({ length: item.rating }).map(() => (
                      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" />
                      </svg>
                    ))}
                  </div>
                  <blockquote class="mt-4 flex-1 text-lg leading-8 text-pretty text-white">&ldquo;{item.quote}&rdquo;</blockquote>
                  <figcaption class="mt-6 flex items-center gap-3">
                    {hasRealAvatar(item.avatar) ? (
                      <img src={item.avatar} alt="" width="44" height="44" loading="lazy" decoding="async" class="h-11 w-11 rounded-full object-cover ring-1 ring-white/15" />
                    ) : item.logo ? (
                      <img
                        src={item.logo}
                        alt=""
                        width="44"
                        height="44"
                        loading="lazy"
                        decoding="async"
                        class="h-11 w-11 rounded-xl bg-white object-contain ring-1 ring-white/15"
                      />
                    ) : (
                      <span
                        class="flex h-11 w-11 items-center justify-center rounded-full bg-white/[0.06] text-sm font-semibold text-slate-300 ring-1 ring-white/10"
                        aria-hidden="true"
                      >
                        {initialsOf(item.name)}
                      </span>
                    )}
                    <span>
                      <cite class="block text-sm font-semibold text-white not-italic">{item.name}</cite>
                      <span class="block text-sm text-slate-400">{item.role}</span>
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
            <div class="mt-4 flex gap-1.5">
              {allTestimonials.map((item, index) => (
                <button
                  type="button"
                  data-review-dot={index}
                  aria-label={`Show review from ${item.name}`}
                  aria-current={index === 0 ? 'true' : undefined}
                  class="review-dot flex h-6 w-6 items-center justify-center rounded-full focus-visible:ring-2 focus-visible:ring-[#44BCFF] focus-visible:outline-none"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-white/25 transition-[width,background-color]" />
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .review-slide {
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease,
      visibility 0s linear 0.4s;
  }
  .review-slide.is-active {
    opacity: 1;
    visibility: inherit;
    transform: none;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
  .review-dot[aria-current='true'] span {
    width: 1.25rem;
    background-color: #44bcff;
  }
  @media (prefers-reduced-motion: reduce) {
    .review-slide {
      transition: none;
    }
  }
</style>

<script>
  // Rotate customer reviews: random start each visit, pause while hovered or focused.
  document.querySelectorAll<HTMLElement>('[data-review-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-review-slide]'))
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-review-dot]'))
    if (slides.length < 2) return
    let current = 0
    let timer = 0
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    const show = (index: number) => {
      current = (index + slides.length) % slides.length
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === current)
        if (i === current) slide.removeAttribute('aria-hidden')
        else slide.setAttribute('aria-hidden', 'true')
      })
      dots.forEach((dot, i) => {
        if (i === current) dot.setAttribute('aria-current', 'true')
        else dot.removeAttribute('aria-current')
      })
    }
    const stop = () => window.clearInterval(timer)
    const start = () => {
      stop()
      if (!reduceMotion) timer = window.setInterval(() => show(current + 1), 6000)
    }

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i)
        start()
      }),
    )
    carousel.addEventListener('pointerenter', stop)
    carousel.addEventListener('pointerleave', start)
    carousel.addEventListener('focusin', stop)
    carousel.addEventListener('focusout', start)

    show(Math.floor(Math.random() * slides.length))
    start()
  })
</script>

<script>
  import '@/scripts/register'
</script>
