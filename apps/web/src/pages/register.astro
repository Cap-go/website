---
import Layout from '@/layouts/Layout.astro'
import m from '@/copy/messages'
import { getRelativeLocaleUrl } from '@/services/links'
import 'toastify-js/src/toastify.css'
import { capgoReviews, hasRealAvatar } from '@/config/productTestimonials'
import { customerApps } from '@/config/customerApps'
import PayAsYouGoCopy from '@/components/pricing/PayAsYouGoCopy.astro'

// Static pages read the CI secret at build time; import.meta.env only exposes .env-file values here.
const CLOUDFLARE_TURNSTILE_SITE_KEY = import.meta.env.CLOUDFLARE_TURNSTILE_SITE_KEY || process.env.CLOUDFLARE_TURNSTILE_SITE_KEY
const enableCaptcha = !!CLOUDFLARE_TURNSTILE_SITE_KEY

const title = `${Astro.locals.runtimeConfig.public.brand} | ${m.register_title({}, { locale: Astro.locals.locale })}`
const description = m.register_description
  ? m.register_description({}, { locale: Astro.locals.locale })
  : 'Create your free Capgo account and start deploying live updates to your Capacitor apps in minutes.'
// The right column answers "what do I get, how much work is it, who else uses it" next to the form.
const nextSteps = [
  { title: m.register_step_account_title({}, { locale: Astro.locals.locale }), body: m.register_step_account_body({}, { locale: Astro.locals.locale }) },
  {
    title: m.register_step_init_title({}, { locale: Astro.locals.locale }),
    body: m.register_step_init_body({}, { locale: Astro.locals.locale }),
    command: 'npx @capgo/cli@latest init',
  },
  { title: m.register_step_ship_title({}, { locale: Astro.locals.locale }), body: m.register_step_ship_body({}, { locale: Astro.locals.locale }) },
]
const trustedBy = m.register_trusted_by(
  {
    teams: m.companies_logo_stat_companies_value({}, { locale: Astro.locals.locale }),
    devices: m.companies_logo_stat_devices_value({}, { locale: Astro.locals.locale }),
  },
  { locale: Astro.locals.locale },
)
const featuredApps = customerApps.slice(0, 6)
// One review: Sergiu's quote is the most concrete ("days to minutes") and has a real portrait.
const featuredReview = capgoReviews[0]
const passwordRules = [
  { key: 'length', label: m.password_rule_length({}, { locale: Astro.locals.locale }) },
  { key: 'lowercase', label: m.password_rule_lowercase({}, { locale: Astro.locals.locale }) },
  { key: 'uppercase', label: m.password_rule_uppercase({}, { locale: Astro.locals.locale }) },
  { key: 'number', label: m.password_rule_number({}, { locale: Astro.locals.locale }) },
  { key: 'special', label: m.password_rule_special({}, { locale: Astro.locals.locale }) },
]
const initialsOf = (name: string) =>
  name
    .replace(/@.*/, '')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]?.toUpperCase() ?? '')
    .join('')
const pricingUrl = getRelativeLocaleUrl(Astro.locals.locale, 'pricing')
const registerCanonical = new URL(getRelativeLocaleUrl(Astro.locals.locale, 'register'), Astro.site ?? Astro.url.origin).toString()
const content = {
  title,
  description,
  keywords: 'Capgo register, sign up, create account, Capacitor live updates, OTA updates',
  canonical: registerCanonical,
}
---

{enableCaptcha && <script is:inline>
  // Defined before api.js loads: Turnstile resolves these callback names when it renders the widget.
  ;['Success', 'Error', 'Expired', 'Timeout'].forEach(function (kind) {
    window['capgoTurnstile' + kind] = function (detail) {
      document.dispatchEvent(new CustomEvent('capgo-turnstile', { detail: { kind: kind.toLowerCase(), code: detail } }))
      return kind === 'Error'
    }
  })
</script>}
{enableCaptcha && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<Layout content={content}>
  <div class="hero-wash">
    <section class="relative overflow-hidden px-4 pt-10 pb-24 sm:pt-16">
      <div class="relative mx-auto grid max-w-6xl items-start gap-10 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-16">
        <div class="rounded-3xl border border-white/10 bg-[#101216]/90 p-6 shadow-2xl shadow-black/40 backdrop-blur-xl sm:p-8">
          <h1 class="text-3xl font-bold tracking-tight text-white">{m.register_title({}, { locale: Astro.locals.locale })}</h1>
          <!-- One value line instead of badges. Paid-ads visitors (offer=direct) pay first, backed by a money-back guarantee. -->
          <p class="mt-2 text-[15px] text-slate-300">
            <span data-trial-copy>
              <span class="whitespace-nowrap">{m.days_free_trial({}, { locale: Astro.locals.locale })}</span>
              <span class="text-slate-500" aria-hidden="true">
                {' · '}
              </span>
              <span class="whitespace-nowrap">{m.no_credit_card_required({}, { locale: Astro.locals.locale })}</span>
            </span>
            <span data-direct-copy>
              <span class="whitespace-nowrap">{m.direct_offer_guarantee({}, { locale: Astro.locals.locale })}</span>
              <span class="text-slate-500" aria-hidden="true">
                {' · '}
              </span>
              <span class="whitespace-nowrap">{m.direct_offer_cancel_anytime({}, { locale: Astro.locals.locale })}</span>
            </span>
          </p>

          <form
            id="registerForm"
            class="mt-7 space-y-4"
            data-captcha-required={m.register_captcha_required({}, { locale: Astro.locals.locale })}
            data-network-error={m.register_network_error({}, { locale: Astro.locals.locale })}
          >
            <div>
              <label for="email" class="block text-sm font-medium text-slate-300">
                {m.email_label({}, { locale: Astro.locals.locale })}
              </label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="mt-1.5 block w-full rounded-xl border border-white/10 bg-white/[0.04] px-3.5 py-2.5 text-[15px] text-white placeholder-slate-500 transition-colors focus:border-[#44BCFF]/60 focus:bg-white/[0.06] focus:ring-2 focus:ring-[#44BCFF]/30 focus:outline-none"
                placeholder={m.email_placeholder({}, { locale: Astro.locals.locale })}
              />
            </div>
            <div>
              <label for="password" class="block text-sm font-medium text-slate-300">
                {m.password_label({}, { locale: Astro.locals.locale })}
              </label>
              <div class="relative mt-1.5">
                <input
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="new-password"
                  passwordrules="minlength: 6; required: lower; required: upper; required: digit; required: [-!@#$%^&*_+=?];"
                  aria-describedby="password-requirements"
                  required
                  class="block w-full rounded-xl border border-white/10 bg-white/[0.04] py-2.5 pr-12 pl-3.5 text-[15px] text-white placeholder-slate-500 transition-colors focus:border-[#44BCFF]/60 focus:bg-white/[0.06] focus:ring-2 focus:ring-[#44BCFF]/30 focus:outline-none"
                  placeholder={m.password_placeholder({}, { locale: Astro.locals.locale })}
                />
                <button
                  type="button"
                  id="password-toggle"
                  aria-controls="password"
                  aria-pressed="false"
                  aria-label={m.password_show({}, { locale: Astro.locals.locale })}
                  data-label-show={m.password_show({}, { locale: Astro.locals.locale })}
                  data-label-hide={m.password_hide({}, { locale: Astro.locals.locale })}
                  class="absolute inset-y-0 right-0 flex w-11 items-center justify-center rounded-r-xl text-slate-400 transition-colors hover:text-white focus-visible:ring-2 focus-visible:ring-[#44BCFF] focus-visible:outline-none"
                >
                  <svg data-eye-open class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M2.04 12.32a1 1 0 0 1 0-.64C3.42 7.51 7.36 4.5 12 4.5c4.64 0 8.57 3 9.96 7.18a1 1 0 0 1 0 .64C20.58 16.49 16.64 19.5 12 19.5c-4.64 0-8.57-3-9.96-7.18Z"
                    />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  </svg>
                  <svg data-eye-closed class="hidden h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3.98 8.22A10.48 10.48 0 0 0 2.04 12c1.38 4.18 5.32 7.5 9.96 7.5 1.99 0 3.86-.55 5.45-1.52M6.23 6.23A10.45 10.45 0 0 1 12 4.5c4.64 0 8.57 3 9.96 7.18a10.5 10.5 0 0 1-4.19 5.55M6.23 6.23 3 3m3.23 3.23 3.65 3.65m7.89 7.89L21 21m-3.23-3.23-3.65-3.65m0 0a3 3 0 1 0-4.24-4.24m4.24 4.24L9.88 9.88"
                    />
                  </svg>
                </button>
              </div>
              <ul id="password-requirements" hidden aria-live="polite" class="mt-2 grid grid-cols-1 gap-x-3 gap-y-1 text-xs text-slate-400 sm:grid-cols-2">
                {passwordRules.map((rule) => (
                  <li data-password-rule={rule.key} class="password-rule flex items-center gap-1.5">
                    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path
                        data-rule-check
                        fill-rule="evenodd"
                        d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                        clip-rule="evenodd"
                      />
                      <circle data-rule-dot cx="10" cy="10" r="3" />
                    </svg>
                    <span>{rule.label}</span>
                  </li>
                ))}
              </ul>
            </div>
            {enableCaptcha && (
              <div>
                <div
                  class="cf-turnstile"
                  data-sitekey={CLOUDFLARE_TURNSTILE_SITE_KEY}
                  data-size="flexible"
                  data-theme="dark"
                  data-appearance="interaction-only"
                  data-callback="capgoTurnstileSuccess"
                  data-error-callback="capgoTurnstileError"
                  data-expired-callback="capgoTurnstileExpired"
                  data-timeout-callback="capgoTurnstileTimeout"
                />
                <p
                  id="captcha-status"
                  class="mt-2 hidden text-xs text-amber-300"
                  aria-live="polite"
                  data-retrying={m.register_captcha_retrying({}, { locale: Astro.locals.locale })}
                  data-blocked={m.register_captcha_blocked({}, { locale: Astro.locals.locale })}
                />
              </div>
            )}
            <div id="email-exists-alert" role="alert" hidden class="rounded-xl border border-amber-400/30 bg-amber-400/10 px-3.5 py-3 text-sm text-amber-100">
              {m.register_email_exists({}, { locale: Astro.locals.locale })}{' '}
              <a href="https://console.capgo.app/login/" class="font-semibold text-white underline underline-offset-2">
                {m.register_email_exists_sign_in({}, { locale: Astro.locals.locale })}
              </a>
              {' · '}
              <a href="https://console.capgo.app/forgot_password/" class="font-semibold text-white underline underline-offset-2">
                {m.register_email_exists_reset({}, { locale: Astro.locals.locale })}
              </a>
            </div>
            <button
              type="submit"
              class="flex min-h-12 w-full items-center justify-center rounded-xl bg-blue-600 px-4 text-[15px] font-semibold text-white shadow-lg shadow-blue-600/20 transition-colors hover:bg-blue-500 focus-visible:ring-2 focus-visible:ring-[#44BCFF] focus-visible:ring-offset-2 focus-visible:ring-offset-[#101216] focus-visible:outline-none disabled:cursor-not-allowed disabled:opacity-60"
            >
              {m.sign_up_button({}, { locale: Astro.locals.locale })}
            </button>
            <div class="space-y-1 text-center text-xs leading-5 text-slate-500">
              <p class="text-sm leading-6 text-slate-400">
                <PayAsYouGoCopy />{' '}
                <a href={pricingUrl} target="_blank" rel="noopener" class="text-slate-300 underline underline-offset-2 hover:text-white">
                  {m.register_pricing_link({}, { locale: Astro.locals.locale })}
                </a>
              </p>
              <p class="[&_a]:text-slate-300 [&_a]:underline [&_a]:underline-offset-2" set:html={m.register_tos_notice({}, { locale: Astro.locals.locale })} />
            </div>
          </form>

          <div class="mt-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-white/10 pt-5 text-sm text-slate-400">
            <p>
              {m.already_have_account({}, { locale: Astro.locals.locale })}{' '}
              <a href="https://console.capgo.app/login/" class="font-semibold text-[#44BCFF] underline-offset-4 hover:text-white hover:underline">
                {m.sign_in({}, { locale: Astro.locals.locale })}
              </a>
            </p>
            <a href="https://support.capgo.app" class="text-slate-400 underline-offset-4 hover:text-white hover:underline">
              {m.register_contact_support({}, { locale: Astro.locals.locale })}
            </a>
          </div>
        </div>

        <div class="text-white lg:pt-4">
          <h2 class="text-2xl font-bold tracking-tight text-balance text-white sm:text-3xl">{m.register_next_title({}, { locale: Astro.locals.locale })}</h2>
          <ol class="mt-6 space-y-6">
            {nextSteps.map((step, index) => (
              <li class="flex gap-4">
                <span
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#44BCFF]/15 text-sm font-bold text-[#44BCFF] ring-1 ring-[#44BCFF]/30"
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <div class="min-w-0">
                  <h3 class="text-base font-semibold text-white">{step.title}</h3>
                  <p class="mt-1 text-sm leading-6 text-slate-400">{step.body}</p>
                  {step.command && (
                    <code class="mt-2 inline-block max-w-full overflow-x-auto rounded-lg border border-white/10 bg-black/40 px-3 py-1.5 font-mono text-[13px] whitespace-nowrap text-slate-200">
                      <span class="text-slate-500 select-none" aria-hidden="true">
                        $&nbsp;
                      </span>
                      {step.command}
                    </code>
                  )}
                </div>
              </li>
            ))}
          </ol>

          <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-3">
            <ul class="flex gap-1.5" role="list" aria-label={trustedBy}>
              {featuredApps.map((app) => (
                <li>
                  <img
                    src={app.icon}
                    alt={app.name}
                    title={app.name}
                    width="32"
                    height="32"
                    loading="lazy"
                    decoding="async"
                    class="h-8 w-8 rounded-lg object-cover ring-1 ring-white/10"
                  />
                </li>
              ))}
            </ul>
            <p class="text-sm text-slate-400">{trustedBy}</p>
          </div>

          <figure class="mt-8 border-l-2 border-[#44BCFF]/40 pl-5">
            <div class="flex gap-0.5 text-amber-300" role="img" aria-label={m.rating_summary_aria({ rating: featuredReview.rating.toFixed(1) }, { locale: Astro.locals.locale })}>
              {Array.from({ length: featuredReview.rating }).map(() => (
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" />
                </svg>
              ))}
            </div>
            <blockquote class="mt-3 text-base leading-7 text-pretty text-slate-200">&ldquo;{featuredReview.quote}&rdquo;</blockquote>
            <figcaption class="mt-4 flex items-center gap-3">
              {hasRealAvatar(featuredReview.avatar) ? (
                <img src={featuredReview.avatar} alt="" width="36" height="36" loading="lazy" decoding="async" class="h-9 w-9 rounded-full object-cover ring-1 ring-white/15" />
              ) : (
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.06] text-xs font-semibold text-slate-300 ring-1 ring-white/10" aria-hidden="true">
                  {initialsOf(featuredReview.name)}
                </span>
              )}
              <span class="min-w-0">
                <cite class="block text-sm font-semibold text-white not-italic">{featuredReview.name}</cite>
                <span class="block text-xs text-slate-400">{featuredReview.role}</span>
              </span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .password-rule [data-rule-check] {
    display: none;
  }
  .password-rule.is-met {
    color: #6ee7b7;
  }
  .password-rule.is-met [data-rule-check] {
    display: inline;
  }
  .password-rule.is-met [data-rule-dot] {
    display: none;
  }
</style>

<script>
  import '@/scripts/register'
  import { initCurrency } from '@/scripts/currency'

  // Show the starting price in the visitor's currency; it stays in USD if the prices endpoint is unavailable.
  initCurrency()
</script>
