---
import ConversionLandingLayout from '@/components/conversion/ConversionLandingLayout.astro'
import { getRelativeLocaleUrl } from '@/services/links'
import m from '@/copy/messages'
import { createServiceLdJson, createLdJsonGraph } from '@/lib/ldJson'

const locale = Astro.locals.locale
const title = m.review_appflow_title({}, { locale })
const description = m.review_appflow_meta_description({}, { locale })

const serviceLdJson = createServiceLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description,
  url: Astro.url.href,
  serviceType: 'Software Development Service',
  areaServed: ['Worldwide'],
})

const ldJSON = createLdJsonGraph(Astro.locals.runtimeConfig.public, serviceLdJson, {
  includeOrganization: true,
})

const content = { title, description, ldJSON, image: `${Astro.locals.runtimeConfig.public.baseUrl}/capgo_social.png` }

const relatedLinks = [
  { label: m.capflow_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'alternatives/ionic-appflow') },
  { label: m.migrate_from_appflow_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'migrate/from-appflow') },
  { label: m.best_appflow_alternative_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'best/appflow-alternative') },
  { label: 'Upgrade guide (docs)', href: getRelativeLocaleUrl(locale, 'docs/upgrade/from-appflow-to-capgo') },
  { label: 'Alternative to Appflow (blog)', href: getRelativeLocaleUrl(locale, 'blog/alternative-to-appflow') },
]
---

<ConversionLandingLayout
  locale={locale}
  content={content}
  heroTitle={m.review_appflow_hero_title({}, { locale })}
  heroSubtitle={m.review_appflow_hero_subtitle({}, { locale })}
  sections={[
    { title: m.review_appflow_what_title({}, { locale }), paragraphs: [m.review_appflow_what_p1({}, { locale })] },
    { title: m.review_appflow_change_title({}, { locale }), paragraphs: [m.review_appflow_change_p1({}, { locale })] },
    { title: m.review_appflow_capgo_title({}, { locale }), paragraphs: [m.review_appflow_capgo_p1({}, { locale })] },
  ]}
  relatedLinks={relatedLinks}
/>
