---
import ConversionLandingLayout from '@/components/conversion/ConversionLandingLayout.astro'
import { getRelativeLocaleUrl } from '@/services/links'
import m from '@/copy/messages'
import { createServiceLdJson, createLdJsonGraph } from '@/lib/ldJson'

const locale = Astro.locals.locale
const title = m.review_codepush_title({}, { locale })
const description = m.review_codepush_meta_description({}, { locale })

const serviceLdJson = createServiceLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description,
  url: Astro.url.href,
  serviceType: 'Software Development Service',
  areaServed: ['Worldwide'],
})

const ldJSON = createLdJsonGraph(Astro.locals.runtimeConfig.public, serviceLdJson, {
  includeOrganization: true,
})

const content = { title, description, ldJSON, image: `${Astro.locals.runtimeConfig.public.baseUrl}/capgo_social.png` }

const relatedLinks = [
  { label: m.codepush_alt_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'alternatives/codepush') },
  { label: m.migrate_from_codepush_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'migrate/from-codepush') },
  { label: m.best_codepush_alternative_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'best/codepush-alternative') },
  { label: 'Moving from App Center (blog)', href: getRelativeLocaleUrl(locale, 'blog/moving-from-microsoft-app-center-to-capgo') },
]
---

<ConversionLandingLayout
  locale={locale}
  content={content}
  heroTitle={m.review_codepush_hero_title({}, { locale })}
  heroSubtitle={m.review_codepush_hero_subtitle({}, { locale })}
  sections={[
    { title: m.review_codepush_what_title({}, { locale }), paragraphs: [m.review_codepush_what_p1({}, { locale })] },
    { title: m.review_codepush_change_title({}, { locale }), paragraphs: [m.review_codepush_change_p1({}, { locale })] },
    { title: m.review_codepush_capgo_title({}, { locale }), paragraphs: [m.review_codepush_capgo_p1({}, { locale })] },
  ]}
  relatedLinks={relatedLinks}
/>
