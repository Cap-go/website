---
import m from '@/copy/messages'
import DataPageCta from '@/components/DataPageCta.astro'
import ProductTestimonials from '@/components/ProductTestimonials.astro'
import { productTestimonials } from '@/config/productTestimonials'
import Layout from '@/layouts/Layout.astro'
import { getBuilderFailureInfo } from '@/lib/builderFailureReasons'
import { emptyBuilderMetrics } from '@/lib/builderMetrics'
import { BUILDER_METRICS_PATH } from '@/lib/publicBuilderMetrics'
import { createLdJsonGraph, createWebPageLdJson } from '@/lib/ldJson'
import { formatTrendTooltip, selectTrendRows, TREND_RANGE_OPTIONS } from '@/lib/metricsTrendChart'

// The toolchain shares are daily only: no hourly 1D window.
const SHARE_RANGE_OPTIONS = TREND_RANGE_OPTIONS.filter((option) => option.key !== '1d')
const SHARE_CHARTS = [
  { key: 'xcode', title: 'Xcode version per day' },
  { key: 'dependency', title: 'CocoaPods vs SPM per day' },
] as const
import { getRelativeLocaleUrl } from '@/services/links'

const config = Astro.locals.runtimeConfig
const metrics = emptyBuilderMetrics()
const title = 'Capgo Native Build data | Builder trends'
const description = 'Global native iOS and Android build success, processing time, and failure mix for the last 30 days. Rates and minutes only, not queue counts and not realtime.'
const content = {
  title,
  description,
  image: `${config.public.baseUrl}/landing-demos/builder-status.webp`,
  ldJSON: createLdJsonGraph(config.public, createWebPageLdJson(config.public, { name: title, description, url: Astro.url.href }), { includeOrganization: true }),
}

const pending = !metrics.updated_at
const updatedLabel = pending
  ? 'Loading latest rates…'
  : (() => {
      const timestamp = new Date(metrics.updated_at)
      return Number.isNaN(timestamp.getTime())
        ? 'Updated moments ago'
        : `Updated ${new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(timestamp)} UTC`
    })()

const topFailure = metrics.failures[0]
const topFailureInfo = topFailure ? getBuilderFailureInfo(topFailure.reason) : null
const topFailureLead = pending
  ? 'Loading failure mix…'
  : topFailureInfo
    ? `${topFailureInfo.label} accounts for ${Math.ceil(topFailure.share)}% of failed jobs in this window.`
    : 'Normalized categories across all apps.'

function formatRate(value: number | null) {
  if (pending || value === null) return '—'
  return `${Number(value.toFixed(1))}%`
}

function failureRate(success: number | null) {
  return success === null ? null : Number((100 - success).toFixed(1))
}

function formatDuration(seconds: number | null) {
  if (pending || seconds === null) return '—'
  if (seconds < 90) return `${Math.round(seconds)}s`
  return `${(seconds / 60).toFixed(1)} min`
}

function platformOf(key: 'ios' | 'android') {
  return (
    metrics.platforms.find((item) => item.key === key) ?? {
      key,
      share: 0,
      success_rate: null,
      avg_process_seconds: null,
      avg_queue_seconds: null,
      top_failure: null,
    }
  )
}

function sliceDays<T extends { date: string }>(rows: T[], days: number) {
  return rows.slice(Math.max(0, rows.length - days))
}

function chartScale(values: number[], kind: 'rate' | 'duration') {
  if (!values.length) return kind === 'rate' ? { min: 0, max: 100 } : { min: 0, max: 300 }
  const min = Math.min(...values)
  const max = Math.max(...values)
  const pad = Math.max(kind === 'rate' ? 3 : 20, (max - min) * 0.25)
  if (kind === 'rate') {
    return { min: Math.max(0, Number((min - pad).toFixed(1))), max: Math.min(100, Number((max + pad).toFixed(1))) }
  }
  return { min: Math.max(0, Number((min - pad).toFixed(1))), max: Number((max + pad).toFixed(1)) }
}

function chartPoints(values: Array<number | null>, scale: { min: number; max: number }, width = 800, height = 260) {
  const pad = { l: 44, r: 16, t: 16, b: 28 }
  const innerW = width - pad.l - pad.r
  const innerH = height - pad.t - pad.b
  const span = Math.max(scale.max - scale.min, 1)
  return values
    .map((value, index) => {
      if (value === null) return null
      const x = pad.l + (values.length <= 1 ? innerW / 2 : (index / (values.length - 1)) * innerW)
      const y = pad.t + (1 - (value - scale.min) / span) * innerH
      return `${x.toFixed(1)},${y.toFixed(1)}`
    })
    .filter((point): point is string => point !== null)
    .join(' ')
}

const ios = platformOf('ios')
const android = platformOf('android')
const chartRows = selectTrendRows(metrics, '1m')
const rateValues = chartRows.flatMap((row) => [row.ios, row.android]).filter((value): value is number => value !== null)
const chartRange = chartScale(rateValues, 'rate')
const iosChart = chartPoints(
  chartRows.map((row) => row.ios),
  chartRange,
)
const androidChart = chartPoints(
  chartRows.map((row) => row.android),
  chartRange,
)
const chartMid = Number(((chartRange.min + chartRange.max) / 2).toFixed(1))

function trendTip(date: string, ios: number | null, android: number | null) {
  return formatTrendTooltip(date, ios, android, formatRate)
}

const liveUpdateHref = getRelativeLocaleUrl(Astro.locals.locale, 'data')
const nativeBuildHref = getRelativeLocaleUrl(Astro.locals.locale, 'native-build')
---

<Layout content={content}>
  <main class="data-page" data-metrics-endpoint={BUILDER_METRICS_PATH} aria-busy="true">
    <section class="data-hero">
      <div class="data-shell">
        <div class="data-title-row">
          <h1>Native Builds</h1>
          <p class="data-badge" data-status-badge data-tone={pending ? 'loading' : 'operational'}><span aria-hidden="true"></span> {pending ? 'Loading' : 'Operational'}</p>
        </div>
        <p class="data-summary">Global iOS and Android builder success for the last 30 days. Each rate is finished jobs only, not a live queue, and not a build count.</p>
        <p class="data-crosslink">Shipping over-the-air updates? See <a class="data-inline-link" href={liveUpdateHref}>Live Update delivery data</a>.</p>
        <p class="data-updated" data-updated aria-live="polite" translate="no">{updatedLabel}</p>
        <p class="data-sr-only" data-kpi-status aria-live="polite"></p>
        <div class="data-kpis" aria-label="Global builder reliability">
          <div><p>Success</p><strong data-kpi="success-rate" translate="no">{formatRate(metrics.success_rate)}</strong></div>
          <div><p>Process</p><strong data-kpi="process" translate="no">{formatDuration(metrics.avg_process_seconds)}</strong></div>
          <div><p>Queue</p><strong data-kpi="queue" translate="no">{formatDuration(metrics.avg_queue_seconds)}</strong></div>
          <div><p>Window</p><strong>30 days</strong></div>
        </div>
      </div>
    </section>

    <section class="data-section" aria-labelledby="platforms-title">
      <div class="data-shell">
        <div class="data-heading">
          <div>
            <p class="data-eyebrow">Platforms</p>
            <h2 id="platforms-title">iOS and Android</h2>
          </div>
          <p>Success and failure over the last 30 days. The sparkline is one tick per UTC day, green at 70% or better.</p>
        </div>
        <div class="data-cards">
          <article class="data-card" data-platform-card="ios">
            <h3>
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M16.4 12.7c0-2.4 2-3.4 2.1-3.5-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9s-1.9-.9-3.2-.8c-1.6.1-3.1.9-4 2.4-1.7 2.9-.4 7.3 1.2 9.7.8 1.2 1.8 2.5 3 2.4 1.2-.1 1.6-.8 3.1-.8s1.8.8 3.2.7c1.3 0 2.1-1.2 2.9-2.4.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.5-1-2.5-3.9zM14.3 5.9c.6-.8 1.1-1.9.9-3-1 .1-2.2.7-2.9 1.5-.6.7-1.2 1.8-.9 2.9 1.1.1 2.2-.5 2.9-1.4z"
                ></path></svg
              >
              iOS
            </h3>
            <div class="data-card-stats">
              <div>
                <p>Success</p>
                <strong data-kpi="ios-success" translate="no">{formatRate(ios.success_rate)}</strong>
                <small data-process="ios">{formatDuration(ios.avg_process_seconds)} avg process</small>
              </div>
              <div>
                <p>Failure</p>
                <strong data-kpi="ios-failure" data-tone="poor" translate="no">{formatRate(failureRate(ios.success_rate))}</strong>
                <small data-top-failure="ios">{pending ? 'Loading…' : ios.top_failure ? getBuilderFailureInfo(ios.top_failure.reason).label : 'No leading failure'}</small>
              </div>
            </div>
            <div class="data-spark" data-spark="ios" role="img" aria-label="iOS daily success"></div>
          </article>
          <article class="data-card" data-platform-card="android">
            <h3>
              <svg viewBox="0 0 24 24" aria-hidden="true"
                ><path
                  fill="currentColor"
                  d="M17.6 9.5h.1c.8 0 1.4.6 1.4 1.4v6.4c0 .8-.6 1.4-1.4 1.4h-.1v2.2c0 .8-.6 1.4-1.4 1.4s-1.4-.6-1.4-1.4v-2.2H10.2v2.2c0 .8-.6 1.4-1.4 1.4s-1.4-.6-1.4-1.4v-2.2h-.1c-.8 0-1.4-.6-1.4-1.4v-6.4c0-.8.6-1.4 1.4-1.4h10.3zM7.4 4.8l.8 1.4c1.1-.6 2.4-.9 3.8-.9s2.7.3 3.8.9l.8-1.4c.2-.4.7-.5 1.1-.3.4.2.5.7.3 1.1l-.7 1.3C18.6 8 19.5 9.6 19.5 11.4H4.5c0-1.8.9-3.4 2.3-4.5l-.7-1.3c-.2-.4-.1-.9.3-1.1.4-.2.9-.1 1.1.3zM9 12.2a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm6 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"
                ></path></svg
              >
              Android
            </h3>
            <div class="data-card-stats">
              <div>
                <p>Success</p>
                <strong data-kpi="android-success" translate="no">{formatRate(android.success_rate)}</strong>
                <small data-process="android">{formatDuration(android.avg_process_seconds)} avg process</small>
              </div>
              <div>
                <p>Failure</p>
                <strong data-kpi="android-failure" data-tone="poor" translate="no">{formatRate(failureRate(android.success_rate))}</strong>
                <small data-top-failure="android"
                  >{pending ? 'Loading…' : android.top_failure ? getBuilderFailureInfo(android.top_failure.reason).label : 'No leading failure'}</small
                >
              </div>
            </div>
            <div class="data-spark" data-spark="android" role="img" aria-label="Android daily success"></div>
          </article>
        </div>
      </div>
    </section>

    <section class="data-section data-section-muted" aria-labelledby="trend-title">
      <div class="data-shell">
        <div class="data-heading">
          <div>
            <p class="data-eyebrow">Trend</p>
            <h2 id="trend-title">Builder success over time</h2>
          </div>
          <p>Hourly or daily iOS and Android rates, plus average processing time, depending on the selected window. Use 1D, 1W, 1M, or 3M to change the chart range. This chart is not a live feed.</p>
        </div>
        <p class="data-sr-only" data-trend-status aria-live="polite"></p>
        <div class="data-trend" data-trend>
          <div class="data-trend-head">
            <p data-trend-label>Build success</p>
            <div class="data-trend-controls">
              <div class="data-periods" role="tablist" aria-label="Trend metric">
                <button type="button" data-metric="rate" aria-selected="true">Success</button>
                <button type="button" data-metric="duration">Process</button>
              </div>
              <p class="data-sr-only" id="trend-window-label">Trend window</p>
              <div class="data-periods" role="group" aria-labelledby="trend-window-label">
                {
                  TREND_RANGE_OPTIONS.map((option) => (
                    <button type="button" data-trend-range={option.key} aria-pressed={option.key === '1m' ? 'true' : 'false'}>
                      {option.label}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
          <div class="data-chart-skeleton" hidden={chartRows.length > 0}>
            <div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div>
          </div>
          <div class="data-trend-plot" translate="no">
            <svg class="data-trend-svg" data-trend-svg viewBox="0 0 800 260" role="img" aria-label="iOS and Android build success">
              <line x1="44" y1="16" x2="784" y2="16"></line>
              <line x1="44" y1="124" x2="784" y2="124"></line>
              <line x1="44" y1="232" x2="784" y2="232"></line>
              <text data-trend-max x="0" y="20">{formatRate(chartRange.max)}</text>
              <text data-trend-mid x="0" y="128">{formatRate(chartMid)}</text>
              <text data-trend-min x="0" y="236">{formatRate(chartRange.min)}</text>
              <polyline data-trend-line="ios" points={iosChart}></polyline>
              <polyline data-trend-line="android" points={androidChart}></polyline>
              <g data-trend-markers="ios"></g>
              <g data-trend-markers="android"></g>
              <text data-trend-start x="44" y="256">{chartRows[0]?.date ?? ''}</text>
              <text data-trend-end x="784" y="256" text-anchor="end">{chartRows.at(-1)?.date ?? ''}</text>
            </svg>
            <div
              class="data-trend-overlay"
              data-trend-overlay
              tabindex="0"
              role="group"
              aria-label="Builder success trend values. Move pointer across the chart or use arrow keys."
              hidden={chartRows.length === 0}
            >
              <span class="data-trend-guide" data-trend-guide hidden aria-hidden="true"></span>
              <span class="data-trend-tooltip" data-trend-tooltip hidden></span>
            </div>
          </div>
          <div class="data-legend">
            <span data-legend="ios">iOS</span>
            <span data-legend="android">Android</span>
          </div>
        </div>
      </div>
    </section>

    <section class="data-section" aria-labelledby="failures-title">
      <div class="data-shell data-split">
        <div>
          <p class="data-eyebrow">Failures</p>
          <h2 id="failures-title">Top failure reasons</h2>
          <p class="data-copy" data-failures-lead translate="no">{topFailureLead}</p>
          <p class="data-copy data-copy-secondary">
            Script errors come from the app repo. Timeouts, host failures, and missing runners are builder-side. Shares only, no job counts.
          </p>
          <p class="data-copy data-copy-secondary">
            Need signed binaries? See <a class="data-inline-link" href={nativeBuildHref}>Native Builds</a>. Live Update install rates live on <a
              class="data-inline-link"
              href={liveUpdateHref}>Live Update data</a
            >.
          </p>
        </div>
        <ol class="data-failures" data-failures translate="no">
          {
            metrics.failures.length
              ? metrics.failures.map((item, index) => {
                  const info = getBuilderFailureInfo(item.reason)
                  return (
                    <li>
                      <span>{String(index + 1).padStart(2, '0')}</span>
                      <div class="data-failure-copy">
                        <strong>{info.label}</strong>
                        <p>{info.explanation}</p>
                      </div>
                      <b>{Math.ceil(item.share)}%</b>
                      <i aria-hidden="true">
                        <em style={`--share: ${item.share}%`} />
                      </i>
                    </li>
                  )
                })
              : pending
                ? [<li class="data-empty">Loading failure mix…</li>]
                : [<li class="data-empty">No failures in this window.</li>]
          }
        </ol>
      </div>
    </section>

    <section class="data-section data-section-muted" aria-labelledby="toolchain-title">
      <div class="data-shell data-split">
        <div>
          <p class="data-eyebrow">iOS toolchain</p>
          <h2 id="toolchain-title">Xcode and dependency managers</h2>
          <p class="data-copy" data-toolchain-lead translate="no">{pending ? 'Loading toolchain mix…' : 'No iOS toolchain data in this window.'}</p>
          <p class="data-copy data-copy-secondary">
            Share of iOS builds over the last 30 days. Xcode is the version that built the app. CocoaPods or Swift Package Manager is what the Capgo CLI found in the
            project; builds from older CLI versions don't report it. Shares only, no build counts.
          </p>
        </div>
        <div class="data-toolchain">
          <div>
            <h3 id="xcode-shares-title">Xcode version</h3>
            <ol class="data-failures data-shares" data-xcode-shares aria-labelledby="xcode-shares-title" translate="no">
              <li class="data-empty">{pending ? 'Loading…' : 'No data in this window.'}</li>
            </ol>
          </div>
          <div>
            <h3 id="dependency-shares-title">CocoaPods vs SPM</h3>
            <ol class="data-failures data-shares" data-dependency-shares aria-labelledby="dependency-shares-title" translate="no">
              <li class="data-empty">{pending ? 'Loading…' : 'No data in this window.'}</li>
            </ol>
          </div>
        </div>
      </div>
      <div class="data-shell data-toolchain-trends">
        {
          SHARE_CHARTS.map((chart) => (
            <div class="data-trend data-share-trend" data-share-trend={chart.key}>
              <div class="data-trend-head">
                <p id={`${chart.key}-trend-title`}>{chart.title}</p>
                <div class="data-periods" role="group" aria-label={`${chart.title} window`}>
                  {SHARE_RANGE_OPTIONS.map((option) => (
                    <button type="button" data-share-range={option.key} aria-pressed={option.key === '1m' ? 'true' : 'false'}>
                      {option.label}
                    </button>
                  ))}
                </div>
              </div>
              <p class="data-sr-only" data-share-status aria-live="polite"></p>
              <p class="data-empty" data-share-empty>{pending ? 'Loading…' : 'No data in this window.'}</p>
              <div class="data-trend-plot" data-share-plot translate="no" hidden>
                <svg class="data-trend-svg" viewBox="0 0 800 260" role="img" aria-labelledby={`${chart.key}-trend-title`}>
                  <line x1="44" y1="16" x2="784" y2="16" />
                  <line x1="44" y1="124" x2="784" y2="124" />
                  <line x1="44" y1="232" x2="784" y2="232" />
                  <text x="0" y="20">100%</text>
                  <text x="0" y="128">50%</text>
                  <text x="0" y="236">0%</text>
                  <g data-share-lines />
                  <text data-share-start x="44" y="256" />
                  <text data-share-end x="784" y="256" text-anchor="end" />
                </svg>
                <div class="data-trend-overlay" data-share-overlay tabindex="0" role="group" aria-label={`${chart.title} values. Move pointer across the chart or use arrow keys.`}>
                  <span class="data-trend-guide" data-share-guide hidden aria-hidden="true" />
                  <span class="data-trend-tooltip" data-share-tooltip hidden />
                </div>
              </div>
              <div class="data-legend" data-share-legend translate="no" />
            </div>
          ))
        }
      </div>
    </section>
    <ProductTestimonials
      variant="dark"
      eyebrow={m.proof_customers_eyebrow({}, { locale: Astro.locals.locale })}
      title={m.proof_data_title({}, { locale: Astro.locals.locale })}
      description={m.proof_data_desc({}, { locale: Astro.locals.locale })}
      testimonials={productTestimonials.nativeBuildData}
    />
    <DataPageCta
      id="builder-data-final-signup-cta"
      eyebrow="Build in the cloud"
      title="Build your iOS and Android apps without a Mac"
      description="Run native Capacitor builds on Capgo's cloud builders and ship straight to the App Store and Google Play, with the reliability tracked on this page."
    />
  </main>
</Layout>

<script>
  import { getBuilderFailureInfo } from '@/lib/builderFailureReasons'
  import { normalizeBuilderMetrics, type BuilderMetrics } from '@/lib/builderMetrics'
  import {
    formatTrendAxisLabel,
    formatTrendTooltip,
    selectTrendRows,
    sliceSparklineRows,
    TREND_RANGE_OPTIONS,
    trendHitLeftPercent,
    trendNearestIndex,
    trendRangeDays,
    trendRowUnit,
    type TrendRangeKey,
  } from '@/lib/metricsTrendChart'

  function boot() {
    const page = document.querySelector<HTMLElement>('.data-page')
    const endpoint = page?.dataset.metricsEndpoint
    const updated = page?.querySelector<HTMLElement>('[data-updated]')
    const statusBadge = page?.querySelector<HTMLElement>('[data-status-badge]')
    const kpiStatus = page?.querySelector<HTMLElement>('[data-kpi-status]')
    const successRateKpi = page?.querySelector<HTMLElement>('[data-kpi="success-rate"]')
    const processKpi = page?.querySelector<HTMLElement>('[data-kpi="process"]')
    const queueKpi = page?.querySelector<HTMLElement>('[data-kpi="queue"]')
    const iosSuccessKpi = page?.querySelector<HTMLElement>('[data-kpi="ios-success"]')
    const iosFailureKpi = page?.querySelector<HTMLElement>('[data-kpi="ios-failure"]')
    const androidSuccessKpi = page?.querySelector<HTMLElement>('[data-kpi="android-success"]')
    const androidFailureKpi = page?.querySelector<HTMLElement>('[data-kpi="android-failure"]')
    const iosProcess = page?.querySelector<HTMLElement>('[data-process="ios"]')
    const androidProcess = page?.querySelector<HTMLElement>('[data-process="android"]')
    const iosTopFailure = page?.querySelector<HTMLElement>('[data-top-failure="ios"]')
    const androidTopFailure = page?.querySelector<HTMLElement>('[data-top-failure="android"]')
    const iosSpark = page?.querySelector<HTMLElement>('[data-spark="ios"]')
    const androidSpark = page?.querySelector<HTMLElement>('[data-spark="android"]')
    const trendLabel = page?.querySelector<HTMLElement>('[data-trend-label]')
    const trendSvg = page?.querySelector<SVGElement>('[data-trend-svg]')
    const trendIos = page?.querySelector<SVGPolylineElement>('[data-trend-line="ios"]')
    const trendAndroid = page?.querySelector<SVGPolylineElement>('[data-trend-line="android"]')
    const trendIosMarkers = page?.querySelector<SVGGElement>('[data-trend-markers="ios"]')
    const trendAndroidMarkers = page?.querySelector<SVGGElement>('[data-trend-markers="android"]')
    const trendStart = page?.querySelector<SVGTextElement>('[data-trend-start]')
    const trendEnd = page?.querySelector<SVGTextElement>('[data-trend-end]')
    const trendMax = page?.querySelector<SVGTextElement>('[data-trend-max]')
    const trendMid = page?.querySelector<SVGTextElement>('[data-trend-mid]')
    const trendMin = page?.querySelector<SVGTextElement>('[data-trend-min]')
    const trendOverlay = page?.querySelector<HTMLElement>('[data-trend-overlay]')
    const trendTooltip = page?.querySelector<HTMLElement>('[data-trend-tooltip]')
    const trendGuide = page?.querySelector<HTMLElement>('[data-trend-guide]')
    const trendStatus = page?.querySelector<HTMLElement>('[data-trend-status]')
    const dailySkeleton = page?.querySelector<HTMLElement>('.data-chart-skeleton')
    const failuresLead = page?.querySelector<HTMLElement>('[data-failures-lead]')
    const failuresList = page?.querySelector<HTMLOListElement>('[data-failures]')
    const toolchainLead = page?.querySelector<HTMLElement>('[data-toolchain-lead]')
    const xcodeShares = page?.querySelector<HTMLOListElement>('[data-xcode-shares]')
    const dependencyShares = page?.querySelector<HTMLOListElement>('[data-dependency-shares]')
    function shareChart(key: 'xcode' | 'dependency') {
      const root = page?.querySelector<HTMLElement>(`[data-share-trend="${key}"]`)
      const overlay = root?.querySelector<HTMLElement>('[data-share-overlay]')
      return {
        root,
        status: root?.querySelector<HTMLElement>('[data-share-status]'),
        defaultLabel: overlay?.getAttribute('aria-label') ?? '',
        plot: root?.querySelector<HTMLElement>('[data-share-plot]'),
        empty: root?.querySelector<HTMLElement>('[data-share-empty]'),
        lines: root?.querySelector<SVGGElement>('[data-share-lines]'),
        start: root?.querySelector<SVGTextElement>('[data-share-start]'),
        end: root?.querySelector<SVGTextElement>('[data-share-end]'),
        overlay,
        guide: root?.querySelector<HTMLElement>('[data-share-guide]'),
        tooltip: root?.querySelector<HTMLElement>('[data-share-tooltip]'),
        legend: root?.querySelector<HTMLElement>('[data-share-legend]'),
        ranges: [...(root?.querySelectorAll<HTMLButtonElement>('[data-share-range]') ?? [])],
        range: '1m' as TrendRangeKey,
        rows: [] as ShareDay[],
        focus: -1,
      }
    }
    type ShareDay = { date: string; values: Record<string, number> | null }
    const shareCharts = { xcode: shareChart('xcode'), dependency: shareChart('dependency') }
    const trendRangeButtons = [...(page?.querySelectorAll<HTMLButtonElement>('[data-trend-range]') ?? [])]
    const metricButtons = [...(page?.querySelectorAll<HTMLButtonElement>('[data-metric]') ?? [])]
    const styleScopeAttributes = [...(page?.attributes ?? [])].map((attribute) => attribute.name).filter((name) => name.startsWith('data-astro-cid-'))
    let trendRange: TrendRangeKey = '1m'
    let metric: 'rate' | 'duration' = 'rate'
    let latestMetrics: BuilderMetrics | null = null

    function createScopedElement<K extends keyof HTMLElementTagNameMap>(tag: K) {
      const element = document.createElement(tag)
      for (const attribute of styleScopeAttributes) element.setAttribute(attribute, '')
      return element
    }

    function formatRate(value: number | null) {
      return value === null ? '—' : `${Number(value.toFixed(1))}%`
    }

    function formatDuration(seconds: number | null) {
      if (seconds === null) return '—'
      if (seconds < 90) return `${Math.round(seconds)}s`
      return `${(seconds / 60).toFixed(1)} min`
    }

    function failureRate(success: number | null) {
      return success === null ? null : Number((100 - success).toFixed(1))
    }

    function sparkTone(rate: number | null) {
      if (rate === null) return 'empty'
      return rate >= 70 ? 'good' : 'poor'
    }

    function sparkTip(date: string, rate: number | null) {
      return `${date}: ${formatRate(rate)}`
    }

    function trendTip(date: string, ios: number | null, android: number | null) {
      return formatTrendTooltip(date, ios, android, metric === 'rate' ? formatRate : formatDuration)
    }

    let trendRows: BuilderMetrics['daily_platforms'] = []
    let trendFocusIndex = -1
    const trendOverlayLabel = 'Builder success trend values. Move pointer across the chart or use arrow keys.'

    function clampTrendTooltip(leftPercent: number) {
      return Math.max(8, Math.min(92, leftPercent))
    }

    function trendStatusAnnounce(rows: BuilderMetrics['daily_platforms']) {
      const metricLabel = metric === 'rate' ? 'Build success' : 'Processing time'
      const rangeLabel = TREND_RANGE_OPTIONS.find((option) => option.key === trendRange)?.label ?? trendRange
      if (!rows.length) return 'Builder trend unavailable'
      const unit = trendRowUnit(rows, trendRange)
      const dates = rows.length === 1 ? rows[0].date : `${rows[0]?.date} to ${rows.at(-1)?.date}`
      return `${metricLabel} trend updated for ${rangeLabel}: ${rows.length} ${unit}${rows.length === 1 ? '' : 's'} (${dates})`
    }

    function clearTrendSelection(announce = '') {
      trendFocusIndex = -1
      if (trendTooltip) trendTooltip.hidden = true
      if (trendGuide) trendGuide.hidden = true
      if (trendStatus) trendStatus.textContent = announce
      if (trendOverlay) trendOverlay.setAttribute('aria-label', trendOverlayLabel)
    }

    function showTrendPoint(index: number) {
      if (!trendOverlay || !trendTooltip) return
      const row = trendRows[index]
      if (!row) {
        trendTooltip.hidden = true
        if (trendGuide) trendGuide.hidden = true
        if (trendStatus) trendStatus.textContent = ''
        return
      }
      const iosValue = metric === 'rate' ? row.ios : row.ios_process_seconds
      const androidValue = metric === 'rate' ? row.android : row.android_process_seconds
      const tooltip = trendTip(row.date, iosValue, androidValue)
      const guideLeft = trendHitLeftPercent(index, trendRows.length)
      const tooltipLeft = clampTrendTooltip(guideLeft)
      trendFocusIndex = index
      trendTooltip.textContent = tooltip
      trendTooltip.hidden = false
      trendTooltip.style.left = `${tooltipLeft}%`
      if (trendGuide) {
        trendGuide.hidden = false
        trendGuide.style.left = `${guideLeft}%`
      }
      if (trendStatus) trendStatus.textContent = tooltip
      trendOverlay.setAttribute('aria-label', tooltip)
    }

    function bindTrendOverlay() {
      if (!trendOverlay) return
      trendOverlay.addEventListener('pointermove', (event) => {
        if (!trendRows.length) return
        const rect = trendOverlay.getBoundingClientRect()
        const index = trendNearestIndex(event.clientX, rect.left, rect.width, trendRows.length)
        showTrendPoint(index)
      })
      trendOverlay.addEventListener('pointerleave', () => {
        trendFocusIndex = -1
        if (trendTooltip) trendTooltip.hidden = true
        if (trendGuide) trendGuide.hidden = true
        if (trendStatus) trendStatus.textContent = ''
        trendOverlay.setAttribute('aria-label', trendOverlayLabel)
      })
      trendOverlay.addEventListener('keydown', (event) => {
        if (!trendRows.length) return
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight' && event.key !== 'Home' && event.key !== 'End') return
        event.preventDefault()
        const next =
          event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? trendRows.length - 1
              : Math.max(0, Math.min(trendRows.length - 1, (trendFocusIndex < 0 ? 0 : trendFocusIndex) + (event.key === 'ArrowRight' ? 1 : -1)))
        showTrendPoint(next)
      })
    }

    bindTrendOverlay()

    function platformOf(metrics: BuilderMetrics, key: 'ios' | 'android') {
      return (
        metrics.platforms.find((item) => item.key === key) ?? {
          key,
          share: 0,
          success_rate: null,
          avg_process_seconds: null,
          avg_queue_seconds: null,
          top_failure: null,
        }
      )
    }

    function sliceDays<T extends { date: string }>(rows: T[], days: number) {
      return rows.slice(Math.max(0, rows.length - days))
    }

    function chartScale(values: number[], kind: 'rate' | 'duration') {
      if (!values.length) return kind === 'rate' ? { min: 0, max: 100 } : { min: 0, max: 300 }
      const min = Math.min(...values)
      const max = Math.max(...values)
      const pad = Math.max(kind === 'rate' ? 3 : 20, (max - min) * 0.25)
      if (kind === 'rate') {
        return { min: Math.max(0, Number((min - pad).toFixed(1))), max: Math.min(100, Number((max + pad).toFixed(1))) }
      }
      return { min: Math.max(0, Number((min - pad).toFixed(1))), max: Number((max + pad).toFixed(1)) }
    }

    function chartPoints(values: Array<number | null>, scale: { min: number; max: number }, width = 800, height = 260) {
      const pad = { l: 44, r: 16, t: 16, b: 28 }
      const innerW = width - pad.l - pad.r
      const innerH = height - pad.t - pad.b
      const span = Math.max(scale.max - scale.min, 1)
      return values
        .map((value, index) => {
          if (value === null) return null
          const x = pad.l + (values.length <= 1 ? innerW / 2 : (index / (values.length - 1)) * innerW)
          const y = pad.t + (1 - (value - scale.min) / span) * innerH
          return `${x.toFixed(1)},${y.toFixed(1)}`
        })
        .filter((point): point is string => point !== null)
        .join(' ')
    }

    function formatTick(value: number) {
      return metric === 'rate' ? formatRate(value) : formatDuration(value)
    }

    function renderTrendMarker(group: SVGGElement | null | undefined, values: Array<number | null>, scale: { min: number; max: number }, show: boolean, fill: string) {
      if (!group) return
      group.replaceChildren()
      if (!show) return
      const coords = chartPoints(values, scale)
      if (!coords) return
      const [cx, cy] = coords.split(',')
      const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle')
      circle.setAttribute('cx', cx)
      circle.setAttribute('cy', cy)
      circle.setAttribute('r', '5')
      circle.setAttribute('fill', fill)
      group.append(circle)
    }

    function renderSpark(target: HTMLElement | null | undefined, rows: BuilderMetrics['daily_platforms'], key: 'ios' | 'android') {
      if (!target) return
      target.replaceChildren()
      for (const row of rows) {
        const tick = createScopedElement('i')
        tick.dataset.tone = sparkTone(row[key])
        tick.dataset.tip = sparkTip(row.date, row[key])
        target.append(tick)
      }
    }

    function trendReferenceDate(metrics: BuilderMetrics) {
      const timestamp = new Date(metrics.updated_at)
      return Number.isNaN(timestamp.getTime()) ? undefined : timestamp
    }

    function renderTrend(metrics: BuilderMetrics) {
      const rows = selectTrendRows(metrics, trendRange, trendRange === '1d' ? trendReferenceDate(metrics) : undefined)
      const iosValues = rows.map((row) => (metric === 'rate' ? row.ios : row.ios_process_seconds))
      const androidValues = rows.map((row) => (metric === 'rate' ? row.android : row.android_process_seconds))
      const values = [...iosValues, ...androidValues].filter((value): value is number => value !== null)
      const scale = chartScale(values, metric === 'rate' ? 'rate' : 'duration')
      const mid = Number(((scale.min + scale.max) / 2).toFixed(1))
      if (trendLabel) trendLabel.textContent = metric === 'rate' ? 'Build success' : 'Processing time'
      if (trendSvg) {
        trendSvg.style.display = rows.length ? '' : 'none'
        trendSvg.setAttribute('aria-label', metric === 'rate' ? 'iOS and Android build success' : 'iOS and Android processing time')
      }
      if (dailySkeleton) dailySkeleton.hidden = rows.length > 0
      if (trendIos) trendIos.setAttribute('points', chartPoints(iosValues, scale))
      if (trendAndroid) trendAndroid.setAttribute('points', chartPoints(androidValues, scale))
      const showIosMarker = iosValues.filter((value): value is number => value !== null).length === 1
      const showAndroidMarker = androidValues.filter((value): value is number => value !== null).length === 1
      renderTrendMarker(trendIosMarkers, iosValues, scale, showIosMarker, '#60a5fa')
      renderTrendMarker(trendAndroidMarkers, androidValues, scale, showAndroidMarker, '#34d399')
      if (trendMax) trendMax.textContent = formatTick(scale.max)
      if (trendMid) trendMid.textContent = formatTick(mid)
      if (trendMin) trendMin.textContent = formatTick(scale.min)
      if (trendStart) trendStart.textContent = formatTrendAxisLabel(rows[0]?.date ?? '', trendRange)
      if (trendEnd) trendEnd.textContent = formatTrendAxisLabel(rows.at(-1)?.date ?? '', trendRange)
      trendRows = rows
      clearTrendSelection(trendStatusAnnounce(rows))
      if (trendOverlay) trendOverlay.hidden = rows.length === 0
    }

    function renderFailures(metrics: BuilderMetrics) {
      if (!failuresList) return
      failuresList.replaceChildren()
      const lead = metrics.failures[0]
      if (failuresLead) {
        if (lead) {
          const info = getBuilderFailureInfo(lead.reason)
          failuresLead.textContent = `${info.label} accounts for ${Math.ceil(lead.share)}% of failed jobs in this window.`
        } else {
          failuresLead.textContent = 'Normalized categories across all apps.'
        }
      }
      for (const [index, item] of metrics.failures.entries()) {
        const info = getBuilderFailureInfo(item.reason)
        const row = createScopedElement('li')
        const rank = createScopedElement('span')
        rank.textContent = String(index + 1).padStart(2, '0')
        const copy = createScopedElement('div')
        copy.className = 'data-failure-copy'
        const reason = createScopedElement('strong')
        reason.textContent = info.label
        const explanation = createScopedElement('p')
        explanation.textContent = info.explanation
        copy.append(reason, explanation)
        const share = createScopedElement('b')
        share.textContent = `${Math.ceil(item.share)}%`
        const track = createScopedElement('i')
        track.setAttribute('aria-hidden', 'true')
        const fill = createScopedElement('em')
        fill.style.setProperty('--share', `${item.share}%`)
        track.append(fill)
        row.append(rank, copy, share, track)
        failuresList.append(row)
      }
      if (!metrics.failures.length) failuresList.append(Object.assign(createScopedElement('li'), { className: 'data-empty', textContent: 'No failures in this window.' }))
    }

    function renderShares(list: HTMLOListElement | null | undefined, items: Array<{ label: string; share: number }>, empty: string) {
      if (!list) return
      list.replaceChildren()
      for (const item of items) {
        const row = createScopedElement('li')
        const label = createScopedElement('strong')
        label.textContent = item.label
        const share = createScopedElement('b')
        share.textContent = `${Math.round(item.share)}%`
        const track = createScopedElement('i')
        track.setAttribute('aria-hidden', 'true')
        const fill = createScopedElement('em')
        fill.style.setProperty('--share', `${item.share}%`)
        track.append(fill)
        row.append(label, share, track)
        list.append(row)
      }
      if (!items.length) list.append(Object.assign(createScopedElement('li'), { className: 'data-empty', textContent: empty }))
    }

    const XCODE_COLORS = ['#60a5fa', '#a78bfa', '#34d399', '#f472b6', '#94a3b8']
    const DEPENDENCY_COLORS: Record<string, string> = { 'Swift Package Manager': '#60a5fa', CocoaPods: '#f59e0b' }
    const SHARE_SCALE = { min: 0, max: 100 }
    const shareSeries: Record<keyof typeof shareCharts, Array<{ label: string; color: string }>> = { xcode: [], dependency: [] }
    let shareDays: Record<keyof typeof shareCharts, ShareDay[]> = { xcode: [], dependency: [] }

    function shareTip(row: ShareDay, series: Array<{ label: string }>) {
      if (!row.values) return `${row.date} · no data`
      return [row.date, ...series.map((item) => `${item.label} ${formatRate(row.values?.[item.label] ?? 0)}`)].join(' · ')
    }

    function hideShareTooltip(chart: ReturnType<typeof shareChart>) {
      chart.focus = -1
      if (chart.tooltip) chart.tooltip.hidden = true
      if (chart.guide) chart.guide.hidden = true
      if (chart.status) chart.status.textContent = ''
      chart.overlay?.setAttribute('aria-label', chart.defaultLabel)
    }

    function showSharePoint(key: keyof typeof shareCharts, index: number) {
      const chart = shareCharts[key]
      const row = chart.rows[index]
      if (!row || !chart.tooltip) return hideShareTooltip(chart)
      const tip = shareTip(row, shareSeries[key])
      const left = trendHitLeftPercent(index, chart.rows.length)
      chart.focus = index
      chart.tooltip.textContent = tip
      chart.tooltip.hidden = false
      chart.tooltip.style.left = `${clampTrendTooltip(left)}%`
      if (chart.guide) {
        chart.guide.hidden = false
        chart.guide.style.left = `${left}%`
      }
      chart.overlay?.setAttribute('aria-label', tip)
      if (chart.status) chart.status.textContent = tip
    }

    function bindShareChart(key: keyof typeof shareCharts) {
      const chart = shareCharts[key]
      const overlay = chart.overlay
      if (overlay) {
        overlay.addEventListener('pointermove', (event) => {
          if (!chart.rows.length) return
          const rect = overlay.getBoundingClientRect()
          showSharePoint(key, trendNearestIndex(event.clientX, rect.left, rect.width, chart.rows.length))
        })
        overlay.addEventListener('pointerleave', () => hideShareTooltip(chart))
        overlay.addEventListener('keydown', (event) => {
          if (!chart.rows.length) return
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight' && event.key !== 'Home' && event.key !== 'End') return
          event.preventDefault()
          const last = chart.rows.length - 1
          const step = event.key === 'ArrowRight' ? 1 : -1
          const next = event.key === 'Home' ? 0 : event.key === 'End' ? last : Math.max(0, Math.min(last, (chart.focus < 0 ? 0 : chart.focus) + step))
          showSharePoint(key, next)
        })
      }
      for (const button of chart.ranges) {
        button.addEventListener('click', () => {
          chart.range = (button.dataset.shareRange as TrendRangeKey) ?? '1m'
          for (const item of chart.ranges) item.setAttribute('aria-pressed', item === button ? 'true' : 'false')
          drawShareChart(key)
        })
      }
    }

    /** Lines of each series' daily share on a fixed 0–100% scale, from the first day with data in the window. */
    function drawShareChart(key: keyof typeof shareCharts, empty = 'No data in this window.') {
      const chart = shareCharts[key]
      const series = shareSeries[key]
      const windowRows = sliceDays(shareDays[key], trendRangeDays(chart.range))
      const first = windowRows.findIndex((row) => row.values !== null)
      chart.rows = first === -1 ? [] : windowRows.slice(first)
      hideShareTooltip(chart)
      const hasData = chart.rows.length > 0 && series.length > 0
      if (chart.plot) chart.plot.hidden = !hasData
      if (chart.empty) {
        chart.empty.hidden = hasData
        chart.empty.textContent = empty
      }
      chart.lines?.replaceChildren()
      chart.legend?.replaceChildren()
      if (!hasData) return
      for (const item of series) {
        const values = chart.rows.map((row) => (row.values ? (row.values[item.label] ?? 0) : null))
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'polyline')
        for (const name of styleScopeAttributes) line.setAttribute(name, '')
        line.setAttribute('points', chartPoints(values, SHARE_SCALE))
        line.style.stroke = item.color
        chart.lines?.append(line)
        if (values.filter((value) => value !== null).length === 1) {
          const marker = document.createElementNS('http://www.w3.org/2000/svg', 'g')
          renderTrendMarker(marker, values, SHARE_SCALE, true, item.color)
          chart.lines?.append(marker)
        }
        const legend = createScopedElement('span')
        legend.textContent = item.label
        legend.style.setProperty('--legend-color', item.color)
        chart.legend?.append(legend)
      }
      if (chart.start) chart.start.textContent = chart.rows[0]?.date ?? ''
      if (chart.end) chart.end.textContent = chart.rows.at(-1)?.date ?? ''
    }

    function dependencyLabel(key: 'spm' | 'cocoapods') {
      return key === 'spm' ? 'Swift Package Manager' : 'CocoaPods'
    }

    function renderToolchainTrends(metrics: BuilderMetrics) {
      // Newest Xcode first, with the same color on every day.
      const versions = [...new Set(metrics.daily_ios_toolchain.flatMap((day) => day.xcode_versions.map((item) => item.version)))].sort((a, b) => Number(b) - Number(a))
      shareSeries.xcode = versions.map((version, index) => ({ label: `Xcode ${version}`, color: XCODE_COLORS[Math.min(index, XCODE_COLORS.length - 1)] }))
      const managers = (['spm', 'cocoapods'] as const).filter((key) => metrics.daily_ios_toolchain.some((day) => day.ios_dependency_managers.some((item) => item.key === key)))
      shareSeries.dependency = managers.map((key) => ({ label: dependencyLabel(key), color: DEPENDENCY_COLORS[dependencyLabel(key)] }))
      shareDays = {
        xcode: metrics.daily_ios_toolchain.map((day) => ({
          date: day.date,
          values: day.xcode_versions.length ? Object.fromEntries(day.xcode_versions.map((item) => [`Xcode ${item.version}`, item.share])) : null,
        })),
        dependency: metrics.daily_ios_toolchain.map((day) => ({
          date: day.date,
          values: day.ios_dependency_managers.length ? Object.fromEntries(day.ios_dependency_managers.map((item) => [dependencyLabel(item.key), item.share])) : null,
        })),
      }
      drawShareChart('xcode')
      drawShareChart('dependency')
    }

    bindShareChart('xcode')
    bindShareChart('dependency')

    function renderToolchain(metrics: BuilderMetrics) {
      renderToolchainTrends(metrics)
      const xcode = metrics.xcode_versions.map((item) => ({ label: `Xcode ${item.version}`, share: item.share }))
      const managers = metrics.ios_dependency_managers.map((item) => ({ label: dependencyLabel(item.key), share: item.share }))
      renderShares(xcodeShares, xcode, 'No data in this window.')
      renderShares(dependencyShares, managers, 'No data in this window.')
      if (toolchainLead) {
        const topXcode = [...xcode].sort((a, b) => b.share - a.share)[0]
        const topManager = [...managers].sort((a, b) => b.share - a.share)[0]
        const parts = [
          topXcode ? `${topXcode.label} built ${Math.round(topXcode.share)}% of iOS builds` : '',
          topManager ? `${Math.round(topManager.share)}% use ${topManager.label}` : '',
        ].filter(Boolean)
        toolchainLead.textContent = parts.length ? `${parts.join(', and ')} in this window.` : 'No iOS toolchain data in this window.'
      }
    }

    function renderMetrics(metrics: BuilderMetrics) {
      latestMetrics = metrics
      const ios = platformOf(metrics, 'ios')
      const android = platformOf(metrics, 'android')
      if (successRateKpi) successRateKpi.textContent = formatRate(metrics.success_rate)
      if (processKpi) processKpi.textContent = formatDuration(metrics.avg_process_seconds)
      if (queueKpi) queueKpi.textContent = formatDuration(metrics.avg_queue_seconds)
      if (iosSuccessKpi) iosSuccessKpi.textContent = formatRate(ios.success_rate)
      if (iosFailureKpi) iosFailureKpi.textContent = formatRate(failureRate(ios.success_rate))
      if (androidSuccessKpi) androidSuccessKpi.textContent = formatRate(android.success_rate)
      if (androidFailureKpi) androidFailureKpi.textContent = formatRate(failureRate(android.success_rate))
      if (iosProcess) iosProcess.textContent = `${formatDuration(ios.avg_process_seconds)} avg process`
      if (androidProcess) androidProcess.textContent = `${formatDuration(android.avg_process_seconds)} avg process`
      if (iosTopFailure) iosTopFailure.textContent = ios.top_failure ? getBuilderFailureInfo(ios.top_failure.reason).label : 'No leading failure'
      if (androidTopFailure) androidTopFailure.textContent = android.top_failure ? getBuilderFailureInfo(android.top_failure.reason).label : 'No leading failure'
      if (statusBadge) {
        statusBadge.dataset.tone = 'operational'
        if (statusBadge.lastChild) statusBadge.lastChild.textContent = ' Operational'
      }
      if (kpiStatus) {
        kpiStatus.textContent = `Success ${formatRate(metrics.success_rate)}, process ${formatDuration(metrics.avg_process_seconds)}, queue ${formatDuration(metrics.avg_queue_seconds)}`
      }
      const sparkRows = sliceSparklineRows(metrics.daily_platforms)
      renderSpark(iosSpark, sparkRows, 'ios')
      renderSpark(androidSpark, sparkRows, 'android')
      renderTrend(metrics)
      renderFailures(metrics)
      renderToolchain(metrics)
      if (updated) {
        const timestamp = new Date(metrics.updated_at)
        updated.textContent = Number.isNaN(timestamp.getTime())
          ? 'Updated moments ago'
          : `Updated ${new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(timestamp)} UTC`
      }
    }

    function renderUnavailable() {
      latestMetrics = null
      if (updated) updated.textContent = 'Builder data is temporarily unavailable. Check back shortly.'
      if (statusBadge) {
        statusBadge.dataset.tone = 'unavailable'
        if (statusBadge.lastChild) statusBadge.lastChild.textContent = ' Unavailable'
      }
      if (kpiStatus) kpiStatus.textContent = 'Builder metrics unavailable'
      if (successRateKpi) successRateKpi.textContent = '—'
      if (processKpi) processKpi.textContent = '—'
      if (queueKpi) queueKpi.textContent = '—'
      if (iosSuccessKpi) iosSuccessKpi.textContent = '—'
      if (iosFailureKpi) iosFailureKpi.textContent = '—'
      if (androidSuccessKpi) androidSuccessKpi.textContent = '—'
      if (androidFailureKpi) androidFailureKpi.textContent = '—'
      if (iosSpark) iosSpark.replaceChildren()
      if (androidSpark) androidSpark.replaceChildren()
      if (trendSvg) trendSvg.style.display = 'none'
      if (failuresLead) failuresLead.textContent = 'Failure data is temporarily unavailable.'
      if (failuresList) failuresList.replaceChildren(Object.assign(createScopedElement('li'), { className: 'data-empty', textContent: 'Failure data is temporarily unavailable.' }))
      if (toolchainLead) toolchainLead.textContent = 'Toolchain data is temporarily unavailable.'
      renderShares(xcodeShares, [], 'Temporarily unavailable.')
      renderShares(dependencyShares, [], 'Temporarily unavailable.')
      shareDays = { xcode: [], dependency: [] }
      drawShareChart('xcode', 'Temporarily unavailable.')
      drawShareChart('dependency', 'Temporarily unavailable.')
    }

    async function fetchMetrics() {
      if (!endpoint) throw new Error('Missing metrics endpoint')
      const controller = new AbortController()
      const timeoutId = window.setTimeout(() => controller.abort(), 10_000)
      try {
        const response = await fetch(endpoint, {
          headers: { Accept: 'application/json' },
          signal: controller.signal,
          cache: 'default',
        })
        const payload = response.ok ? await response.json() : null
        const metrics = normalizeBuilderMetrics(payload)
        if (!metrics) throw new Error('Invalid metrics response')
        writeCachedMetrics(payload)
        return metrics
      } finally {
        window.clearTimeout(timeoutId)
      }
    }

    const METRICS_CACHE_KEY = 'capgo-builder-metrics-v2'
    const METRICS_CACHE_FRESH_MS = 5 * 60 * 1000
    const METRICS_CACHE_STALE_MS = 24 * 60 * 60 * 1000

    function readCachedMetrics(): { metrics: BuilderMetrics; fresh: boolean } | null {
      try {
        const raw = localStorage.getItem(METRICS_CACHE_KEY)
        if (!raw) return null
        const parsed = JSON.parse(raw) as { savedAt?: unknown; payload?: unknown }
        if (typeof parsed.savedAt !== 'number') return null
        const age = Date.now() - parsed.savedAt
        if (age > METRICS_CACHE_STALE_MS) return null
        const metrics = normalizeBuilderMetrics(parsed.payload)
        if (!metrics) return null
        return { metrics, fresh: age <= METRICS_CACHE_FRESH_MS }
      } catch {
        return null
      }
    }

    function writeCachedMetrics(payload: unknown) {
      try {
        localStorage.setItem(METRICS_CACHE_KEY, JSON.stringify({ savedAt: Date.now(), payload }))
      } catch {
        // Ignore quota / private-mode failures.
      }
    }

    async function loadMetrics() {
      const cached = readCachedMetrics()
      const initial = cached?.metrics

      if (initial) {
        renderMetrics(initial)
        page?.setAttribute('aria-busy', 'false')
      }

      if (cached?.fresh) {
        void fetchMetrics()
          .then((metrics) => renderMetrics(metrics))
          .catch(() => undefined)
        return
      }

      try {
        const metrics = await fetchMetrics()
        renderMetrics(metrics)
      } catch {
        if (!initial) renderUnavailable()
      } finally {
        page?.setAttribute('aria-busy', 'false')
      }
    }

    for (const button of trendRangeButtons) {
      button.addEventListener('click', () => {
        const next = button.dataset.trendRange
        if (next !== '1d' && next !== '1w' && next !== '1m' && next !== '3m') return
        trendRange = next
        for (const item of trendRangeButtons) item.setAttribute('aria-pressed', item === button ? 'true' : 'false')
        if (latestMetrics) renderTrend(latestMetrics)
      })
    }

    for (const button of metricButtons) {
      button.addEventListener('click', () => {
        const next = button.dataset.metric
        if (next !== 'rate' && next !== 'duration') return
        metric = next
        for (const item of metricButtons) item.ariaSelected = item === button ? 'true' : 'false'
        if (latestMetrics) renderTrend(latestMetrics)
      })
    }

    void loadMetrics()
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true })
  else boot()
</script>

