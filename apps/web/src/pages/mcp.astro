---
import '@/styles/cli-product.css'
import ConversionRelatedLinks from '@/components/conversion/ConversionRelatedLinks.astro'
import McpConnect from '@/components/mcp/McpConnect.astro'
import McpFeatureAtlas from '@/components/mcp/McpFeatureAtlas.astro'
import McpServerChoice from '@/components/mcp/McpServerChoice.astro'
import Layout from '@/layouts/Layout.astro'
import m from '@/copy/messages'
import { createFAQPageLdJson, createLdJsonGraph, createServiceLdJson, createSoftwareApplicationLdJson } from '@/lib/ldJson'
import { getRelativeLocaleUrl } from '@/services/links'
import { HOSTED_MCP_URL } from '../../../shared/agentDiscovery'

const locale = Astro.locals.locale
const title = m.mcp_page_title({}, { locale })
const description = m.mcp_page_meta_description({}, { locale })

const faqs = [
  {
    question: 'Which URL do I paste into Claude, ChatGPT, or Cursor?',
    answer: `Paste ${HOSTED_MCP_URL} for account tools. Sign in with OAuth, or send Authorization: Bearer and a Capgo API key. https://capgo.app/mcp/ is this guide. https://capgo.app/mcp/public is the public docs server and cannot see your account.`,
  },
  {
    question: 'When do I need the local CLI server?',
    answer:
      'When the agent must read the project folder: upload a bundle, run doctor or probe, check compatibility against local native packages, or request a native build from that checkout. Start it with npx @capgo/cli@latest mcp after npx @capgo/cli@latest login. You can connect the hosted server and the local server at the same time.',
  },
  {
    question: 'How do I disconnect an agent?',
    answer:
      'OAuth creates a Capgo API key named MCP · <client name> for that client. Delete the key on the API keys page. The client loses access and has to sign in again. The key lasts at most 90 days, and a shorter organization policy wins.',
  },
  {
    question: 'Can the agent upload signing certificates in chat?',
    answer:
      'Do not paste keystores, certificates, or private keys into the chat. capgo_prepare_build_credentials_upload returns a signed URL. The file transfer happens outside the conversation. If the agent cannot transfer a local file, run npx @capgo/cli@latest build credentials push or build credentials save from the project.',
  },
  {
    question: 'Does a hosted build-status check record build minutes?',
    answer:
      'No. On the hosted server, capgo_get_build_status is read-only and returns persisted: false. It does not sync build history, record minutes, emit webhooks, or cancel a timed-out job. The CLI and the local MCP server still persist on a status read.',
  },
]

const serviceLdJson = createServiceLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description,
  url: Astro.url.href,
  serviceType: 'Software Development Service',
  areaServed: ['Worldwide'],
})

const softwareLdJson = createSoftwareApplicationLdJson(Astro.locals.runtimeConfig.public, {
  name: 'Capgo MCP',
  description,
  url: Astro.url.href,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Model Context Protocol servers for Capgo',
  featureList: [
    'Hosted MCP server at api.capgo.app/mcp with OAuth or API key auth',
    'Local CLI MCP for bundle uploads, doctor, probe, and native builds',
    'Public docs MCP with no account access',
    'Observe, rollout, webhook, and MCP event tools',
    'Read-only web-app-to-mobile planning tools',
  ],
})

const faqLdJson = createFAQPageLdJson(Astro.locals.runtimeConfig.public, {
  url: Astro.url.href,
  questions: faqs,
})

const content = {
  title,
  description,
  keywords: 'Capgo MCP, Capacitor MCP, Claude MCP, Cursor MCP, ChatGPT MCP, hosted MCP, CLI MCP',
  image: `${Astro.locals.runtimeConfig.public.baseUrl}/capgo_social.png`,
  ldJSON: createLdJsonGraph(Astro.locals.runtimeConfig.public, serviceLdJson, {
    includeOrganization: true,
    additionalEntities: [softwareLdJson, faqLdJson],
  }),
}

const hostedMcpDocsUrl = getRelativeLocaleUrl(locale, 'docs/ai/mcp')
const cliUrl = getRelativeLocaleUrl(locale, 'capgo-cli')
const heroMeta = ['OAuth or API key', 'Local server for project files', 'Same permissions as the API key']

const relatedLinks = [
  { label: m.mcp_page_links_hosted({}, { locale }), href: hostedMcpDocsUrl },
  { label: m.mcp_page_links_manifest({}, { locale }), href: '/.well-known/mcp.json' },
  { label: m.mcp_page_links_docs({}, { locale }), href: getRelativeLocaleUrl(locale, 'docs/cli/reference/mcp') },
  { label: m.mcp_page_links_skills({}, { locale }), href: getRelativeLocaleUrl(locale, 'skills') },
  { label: m.mcp_page_links_agents({}, { locale }), href: getRelativeLocaleUrl(locale, 'agents') },
  { label: m.nav_capgo_cli({}, { locale }), href: cliUrl },
  { label: m.best_ai_tools_capacitor_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'best/ai-tools-for-capacitor') },
  { label: m.mcp_page_links_openapi({}, { locale }), href: '/openapi.json' },
  { label: m.contact({}, { locale }), href: getRelativeLocaleUrl(locale, 'contact') },
]
---

<Layout content={content}>
  <div class="cli mcp bg-ad">
    <section class="section hero bg-grid grain" id="top">
      <div class="shell">
        <div class="beta-badge">
          <span class="dot"></span>
          Capgo MCP
        </div>
        <h1 class="hero-banner" aria-label={m.mcp_page_hero_title({}, { locale })}>
          <span class="hbv-underlined">
            <span class="hbv-u-name">{m.mcp_page_hero_title({}, { locale })}</span>
            <span class="hbv-u-rule"></span>
          </span>
        </h1>
        <p class="lead hero-lead">{m.mcp_page_hero_subtitle({}, { locale })}</p>
        <div class="hero-ctas">
          <div class="hero-cta-buttons">
            <a class="btn btn-lg btn-primary" href={hostedMcpDocsUrl}>
              Hosted MCP setup
            </a>
            <a class="btn btn-lg btn-ghost" href="#capabilities">
              See the tools
            </a>
          </div>
          <p class="hero-cta-note">
            Commands for a laptop or CI stay on the
            <a class="text-link" href={cliUrl}>
              Capgo CLI
            </a>
            page.
          </p>
        </div>
        <div class="hero-meta">
          {heroMeta.map((item) => (
            <span>
              <span class="check">✓</span>
              {item}
            </span>
          ))}
        </div>
      </div>
    </section>

    <McpServerChoice />
  </div>

  <McpFeatureAtlas />

  <section class="bg-[#1a1a1a] py-16 sm:py-20" id="access" aria-labelledby="mcp-access-title">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:px-8">
      <div>
        <p class="font-mono text-sm font-semibold tracking-wide text-emerald-300 uppercase">Access</p>
        <h2 id="mcp-access-title" class="mt-3 text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">
          A key per client, and a way to delete it
        </h2>
        <p class="mt-5 text-base leading-7 text-slate-300">
          The hosted server uses OAuth 2.1 with PKCE. The client opens the Capgo consent page. You sign in, pick the organizations that client may access, and Capgo creates a key
          named MCP · &lt;client name&gt;.
        </p>
      </div>
      <ol class="grid gap-3">
        <li class="rounded-lg border border-white/10 bg-white/[0.04] p-4 text-sm leading-6 text-slate-300">
          <span class="font-semibold text-white">1. Sign in from the client.</span> The consent page is on the Capgo console. You choose the organizations. You do not paste a
          password into the agent.
        </li>
        <li class="rounded-lg border border-white/10 bg-white/[0.04] p-4 text-sm leading-6 text-slate-300">
          <span class="font-semibold text-white">2. The key expires.</span> At most 90 days. If the organization forces a shorter API key lifetime, that shorter limit wins. Sign in
          again from the client to reconnect.
        </li>
        <li class="rounded-lg border border-white/10 bg-white/[0.04] p-4 text-sm leading-6 text-slate-300">
          <span class="font-semibold text-white">3. Revoke by deleting the key.</span> Each client has its own MCP · name key on the API keys page. Delete it and that client loses
          access.
        </li>
        <li class="rounded-lg border border-white/10 bg-white/[0.04] p-4 text-sm leading-6 text-slate-300">
          <span class="font-semibold text-white">4. Clients without OAuth send a bearer token.</span> n8n, scripts, and CI use Authorization: Bearer and a Capgo API key. Use the
          smallest role that covers the job.
        </li>
      </ol>
    </div>
  </section>

  <McpConnect />

  <section class="bg-[#1a1a1a] py-16 sm:py-20" id="faq" aria-labelledby="mcp-faq-title">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 id="mcp-faq-title" class="text-3xl font-semibold tracking-tight text-white">
        Questions
      </h2>
      <div class="mt-8 divide-y divide-white/10 border-y border-white/10">
        {faqs.map((faq) => (
          <details class="group py-4">
            <summary class="cursor-pointer list-none text-base font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-300 [&::-webkit-details-marker]:hidden">
              <span class="flex items-start justify-between gap-4">
                {faq.question}
                <span class="font-mono text-emerald-300 group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </span>
            </summary>
            <p class="mt-3 text-sm leading-6 text-slate-300">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[1fr_auto] lg:items-center lg:px-8">
      <div>
        <p class="font-mono text-sm font-semibold tracking-wide text-emerald-300 uppercase">Start</p>
        <h2 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">
          Connect the hosted server, then add the local one if the agent must touch the repo.
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300">{m.mcp_page_cli_onboarding({}, { locale })}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a
          id="mcp-agent-onboarding-cta"
          href={getRelativeLocaleUrl(locale, 'register')}
          class="inline-flex min-h-12 items-center justify-center rounded-lg bg-emerald-500 px-5 py-3 text-sm font-semibold text-slate-950 hover:bg-emerald-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-300"
        >
          {m.mcp_page_cli_onboarding_cta({}, { locale })}
        </a>
        <a
          href={cliUrl}
          class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/15 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >
          Capgo CLI
        </a>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-6 pb-20">
    <ConversionRelatedLinks title={m.mcp_page_links_title({}, { locale })} links={relatedLinks} />
  </div>
</Layout>
