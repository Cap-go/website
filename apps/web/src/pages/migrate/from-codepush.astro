---
import ConversionLandingLayout from '@/components/conversion/ConversionLandingLayout.astro'
import { getRelativeLocaleUrl } from '@/services/links'
import m from '@/copy/messages'
import { createServiceLdJson, createLdJsonGraph } from '@/lib/ldJson'

const locale = Astro.locals.locale
const title = m.migrate_from_codepush_title({}, { locale })
const description = m.migrate_from_codepush_meta_description({}, { locale })

const serviceLdJson = createServiceLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description,
  url: Astro.url.href,
  serviceType: 'Software Development Service',
  areaServed: ['Worldwide'],
})

const ldJSON = createLdJsonGraph(Astro.locals.runtimeConfig.public, serviceLdJson, {
  includeOrganization: true,
})

const content = { title, description, ldJSON, image: `${Astro.locals.runtimeConfig.public.baseUrl}/capgo_social.png` }

const relatedLinks = [
  { label: m.codepush_alt_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'alternatives/codepush') },
  { label: m.review_codepush_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'reviews/codepush') },
  { label: 'App Center migration (blog)', href: getRelativeLocaleUrl(locale, 'blog/appcenter-migration') },
  { label: 'Moving from Microsoft App Center (blog)', href: getRelativeLocaleUrl(locale, 'blog/moving-from-microsoft-app-center-to-capgo') },
]
---

<ConversionLandingLayout
  locale={locale}
  content={content}
  heroTitle={m.migrate_from_codepush_hero_title({}, { locale })}
  heroSubtitle={m.migrate_from_codepush_hero_subtitle({}, { locale })}
  sections={[
    {
      title: m.migrate_from_codepush_steps_title({}, { locale }),
      paragraphs: [m.migrate_from_codepush_steps_p1({}, { locale })],
      listItems: [m.migrate_from_codepush_steps_li1({}, { locale }), m.migrate_from_codepush_steps_li2({}, { locale }), m.migrate_from_codepush_steps_li3({}, { locale })],
    },
  ]}
  relatedLinks={relatedLinks}
/>
