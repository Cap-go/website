---
import { ossApps, type OssApp, type OssAppLicense, type OssAppScreenshot } from '@/config/ossApps'
import Layout from '@/layouts/Layout.astro'
import { createItemListLdJson, createLdJsonGraph } from '@/lib/ldJson'
import m from '@/copy/messages'
import { defaultLocale } from '@/services/locale'
import { getRelativeLocaleUrl } from '@/services/links'
import { Icon as AstroIcon } from 'astro-icon/components'

const locale = Astro.locals.locale ?? defaultLocale
const brand = Astro.locals.runtimeConfig.public.brand
const description = m.oss_apps_description({}, { locale })

const makeSeoTitle = (primary: string, descriptionText: string) => {
  const normalizedPrimary = primary.replace(/\s+/g, ' ').trim()
  const normalizedDescription = descriptionText
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/[.!?]\s*$/, '')
  const base = `${brand} | ${normalizedPrimary}`

  if (base.length >= 50 && base.length <= 60) return base
  if (base.length > 60) return base.slice(0, 60).trimEnd()

  const separator = ' — '
  const available = 60 - base.length - separator.length
  if (available <= 0) return base

  const snippetRaw = normalizedDescription.slice(0, available)
  const lastSpace = snippetRaw.lastIndexOf(' ')
  const snippet = (lastSpace > available * 0.6 ? snippetRaw.slice(0, lastSpace) : snippetRaw).trim().replace(/[,:;\-–—]\s*$/, '')

  return snippet ? `${base}${separator}${snippet}` : base
}

const title = makeSeoTitle(m.oss_apps_seo_title({}, { locale }), description)

const licenseLabel: Record<OssAppLicense, string> = {
  mit: m.oss_apps_license_mit({}, { locale }),
  agpl: m.oss_apps_license_agpl({}, { locale }),
  public: m.oss_apps_license_public({}, { locale }),
}

type AppCopyKey = OssApp['kindKey'] | OssApp['summaryKey'] | OssAppScreenshot['altKey']

// Literal calls stay here so the translation scanner still records each key.
const copyByKey = {
  oss_apps_kind_browser: m.oss_apps_kind_browser({}, { locale }),
  oss_apps_kind_events: m.oss_apps_kind_events({}, { locale }),
  oss_apps_kind_habits: m.oss_apps_kind_habits({}, { locale }),
  oss_apps_kind_quotes: m.oss_apps_kind_quotes({}, { locale }),
  oss_apps_kind_game: m.oss_apps_kind_game({}, { locale }),
  oss_apps_kind_tools: m.oss_apps_kind_tools({}, { locale }),
  oss_apps_autobrowse_description: m.oss_apps_autobrowse_description({}, { locale }),
  oss_apps_simplefest_description: m.oss_apps_simplefest_description({}, { locale }),
  oss_apps_mondayquest_description: m.oss_apps_mondayquest_description({}, { locale }),
  oss_apps_bewise_description: m.oss_apps_bewise_description({}, { locale }),
  oss_apps_mimesis_description: m.oss_apps_mimesis_description({}, { locale }),
  oss_apps_forgr_description: m.oss_apps_forgr_description({}, { locale }),
  oss_apps_autobrowse_chat_alt: m.oss_apps_autobrowse_chat_alt({}, { locale }),
  oss_apps_autobrowse_home_alt: m.oss_apps_autobrowse_home_alt({}, { locale }),
  oss_apps_simplefest_home_alt: m.oss_apps_simplefest_home_alt({}, { locale }),
  oss_apps_simplefest_scan_alt: m.oss_apps_simplefest_scan_alt({}, { locale }),
  oss_apps_mondayquest_today_alt: m.oss_apps_mondayquest_today_alt({}, { locale }),
  oss_apps_mondayquest_track_alt: m.oss_apps_mondayquest_track_alt({}, { locale }),
  oss_apps_bewise_today_alt: m.oss_apps_bewise_today_alt({}, { locale }),
  oss_apps_bewise_widget_alt: m.oss_apps_bewise_widget_alt({}, { locale }),
  oss_apps_mimesis_playing_alt: m.oss_apps_mimesis_playing_alt({}, { locale }),
  oss_apps_mimesis_themes_alt: m.oss_apps_mimesis_themes_alt({}, { locale }),
  oss_apps_forgr_home_alt: m.oss_apps_forgr_home_alt({}, { locale }),
  oss_apps_forgr_chat_alt: m.oss_apps_forgr_chat_alt({}, { locale }),
} satisfies Record<AppCopyKey, string>

const apps = ossApps.map((app) => ({
  ...app,
  kind: copyByKey[app.kindKey],
  summary: copyByKey[app.summaryKey],
  licenseLabel: licenseLabel[app.license],
  screenshots: app.screenshots.map((screenshot) => ({
    ...screenshot,
    alt: copyByKey[screenshot.altKey],
  })),
}))

const directoryStats = [
  { label: m.oss_apps_stat_apps({}, { locale }), value: String(apps.length) },
  { label: m.oss_apps_stat_play({}, { locale }), value: String(apps.filter((app) => app.play).length) },
  { label: m.oss_apps_stat_app_store({}, { locale }), value: String(apps.filter((app) => app.appStore).length) },
  { label: m.oss_apps_stat_licensed({}, { locale }), value: String(apps.filter((app) => app.license !== 'public').length) },
]

const baseUrl = Astro.locals.runtimeConfig.public.baseUrl
const appsUrl = new URL(getRelativeLocaleUrl(locale, '/apps/'), baseUrl).toString()
const ldJSON = createLdJsonGraph(
  Astro.locals.runtimeConfig.public,
  createItemListLdJson(Astro.locals.runtimeConfig.public, {
    url: appsUrl,
    name: title,
    description,
    items: apps.map((app) => ({
      name: app.name,
      url: app.website,
      image: new URL(app.screenshots[0].src, baseUrl).toString(),
      description: app.summary,
    })),
  }),
  {
    includeOrganization: true,
    includeBreadcrumbs: true,
    breadcrumbs: [
      { name: brand, url: new URL(getRelativeLocaleUrl(locale, '/'), baseUrl).toString() },
      { name: m.oss_apps_nav({}, { locale }), url: appsUrl },
    ],
  },
)

const content = {
  title,
  description,
  keywords: 'capacitor apps, public source, capgo apps, bewise, mimesis, simple fest, monday quest, auto browse, forgr',
  ldJSON,
}

const linkClass = 'inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-2'
---

<Layout content={content}>
  <div class="product-hero relative min-h-screen">
    <section class="px-6 pt-12 pb-8 lg:px-8 lg:pt-16 lg:pb-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12">
          <div class="mb-6 inline-flex items-center rounded-full border border-gray-600/40 bg-gray-800/40 px-4 py-2 text-sm font-medium text-gray-200">
            <span class="mr-2 h-2 w-2 animate-pulse rounded-full bg-blue-400"></span>
            {apps.length} {m.oss_apps_eyebrow({}, { locale })}
          </div>

          <h1 class="font-pj text-3xl font-bold text-white sm:text-4xl md:text-5xl">{m.oss_apps_title({}, { locale })}</h1>
          <p class="mt-4 max-w-2xl text-gray-300">{m.oss_apps_lede({}, { locale })}</p>
        </div>

        <div class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-gray-800 bg-gray-800/80 text-gray-300 lg:grid-cols-4">
          {directoryStats.map((stat) => (
            <div class="min-h-24 bg-gray-950/70 px-4 py-4">
              <span class="block text-2xl font-semibold text-white tabular-nums">{stat.value}</span>
              <span class="mt-1 block text-sm leading-snug text-gray-400">{stat.label}</span>
            </div>
          ))}
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <div class="flex gap-4 rounded-lg border border-gray-800 bg-gray-950/70 p-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-emerald-400/10 text-emerald-300 ring-1 ring-emerald-400/20" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
              </svg>
            </span>
            <div>
              <h2 class="text-base font-semibold text-white">{m.oss_apps_source_title({}, { locale })}</h2>
              <p class="mt-1 text-sm leading-6 text-gray-400">{m.oss_apps_source_body({}, { locale })}</p>
              <a
                href="https://github.com/Cap-go"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-emerald-300! focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300 [@media(hover:hover)]:hover:text-white!"
              >
                {m.oss_apps_source_cta({}, { locale })} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <div class="flex gap-4 rounded-lg border border-gray-800 bg-gray-950/70 p-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-400/10 text-blue-300 ring-1 ring-blue-400/20" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5 12 3 3 7.5m18 0L12 12m9-4.5v9L12 21m0-9L3 7.5m9 4.5v9" />
              </svg>
            </span>
            <div>
              <h2 class="text-base font-semibold text-white">{m.oss_apps_stack_title({}, { locale })}</h2>
              <p class="mt-1 text-sm leading-6 text-gray-400">{m.oss_apps_stack_body({}, { locale })}</p>
              <a
                href={getRelativeLocaleUrl(locale, 'plugins')}
                class="mt-2 inline-flex items-center gap-1 text-sm font-medium text-blue-300! focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300 [@media(hover:hover)]:hover:text-white!"
              >
                {m.oss_apps_stack_cta({}, { locale })} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="apps" class="px-6 pt-4 pb-20 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-10 max-w-2xl">
          <h2 class="font-pj text-3xl font-bold text-white sm:text-4xl">{m.oss_apps_section_title({}, { locale })}</h2>
          <p class="mt-3 text-gray-300">{m.oss_apps_section_lede({}, { locale })}</p>
        </div>

        <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-2">
          {apps.map((app) => (
            <article class="overflow-hidden rounded-lg border border-gray-700/80 bg-gray-950/45">
              <div class="grid grid-cols-2 gap-2 bg-gray-950/80 p-3">
                {app.screenshots.map((screenshot) => (
                  <img
                    src={screenshot.src}
                    width={screenshot.width}
                    height={screenshot.height}
                    alt={screenshot.alt}
                    loading="lazy"
                    decoding="async"
                    class="h-auto w-full rounded-md bg-gray-900"
                  />
                ))}
              </div>
              <div class="p-5">
                <div class="mb-4 flex items-start justify-between gap-3 text-sm font-semibold">
                  <span class="rounded-full border border-blue-400/20 bg-blue-400/10 px-3 py-1 text-blue-200">{app.kind}</span>
                  <span class="rounded-full border border-gray-600 px-3 py-1 text-gray-300">{app.licenseLabel}</span>
                </div>
                <h3 class="font-pj text-2xl font-bold text-white">{app.name}</h3>
                <p class="mt-3 leading-relaxed text-gray-300">{app.summary}</p>
                <div class="mt-5">
                  <h4 class="text-sm font-semibold text-white">{m.oss_apps_plugins_label({}, { locale })}</h4>
                  <ul class="mt-2 flex flex-wrap gap-1.5">
                    {app.plugins.map((plugin) => (
                      <li>
                        <a
                          href={getRelativeLocaleUrl(locale, `plugins/${plugin.slug}`)}
                          class="inline-flex min-h-8 items-center rounded-full border border-gray-600 px-2.5 text-xs font-medium text-gray-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300 [@media(hover:hover)]:hover:border-blue-300/70 [@media(hover:hover)]:hover:text-white"
                        >
                          {plugin.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
                <p class="mt-3 truncate font-mono text-xs text-gray-400">{app.repo}</p>
                <div class="mt-5 flex flex-wrap gap-2">
                  <a
                    href={app.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[linkClass, 'bg-blue-600 text-white hover:bg-blue-700 focus-visible:outline-blue-300']}
                  >
                    {m.oss_apps_website({}, { locale })}
                    <AstroIcon name="heroicons:arrow-up-right-solid" class="ml-1 h-4 w-4 text-white" aria-hidden="true" />
                  </a>
                  <a
                    href={app.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[linkClass, 'border border-gray-600 bg-gray-800 text-white hover:bg-gray-700 focus-visible:outline-gray-300']}
                  >
                    {m.oss_apps_github({}, { locale })}
                    <AstroIcon name="heroicons:arrow-up-right-solid" class="ml-1 h-4 w-4 text-white" aria-hidden="true" />
                  </a>
                  <a
                    href={app.play}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[linkClass, 'border border-gray-600 bg-gray-800 text-white hover:bg-gray-700 focus-visible:outline-gray-300']}
                  >
                    {m.oss_apps_google_play({}, { locale })}
                    <AstroIcon name="heroicons:arrow-up-right-solid" class="ml-1 h-4 w-4 text-white" aria-hidden="true" />
                  </a>
                  {app.appStore && (
                    <a
                      href={app.appStore}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={[linkClass, 'border border-gray-600 bg-gray-800 text-white hover:bg-gray-700 focus-visible:outline-gray-300']}
                    >
                      {m.oss_apps_app_store({}, { locale })}
                      <AstroIcon name="heroicons:arrow-up-right-solid" class="ml-1 h-4 w-4 text-white" aria-hidden="true" />
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>
