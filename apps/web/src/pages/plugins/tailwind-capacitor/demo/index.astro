---
import RegistryNav from '@/components/tailwind-capacitor-demo/TailwindCapacitorDemoNav.astro'
import TailwindCapacitorInstallTabs from '@/components/tailwind-capacitor-demo/TailwindCapacitorInstallTabs.astro'
import { TAILWIND_CAPACITOR_REGISTRY_COMMIT } from '../../../../../../shared/config/tailwindCapacitorRegistry'
import manifest from '@/tailwind-capacitor-snapshot/registry-manifest.json'
import Layout from '@/layouts/Layout.astro'
import { createLdJsonGraph, createWebPageLdJson } from '@/lib/ldJson'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale ?? 'en'
const pluginHref = getRelativeLocaleUrl(locale, 'plugins/tailwind-capacitor/')
const title = 'Tailwind Capacitor live component demo'
const description =
  'Browse every Tailwind Capacitor registry component with iOS or Material styling and light or dark mode. Synced from the shadcn registry on GitHub.'

const webPage = createWebPageLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description,
  url: Astro.url.href,
})

const ldJson = createLdJsonGraph(Astro.locals.runtimeConfig.public, webPage, { includeOrganization: true })
---

<Layout content={{ title, description, ldJson, canonical: Astro.url.pathname }}>
  <section class="border-b border-white/10 bg-gray-950 px-6 py-10 lg:px-8">
    <div class="mx-auto max-w-6xl">
      <nav class="text-sm text-gray-400" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a class="text-blue-300 hover:text-blue-200" href={getRelativeLocaleUrl(locale, 'plugins/')}>Plugins</a></li>
          <li aria-hidden="true">/</li>
          <li><a class="text-blue-300 hover:text-blue-200" href={pluginHref}>Tailwind Capacitor</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gray-200">Demo</li>
        </ol>
      </nav>
      <h1 class="mt-4 font-pj text-3xl font-bold text-white sm:text-4xl">{title}</h1>
      <p class="mt-3 max-w-3xl text-base leading-7 text-gray-300">{description}</p>
      <p class="mt-2 text-xs text-gray-500">
        Registry pin: <code class="text-gray-400">{TAILWIND_CAPACITOR_REGISTRY_COMMIT}</code> ({manifest.itemCount} items)
      </p>
    </div>
  </section>

  <section class="px-6 py-8 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div class="min-w-0">
        <div class="rounded-2xl border border-white/10 bg-black/40 p-4">
          <div class="mb-4 flex flex-wrap items-center gap-3" data-tc-demo-controls>
            <fieldset class="flex flex-wrap gap-2 border-0 p-0">
              <legend class="sr-only">Platform style</legend>
              <button type="button" data-tc-platform="ios" class="tc-demo-toggle rounded-lg border border-white/15 px-3 py-1.5 text-sm text-white" aria-pressed="true">iOS</button>
              <button type="button" data-tc-platform="material" class="tc-demo-toggle rounded-lg border border-white/15 px-3 py-1.5 text-sm text-gray-300" aria-pressed="false">Material</button>
            </fieldset>
            <fieldset class="flex flex-wrap gap-2 border-0 p-0">
              <legend class="sr-only">Color mode</legend>
              <button type="button" data-tc-dark="0" class="tc-demo-toggle rounded-lg border border-white/15 px-3 py-1.5 text-sm text-white" aria-pressed="true">Light</button>
              <button type="button" data-tc-dark="1" class="tc-demo-toggle rounded-lg border border-white/15 px-3 py-1.5 text-sm text-gray-300" aria-pressed="false">Dark</button>
            </fieldset>
          </div>

          <div class="mx-auto w-full max-w-[420px] overflow-hidden rounded-[2rem] border border-white/20 bg-black shadow-2xl">
            <iframe
              id="tc-demo-iframe"
              title="Tailwind Capacitor components"
              class="h-[min(78dvh,820px)] w-full bg-white"
              src={`${getRelativeLocaleUrl(locale, 'plugins/tailwind-capacitor/demo/shell/')}?platform=ios&dark=0`}
            ></iframe>
          </div>
        </div>

        <div class="mt-8 lg:hidden">
          <RegistryNav items={manifest.items} />
        </div>

        <div class="mt-10">
          <h2 class="text-xl font-semibold text-white">Install from the registry</h2>
          <p class="mt-2 text-sm leading-6 text-gray-300">Add the same components to your Vue, React, or Angular app.</p>
          <TailwindCapacitorInstallTabs class="mt-4" />
        </div>
      </div>

      <aside class="hidden lg:block">
        <RegistryNav items={manifest.items} />
      </aside>
    </div>
  </section>
</Layout>

<script>
  const root = document.querySelector('[data-tc-demo-controls]')
  const iframe = document.getElementById('tc-demo-iframe') as HTMLIFrameElement | null
  if (root && iframe) {
    let platform = 'ios'
    let dark = false

    const shellBase = iframe.getAttribute('src')?.split('?')[0] ?? iframe.src.split('?')[0]

    const syncPressed = () => {
      root.querySelectorAll('[data-tc-platform]').forEach((btn) => {
        const el = btn as HTMLButtonElement
        const active = el.dataset.tcPlatform === platform
        el.setAttribute('aria-pressed', String(active))
        el.classList.toggle('text-white', active)
        el.classList.toggle('text-gray-300', !active)
        el.classList.toggle('border-blue-400/40', active)
      })
      root.querySelectorAll('[data-tc-dark]').forEach((btn) => {
        const el = btn as HTMLButtonElement
        const active = (el.dataset.tcDark === '1') === dark
        el.setAttribute('aria-pressed', String(active))
        el.classList.toggle('text-white', active)
        el.classList.toggle('text-gray-300', !active)
        el.classList.toggle('border-blue-400/40', active)
      })
    }

    const pushTheme = () => {
      const qs = new URLSearchParams({ platform, dark: dark ? '1' : '0' })
      iframe.src = `${shellBase}?${qs.toString()}`
      iframe.contentWindow?.postMessage({ type: 'tc-demo-theme', platform, dark }, '*')
    }

    root.querySelectorAll('[data-tc-platform]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = (btn as HTMLButtonElement).dataset.tcPlatform
        if (next === 'ios' || next === 'material') {
          platform = next
          syncPressed()
          pushTheme()
        }
      })
    })

    root.querySelectorAll('[data-tc-dark]').forEach((btn) => {
      btn.addEventListener('click', () => {
        dark = (btn as HTMLButtonElement).dataset.tcDark === '1'
        syncPressed()
        pushTheme()
      })
    })
  }
</script>
