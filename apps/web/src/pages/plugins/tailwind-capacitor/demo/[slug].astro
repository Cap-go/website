---
import TailwindCapacitorDemoFrame from '@/components/tailwind-capacitor-demo/TailwindCapacitorDemoFrame.astro'
import RegistryNav from '@/components/tailwind-capacitor-demo/TailwindCapacitorDemoNav.astro'
import TailwindCapacitorDemoInstallSection from '@/components/tailwind-capacitor-demo/TailwindCapacitorDemoInstallSection.astro'
import TailwindCapacitorDemoIntro from '@/components/tailwind-capacitor-demo/TailwindCapacitorDemoIntro.astro'
import { TAILWIND_CAPACITOR_REGISTRY_COMMIT } from '../../../../../../shared/config/tailwindCapacitorRegistry'
import {
  resolveTailwindCapacitorDemoSlug,
  tailwindCapacitorDemoNavItems,
  tailwindCapacitorDemoTitle,
} from '@/lib/tailwindCapacitorDemoCatalog'
import manifest from '@/tailwind-capacitor-snapshot/registry-manifest.json'
import Layout from '@/layouts/Layout.astro'
import { createLdJsonGraph, createWebPageLdJson } from '@/lib/ldJson'
import { getRelativeLocaleUrl } from '@/services/links'

export function getStaticPaths() {
  return tailwindCapacitorDemoNavItems.map((item) => ({
    params: { slug: item.name },
    props: { slug: item.name },
  }))
}

const locale = Astro.locals.locale ?? 'en'
const slugParam = Astro.params.slug ?? ''
const slug = resolveTailwindCapacitorDemoSlug(slugParam)
if (!slug) {
  return Astro.redirect(getRelativeLocaleUrl(locale, 'plugins/tailwind-capacitor/demo/'))
}

const pluginHref = getRelativeLocaleUrl(locale, 'plugins/tailwind-capacitor/')
const indexHref = getRelativeLocaleUrl(locale, 'plugins/tailwind-capacitor/demo/')
const componentTitle = tailwindCapacitorDemoTitle(slug)
const title = `${componentTitle} live demo`
const description = `Interactive ${componentTitle} preview with iOS or Material styling and light or dark mode. Tailwind Capacitor registry pin ${TAILWIND_CAPACITOR_REGISTRY_COMMIT}.`

const webPage = createWebPageLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description,
  url: Astro.url.href,
})

const ldJson = createLdJsonGraph(Astro.locals.runtimeConfig.public, webPage, { includeOrganization: true })
const catalogSectionCount = tailwindCapacitorDemoNavItems.length
const shellSlug = slug === 'foundation' ? 'foundation' : slug
const metaLine = `Registry pin: <code class="text-gray-400">${TAILWIND_CAPACITOR_REGISTRY_COMMIT}</code>. ${manifest.itemCount} registry items with interactive previews on dedicated pages.`
---

<Layout content={{ title, description, ldJson, canonical: Astro.url.pathname }}>
  <TailwindCapacitorDemoIntro
    locale={locale}
    title={title}
    description={description}
    metaLine={metaLine}
    pluginHref={pluginHref}
    indexHref={indexHref}
    currentCrumb={componentTitle}
    headingClass="mt-4 font-pj text-2xl font-bold text-white sm:text-4xl"
  />

  <section class="px-4 py-6 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl gap-6 lg:grid-cols-[minmax(0,240px)_minmax(0,1fr)] lg:gap-8">
      <aside class="hidden lg:block">
        <RegistryNav
          items={tailwindCapacitorDemoNavItems}
          registryItemCount={manifest.itemCount}
          catalogSectionCount={catalogSectionCount}
          locale={locale}
          activeSlug={slugParam}
        />
      </aside>

      <TailwindCapacitorDemoFrame locale={locale} slug={shellSlug} activeSlug={slugParam} />
    </div>

    <TailwindCapacitorDemoInstallSection />
  </section>
</Layout>