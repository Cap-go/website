---
import BlogListing from '@/components/BlogListing.astro'
import { filterBlogPosts } from '@/lib/blog'
import { getCollection } from 'astro:content'

const allPosts = filterBlogPosts(await getCollection('blog'), {
  origin: 'ai',
  locale: Astro.locals.locale,
})
---

<BlogListing {allPosts} listingOrigin="ai" />
