---
import ComparisonPage from '@/components/comparison/ComparisonPage.astro'
import Layout from '@/layouts/Layout.astro'
import { productTestimonials } from '@/config/productTestimonials'
import m from '@/copy/messages'
import { createLdJsonGraph, createServiceLdJson } from '@/lib/ldJson'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const config = Astro.locals.runtimeConfig.public
const title = m.codepush_alt_title({}, { locale })
const description = m.codepush_alt_meta_description({}, { locale })
const competitor = 'Microsoft CodePush'

const ldJSON = createLdJsonGraph(
  config,
  createServiceLdJson(config, {
    name: title,
    description,
    url: Astro.url.href,
    serviceType: 'Software Development Service',
    areaServed: ['Worldwide'],
  }),
  { includeOrganization: true },
)

const content = {
  title,
  description,
  image: `${config.baseUrl}/capgo_social.png`,
  keywords: 'CodePush alternative, App Center migration, Capacitor live updates, Ionic OTA',
  ldJSON,
}

const sources = [
  { label: m.compare_codepush_source_retirement({}, { locale }), href: 'https://learn.microsoft.com/en-us/appcenter/retirement' },
  { label: m.compare_codepush_source_server({}, { locale }), href: 'https://github.com/microsoft/code-push-server' },
  { label: m.compare_codepush_source_cli({}, { locale }), href: 'https://github.com/microsoft/code-push-server/blob/main/cli/README.md' },
]

const rows = {
  pricing: { text: m.compare_codepush_pricing({}, { locale }), sources: [1, 2] },
  ota: { text: m.compare_codepush_ota({}, { locale }), sources: [2] },
  native_builds: { text: m.compare_codepush_native_builds({}, { locale }), sources: [1] },
  frameworks: { text: m.compare_codepush_frameworks({}, { locale }), sources: [2] },
  open_source: { text: m.compare_codepush_open_source({}, { locale }), sources: [2] },
  rollback: { text: m.compare_codepush_rollback({}, { locale }), sources: [3] },
  support: { text: m.compare_codepush_support({}, { locale }), sources: [2] },
  company: { text: m.compare_codepush_company({}, { locale }), sources: [1, 2] },
}

const better = [
  { title: m.compare_codepush_better_1_title({}, { locale }), text: m.compare_codepush_better_1_text({}, { locale }), sources: [2] },
  { title: m.compare_codepush_better_2_title({}, { locale }), text: m.compare_codepush_better_2_text({}, { locale }), sources: [2] },
]

const migration = {
  title: m.codepush_alt_migrate_title({}, { locale }),
  lead: m.codepush_alt_migrate_p1({}, { locale }),
  steps: [
    { title: m.compare_codepush_step1_title({}, { locale }), html: m.compare_codepush_step1_text({}, { locale }) },
    { title: m.compare_step_install_title({}, { locale }), html: m.compare_codepush_step2_text({}, { locale }) },
    { title: m.compare_codepush_step3_title({}, { locale }), html: m.compare_codepush_step3_text({}, { locale }) },
  ],
  links: [
    { label: m.migrate_from_codepush_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'migrate/from-codepush') },
    { label: m.compare_codepush_blog_cta({}, { locale }), href: getRelativeLocaleUrl(locale, 'blog/appcenter-migration') },
  ],
}

const related = [
  { label: m.review_codepush_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'reviews/codepush') },
  { label: m.best_codepush_alternative_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'best/codepush-alternative') },
  { label: m.compare_codepush_blog_alternatives({}, { locale }), href: getRelativeLocaleUrl(locale, 'blog/best-codepush-alternatives-for-capacitor-ionic-cordova') },
  { label: m.live_update({}, { locale }), href: getRelativeLocaleUrl(locale, 'live-update') },
  { label: m.alternatives({}, { locale }), href: getRelativeLocaleUrl(locale, 'alternatives') },
]
---

<Layout content={content}>
  <ComparisonPage
    competitor={competitor}
    eyebrow={m.compare_codepush_eyebrow({}, { locale })}
    heading={m.codepush_alt_hero_title({}, { locale })}
    lead={m.compare_codepush_lead({}, { locale })}
    verdict={m.compare_codepush_verdict({}, { locale })}
    rows={rows}
    sources={sources}
    better={better}
    migration={migration}
    testimonials={productTestimonials.liveUpdate}
    related={related}
    secondaryCta={{ label: m.migrate_from_codepush_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'migrate/from-codepush') }}
  />
</Layout>
