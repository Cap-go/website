---
import ComparisonPage from '@/components/comparison/ComparisonPage.astro'
import Layout from '@/layouts/Layout.astro'
import { productTestimonials } from '@/config/productTestimonials'
import m from '@/copy/messages'
import { createFAQPageLdJson, createLdJsonGraph, createWebPageLdJson } from '@/lib/ldJson'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const config = Astro.locals.runtimeConfig.public
const pageUrl = new URL(Astro.url.pathname, config.baseUrl).href
const competitor = 'Median'

const faq = [
  { question: m.compare_median_faq_q1({}, { locale }), answer: m.compare_median_faq_a1({}, { locale }) },
  { question: m.compare_median_faq_q2({}, { locale }), answer: m.compare_median_faq_a2({}, { locale }) },
  { question: m.compare_median_faq_q3({}, { locale }), answer: m.compare_median_faq_a3({}, { locale }) },
  { question: m.compare_median_faq_q4({}, { locale }), answer: m.compare_median_faq_a4({}, { locale }) },
  { question: m.compare_median_faq_q5({}, { locale }), answer: m.compare_median_faq_a5({}, { locale }) },
]

const title = m.compare_median_meta_title({}, { locale })
const description = m.compare_median_meta_description({}, { locale })

const content = {
  title,
  description,
  canonical: pageUrl,
  url: pageUrl,
  image: `${config.baseUrl}/capgo_social.png`,
  keywords: 'Median vs Capgo, Median alternative, webview app builder, Capacitor live updates, Capgo',
  ldJSON: createLdJsonGraph(
    config,
    createWebPageLdJson(config, {
      name: title,
      description,
      url: pageUrl,
    }),
    {
      includeOrganization: true,
      additionalEntities: [
        createFAQPageLdJson(config, {
          url: pageUrl,
          questions: faq,
        }),
      ],
    },
  ),
}

const sources = [
  { label: m.compare_median_source_pricing({}, { locale }), href: 'https://median.co/pricing' },
  { label: m.compare_median_source_updates({}, { locale }), href: 'https://docs.median.co/docs/app-updates' },
  { label: m.compare_median_source_bridge({}, { locale }), href: 'https://docs.median.co/docs/javascript-bridge' },
  { label: m.compare_median_source_licenses({}, { locale }), href: 'https://docs.median.co/docs/licenses' },
]

const rows = {
  pricing: { text: m.compare_median_pricing({}, { locale }), sources: [1] },
  ota: { text: m.compare_median_ota({}, { locale }), sources: [2] },
  native_builds: { text: m.compare_median_native_builds({}, { locale }), sources: [1, 2] },
  frameworks: { text: m.compare_median_frameworks({}, { locale }), sources: [1] },
  open_source: { text: m.compare_median_open_source({}, { locale }), sources: [3, 1] },
  rollback: { text: m.compare_median_rollback({}, { locale }), sources: [2] },
  support: { text: m.compare_median_support({}, { locale }), sources: [1, 4] },
  company: { text: m.compare_median_company({}, { locale }), sources: [1] },
}

const better = [
  { title: m.compare_median_better_1_title({}, { locale }), text: m.compare_median_better_1_text({}, { locale }), sources: [1] },
  { title: m.compare_median_better_2_title({}, { locale }), text: m.compare_median_better_2_text({}, { locale }), sources: [1] },
  { title: m.compare_median_better_3_title({}, { locale }), text: m.compare_median_better_3_text({}, { locale }), sources: [4] },
]

const migration = {
  title: m.compare_median_migration_title({}, { locale }),
  lead: m.compare_median_migration_lead({}, { locale }),
  steps: [
    { title: m.compare_step_capacitor_title({}, { locale }), html: m.compare_step_capacitor_text({}, { locale }) },
    { title: m.compare_median_step2_title({}, { locale }), html: m.compare_median_step2_text({}, { locale }) },
    { title: m.compare_step_install_title({}, { locale }), html: m.compare_step_install_text({}, { locale }) },
  ],
  links: [
    { label: m.compare_quickstart_cta({}, { locale }), href: getRelativeLocaleUrl(locale, 'docs/getting-started/quickstart/') },
    { label: m.compare_plugins_cta({}, { locale }), href: getRelativeLocaleUrl(locale, 'plugins') },
  ],
}

const related = [
  { label: m.live_update({}, { locale }), href: getRelativeLocaleUrl(locale, 'live-update') },
  { label: m.native_build({}, { locale }), href: getRelativeLocaleUrl(locale, 'native-build') },
  { label: m.compare_premium_support_link({}, { locale }), href: getRelativeLocaleUrl(locale, 'premium-support') },
  { label: m.alternatives({}, { locale }), href: getRelativeLocaleUrl(locale, 'alternatives') },
]
---

<Layout content={content}>
  <ComparisonPage
    competitor={competitor}
    eyebrow={m.compare_median_eyebrow({}, { locale })}
    heading={m.compare_median_h1({}, { locale })}
    lead={m.compare_median_lead({}, { locale })}
    verdict={m.compare_median_verdict({}, { locale })}
    rows={rows}
    sources={sources}
    better={better}
    migration={migration}
    faq={faq}
    testimonials={productTestimonials.mobile}
    related={related}
    secondaryCta={{ label: m.compare_quickstart_cta({}, { locale }), href: getRelativeLocaleUrl(locale, 'docs/getting-started/quickstart/') }}
  />
</Layout>
