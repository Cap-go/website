---
import ComparisonPage from '@/components/comparison/ComparisonPage.astro'
import Layout from '@/layouts/Layout.astro'
import { productTestimonials } from '@/config/productTestimonials'
import { productVideos } from '@/config/productVideos'
import m from '@/copy/messages'
import { createFAQPageLdJson, createLdJsonGraph, createServiceLdJson } from '@/lib/ldJson'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const config = Astro.locals.runtimeConfig.public
const title = m.capflow_title({}, { locale })
const description = m.capflow_meta_description({}, { locale })
const competitor = 'Ionic Appflow'

const faq = [
  { question: m.appflow_faq_q1({}, { locale }), answer: m.appflow_faq_a1({}, { locale }) },
  { question: m.appflow_faq_q2({}, { locale }), answer: m.appflow_faq_a2({}, { locale }) },
  { question: m.appflow_faq_q3({}, { locale }), answer: m.appflow_faq_a3({}, { locale }) },
  { question: m.appflow_faq_q4({}, { locale }), answer: m.appflow_faq_a4({}, { locale }) },
  { question: m.appflow_faq_q5({}, { locale }), answer: m.appflow_faq_a5({}, { locale }) },
  { question: m.appflow_faq_q6({}, { locale }), answer: m.appflow_faq_a6({}, { locale }) },
]

const ldJSON = createLdJsonGraph(
  config,
  createServiceLdJson(config, {
    name: title,
    description,
    url: Astro.url.href,
    serviceType: 'Software Development Service',
    areaServed: ['Worldwide'],
  }),
  {
    includeOrganization: true,
    additionalEntities: [createFAQPageLdJson(config, { url: Astro.url.href, questions: faq })],
  },
)

const content = {
  title,
  description,
  image: `${config.baseUrl}/capgo_social.png`,
  keywords: 'Ionic Appflow alternative, Appflow shutdown, Appflow migration, Capacitor live updates, Capgo',
  ldJSON,
}

const sources = [
  { label: m.compare_appflow_source_announcement({}, { locale }), href: 'https://ionic.io/blog/important-announcement-the-future-of-ionics-commercial-products' },
  { label: m.compare_appflow_source_docs({}, { locale }), href: 'https://ionic.io/docs/appflow' },
  { label: m.compare_appflow_source_apple({}, { locale }), href: 'https://ionic.io/docs/appflow/destinations/apple' },
  { label: m.compare_appflow_source_channels({}, { locale }), href: 'https://ionic.io/docs/appflow/deploy/channels' },
]

const rows = {
  pricing: { text: m.compare_appflow_pricing({}, { locale }), sources: [1] },
  ota: { text: m.compare_appflow_ota({}, { locale }), sources: [2] },
  native_builds: { text: m.compare_appflow_native_builds({}, { locale }), sources: [2, 3] },
  frameworks: { text: m.compare_appflow_frameworks({}, { locale }), sources: [2] },
  open_source: { text: m.compare_appflow_open_source({}, { locale }), sources: [1] },
  rollback: { text: m.compare_appflow_rollback({}, { locale }), sources: [4] },
  support: { text: m.compare_appflow_support({}, { locale }), sources: [1] },
  company: { text: m.compare_appflow_company({}, { locale }), sources: [1] },
}

const better = [
  { title: m.compare_appflow_better_1_title({}, { locale }), text: m.compare_appflow_better_1_text({}, { locale }), sources: [1] },
  { title: m.compare_appflow_better_2_title({}, { locale }), text: m.compare_appflow_better_2_text({}, { locale }), sources: [2] },
  { title: m.compare_appflow_better_3_title({}, { locale }), text: m.compare_appflow_better_3_text({}, { locale }), sources: [2] },
]

const migration = {
  title: m.appflow_migration_how_title({}, { locale }),
  lead: m.compare_appflow_migration_lead({}, { locale }),
  steps: [
    { title: m.compare_step_install_title({}, { locale }), html: m.appflow_migration_step1({}, { locale }) },
    { title: m.compare_step_ready_title({}, { locale }), html: m.appflow_migration_step2({}, { locale }) },
    { title: m.compare_step_upload_title({}, { locale }), html: m.appflow_migration_step3({}, { locale }) },
  ],
  links: [
    { label: m.compare_migration_docs_cta({}, { locale }), href: getRelativeLocaleUrl(locale, 'docs/upgrade/from-appflow-to-capgo/') },
    { label: m.appflow_cta_book_migration({}, { locale }), href: 'https://book.capgo.app/appflow-migration/', external: true },
  ],
}

const plugins = [
  {
    ionic: 'Ionic Secure Storage',
    capgo: [
      { label: 'Fast SQL', href: getRelativeLocaleUrl(locale, 'docs/plugins/fast-sql/') },
      { label: 'Data Storage SQLite', href: getRelativeLocaleUrl(locale, 'docs/plugins/data-storage-sqlite/') },
    ],
    guide: getRelativeLocaleUrl(locale, 'docs/upgrade/from-ionic-secure-storage/'),
  },
  {
    ionic: 'Ionic Auth Connect',
    capgo: [{ label: 'Social Login', href: getRelativeLocaleUrl(locale, 'docs/plugins/social-login/') }],
    guide: getRelativeLocaleUrl(locale, 'docs/upgrade/from-ionic-auth-connect/'),
  },
  {
    ionic: 'Ionic Identity Vault',
    capgo: [
      { label: 'Native Biometric', href: getRelativeLocaleUrl(locale, 'docs/plugins/native-biometric/'), joiner: '+' },
      { label: 'Fast SQL', href: getRelativeLocaleUrl(locale, 'docs/plugins/fast-sql/') },
      { label: 'Data Storage SQLite', href: getRelativeLocaleUrl(locale, 'docs/plugins/data-storage-sqlite/') },
    ],
    guide: getRelativeLocaleUrl(locale, 'docs/upgrade/from-ionic-identity-vault/'),
  },
  {
    ionic: 'Ionic Zebra Scanner',
    capgo: [{ label: 'Zebra DataWedge', href: getRelativeLocaleUrl(locale, 'docs/plugins/zebra-datawedge/') }],
    guide: getRelativeLocaleUrl(locale, 'docs/plugins/zebra-datawedge/'),
  },
]

const related = [
  { label: m.migrate_from_appflow_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'migrate/from-appflow') },
  { label: m.review_appflow_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'reviews/appflow') },
  { label: m.best_appflow_alternative_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'best/appflow-alternative') },
  { label: m.alternatives({}, { locale }), href: getRelativeLocaleUrl(locale, 'alternatives') },
]
---

<Layout content={content}>
  <ComparisonPage
    competitor={competitor}
    eyebrow={m.compare_appflow_eyebrow({}, { locale })}
    heading={m.compare_appflow_h1({}, { locale })}
    lead={m.compare_appflow_lead({}, { locale })}
    verdict={m.compare_appflow_verdict({}, { locale })}
    rows={rows}
    sources={sources}
    better={better}
    migration={migration}
    faq={faq}
    testimonials={productTestimonials.liveUpdate}
    video={productVideos.appflowMigration}
    reviewWall
    related={related}
    secondaryCta={{ label: m.compare_migration_docs_cta({}, { locale }), href: getRelativeLocaleUrl(locale, 'docs/upgrade/from-appflow-to-capgo/') }}
  >
    <div slot="after-migration" class="cmp-subsection">
      <div class="section-head section-head--wide cmp-subhead">
        <h3 class="cmp-h3">{m.appflow_plugins_title({}, { locale })}</h3>
        <p class="lead">{m.appflow_plugins_desc({}, { locale })}</p>
      </div>
      <div class="comp-wrap cmp-wrap-scroll">
        <table class="cmp-simple">
          <caption class="cmp-caption">{m.appflow_plugins_caption({}, { locale })}</caption>
          <thead>
            <tr>
              <th scope="col">{m.appflow_plugins_col_ionic({}, { locale })}</th>
              <th scope="col">{m.appflow_plugins_col_capgo({}, { locale })}</th>
              <th scope="col">{m.appflow_plugins_col_guide({}, { locale })}</th>
            </tr>
          </thead>
          <tbody>
            {plugins.map((row) => (
              <tr>
                <th scope="row">{row.ionic}</th>
                <td>
                  {row.capgo.map((plugin, index) => (
                    <>
                      {index > 0 && <span> {'joiner' in row.capgo[index - 1] ? '+' : m.appflow_plugins_or({}, { locale })} </span>}
                      <a href={plugin.href}>{plugin.label}</a>
                    </>
                  ))}
                </td>
                <td>
                  <a href={row.guide}>{m.appflow_plugins_link_text({}, { locale })}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p
        class="cmp-note"
        set:html={m.appflow_enterprise_help_desc(
          {
            pluginsUrl: getRelativeLocaleUrl(locale, 'ionic-enterprise-plugins'),
            supportUrl: getRelativeLocaleUrl(locale, 'premium-support'),
            migrationUrl: getRelativeLocaleUrl(locale, 'consulting'),
          },
          { locale },
        )}
      />
    </div>
  </ComparisonPage>
</Layout>
