---
import Layout from '@/layouts/Layout.astro'
import m, { type MessageKey, type MessageValues } from '@/copy/messages'
import SolutionAppExample from '@/components/solutions/SolutionAppExample.astro'
import SolutionHowItWorks from '@/components/solutions/SolutionHowItWorks.astro'
import SolutionFaq from '@/components/solutions/SolutionFaq.astro'
import ProductTestimonials from '@/components/ProductTestimonials.astro'
import SignupCta from '@/components/SignupCta.astro'
import { solutionTestimonials } from '@/config/productTestimonials'
import { getRelativeLocaleUrl } from '@/services/links'
import { createFAQPageLdJson, createLdJsonGraph, createServiceLdJson } from '@/lib/ldJson'

const locale = Astro.locals.locale
const brand = Astro.locals.runtimeConfig.public.brand

function copy(key: MessageKey, values: MessageValues = {}) {
  return m[key](values, { locale })
}

const title = brand + ' | ' + copy('solutions_webapp_to_mobile_title')
const description = copy('solutions_webapp_to_mobile_description')
const docs = (path: string) => getRelativeLocaleUrl(locale, `docs/${path}`)

const links = {
  onboarding: { href: docs('getting-started/onboarding/'), label: copy('solutions_webapp_to_mobile_link_onboarding') },
  builder: { href: docs('builder/getting-started/'), label: copy('solutions_webapp_to_mobile_link_builder') },
  deploy: { href: docs('getting-started/deploy/'), label: copy('solutions_webapp_to_mobile_link_deploy') },
  channels: { href: docs('live-updates/channels/'), label: copy('solutions_webapp_to_mobile_link_channels') },
  compatibility: { href: docs('live-updates/compatibility/'), label: copy('solutions_webapp_to_mobile_link_compatibility') },
  cicd: { href: docs('getting-started/cicd-integration/'), label: copy('solutions_webapp_to_mobile_link_cicd') },
  plugins: { href: getRelativeLocaleUrl(locale, 'plugins'), label: copy('solutions_webapp_to_mobile_link_plugins') },
  capacitorGuide: {
    href: getRelativeLocaleUrl(locale, 'blog/how-easy-is-it-to-make-web-app-into-mobile-app-with-capacitor'),
    label: copy('solutions_webapp_to_mobile_link_capacitor_guide'),
  },
  nextjs: {
    href: getRelativeLocaleUrl(locale, 'blog/building-a-native-mobile-app-with-nextjs-and-capacitor'),
    label: copy('solutions_webapp_to_mobile_link_nextjs'),
  },
}

const howSteps = [
  {
    title: copy('solutions_webapp_to_mobile_how1_title'),
    body: copy('solutions_webapp_to_mobile_how1_body'),
    code: `npm install @capacitor/core @capacitor/cli @capacitor/ios @capacitor/android
npx cap init "Your App" com.company.app --web-dir dist
npx cap add ios
npx cap add android`,
    href: links.capacitorGuide.href,
    linkLabel: links.capacitorGuide.label,
  },
  {
    title: copy('solutions_webapp_to_mobile_how2_title'),
    body: copy('solutions_webapp_to_mobile_how2_body'),
    code: 'npx @capgo/cli@latest init',
    href: links.onboarding.href,
    linkLabel: links.onboarding.label,
  },
  {
    title: copy('solutions_webapp_to_mobile_how3_title'),
    body: copy('solutions_webapp_to_mobile_how3_body'),
    code: `npm run build && npx cap sync
npx @capgo/cli@latest build init
npx @capgo/cli@latest build request --platform ios
npx @capgo/cli@latest build request --platform android`,
    href: links.builder.href,
    linkLabel: links.builder.label,
  },
  {
    title: copy('solutions_webapp_to_mobile_how4_title'),
    body: copy('solutions_webapp_to_mobile_how4_body'),
    code: `npm run build
npx @capgo/cli@latest bundle upload --channel production`,
    href: links.deploy.href,
    linkLabel: links.deploy.label,
  },
]

const faqItems = [
  { question: copy('solutions_webapp_to_mobile_faq1_q'), answer: copy('solutions_webapp_to_mobile_faq1_a'), ...links.capacitorGuide },
  { question: copy('solutions_webapp_to_mobile_faq2_q'), answer: copy('solutions_webapp_to_mobile_faq2_a'), ...links.nextjs },
  { question: copy('solutions_webapp_to_mobile_faq3_q'), answer: copy('solutions_webapp_to_mobile_faq3_a'), ...links.builder },
  { question: copy('solutions_webapp_to_mobile_faq4_q'), answer: copy('solutions_webapp_to_mobile_faq4_a'), ...links.compatibility },
  { question: copy('solutions_webapp_to_mobile_faq5_q'), answer: copy('solutions_webapp_to_mobile_faq5_a'), ...links.cicd },
].map(({ label, ...item }) => ({ ...item, linkLabel: label }))

const serviceLdJson = createServiceLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description,
  url: Astro.url.href,
  serviceType: 'Web app to mobile release workflow',
  areaServed: ['Worldwide'],
})

const ldJSON = createLdJsonGraph(Astro.locals.runtimeConfig.public, serviceLdJson, {
  includeOrganization: true,
  additionalEntities: [createFAQPageLdJson(Astro.locals.runtimeConfig.public, { url: Astro.url.href, questions: faqItems })],
})

const content = { title, description, ldJSON, image: '/capgo_social.png' }

const stats: { value: MessageKey; label: MessageKey }[] = [
  { value: 'solutions_webapp_to_mobile_stat1_value', label: 'solutions_webapp_to_mobile_stat1_label' },
  { value: 'solutions_webapp_to_mobile_stat2_value', label: 'solutions_webapp_to_mobile_stat2_label' },
  { value: 'solutions_webapp_to_mobile_stat3_value', label: 'solutions_webapp_to_mobile_stat3_label' },
]

const pains: { title: MessageKey; desc: MessageKey }[] = [
  { title: 'solutions_webapp_to_mobile_pain1_title', desc: 'solutions_webapp_to_mobile_pain1_desc' },
  { title: 'solutions_webapp_to_mobile_pain2_title', desc: 'solutions_webapp_to_mobile_pain2_desc' },
  { title: 'solutions_webapp_to_mobile_pain3_title', desc: 'solutions_webapp_to_mobile_pain3_desc' },
]

const checks: { title: MessageKey; desc: MessageKey; link: { href: string; label: string } }[] = [
  { title: 'solutions_webapp_to_mobile_source1_title', desc: 'solutions_webapp_to_mobile_source1_desc', link: links.nextjs },
  { title: 'solutions_webapp_to_mobile_source2_title', desc: 'solutions_webapp_to_mobile_source2_desc', link: links.capacitorGuide },
  { title: 'solutions_webapp_to_mobile_source3_title', desc: 'solutions_webapp_to_mobile_source3_desc', link: links.plugins },
]

const capabilities: { title: MessageKey; desc: MessageKey; link: { href: string; label: string } }[] = [
  { title: 'solutions_webapp_to_mobile_cap1_title', desc: 'solutions_webapp_to_mobile_cap1_desc', link: links.plugins },
  { title: 'solutions_webapp_to_mobile_cap2_title', desc: 'solutions_webapp_to_mobile_cap2_desc', link: links.builder },
  { title: 'solutions_webapp_to_mobile_cap3_title', desc: 'solutions_webapp_to_mobile_cap3_desc', link: links.builder },
  { title: 'solutions_webapp_to_mobile_cap4_title', desc: 'solutions_webapp_to_mobile_cap4_desc', link: links.channels },
]

const heroCommand = `npm install @capacitor/core @capacitor/cli @capacitor/ios @capacitor/android
npx cap init "Your App" com.company.app --web-dir dist
npx cap add ios && npx cap add android
npx @capgo/cli@latest init
npx @capgo/cli@latest build request --platform ios`

const aiInstructions = `You are preparing this existing web app to become an installable iOS and Android app.
Do not assume you can run local tooling. If this environment cannot create native projects or run local tools, create a clean handoff document instead.

Inspect the app and return:

1. The framework, package manager, production build process, and build output folder.
2. Whether the app can be exported or committed to a real Git repository.
3. The app name, bundle ID or package ID suggestion, app icon and splash-screen source, and any missing brand assets.
4. Auth, redirect, deep-link, storage, camera, push, payment, geolocation, file, or notification features that need native plugin planning.
5. Routing, environment variables, API URLs, and asset assumptions that could break inside a native WebView.
6. A proposed Capacitor configuration, including appId, appName, webDir, and required plugins, without inventing secrets.
7. A release-channel plan: production, staging, preview, and rollback expectations for web-layer updates.
8. A list of tasks that must happen outside this environment, such as Apple signing, Android keystore setup, native sync, store records, and signed builds.
9. A docs/mobile-release-handoff.md file with the exact checklist, open questions, and files that a developer or build service should handle next.
10. A short summary of what you changed, what you could not do in this environment, and the next human action.`
---

<Layout content={content}>
  <div class="product-hero">
    <section class="border-b border-white/10 py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-[1fr_0.95fr] lg:items-center">
          <div class="min-w-0">
            <p class="inline-flex min-h-11 items-center rounded-lg border border-cyan-400/30 bg-cyan-500/10 px-4 text-base font-semibold text-cyan-100 sm:text-sm">
              {copy('solutions_webapp_to_mobile_badge')}
            </p>
            <h1 class="mt-6 max-w-4xl text-4xl font-semibold text-white sm:text-5xl lg:text-6xl">{copy('solutions_webapp_to_mobile_h1')}</h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl">{copy('solutions_webapp_to_mobile_lead')}</p>
            <SignupCta align="start" class="mt-8" />
            <dl class="mt-10 grid gap-3 sm:grid-cols-3">
              {stats.map((stat) => (
                <div class="flex flex-col rounded-lg border border-white/10 bg-white/[0.04] p-4">
                  <dt class="order-2 mt-1 text-base leading-6 text-slate-400 sm:text-sm">{copy(stat.label)}</dt>
                  <dd class="order-1 text-2xl font-semibold text-white">{copy(stat.value)}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="min-w-0 overflow-hidden rounded-lg border border-white/10 bg-slate-950 shadow-2xl shadow-cyan-950/25">
            <div class="border-b border-white/10 px-4 py-3">
              <div class="flex items-center gap-2">
                <span aria-hidden="true" class="h-3 w-3 rounded-full bg-red-400/70"></span>
                <span aria-hidden="true" class="h-3 w-3 rounded-full bg-amber-300/70"></span>
                <span aria-hidden="true" class="h-3 w-3 rounded-full bg-emerald-300/70"></span>
              </div>
            </div>
            <pre class="overflow-x-auto p-5 text-sm leading-7 whitespace-pre-wrap text-slate-200 [overflow-wrap:anywhere]"><code>{heroCommand}</code></pre>
            <div class="grid gap-0 border-t border-white/10 sm:grid-cols-2">
              <div class="border-white/10 bg-slate-950 p-4 sm:border-r">
                <p class="text-base font-semibold text-cyan-100 sm:text-sm">{copy('solutions_webapp_to_mobile_visual_from')}</p>
                <p class="mt-2 text-base leading-6 text-slate-300 sm:text-sm">{copy('solutions_webapp_to_mobile_visual_from_detail')}</p>
              </div>
              <div class="bg-emerald-950/30 p-4">
                <p class="text-base font-semibold text-emerald-100 sm:text-sm">{copy('solutions_webapp_to_mobile_visual_to')}</p>
                <p class="mt-2 text-base leading-6 text-slate-300 sm:text-sm">{copy('solutions_webapp_to_mobile_visual_to_detail')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="problem" class="bg-gray-950 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold text-red-300 uppercase">{copy('solutions_the_problem')}</p>
          <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">{copy('solutions_webapp_to_mobile_problem_title')}</h2>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {pains.map((pain) => (
            <article class="rounded-lg border border-red-400/20 bg-red-950/20 p-6">
              <h3 class="text-xl font-semibold text-white">{copy(pain.title)}</h3>
              <p class="mt-3 text-base leading-7 text-slate-300">{copy(pain.desc)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="source-requirements" class="border-y border-white/10 bg-slate-900 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold text-amber-200 uppercase">{copy('solutions_webapp_to_mobile_source_label')}</p>
          <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">{copy('solutions_webapp_to_mobile_source_title')}</h2>
          <p class="mt-4 text-lg leading-8 text-slate-300">{copy('solutions_webapp_to_mobile_source_lead')}</p>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {checks.map((check, index) => (
            <article class="flex flex-col rounded-lg border border-white/10 bg-gray-950 p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-500/15 font-semibold text-amber-200 ring-1 ring-amber-400/20" aria-hidden="true">
                {index + 1}
              </div>
              <h3 class="mt-5 text-xl font-semibold text-white">{copy(check.title)}</h3>
              <p class="mt-3 text-base leading-7 text-slate-300">{copy(check.desc)}</p>
              <a href={check.link.href} class="mt-auto inline-flex pt-4 text-sm font-semibold text-cyan-300 hover:text-white hover:underline">
                {check.link.label}
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="capabilities" class="bg-gray-950 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold text-cyan-200 uppercase">{copy('solutions_the_solution')}</p>
            <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">{copy('solutions_webapp_to_mobile_cap_title')}</h2>
            <p class="mt-4 text-lg leading-8 text-slate-300">{copy('solutions_webapp_to_mobile_cap_lead')}</p>
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            {capabilities.map((capability) => (
              <article class="flex flex-col rounded-lg border border-white/10 bg-white/[0.04] p-5">
                <h3 class="text-lg font-semibold text-white">{copy(capability.title)}</h3>
                <p class="mt-3 text-base leading-7 text-slate-300">{copy(capability.desc)}</p>
                <a href={capability.link.href} class="mt-auto inline-flex pt-4 text-sm font-semibold text-cyan-300 hover:text-white hover:underline">
                  {capability.link.label}
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <SolutionHowItWorks
      eyebrow={copy('solutions_how_it_works_eyebrow')}
      title={copy('solutions_webapp_to_mobile_how_title')}
      description={copy('solutions_webapp_to_mobile_how_desc')}
      steps={howSteps}
      docsTitle={copy('solutions_docs_title')}
      docs={[links.onboarding, links.builder, links.deploy, links.channels, links.compatibility, links.cicd]}
      class="border-y border-white/10 bg-slate-900"
    />

    <section id="ai-instructions" class="bg-gray-950 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold text-emerald-200 uppercase">{copy('solutions_webapp_to_mobile_code_label')}</p>
            <h2 class="mt-3 text-3xl font-semibold text-white sm:text-4xl">{copy('solutions_webapp_to_mobile_code_title')}</h2>
            <p class="mt-4 text-lg leading-8 text-slate-300">{copy('solutions_webapp_to_mobile_code_lead')}</p>
          </div>
          <div class="min-w-0 rounded-lg border border-white/10 bg-black/50">
            <div class="flex items-center justify-between gap-4 border-b border-white/10 px-4 py-3">
              <p class="text-sm font-semibold text-slate-300">{copy('solutions_webapp_to_mobile_prompt_card_title')}</p>
              <button
                type="button"
                class="inline-flex min-h-10 items-center rounded-lg border border-emerald-400/30 px-3 text-sm font-semibold text-emerald-100 transition-colors hover:bg-emerald-500/10 focus:ring-2 focus:ring-emerald-300 focus:ring-offset-2 focus:ring-offset-slate-950 focus:outline-none"
                data-copy-prompt={aiInstructions}
              >
                {copy('solutions_webapp_to_mobile_prompt_copy')}
              </button>
            </div>
            <pre class="max-h-[32rem] overflow-auto p-5 text-sm leading-7 whitespace-pre-wrap text-slate-200"><code>{aiInstructions}</code></pre>
          </div>
        </div>
      </div>
    </section>

    <SolutionAppExample solution="webapp-to-mobile" />
    <ProductTestimonials eyebrow={copy('solutions_testimonials_eyebrow')} title={copy('solutions_testimonials_title')} testimonials={solutionTestimonials['webapp-to-mobile']} />
    <SolutionFaq
      eyebrow={copy('solutions_faq_eyebrow')}
      title={copy('solutions_webapp_to_mobile_faq_title')}
      description={copy('solutions_webapp_to_mobile_faq_desc')}
      items={faqItems}
    />

    <section class="bg-slate-900 py-16 sm:py-20">
      <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="text-3xl font-semibold text-white sm:text-4xl">{copy('solutions_webapp_to_mobile_cta_title')}</h2>
        <p class="mx-auto mt-4 max-w-3xl text-lg leading-8 text-slate-300">{copy('solutions_webapp_to_mobile_cta_subtitle')}</p>
        <SignupCta humanSupport enterprise class="mt-8" />
      </div>
    </section>
  </div>
</Layout>

<script>
  async function copyPrompt(button: HTMLButtonElement): Promise<void> {
    const value = button.dataset.copyPrompt
    if (!value || !navigator.clipboard?.writeText) return

    const original = button.textContent || 'Copy prompt'

    try {
      await navigator.clipboard.writeText(value)
      button.textContent = 'Copied'
      window.setTimeout(() => {
        button.textContent = original
      }, 1800)
    } catch {
      button.textContent = original
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((button) => {
    button.addEventListener('click', () => copyPrompt(button))
  })
</script>
