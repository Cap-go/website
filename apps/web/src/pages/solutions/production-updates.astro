---
import Layout from '@/layouts/Layout.astro'
import m from '@/copy/messages'
import SolutionAppExample from '@/components/solutions/SolutionAppExample.astro'
import SolutionHowItWorks from '@/components/solutions/SolutionHowItWorks.astro'
import SolutionFaq from '@/components/solutions/SolutionFaq.astro'
import ProductTestimonials from '@/components/ProductTestimonials.astro'
import { solutionTestimonials } from '@/config/productTestimonials'
import { getRelativeLocaleUrl } from '@/services/links'
import { createFAQPageLdJson, createServiceLdJson, createLdJsonGraph } from '@/lib/ldJson'
import HumanSupport from '@/components/HumanSupport.astro'

const locale = Astro.locals.locale
const brand = Astro.locals.runtimeConfig.public.brand
const docs = (path: string) => getRelativeLocaleUrl(locale, `docs/${path}`)

const title = `${brand} | ${m.solutions_production_updates_title({}, { locale })}`
const description = m.solutions_production_updates_description({}, { locale })

const links = {
  updateBehavior: { href: docs('live-updates/update-behavior/'), label: m.solutions_production_updates_link_update_behavior({}, { locale }) },
  delta: { href: docs('live-updates/differentials/'), label: m.solutions_production_updates_link_delta({}, { locale }) },
  rollouts: { href: docs('live-updates/progressive-rollouts/'), label: m.solutions_production_updates_link_rollouts({}, { locale }) },
  notify: { href: docs('plugins/updater/notify-app-ready/'), label: m.solutions_production_updates_link_notify({}, { locale }) },
  observe: { href: docs('webapp/observe/'), label: m.solutions_production_updates_link_observe({}, { locale }) },
  notifications: { href: docs('webapp/channels/#send-update-notification'), label: m.solutions_production_updates_link_notifications({}, { locale }) },
  versionTargeting: { href: docs('live-updates/version-targeting/'), label: m.solutions_production_updates_link_version_targeting({}, { locale }) },
  rollbacks: { href: docs('live-updates/rollbacks/'), label: m.solutions_production_updates_link_rollbacks({}, { locale }) },
  compatibility: { href: docs('live-updates/compatibility/'), label: m.solutions_production_updates_link_compatibility({}, { locale }) },
}

const useCases = [
  {
    title: m.solutions_usecase1_title({}, { locale }),
    desc: m.solutions_usecase1_desc({}, { locale }),
    link: links.updateBehavior,
    color: 'bg-blue-500/20 text-blue-400',
    icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
  },
  {
    title: m.solutions_usecase2_title({}, { locale }),
    desc: m.solutions_usecase2_desc({}, { locale }),
    link: links.compatibility,
    color: 'bg-purple-500/20 text-purple-400',
    icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
  },
  {
    title: m.solutions_usecase3_title({}, { locale }),
    desc: m.solutions_usecase3_desc({}, { locale }),
    link: links.observe,
    color: 'bg-green-500/20 text-green-400',
    icon: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  },
  {
    title: m.solutions_usecase4_title({}, { locale }),
    desc: m.solutions_usecase4_desc({}, { locale }),
    link: links.notifications,
    color: 'bg-amber-500/20 text-amber-400',
    icon: 'M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9',
  },
  {
    title: m.solutions_usecase5_title({}, { locale }),
    desc: m.solutions_usecase5_desc({}, { locale }),
    link: links.versionTargeting,
    color: 'bg-rose-500/20 text-rose-400',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: m.solutions_usecase6_title({}, { locale }),
    desc: m.solutions_usecase6_desc({}, { locale }),
    link: links.rollbacks,
    color: 'bg-cyan-500/20 text-cyan-400',
    icon: 'M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6',
  },
]

const howSteps = [
  {
    title: m.solutions_production_updates_how1_title({}, { locale }),
    body: m.solutions_production_updates_how1_body({}, { locale }),
    code: `npx @capgo/cli@latest init
# in your app start-up code
await CapacitorUpdater.notifyAppReady()`,
    href: links.notify.href,
    linkLabel: links.notify.label,
  },
  {
    title: m.solutions_production_updates_how2_title({}, { locale }),
    body: m.solutions_production_updates_how2_body({}, { locale }),
    code: 'npx @capgo/cli@latest bundle upload --channel production --delta --rollout 5',
    href: links.rollouts.href,
    linkLabel: links.rollouts.label,
  },
  {
    title: m.solutions_production_updates_how3_title({}, { locale }),
    body: m.solutions_production_updates_how3_body({}, { locale }),
    code: `npx @capgo/cli@latest channel set production \\
  --auto-pause-enabled \\
  --auto-pause-failure-rate-bps 500 \\
  --auto-pause-action rollback`,
    href: links.observe.href,
    linkLabel: links.observe.label,
  },
  {
    title: m.solutions_production_updates_how4_title({}, { locale }),
    body: m.solutions_production_updates_how4_body({}, { locale }),
    code: `npx @capgo/cli@latest channel set production --rollout-promote
# or, if something looks wrong
npx @capgo/cli@latest channel set production --rollout-rollback`,
    href: links.rollbacks.href,
    linkLabel: links.rollbacks.label,
  },
]

const faqItems = [
  { question: m.solutions_production_updates_faq1_q({}, { locale }), answer: m.solutions_production_updates_faq1_a({}, { locale }), ...links.updateBehavior },
  { question: m.solutions_production_updates_faq2_q({}, { locale }), answer: m.solutions_production_updates_faq2_a({}, { locale }), ...links.notifications },
  { question: m.solutions_production_updates_faq3_q({}, { locale }), answer: m.solutions_production_updates_faq3_a({}, { locale }), ...links.rollbacks },
  { question: m.solutions_production_updates_faq4_q({}, { locale }), answer: m.solutions_production_updates_faq4_a({}, { locale }), ...links.rollouts },
  { question: m.solutions_production_updates_faq5_q({}, { locale }), answer: m.solutions_production_updates_faq5_a({}, { locale }), ...links.compatibility },
].map(({ label, ...item }) => ({ ...item, linkLabel: label }))

const serviceLdJson = createServiceLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description: description,
  url: Astro.url.href,
  serviceType: 'Software Development Service',
  areaServed: ['Worldwide'],
})

const ldJSON = createLdJsonGraph(Astro.locals.runtimeConfig.public, serviceLdJson, {
  includeOrganization: true,
  additionalEntities: [createFAQPageLdJson(Astro.locals.runtimeConfig.public, { url: Astro.url.href, questions: faqItems })],
})

const content = { title, description, ldJSON }
---

<Layout content={content}>
  <div class="product-hero">
    <!-- Hero Section with Problem Statement -->
    <section class="relative overflow-hidden py-20 sm:py-28 lg:py-36">
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute top-0 left-1/2 h-full w-full max-w-6xl -translate-x-1/2">
          <div class="absolute top-1/4 left-1/4 h-96 w-96 rounded-full bg-blue-500/10 blur-3xl"></div>
          <div class="absolute right-1/4 bottom-1/4 h-96 w-96 rounded-full bg-purple-500/10 blur-3xl"></div>
        </div>
      </div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-4xl text-center">
          <div class="mb-8 inline-flex items-center rounded-full border border-blue-400/40 bg-blue-500/10 px-4 py-2 text-sm font-medium text-blue-200">
            <svg aria-hidden="true" class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
              ></path>
            </svg>
            {m.solutions_production_updates({}, { locale })}
          </div>

          <h1 class="text-4xl leading-tight font-bold text-white sm:text-5xl lg:text-6xl">{m.solutions_production_updates_hero_title({}, { locale })}</h1>

          <p class="mx-auto mt-8 max-w-3xl text-xl leading-relaxed text-gray-300">{m.solutions_production_updates_hero_subtitle({}, { locale })}</p>

          <HumanSupport class="mt-8" size="sm" />
          <div class="mt-4 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a
              href={getRelativeLocaleUrl(locale, 'register')}
              class="rounded-xl bg-blue-600 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-blue-500/25 transition-all duration-200 hover:bg-blue-700 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
            >
              {m.solutions_start_free_trial({}, { locale })}
            </a>
            <a
              href="https://book.capgo.app/demo/"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl border border-gray-600 px-8 py-4 text-base font-semibold text-gray-300 transition-all duration-200 hover:bg-gray-800 hover:text-white"
            >
              {m.solutions_talk_to_team({}, { locale })}
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-sm text-gray-400">
            <div class="flex items-center gap-2">
              <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              {m.solutions_no_credit_card({}, { locale })}
            </div>
            <div class="flex items-center gap-2">
              <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              {m.solutions_production_updates_badge_rollback({}, { locale })}
            </div>
            <div class="flex items-center gap-2">
              <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              {m.solutions_app_store_compliant({}, { locale })}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The Problem: Detailed Pain Point Section -->
    <section class="bg-gray-800 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <p class="mb-4 text-sm font-semibold tracking-wide text-red-400 uppercase">{m.solutions_the_problem({}, { locale })}</p>
          <h2 class="text-3xl font-bold text-white sm:text-4xl">{m.solutions_production_problem_title({}, { locale })}</h2>
        </div>

        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <!-- Problem Visualization -->
          <div class="rounded-2xl border border-red-500/30 bg-gray-900 p-8">
            <h3 class="mb-6 text-xl font-bold text-white">{m.solutions_traditional_workflow({}, { locale })}</h3>

            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-500/20">
                  <span class="font-bold text-red-400">1</span>
                </div>
                <div>
                  <p class="font-semibold text-white">{m.solutions_problem_step1_title({}, { locale })}</p>
                  <p class="mt-1 text-sm text-gray-400">{m.solutions_problem_step1_desc({}, { locale })}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-500/20">
                  <span class="font-bold text-red-400">2</span>
                </div>
                <div>
                  <p class="font-semibold text-white">{m.solutions_problem_step2_title({}, { locale })}</p>
                  <p class="mt-1 text-sm text-gray-400">{m.solutions_problem_step2_desc({}, { locale })}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-500/20">
                  <span class="font-bold text-red-400">3</span>
                </div>
                <div>
                  <p class="font-semibold text-white">{m.solutions_problem_step3_title({}, { locale })}</p>
                  <p class="mt-1 text-sm text-gray-400">{m.solutions_problem_step3_desc({}, { locale })}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-500/20">
                  <span class="font-bold text-red-400">4</span>
                </div>
                <div>
                  <p class="font-semibold text-white">{m.solutions_problem_step4_title({}, { locale })}</p>
                  <p class="mt-1 text-sm text-gray-400">{m.solutions_problem_step4_desc({}, { locale })}</p>
                </div>
              </div>
            </div>

            <div class="mt-8 rounded-xl border border-red-500/30 bg-red-500/10 p-4">
              <p class="font-medium text-red-300">{m.solutions_problem_result({}, { locale })}</p>
            </div>
          </div>

          <!-- Real World Impact -->
          <div>
            <h3 class="mb-6 text-xl font-bold text-white">{m.solutions_real_cost({}, { locale })}</h3>

            <div class="space-y-6">
              <div class="rounded-xl border border-gray-700 bg-gray-900 p-6">
                <div class="mb-3 flex items-center gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-500/20">
                    <svg aria-hidden="true" class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-2xl font-bold text-white">24–48h+</p>
                    <p class="text-gray-400">{m.solutions_avg_review_time({}, { locale })}</p>
                  </div>
                </div>
                <p class="text-sm text-gray-400">{m.solutions_review_time_explanation({}, { locale })}</p>
              </div>
              <div class="rounded-xl border border-gray-700 bg-gray-900 p-6">
                <div class="mb-3 flex items-center gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-500/20">
                    <svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-2xl font-bold text-white">{m.solutions_cost_adoption_value({}, { locale })}</p>
                    <p class="text-gray-400">{m.solutions_cost_adoption_label({}, { locale })}</p>
                  </div>
                </div>
                <p class="text-sm text-gray-400">{m.solutions_cost_adoption_explanation({}, { locale })}</p>
              </div>
              <div class="rounded-xl border border-gray-700 bg-gray-900 p-6">
                <div class="mb-3 flex items-center gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-500/20">
                    <svg class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <p class="text-2xl font-bold text-white">{m.solutions_cost_damage_value({}, { locale })}</p>
                    <p class="text-gray-400">{m.solutions_cost_damage_label({}, { locale })}</p>
                  </div>
                </div>
                <p class="text-sm text-gray-400">{m.solutions_cost_damage_explanation({}, { locale })}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The Solution: How Capgo Works -->
    <section class="bg-gray-900 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <p class="mb-4 text-sm font-semibold tracking-wide text-green-400 uppercase">{m.solutions_the_solution({}, { locale })}</p>
          <h2 class="text-3xl font-bold text-white sm:text-4xl">{m.solutions_production_solution_title({}, { locale })}</h2>
          <p class="mt-4 text-xl text-gray-400">{m.solutions_production_solution_subtitle({}, { locale })}</p>
        </div>

        <div class="mx-auto max-w-4xl rounded-2xl border border-green-500/30 bg-gray-800 p-8">
          <h3 class="mb-6 text-center text-xl font-bold text-white">{m.solutions_with_capgo({}, { locale })}</h3>

          <ol class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {[
              [m.solutions_solution_step1_title({}, { locale }), m.solutions_solution_step1_desc({}, { locale }), m.solutions_solution_step1_time({}, { locale })],
              [m.solutions_solution_step2_title({}, { locale }), m.solutions_solution_step2_desc({}, { locale }), m.solutions_solution_step2_time({}, { locale })],
              [m.solutions_solution_step3_title({}, { locale }), m.solutions_solution_step3_desc({}, { locale }), m.solutions_solution_step3_time({}, { locale })],
            ].map(([stepTitle, stepDesc, stepTime], index) => (
              <li class="rounded-xl bg-gray-900 p-6 text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-green-500/20" aria-hidden="true">
                  <span class="text-xl font-bold text-green-400">{index + 1}</span>
                </div>
                <h4 class="mb-2 font-semibold text-white">{stepTitle}</h4>
                <p class="text-sm text-gray-400">{stepDesc}</p>
                <p class="mt-3 font-medium text-green-400">{stepTime}</p>
              </li>
            ))}
          </ol>

          <div class="mt-8 rounded-xl border border-green-500/30 bg-green-500/10 p-4 text-center">
            <p class="font-medium text-green-300">{m.solutions_solution_result({}, { locale })}</p>
            <a href={getRelativeLocaleUrl(locale, 'solutions/direct-updates')} class="mt-2 inline-flex text-sm font-semibold text-green-200 underline hover:text-white">
              {m.solutions_production_updates_link_direct({}, { locale })}
            </a>
          </div>
          <p class="mt-4 text-center text-sm">
            <a href={links.updateBehavior.href} class="font-semibold text-blue-300 hover:text-white hover:underline">
              {links.updateBehavior.label}
            </a>
          </p>
        </div>
      </div>
    </section>

    <SolutionHowItWorks
      eyebrow={m.solutions_how_it_works_eyebrow({}, { locale })}
      title={m.solutions_production_updates_how_title({}, { locale })}
      description={m.solutions_production_updates_how_desc({}, { locale })}
      steps={howSteps}
      docsTitle={m.solutions_docs_title({}, { locale })}
      docs={[links.updateBehavior, links.delta, links.rollouts, links.notify, links.observe, links.notifications, links.versionTargeting]}
      class="bg-gray-900 border-t border-white/10"
    />

    <!-- Key Benefits -->
    <section class="bg-gray-800 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <h2 class="text-3xl font-bold text-white sm:text-4xl">{m.solutions_why_teams_choose({}, { locale })}</h2>
          <p class="mt-4 text-xl text-gray-400">{m.solutions_benefits_subtitle({}, { locale })}</p>
        </div>

        <div class="space-y-8">
          <div class="rounded-2xl border border-gray-700 bg-gray-800 p-8 lg:p-10">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
              <div class="lg:col-span-2">
                <div class="mb-4 flex items-center gap-3">
                  <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-500/20">
                    <svg class="h-5 w-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
