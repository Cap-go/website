      title={copy('solutions_lovable_to_mobile_how_title')}
      description={copy('solutions_lovable_to_mobile_how_desc')}
      steps={howSteps}
      docsTitle={copy('solutions_docs_title')}
      docs={[links.tutorial, links.onboarding, links.builder, links.githubActions, links.compatibility, links.mcp]}
