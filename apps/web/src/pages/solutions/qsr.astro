                    </svg>
                    {m.solutions_qsr_sol3_point1({}, { locale })}
                  </li>
                  <li class="flex items-center gap-3 text-gray-300">
                    <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {m.solutions_qsr_sol3_point2({}, { locale })}
                  </li>
                  <li class="flex items-center gap-3 text-gray-300">
                    <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {m.solutions_qsr_sol3_point3({}, { locale })}
                  </li>
                </ul>
                <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
                  <a href={links.channels.href} class="text-blue-300 hover:text-white hover:underline">
                    {links.channels.label}
                  </a>
                  <a href={links.rollouts.href} class="text-blue-300 hover:text-white hover:underline">
                    {links.rollouts.label}
                  </a>
                </div>
              </div>
              <div class="min-w-0 rounded-xl bg-gray-800 p-6">
                <pre class="overflow-x-auto text-sm leading-6 whitespace-pre-wrap text-gray-300 [overflow-wrap:anywhere]"><code>{marketCode}</code></pre>
              </div>
            </div>
          </div>

          <!-- Solution 4: Kiosks -->
          <div class="rounded-2xl border border-gray-700 bg-gray-900 p-8 lg:p-10">
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2">
              <div class="order-2 min-w-0 rounded-xl bg-gray-800 p-6 lg:order-1">
                <div class="mb-4 flex items-center gap-2">
                  <div class="h-3 w-3 rounded-full bg-gray-500"></div>
                  <div class="h-3 w-3 rounded-full bg-gray-500"></div>
                  <div class="h-3 w-3 rounded-full bg-gray-500"></div>
                  <span class="ml-2 text-sm text-gray-500">kiosk updates</span>
                </div>
                <pre class="overflow-x-auto text-sm leading-6 whitespace-pre-wrap text-gray-300 [overflow-wrap:anywhere]"><code>{kioskCode}</code></pre>
              </div>
              <div class="order-1 lg:order-2">
                <div class="mb-6 flex items-center gap-3">
                  <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-purple-500/20">
                    <svg aria-hidden="true" class="h-6 w-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
