                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {m.solutions_qsr_sol4_point1({}, { locale })}
                  </li>
                  <li class="flex items-center gap-3 text-gray-300">
                    <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {m.solutions_qsr_sol4_point2({}, { locale })}
                  </li>
                  <li class="flex items-center gap-3 text-gray-300">
                    <svg aria-hidden="true" class="h-5 w-5 shrink-0 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {m.solutions_qsr_sol4_point3({}, { locale })}
                  </li>
                </ul>
                <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold">
                  <a href={links.kiosk.href} class="text-blue-300 hover:text-white hover:underline">
                    {links.kiosk.label}
                  </a>
                  <a href={links.updateBehavior.href} class="text-blue-300 hover:text-white hover:underline">
                    {links.updateBehavior.label}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="bg-gray-900 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <dl class="grid grid-cols-2 gap-8 lg:grid-cols-4">
          <div class="flex flex-col-reverse text-center">
            <dt class="mt-2 text-gray-400">{m.solutions_qsr_stat1({}, { locale })}</dt>
            <dd class="text-4xl font-bold text-orange-400 lg:text-5xl">1B+</dd>
          </div>
          <div class="flex flex-col-reverse text-center">
            <dt class="mt-2 text-gray-400">{m.solutions_qsr_stat2({}, { locale })}</dt>
            <dd class="text-4xl font-bold text-orange-400 lg:text-5xl">~50ms</dd>
          </div>
          <div class="flex flex-col-reverse text-center">
            <dt class="mt-2 text-gray-400">{m.solutions_qsr_stat3({}, { locale })}</dt>
            <dd class="text-4xl font-bold text-orange-400 lg:text-5xl">90M+</dd>
          </div>
          <div class="flex flex-col-reverse text-center">
            <dt class="mt-2 text-gray-400">{m.solutions_qsr_stat4({}, { locale })}</dt>
            <dd class="text-4xl font-bold text-orange-400 lg:text-5xl">4.7K+</dd>
          </div>
        </dl>
      </div>
    </section>

    <SolutionHowItWorks
      eyebrow={m.solutions_how_it_works_eyebrow({}, { locale })}
      title={m.solutions_qsr_how_title({}, { locale })}
      description={m.solutions_qsr_how_desc({}, { locale })}
      steps={howSteps}
      docsTitle={m.solutions_docs_title({}, { locale })}
      docs={[links.channels, links.rollouts, links.rollbacks, links.updateBehavior, links.integrations, links.roles, links.kiosk]}
      class="bg-gray-900 border-t border-white/10"
    />

    <SolutionAppExample solution="qsr" />
    <ProductTestimonials
      eyebrow={m.solutions_testimonials_eyebrow({}, { locale })}
      title={m.solutions_testimonials_title({}, { locale })}
      testimonials={solutionTestimonials.qsr}
    />
    <SolutionFaq
      eyebrow={m.solutions_faq_eyebrow({}, { locale })}
      title={m.solutions_qsr_faq_title({}, { locale })}
      description={m.solutions_qsr_faq_desc({}, { locale })}
      items={faqItems}
    />

    <!-- CTA Section -->
    <section class="bg-gray-900 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-3xl bg-linear-to-r from-orange-600 to-red-600 px-8 py-16 sm:px-16">
          <div aria-hidden="true" class="absolute inset-0">
            <svg
              aria-hidden="true"
              class="absolute inset-0 h-full w-full"
              preserveAspectRatio="xMidYMid slice"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 1463 360"
            >
              <path class="text-opacity-40 text-orange-500" fill="currentColor" d="M-82.673 72l1761.849 472.086-134.327 501.315-1761.85-472.086z"></path>
              <path class="text-opacity-20 text-red-400" fill="currentColor" d="M-217.088 544.086L1544.761 72l134.327 501.316-1761.849 472.086z"></path>
            </svg>
          </div>
          <div class="relative text-center">
            <h2 class="text-3xl font-bold text-white sm:text-4xl">{m.solutions_qsr_cta_title({}, { locale })}</h2>
            <p class="mx-auto mt-4 max-w-2xl text-lg text-orange-100">{m.solutions_qsr_cta_subtitle({}, { locale })}</p>
            <SignupCta enterprise class="mt-8" />
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
