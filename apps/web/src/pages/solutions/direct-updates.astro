---
import Layout from '@/layouts/Layout.astro'
import m from '@/copy/messages'
import SolutionAppExample from '@/components/solutions/SolutionAppExample.astro'
import SolutionHowItWorks from '@/components/solutions/SolutionHowItWorks.astro'
import SolutionFaq from '@/components/solutions/SolutionFaq.astro'
import ProductTestimonials from '@/components/ProductTestimonials.astro'
import { solutionTestimonials } from '@/config/productTestimonials'
import { getRelativeLocaleUrl } from '@/services/links'
import { createFAQPageLdJson, createServiceLdJson, createLdJsonGraph } from '@/lib/ldJson'
import SignupCta from '@/components/SignupCta.astro'

const locale = Astro.locals.locale
const brand = Astro.locals.runtimeConfig.public.brand
const docs = (path: string) => getRelativeLocaleUrl(locale, `docs/${path}`)

const title = `${brand} | ${m.solutions_direct_updates_title({}, { locale })}`
const description = m.solutions_direct_updates_description({}, { locale })

const links = {
  updateBehavior: { href: docs('live-updates/update-behavior/'), label: m.solutions_direct_link_update_behavior({}, { locale }) },
  settings: { href: docs('plugins/updater/settings/'), label: m.solutions_direct_link_settings({}, { locale }) },
  splash: { href: docs('live-updates/update-behavior/#automatic-splashscreen-handling'), label: m.solutions_direct_link_splash({}, { locale }) },
  delta: { href: docs('live-updates/differentials/'), label: m.solutions_direct_link_delta({}, { locale }) },
  notify: { href: docs('plugins/updater/notify-app-ready/'), label: m.solutions_direct_link_notify({}, { locale }) },
  compatibility: { href: docs('live-updates/compatibility/'), label: m.solutions_direct_link_compatibility({}, { locale }) },
  build: { href: docs('builder/getting-started/'), label: m.solutions_direct_link_build({}, { locale }) },
}

const howSteps = [
  {
    title: m.solutions_direct_how1_title({}, { locale }),
    body: m.solutions_direct_how1_body({}, { locale }),
    code: `npm install @capacitor/splash-screen
npx cap sync

// capacitor.config.ts
plugins: {
  CapacitorUpdater: {
    autoUpdate: 'onLaunch', // or 'atInstall' / 'always'
    autoSplashscreen: true,
    keepUrlPathAfterReload: true,
  },
  SplashScreen: { launchAutoHide: false },
}`,
    href: links.splash.href,
    linkLabel: links.splash.label,
  },
  {
    title: m.solutions_direct_how2_title({}, { locale }),
    body: m.solutions_direct_how2_body({}, { locale }),
    code: `npx @capgo/cli@latest build request --platform ios
npx @capgo/cli@latest build request --platform android`,
    href: links.build.href,
    linkLabel: links.build.label,
  },
  {
    title: m.solutions_direct_how3_title({}, { locale }),
    body: m.solutions_direct_how3_body({}, { locale }),
    code: 'npx @capgo/cli@latest bundle upload --channel production --delta',
    href: links.delta.href,
    linkLabel: links.delta.label,
  },
  {
    title: m.solutions_direct_how4_title({}, { locale }),
    body: m.solutions_direct_how4_body({}, { locale }),
    code: `import { CapacitorUpdater } from '@capgo/capacitor-updater'

await CapacitorUpdater.notifyAppReady()`,
    href: links.notify.href,
    linkLabel: links.notify.label,
  },
]

const faqItems = [
  { question: m.solutions_direct_faq1_q({}, { locale }), answer: m.solutions_direct_faq1_a({}, { locale }), ...links.updateBehavior },
  { question: m.solutions_direct_faq2_q({}, { locale }), answer: m.solutions_direct_faq2_a({}, { locale }), ...links.settings },
  { question: m.solutions_direct_faq3_q({}, { locale }), answer: m.solutions_direct_faq3_a({}, { locale }), ...links.splash },
  { question: m.solutions_direct_faq4_q({}, { locale }), answer: m.solutions_direct_faq4_a({}, { locale }), ...links.compatibility },
  {
    question: m.solutions_direct_faq5_q({}, { locale }),
    answer: m.solutions_direct_faq5_a({}, { locale }),
    href: docs('plugins/updater/settings/#directupdate'),
    label: links.settings.label,
  },
].map(({ label, ...item }) => ({ ...item, linkLabel: label }))

const serviceLdJson = createServiceLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description: description,
  url: Astro.url.href,
  serviceType: 'Software Development Service',
  areaServed: ['Worldwide'],
})

const ldJSON = createLdJsonGraph(Astro.locals.runtimeConfig.public, serviceLdJson, {
  includeOrganization: true,
  additionalEntities: [createFAQPageLdJson(Astro.locals.runtimeConfig.public, { url: Astro.url.href, questions: faqItems })],
})

const content = { title, description, ldJSON }
---

<Layout content={content}>
  <div class="product-hero">
    <!-- Hero Section with Urgency -->
    <section class="relative overflow-hidden py-20 sm:py-28 lg:py-36">
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute top-0 left-1/2 h-full w-full max-w-6xl -translate-x-1/2">
          <div class="absolute top-1/4 left-1/4 h-96 w-96 rounded-full bg-emerald-500/10 blur-3xl"></div>
          <div class="absolute right-1/4 bottom-1/4 h-96 w-96 rounded-full bg-teal-500/10 blur-3xl"></div>
        </div>
      </div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-4xl text-center">
          <div class="mb-8 inline-flex items-center rounded-full border border-emerald-400/40 bg-emerald-500/10 px-4 py-2 text-sm font-medium text-emerald-200">
            <svg aria-hidden="true" class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            {m.solutions_direct_updates({}, { locale })}
          </div>

          <h1 class="text-4xl leading-tight font-bold text-white sm:text-5xl lg:text-6xl">{m.solutions_direct_updates_hero_title({}, { locale })}</h1>

          <p class="mx-auto mt-8 max-w-3xl text-xl leading-relaxed text-gray-300">{m.solutions_direct_updates_hero_subtitle({}, { locale })}</p>

          <SignupCta enterprise class="mt-10" />

          <!-- Trust Badges -->
          <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-sm text-gray-400">
            <div class="flex items-center gap-2">
              <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              {m.solutions_direct_instant_apply({}, { locale })}
            </div>
            <div class="flex items-center gap-2">
              <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              {m.solutions_direct_zero_outdated({}, { locale })}
            </div>
            <div class="flex items-center gap-2">
              <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              {m.solutions_direct_sub_second({}, { locale })}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The Problem: Why Waiting Isn't an Option -->
    <section class="bg-gray-800 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <p class="mb-4 text-sm font-semibold tracking-wide text-red-400 uppercase">{m.solutions_the_problem({}, { locale })}</p>
          <h2 class="text-3xl font-bold text-white sm:text-4xl">{m.solutions_direct_problem_title({}, { locale })}</h2>
        </div>

        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <!-- Problem Visualization -->
          <div class="rounded-2xl border border-red-500/30 bg-gray-900 p-8">
            <h3 class="mb-6 text-xl font-bold text-white">{m.solutions_direct_background_problem({}, { locale })}</h3>

            <div class="space-y-6">
              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-500/20">
                  <span class="font-bold text-red-400">1</span>
                </div>
                <div>
                  <p class="font-semibold text-white">{m.solutions_direct_problem_step1_title({}, { locale })}</p>
                  <p class="mt-1 text-sm text-gray-400">{m.solutions_direct_problem_step1_desc({}, { locale })}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-500/20">
                  <span class="font-bold text-red-400">2</span>
                </div>
                <div>
                  <p class="font-semibold text-white">{m.solutions_direct_problem_step2_title({}, { locale })}</p>
                  <p class="mt-1 text-sm text-gray-400">{m.solutions_direct_problem_step2_desc({}, { locale })}</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-500/20">
                  <span class="font-bold text-red-400">3</span>
                </div>
                <div>
                  <p class="font-semibold text-white">{m.solutions_direct_problem_step3_title({}, { locale })}</p>
                  <p class="mt-1 text-sm text-gray-400">{m.solutions_direct_problem_step3_desc({}, { locale })}</p>
                </div>
              </div>
            </div>

            <div class="mt-8 rounded-xl border border-red-500/30 bg-red-500/10 p-4">
              <p class="font-medium text-red-300">{m.solutions_direct_problem_result({}, { locale })}</p>
            </div>
          </div>

          <!-- Critical Scenarios -->
          <div>
            <h3 class="mb-6 text-xl font-bold text-white">{m.solutions_direct_when_matters({}, { locale })}</h3>

            <div class="space-y-6">
              <div class="rounded-xl border border-gray-700 bg-gray-900 p-6">
                <div class="mb-3 flex items-center gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-500/20">
                    <svg aria-hidden="true" class="h-6 w-6 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-lg font-bold text-white">{m.solutions_direct_scenario1_title({}, { locale })}</h4>
                    <p class="text-gray-400">{m.solutions_direct_scenario1_desc({}, { locale })}</p>
                  </div>
                </div>
              </div>

              <div class="rounded-xl border border-gray-700 bg-gray-900 p-6">
                <div class="mb-3 flex items-center gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-amber-500/20">
                    <svg aria-hidden="true" class="h-6 w-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-lg font-bold text-white">{m.solutions_direct_scenario2_title({}, { locale })}</h4>
                    <p class="text-gray-400">{m.solutions_direct_scenario2_desc({}, { locale })}</p>
                  </div>
                </div>
              </div>

              <div class="rounded-xl border border-gray-700 bg-gray-900 p-6">
                <div class="mb-3 flex items-center gap-4">
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-purple-500/20">
                    <svg aria-hidden="true" class="h-6 w-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-lg font-bold text-white">{m.solutions_direct_scenario3_title({}, { locale })}</h4>
                    <p class="text-gray-400">{m.solutions_direct_scenario3_desc({}, { locale })}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The Solution: How Direct Updates Work -->
    <section class="bg-gray-900 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <p class="mb-4 text-sm font-semibold tracking-wide text-green-400 uppercase">{m.solutions_the_solution({}, { locale })}</p>
          <h2 class="text-3xl font-bold text-white sm:text-4xl">{m.solutions_direct_solution_title({}, { locale })}</h2>
          <p class="mt-4 text-xl text-gray-400">{m.solutions_direct_solution_subtitle({}, { locale })}</p>
        </div>

        <!-- Comparison -->
        <div class="mb-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
          <!-- Background Updates -->
          <div class="rounded-2xl border border-gray-700 bg-gray-800 p-8">
            <h3 class="mb-6 flex items-center gap-2 text-lg font-bold text-gray-400">
              <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              {m.solutions_direct_background_mode({}, { locale })}
            </h3>
            <div class="space-y-4">
              <div class="flex items-center gap-3 text-gray-400">
                <div class="flex h-6 w-6 items-center justify-center rounded-full bg-gray-700 text-xs">1</div>
                <span>{m.solutions_direct_bg_step1({}, { locale })}</span>
              </div>
              <div class="flex items-center gap-3 text-gray-400">
                <div class="flex h-6 w-6 items-center justify-center rounded-full bg-gray-700 text-xs">2</div>
                <span>{m.solutions_direct_bg_step2({}, { locale })}</span>
              </div>
              <div class="flex items-center gap-3 text-gray-400">
                <div class="flex h-6 w-6 items-center justify-center rounded-full bg-gray-700 text-xs">3</div>
                <span>{m.solutions_direct_bg_step3({}, { locale })}</span>
              </div>
              <div class="flex items-center gap-3 text-gray-400">
                <div class="flex h-6 w-6 items-center justify-center rounded-full bg-gray-700 text-xs">4</div>
                <span>{m.solutions_direct_bg_step4({}, { locale })}</span>
              </div>
            </div>
            <div class="mt-6 rounded-xl bg-gray-900 p-4">
              <p class="text-sm text-gray-500">{m.solutions_direct_bg_result({}, { locale })}</p>
            </div>
          </div>

          <!-- Direct Updates -->
          <div class="rounded-2xl border border-emerald-500/30 bg-gray-800 p-8">
            <h3 class="mb-6 flex items-center gap-2 text-lg font-bold text-emerald-400">
              <svg aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              {m.solutions_direct_direct_mode({}, { locale })}
            </h3>
            <div class="space-y-4">
              <div class="flex items-center gap-3 text-white">
                <div class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-500/30 text-xs text-emerald-400">1</div>
                <span>{m.solutions_direct_d_step1({}, { locale })}</span>
              </div>
              <div class="flex items-center gap-3 text-white">
                <div class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-500/30 text-xs text-emerald-400">2</div>
                <span>{m.solutions_direct_d_step2({}, { locale })}</span>
              </div>
              <div class="flex items-center gap-3 text-white">
                <div class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-500/30 text-xs text-emerald-400">3</div>
                <span>{m.solutions_direct_d_step3({}, { locale })}</span>
              </div>
            </div>
            <div class="mt-6 rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4">
              <p class="text-sm font-medium text-emerald-300">{m.solutions_direct_d_result({}, { locale })}</p>
            </div>
          </div>
        </div>

        <p class="text-center text-sm">
          <a href={links.updateBehavior.href} class="font-semibold text-emerald-300 hover:text-white hover:underline">
            {links.updateBehavior.label}
          </a>
        </p>
      </div>
    </section>

    <SolutionHowItWorks
      eyebrow={m.solutions_how_it_works_eyebrow({}, { locale })}
      title={m.solutions_direct_how_title({}, { locale })}
      description={m.solutions_direct_how_desc({}, { locale })}
      steps={howSteps}
      docsTitle={m.solutions_docs_title({}, { locale })}
      docs={[links.updateBehavior, links.settings, links.splash, links.delta, links.notify, links.compatibility]}
      class="bg-gray-900 border-t border-white/10"
    />

    <!-- Key Benefits -->
    <section class="bg-gray-900 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <h2 class="text-3xl font-bold text-white sm:text-4xl">{m.solutions_direct_benefits_title({}, { locale })}</h2>
          <p class="mt-4 text-xl text-gray-400">{m.solutions_direct_benefits_subtitle({}, { locale })}</p>
        </div>

        <div class="space-y-8">
          <!-- Benefit 1: Zero Outdated Sessions -->
          <div class="rounded-2xl border border-gray-700 bg-gray-800 p-8 lg:p-10">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
              <div class="lg:col-span-2">
                <div class="mb-4 flex items-center gap-3">
                  <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-500/20">
                    <svg aria-hidden="true" class="h-5 w-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </div>
                  <h3 class="text-xl font-bold text-white">{m.solutions_direct_benefit1_title({}, { locale })}</h3>
                </div>
                <p class="mb-4 text-gray-300">{m.solutions_direct_benefit1_desc({}, { locale })}</p>
                <ul class="space-y-2">
                  <li class="flex items-start gap-2 text-gray-400">
                    <svg aria-hidden="true" class="mt-0.5 h-5 w-5 shrink-0 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      ></path>
                    </svg>
                    {m.solutions_direct_benefit1_point1({}, { locale })}
                  </li>
                  <li class="flex items-start gap-2 text-gray-400">
                    <svg aria-hidden="true" class="mt-0.5 h-5 w-5 shrink-0 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      ></path>
                    </svg>
                    {m.solutions_direct_benefit1_point2({}, { locale })}
                  </li>
                  <li class="flex items-start gap-2 text-gray-400">
                    <svg aria-hidden="true" class="mt-0.5 h-5 w-5 shrink-0 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                      <path
                        fill-rule="evenodd"
                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                        clip-rule="evenodd"
                      ></path>
                    </svg>
                    {m.solutions_direct_benefit1_point3({}, { locale })}
                  </li>
                </ul>
                <a href={links.settings.href} class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-white hover:underline">
                  {links.settings.label}
                </a>
              </div>
              <div class="flex flex-col justify-center rounded-xl bg-gray-900 p-6">
                <p class="mb-2 text-4xl font-bold text-emerald-400">3</p>
                <p class="text-gray-400">{m.solutions_direct_benefit1_stat({}, { locale })}</p>
              </div>
            </div>
          </div>

          <!-- Benefit 2: Faster Bug Resolution -->
          <div class="rounded-2xl border border-gray-700 bg-gray-800 p-8 lg:p-10">
            <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
              <div class="lg:col-span-2">
                <div class="mb-4 flex items-center gap-3">
                  <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-500/20">
