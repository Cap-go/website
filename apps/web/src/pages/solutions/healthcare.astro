---
import Layout from '@/layouts/Layout.astro'
import m from '@/copy/messages'
import SolutionAppExample from '@/components/solutions/SolutionAppExample.astro'
import SolutionHowItWorks from '@/components/solutions/SolutionHowItWorks.astro'
import SolutionFaq from '@/components/solutions/SolutionFaq.astro'
import ProductTestimonials from '@/components/ProductTestimonials.astro'
import { solutionTestimonials } from '@/config/productTestimonials'
import { getRelativeLocaleUrl } from '@/services/links'
import { createFAQPageLdJson, createServiceLdJson, createLdJsonGraph } from '@/lib/ldJson'
import SignupCta from '@/components/SignupCta.astro'

const locale = Astro.locals.locale
const brand = Astro.locals.runtimeConfig.public.brand
const docs = (path: string) => getRelativeLocaleUrl(locale, `docs/${path}`)

const title = `${brand} | ${m.solutions_healthcare_title({}, { locale })}`
const description = m.solutions_healthcare_description({}, { locale })

const links = {
  hipaa: { href: docs('live-updates/hipaa-compliance/'), label: m.solutions_healthcare_link_hipaa({}, { locale }) },
  hipaaPage: { href: getRelativeLocaleUrl(locale, 'hipaa-compliance'), label: m.solutions_healthcare_link_hipaa_page({}, { locale }) },
  encryption: { href: docs('live-updates/encryption/'), label: m.solutions_healthcare_link_encryption({}, { locale }) },
  channels: { href: docs('live-updates/channels/'), label: m.solutions_healthcare_link_channels({}, { locale }) },
  rollouts: { href: docs('live-updates/progressive-rollouts/'), label: m.solutions_healthcare_link_rollouts({}, { locale }) },
  notify: { href: docs('plugins/updater/notify-app-ready/'), label: m.solutions_healthcare_link_notify({}, { locale }) },
  dataLocation: { href: docs('live-updates/data-location/'), label: m.solutions_healthcare_link_data_location({}, { locale }) },
  compliance: { href: docs('live-updates/compliance/'), label: m.solutions_healthcare_link_compliance({}, { locale }) },
  roles: { href: docs('webapp/organization-roles/'), label: m.solutions_healthcare_link_roles({}, { locale }) },
  audit: { href: docs('live-updates/features/#audit-logs'), label: m.solutions_healthcare_link_audit({}, { locale }) },
  compatibility: { href: docs('live-updates/compatibility/'), label: m.solutions_healthcare_link_compatibility({}, { locale }) },
  bundleCli: { href: docs('cli/reference/bundle/'), label: m.solutions_healthcare_link_bundle_cli({}, { locale }) },
  currentApi: { href: docs('plugins/updater/api/#current'), label: m.solutions_healthcare_link_current_api({}, { locale }) },
  selfHosted: { href: docs('plugins/updater/self-hosted/getting-started/'), label: m.solutions_healthcare_link_self_hosted({}, { locale }) },
}

const howSteps = [
  {
    title: m.solutions_healthcare_how1_title({}, { locale }),
    body: m.solutions_healthcare_how1_body({}, { locale }),
    code: `// capacitor.config.ts
plugins: {
  CapacitorUpdater: {
    updateUrl: 'https://plugin.eu.capgo.app/updates',
    // use statsUrl: '' to disable hosted statistics
    statsUrl: 'https://plugin.eu.capgo.app/stats',
    channelUrl: 'https://plugin.eu.capgo.app/channel_self',
  },
}`,
    href: links.hipaa.href,
    linkLabel: links.hipaa.label,
  },
  {
    title: m.solutions_healthcare_how2_title({}, { locale }),
    body: m.solutions_healthcare_how2_body({}, { locale }),
    code: `npx @capgo/cli@latest key create
npx @capgo/cli@latest key save --key ./.capgo_key_v2.pub
npx cap sync`,
    href: links.encryption.href,
    linkLabel: links.encryption.label,
  },
  {
    title: m.solutions_healthcare_how3_title({}, { locale }),
    body: m.solutions_healthcare_how3_body({}, { locale }),
    code: 'npx @capgo/cli@latest bundle upload --channel staging --key-v2',
    href: links.channels.href,
    linkLabel: links.channels.label,
  },
  {
    title: m.solutions_healthcare_how4_title({}, { locale }),
    body: m.solutions_healthcare_how4_body({}, { locale }),
    code: `npx @capgo/cli@latest bundle upload --channel production --key-v2 --rollout 5
npx @capgo/cli@latest channel set production --rollout-promote
# or, if something looks wrong
npx @capgo/cli@latest channel set production --rollout-rollback`,
    href: links.rollouts.href,
    linkLabel: links.rollouts.label,
  },
]

const faqItems = [
  { question: m.solutions_healthcare_faq1_q({}, { locale }), answer: m.solutions_healthcare_faq1_a({}, { locale }), ...links.hipaa },
  { question: m.solutions_healthcare_faq2_q({}, { locale }), answer: m.solutions_healthcare_faq2_a({}, { locale }), ...links.compliance },
  { question: m.solutions_healthcare_faq3_q({}, { locale }), answer: m.solutions_healthcare_faq3_a({}, { locale }), ...links.dataLocation },
  { question: m.solutions_healthcare_faq4_q({}, { locale }), answer: m.solutions_healthcare_faq4_a({}, { locale }), ...links.compatibility },
  { question: m.solutions_healthcare_faq5_q({}, { locale }), answer: m.solutions_healthcare_faq5_a({}, { locale }), ...links.audit },
].map(({ label, ...item }) => ({ ...item, linkLabel: label }))

const serviceLdJson = createServiceLdJson(Astro.locals.runtimeConfig.public, {
  name: title,
  description: description,
  url: Astro.url.href,
  serviceType: 'Software Development Service',
  areaServed: ['Worldwide'],
})

const ldJSON = createLdJsonGraph(Astro.locals.runtimeConfig.public, serviceLdJson, {
  includeOrganization: true,
  additionalEntities: [createFAQPageLdJson(Astro.locals.runtimeConfig.public, { url: Astro.url.href, questions: faqItems })],
})

const content = { title, description, ldJSON }
---

<Layout content={content}>
  <div class="product-hero">
    <!-- Hero Section -->
    <section class="relative overflow-hidden py-20 sm:py-28 lg:py-36">
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute top-0 left-1/2 h-full w-full max-w-6xl -translate-x-1/2">
          <div class="absolute top-1/4 left-1/4 h-96 w-96 rounded-full bg-cyan-500/10 blur-3xl"></div>
          <div class="absolute right-1/4 bottom-1/4 h-96 w-96 rounded-full bg-teal-500/10 blur-3xl"></div>
        </div>
      </div>

      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-4xl text-center">
          <div class="mb-8 inline-flex items-center rounded-full border border-cyan-400/40 bg-cyan-500/10 px-4 py-2 text-sm font-medium text-cyan-200">
            <svg aria-hidden="true" class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              ></path>
            </svg>
            {m.solutions_healthcare_badge({}, { locale })}
          </div>

          <h1 class="text-4xl leading-tight font-bold text-white sm:text-5xl lg:text-6xl">{m.solutions_healthcare_hero_title({}, { locale })}</h1>

          <p class="mx-auto mt-8 max-w-3xl text-xl leading-relaxed text-gray-300">{m.solutions_healthcare_hero_subtitle({}, { locale })}</p>

          <SignupCta enterprise class="mt-8" />

          <!-- Compliance badges -->
          <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-sm text-gray-400">
            <div class="flex items-center gap-2">
              <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              {m.solutions_healthcare_badge_hipaa({}, { locale })}
            </div>
            <div class="flex items-center gap-2">
              <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              {m.solutions_healthcare_badge_soc2({}, { locale })}
            </div>
            <div class="flex items-center gap-2">
              <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              {m.solutions_healthcare_badge_e2e({}, { locale })}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The Healthcare Reality -->
    <section id="reality" class="bg-gray-800 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <h2 class="mb-4 text-sm font-semibold tracking-wide text-red-400 uppercase">{m.solutions_healthcare_reality_label({}, { locale })}</h2>
          <h3 class="text-3xl font-bold text-white sm:text-4xl">{m.solutions_healthcare_reality_title({}, { locale })}</h3>
        </div>

        <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
          <!-- Critical Scenario -->
          <div class="rounded-2xl border border-red-500/30 bg-gray-900 p-8">
            <h4 class="mb-6 flex items-center gap-2 text-xl font-bold text-red-400">
              <svg aria-hidden="true" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                ></path>
              </svg>
              {m.solutions_healthcare_scenario_title({}, { locale })}
            </h4>
            <div class="space-y-4 text-gray-300">
              <p>{m.solutions_healthcare_scenario_para1({}, { locale })}</p>
              <p>{m.solutions_healthcare_scenario_para2({}, { locale })}</p>
              <p class="font-medium text-red-300">{m.solutions_healthcare_scenario_para3({}, { locale })}</p>
            </div>
          </div>

          <!-- Pain Points -->
          <div class="space-y-4">
            <div class="rounded-xl border border-gray-700 bg-gray-900 p-6">
              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-500/20">
                  <svg aria-hidden="true" class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <div>
                  <h4 class="mb-1 text-lg font-bold text-white">{m.solutions_healthcare_pain1_title({}, { locale })}</h4>
                  <p class="text-sm text-gray-400">{m.solutions_healthcare_pain1_desc({}, { locale })}</p>
                </div>
              </div>
            </div>

            <div class="rounded-xl border border-gray-700 bg-gray-900 p-6">
              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-500/20">
                  <svg aria-hidden="true" class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h4 class="mb-1 text-lg font-bold text-white">{m.solutions_healthcare_pain2_title({}, { locale })}</h4>
                  <p class="text-sm text-gray-400">{m.solutions_healthcare_pain2_desc({}, { locale })}</p>
                </div>
              </div>
            </div>

            <div class="rounded-xl border border-gray-700 bg-gray-900 p-6">
              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-500/20">
                  <svg aria-hidden="true" class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h4 class="mb-1 text-lg font-bold text-white">{m.solutions_healthcare_pain3_title({}, { locale })}</h4>
                  <p class="text-sm text-gray-400">{m.solutions_healthcare_pain3_desc({}, { locale })}</p>
                </div>
              </div>
            </div>

            <div class="rounded-xl border border-gray-700 bg-gray-900 p-6">
              <div class="flex items-start gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-red-500/20">
                  <svg aria-hidden="true" class="h-5 w-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                    ></path>
                  </svg>
                </div>
                <div>
                  <h4 class="mb-1 text-lg font-bold text-white">{m.solutions_healthcare_pain4_title({}, { locale })}</h4>
                  <p class="text-sm text-gray-400">{m.solutions_healthcare_pain4_desc({}, { locale })}</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- How We Solve It -->
    <section id="solution" class="bg-gray-900 py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-16 max-w-3xl text-center">
          <h2 class="mb-4 text-sm font-semibold tracking-wide text-cyan-400 uppercase">{m.solutions_healthcare_solution_label({}, { locale })}</h2>
          <h3 class="text-3xl font-bold text-white sm:text-4xl">{m.solutions_healthcare_solution_title({}, { locale })}</h3>
          <p class="mt-4 text-xl text-gray-400">{m.solutions_healthcare_solution_subtitle({}, { locale })}</p>
        </div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <!-- Solution 1: Critical Updates -->
          <div class="rounded-2xl border border-gray-700 bg-gray-800 p-8">
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-cyan-500/20">
                <svg aria-hidden="true" class="h-6 w-6 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">{m.solutions_healthcare_sol1_title({}, { locale })}</h3>
            </div>
            <p class="mb-6 text-gray-300">{m.solutions_healthcare_sol1_desc({}, { locale })}</p>
            <div class="flex flex-wrap gap-x-6 gap-y-2">
              <a href={links.channels.href} class="inline-flex text-sm font-semibold text-cyan-400 hover:text-white hover:underline">
                {links.channels.label}
              </a>
              <a href={links.compatibility.href} class="inline-flex text-sm font-semibold text-cyan-400 hover:text-white hover:underline">
                {links.compatibility.label}
              </a>
            </div>
          </div>

          <!-- Solution 2: HIPAA Compliant -->
          <div class="rounded-2xl border border-gray-700 bg-gray-800 p-8">
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-green-500/20">
                <svg aria-hidden="true" class="h-6 w-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">{m.solutions_healthcare_sol2_title({}, { locale })}</h3>
            </div>
            <p class="mb-6 text-gray-300">{m.solutions_healthcare_sol2_desc({}, { locale })}</p>
            <a href={links.hipaa.href} class="-mt-3 mb-6 inline-flex text-sm font-semibold text-cyan-400 hover:text-white hover:underline">
              {links.hipaa.label}
            </a>
            <ul class="space-y-2">
              <li class="flex items-center gap-2 text-gray-400">
                <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
                {m.solutions_healthcare_sol2_point1({}, { locale })}
              </li>
              <li class="flex items-center gap-2 text-gray-400">
                <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
                {m.solutions_healthcare_sol2_point2({}, { locale })}
              </li>
              <li class="flex items-center gap-2 text-gray-400">
                <svg aria-hidden="true" class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
                {m.solutions_healthcare_sol2_point3({}, { locale })}
              </li>
            </ul>
          </div>

          <!-- Solution 3: End-to-End Encryption -->
          <div class="rounded-2xl border border-gray-700 bg-gray-800 p-8">
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-purple-500/20">
                <svg aria-hidden="true" class="h-6 w-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">{m.solutions_healthcare_sol3_title({}, { locale })}</h3>
            </div>
            <p class="mb-6 text-gray-300">{m.solutions_healthcare_sol3_desc({}, { locale })}</p>
            <a href={links.encryption.href} class="inline-flex text-sm font-semibold text-cyan-400 hover:text-white hover:underline">
              {links.encryption.label}
            </a>
          </div>

          <!-- Solution 4: Staged Rollouts -->
          <div class="rounded-2xl border border-gray-700 bg-gray-800 p-8">
            <div class="mb-6 flex items-center gap-3">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-amber-500/20">
                <svg aria-hidden="true" class="h-6 w-6 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                  ></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">{m.solutions_healthcare_sol4_title({}, { locale })}</h3>
            </div>
            <p class="mb-6 text-gray-300">{m.solutions_healthcare_sol4_desc({}, { locale })}</p>
            <div class="-mt-3 mb-6 flex flex-wrap gap-x-6 gap-y-2">
              <a href={links.rollouts.href} class="inline-flex text-sm font-semibold text-cyan-400 hover:text-white hover:underline">
                {links.rollouts.label}
              </a>
              <a href={links.notify.href} class="inline-flex text-sm font-semibold text-cyan-400 hover:text-white hover:underline">
                {links.notify.label}
              </a>
            </div>
            <div class="space-y-2 rounded-xl bg-gray-900 p-4">
              <div class="flex items-center justify-between rounded bg-gray-800 p-2">
                <span class="text-gray-400">{m.solutions_healthcare_sol4_step1({}, { locale })}</span>
                <span class="text-green-400">5%</span>
              </div>
              <div class="flex items-center justify-between rounded bg-gray-800 p-2">
