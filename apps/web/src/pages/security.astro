---
import Layout from '@/layouts/Layout.astro'
import SecurityTeachingDemo from '@/components/teaching-console/SecurityTeachingDemo.astro'
import m from '@/copy/messages'

const title = [
  Astro.locals.runtimeConfig.public.brand,
  m.security_product_seo_title({}, { locale: Astro.locals.locale }),
].join(' | ')
const description = m.security_product_seo_description({}, { locale: Astro.locals.locale })

const content = { title, description }
---

<Layout content={content}>
  <section class="security-product mx-auto max-w-5xl px-4 pt-12 pb-4" aria-labelledby="security-product-heading">
    <header class="security-product-head">
      <p class="security-product-eyebrow">Capgo Security</p>
      <h1 id="security-product-heading" class="security-product-title">Sign, attest, and gate every release in the Capgo console</h1>
      <p class="security-product-lead">
        Capgo Security is the product surface for signed bundles, attestation, and trust gates — the same controls your team uses when shipping through Capgo Live Updates.
      </p>
    </header>
    <SecurityTeachingDemo />
    <p class="security-product-note">
      Interactive console above · <a href="#security-policy">Vulnerability disclosure policy</a> below
    </p>
  </section>
  <div id="security-policy" class="prose-sm prose prose-invert m-auto py-8">
    <h2>{m.security_policy({}, { locale: Astro.locals.locale })}</h2>
    <p>
      {m.contact({}, { locale: Astro.locals.locale })}: <a href="https://github.com/Cap-go/capgo/security/advisories/new">https://github.com/Cap-go/capgo/security/advisories/new</a
      ><br />
      {m.canonical({}, { locale: Astro.locals.locale })}: <a href="https://capgo.app/security/">https://capgo.app/security.txt</a>
    </p>
    <p>
      {m.security_intro({}, { locale: Astro.locals.locale })}
    </p>
    <p>
      {m.security_discovery({}, { locale: Astro.locals.locale })}
    </p>
    <h2>{m.security_out_of_scope_title({}, { locale: Astro.locals.locale })}</h2>
    <ul>
      <li>{m.security_out_of_scope_1({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_2({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_3({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_4({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_5({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_6({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_7({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_8({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_9({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_10({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_11({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_12({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_13({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_out_of_scope_14({}, { locale: Astro.locals.locale })}</li>
    </ul>
    <h2>{m.security_supabase_limitations_title({}, { locale: Astro.locals.locale })}</h2>
    <p>{m.security_supabase_limitations_intro({}, { locale: Astro.locals.locale })}</p>
    <ul>
      <li>{m.security_supabase_limitations_1({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_supabase_limitations_2({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_supabase_limitations_3({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_supabase_limitations_4({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_supabase_limitations_5({}, { locale: Astro.locals.locale })}</li>
    </ul>
    <h2>{m.security_testing_guidelines_title({}, { locale: Astro.locals.locale })}</h2>
    <ul>
      <li>
        {m.security_testing_guidelines_1({}, { locale: Astro.locals.locale })}
      </li>
      <li>
        {m.security_testing_guidelines_2({}, { locale: Astro.locals.locale })}
      </li>
    </ul>
    <h2>{m.security_reporting_guidelines_title({}, { locale: Astro.locals.locale })}</h2>
    <ul>
      <li>
        {m.security_reporting_guidelines_1({}, { locale: Astro.locals.locale })}: <a href="https://github.com/Cap-go/capgo/security/advisories/new"
          >https://github.com/Cap-go/capgo/security/advisories/new</a
        >
      </li>
      <li>{m.security_reporting_guidelines_2({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_reporting_guidelines_3({}, { locale: Astro.locals.locale })}</li>
    </ul>
    <h2>{m.security_disclosure_guidelines_title({}, { locale: Astro.locals.locale })}</h2>
    <ul>
      <li>{m.security_disclosure_guidelines_1({}, { locale: Astro.locals.locale })}</li>
      <li>
        {m.security_disclosure_guidelines_2({}, { locale: Astro.locals.locale })}
        <ul>
          <li>{m.security_disclosure_guidelines_2_1({}, { locale: Astro.locals.locale })}</li>
          <li>{m.security_disclosure_guidelines_2_2({}, { locale: Astro.locals.locale })}</li>
          <li>{m.security_disclosure_guidelines_2_3({}, { locale: Astro.locals.locale })}</li>
        </ul>
      </li>
    </ul>
    <h2>{m.security_what_we_promise_title({}, { locale: Astro.locals.locale })}</h2>
    <ul>
      <li>{m.security_what_we_promise_1({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_what_we_promise_2({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_what_we_promise_3({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_what_we_promise_4({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_what_we_promise_5({}, { locale: Astro.locals.locale })}</li>
      <li>{m.security_what_we_promise_6({}, { locale: Astro.locals.locale })}</li>
    </ul>
    <p>{m.security_closing({}, { locale: Astro.locals.locale })}</p>
  </div>

  <style>
    .security-product-head {
      margin-bottom: 1.25rem;
      max-width: 42rem;
    }
    .security-product-eyebrow {
      margin: 0 0 0.5rem;
      color: #93c5fd;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .security-product-title {
      margin: 0;
      color: #f8fafc;
      font-size: clamp(1.45rem, 2.4vw, 1.9rem);
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.2;
      text-wrap: balance;
    }
    .security-product-lead {
      margin: 0.75rem 0 0;
      color: #cbd5e1;
      font-size: 1rem;
      line-height: 1.55;
    }
    .security-product-note {
      margin: 0.85rem 0 0;
      color: #94a3b8;
      font-size: 0.8125rem;
    }
    .security-product-note a {
      color: #93c5fd;
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  </style>
</Layout>
