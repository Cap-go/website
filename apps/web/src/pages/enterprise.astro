  { question: m.enterprise_faq_custom_q({}, { locale }), answer: m.enterprise_faq_custom_a({}, { locale }) },
  { question: m.enterprise_faq_payment_q({}, { locale }), answer: m.enterprise_faq_payment_a({}, { locale }) },
  { question: m.enterprise_faq_plugins_q({}, { locale }), answer: m.enterprise_faq_plugins_a({}, { locale }) },
  { question: m.enterprise_faq_migration_q({}, { locale }), answer: m.enterprise_faq_migration_a({}, { locale }) },
