---

<Layout content={content}>
  <div class="lu enterprise-product bg-ad">
    <section class="section hero bg-grid grain" id="top">
      <div class="shell">
        <div class="beta-badge">
          <span class="dot"></span>
          {m.enterprise_hero_badge({}, { locale })}
        </div>
        <h1 class="hero-banner" aria-label={`${m.enterprise_hero_headline({}, { locale })}: ${m.enterprise_hero_title({}, { locale })}`}>
          <span class="hbv-underlined">
            <span class="hbv-u-name">{m.enterprise_hero_headline({}, { locale })}</span>
            <span class="hbv-u-rule"></span>
          </span>
          <span class="hero-banner-tag">{m.enterprise_hero_title({}, { locale })}</span>
        </h1>
        <p class="lead hero-lead">{m.enterprise_hero_desc({}, { locale })}</p>
        <div class="hero-ctas">
          <SignupCta id="enterprise-hero-signup-cta" enterprise />
          <p class="hero-cta-note">{m.enterprise_hero_note({}, { locale })}</p>
        </div>
        <div class="hero-strip enterprise-hero-strip">
          {heroProofPoints.map((point) => (
            <div class="hero-strip-cell">
              <p class="v">{point.value}</p>
              <p class="k">{point.label}</p>
              <p class="enterprise-strip-detail">{point.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section enterprise-proof" id="proof" aria-label={m.trusted_by_the_biggest_capacitor_apps({}, { locale })}>
      <div class="shell">
        <p class="eyebrow eyebrow--blue enterprise-proof-caption">{m.trusted_by_the_biggest_capacitor_apps({}, { locale })}</p>
        <div class="enterprise-logo-grid">
          {customers.map((customer) => (
            <div class="enterprise-logo-card">
              <img
                src={customer.logo}
                alt={`${customer.name} logo`}
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
                class:list={[{ 'rounded-lg bg-slate-200 p-1': customer.plate }]}
              />
              <div>
                <p>{customer.name}</p>
                <span>
                  {customer.downloads} {m.downloads({}, { locale })}
                </span>
              </div>
            </div>
          ))}
        </div>

        <div class="enterprise-proof-grid">
          <ul class="enterprise-check-list enterprise-note-list">
            {enterpriseProofNotes.map((note) => (
              <li>
                <span class="enterprise-check" aria-hidden="true">
                  ✓
                </span>
                <span>{note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section" id="pain">
      <div class="shell">
        <div class="section-head section-head--wide">
          <div class="eyebrow eyebrow--blue">{m.enterprise_pain_label({}, { locale })}</div>
          <h2 class="h2-section">{m.enterprise_pain_title({}, { locale })}</h2>
          <p class="lead">{m.enterprise_pain_desc({}, { locale })}</p>
        </div>

        <div class="enterprise-card-grid enterprise-card-grid--2">
          {enterprisePainPoints.map((pain) => (
            <article class="enterprise-card">
              <p class="enterprise-card-label">{pain.label}</p>
              <h3>{pain.title}</h3>
              <p>{pain.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="recovery">
      <div class="shell">
        <div class="section-head section-head--wide">
          <div class="eyebrow eyebrow--blue">{m.enterprise_comparison_label({}, { locale })}</div>
          <h2 class="h2-section">{m.enterprise_comparison_title({}, { locale })}</h2>
          <p class="lead">{m.enterprise_comparison_desc({}, { locale })}</p>
        </div>

        <GovernedRollout class="enterprise-rollout" />

        <div class="enterprise-card-grid enterprise-card-grid--3 enterprise-pillars">
          {pillars.map((pillar) => (
            <article class="enterprise-card enterprise-pillar">
              <p class="enterprise-card-label">{pillar.eyebrow}</p>
