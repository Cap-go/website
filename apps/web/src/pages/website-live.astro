---
import Layout from '@/layouts/Layout.astro'
import m, { type MessageKey, type MessageValues } from '@/copy/messages'
import SolutionHowItWorks from '@/components/solutions/SolutionHowItWorks.astro'
import SolutionFaq from '@/components/solutions/SolutionFaq.astro'
import { getRelativeLocaleUrl } from '@/services/links'
import { createFAQPageLdJson, createLdJsonGraph, createProductLdJson, createServiceLdJson } from '@/lib/ldJson'

const locale = Astro.locals.locale
const config = Astro.locals.runtimeConfig.public
const brand = config.brand

function copy(key: MessageKey, values: MessageValues = {}) {
  return m[key](values, { locale })
}

const title = brand + ' | ' + copy('website_live_title')
const description = copy('website_live_description')
const registerUrl = 'https://console.capgo.app/register/'
const pricingUrl = getRelativeLocaleUrl(locale, 'pricing')
const docs = (path: string) => getRelativeLocaleUrl(locale, `docs/${path}`)

const links = {
  updater: { href: docs('plugins/updater/'), label: '@capgo/capacitor-updater' },
  notify: { href: docs('plugins/updater/notify-app-ready/'), label: copy('website_live_link_notify') },
  compliance: { href: docs('live-updates/compliance/'), label: copy('website_live_link_compliance') },
  pricing: { href: pricingUrl, label: copy('website_live_cta_secondary') },
}

const howSteps = [
  {
    title: copy('website_live_how1_title'),
    body: copy('website_live_how1_body'),
    code: `npm install @capgo/capacitor-updater
npx cap sync

// capacitor.config.ts
plugins: {
  CapacitorUpdater: {
    appId: 'com.example.app', // your Capgo app id
    websiteMode: true,
    autoUpdate: true,
  },
},

// in your app entry, once the UI has loaded
import { CapacitorUpdater } from '@capgo/capacitor-updater'
CapacitorUpdater.notifyAppReady()`,
    href: links.updater.href,
    linkLabel: links.updater.label,
  },
  {
    title: copy('website_live_how2_title'),
    body: copy('website_live_how2_body'),
  },
  {
    title: copy('website_live_how3_title'),
    body: copy('website_live_how3_body'),
  },
]

const faqItems = [
  { question: copy('website_live_faq1_q'), answer: copy('website_live_faq1_a'), href: links.compliance.href, linkLabel: links.compliance.label },
  { question: copy('website_live_faq2_q'), answer: copy('website_live_faq2_a'), href: links.notify.href, linkLabel: links.notify.label },
  { question: copy('website_live_faq3_q'), answer: copy('website_live_faq3_a') },
  { question: copy('website_live_faq4_q'), answer: copy('website_live_faq4_a') },
  { question: copy('website_live_faq5_q'), answer: copy('website_live_faq5_a') },
  { question: copy('website_live_faq6_q'), answer: copy('website_live_faq6_a') },
  { question: copy('website_live_faq7_q'), answer: copy('website_live_faq7_a'), href: links.pricing.href, linkLabel: links.pricing.label },
]

const serviceLdJson = createServiceLdJson(config, {
  name: title,
  description,
  url: Astro.url.href,
  serviceType: 'Capacitor app updates from a deployed website',
  areaServed: ['Worldwide'],
})

const productLdJson = createProductLdJson(config, {
  name: 'Capgo Website Live',
  description,
  url: Astro.url.href,
  sku: 'capgo-website-live',
  offers: [
    { name: 'Website Live monthly', price: '12', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
    { name: 'Website Live yearly', price: '120', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  ],
})

const ldJSON = createLdJsonGraph(config, serviceLdJson, {
  includeOrganization: true,
  additionalEntities: [productLdJson, createFAQPageLdJson(config, { url: Astro.url.href, questions: faqItems })],
})

const content = { title, description, ldJSON }

const stats: { value: MessageKey; label: MessageKey }[] = [
  { value: 'website_live_stat1_value', label: 'website_live_stat1_label' },
  { value: 'website_live_stat2_value', label: 'website_live_stat2_label' },
  { value: 'website_live_stat3_value', label: 'website_live_stat3_label' },
]

const audiences: { title: MessageKey; desc: MessageKey; accent: string }[] = [
  { title: 'website_live_for1_title', desc: 'website_live_for1_desc', accent: 'border-pink-400/25 bg-pink-500/10' },
  { title: 'website_live_for2_title', desc: 'website_live_for2_desc', accent: 'border-cyan-400/25 bg-cyan-500/10' },
  { title: 'website_live_for3_title', desc: 'website_live_for3_desc', accent: 'border-emerald-400/25 bg-emerald-500/10' },
]

type Cell = boolean | MessageKey
const rows: { label: MessageKey; live: Cell; full: Cell }[] = [
  { label: 'website_live_row_price', live: 'website_live_row_price_live', full: 'website_live_row_price_full' },
  { label: 'website_live_row_source', live: 'website_live_row_source_live', full: 'website_live_row_source_full' },
  { label: 'website_live_row_updates', live: 'website_live_row_updates_value', full: 'website_live_row_updates_value' },
  { label: 'website_live_row_devices', live: 'website_live_row_devices_live', full: 'website_live_row_devices_full' },
  { label: 'website_live_row_bandwidth', live: 'website_live_row_bandwidth_live', full: 'website_live_row_bandwidth_full' },
  { label: 'website_live_row_rollback', live: true, full: true },
  { label: 'website_live_row_channels', live: false, full: true },
  { label: 'website_live_row_rollouts', live: false, full: true },
  { label: 'website_live_row_stats', live: false, full: true },
  { label: 'website_live_row_encryption', live: false, full: true },
  { label: 'website_live_row_history', live: false, full: true },
  { label: 'website_live_row_native_builds', live: false, full: true },
]

const notIncluded: MessageKey[] = [
  'website_live_row_channels',
  'website_live_row_rollouts',
  'website_live_row_stats',
  'website_live_row_encryption',
  'website_live_row_history',
  'website_live_row_native_builds',
]

const primaryButton =
  'inline-flex min-h-11 items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-gray-950 transition-colors hover:bg-gray-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF]'
const secondaryButton =
  'inline-flex min-h-11 items-center justify-center rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-white/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#44BCFF]'
---

<Layout content={content}>
  <div class="product-hero">
    <section class="border-b border-white/10 py-16 sm:py-20 lg:py-28">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-[1fr_0.95fr] lg:items-center">
          <div class="min-w-0">
            <p class="inline-flex min-h-11 items-center rounded-lg border border-cyan-400/30 bg-cyan-500/10 px-4 text-sm font-semibold text-cyan-100">
              {copy('website_live_badge')}
            </p>
            <h1 class="mt-6 max-w-4xl text-4xl leading-tight font-bold text-balance text-white sm:text-5xl lg:text-6xl">{copy('website_live_h1')}</h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 sm:text-xl">{copy('website_live_lead')}</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a id="website-live-hero-register" href={registerUrl} class={primaryButton}>
                {copy('website_live_cta_primary')}
              </a>
              <a href="#compare" class={secondaryButton}>
                {copy('website_live_compare_title')}
              </a>
            </div>
            <div class="mt-10 grid gap-3 sm:grid-cols-3">
              {stats.map((stat) => (
                <div class="rounded-lg border border-white/10 bg-white/[0.04] p-4">
                  <div class="text-2xl font-bold text-white">{copy(stat.value)}</div>
                  <div class="mt-1 text-sm leading-6 text-slate-400">{copy(stat.label)}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="min-w-0 rounded-lg border border-white/10 bg-slate-950 p-5 shadow-2xl shadow-cyan-950/25">
            <div class="grid gap-3">
              <div class="rounded-lg border border-pink-400/20 bg-pink-500/10 p-4">
                <p class="text-sm font-semibold text-pink-100">{copy('website_live_flow1_title')}</p>
                <p class="mt-1 text-sm leading-6 text-slate-300">{copy('website_live_flow1_desc')}</p>
              </div>
              <div class="grid grid-cols-[auto_1fr] items-center gap-3">
                <div aria-hidden="true" class="h-px w-8 bg-white/20"></div>
                <p class="text-xs font-semibold text-slate-400 uppercase">{copy('website_live_flow_bridge_check')}</p>
              </div>
              <div class="rounded-lg border border-cyan-400/20 bg-cyan-500/10 p-4">
                <p class="text-sm font-semibold text-cyan-100">{copy('website_live_flow2_title')}</p>
                <p class="mt-1 text-sm leading-6 text-slate-300">{copy('website_live_flow2_desc')}</p>
              </div>
              <div class="grid grid-cols-[auto_1fr] items-center gap-3">
                <div aria-hidden="true" class="h-px w-8 bg-white/20"></div>
                <p class="text-xs font-semibold text-slate-400 uppercase">{copy('website_live_flow_bridge_download')}</p>
              </div>
              <div class="rounded-lg border border-emerald-400/20 bg-emerald-500/10 p-4">
                <p class="text-sm font-semibold text-emerald-100">{copy('website_live_flow3_title')}</p>
                <p class="mt-1 text-sm leading-6 text-slate-300">{copy('website_live_flow3_desc')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SolutionHowItWorks
      eyebrow={copy('solutions_how_it_works_eyebrow')}
      title={copy('website_live_how_title')}
      description={copy('website_live_how_desc')}
      steps={howSteps}
      class="border-b border-white/10 bg-slate-900"
    />

    <section id="who-its-for" aria-labelledby="who-its-for-title" class="bg-gray-950 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold tracking-wide text-[#44BCFF] uppercase">{copy('website_live_for_eyebrow')}</p>
          <h2 id="who-its-for-title" class="mt-3 text-3xl font-bold text-white sm:text-4xl">
            {copy('website_live_for_title')}
          </h2>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {audiences.map((item) => (
            <article class={`rounded-lg border p-6 ${item.accent}`}>
              <h3 class="text-xl font-bold text-white">{copy(item.title)}</h3>
              <p class="mt-3 leading-7 text-slate-300">{copy(item.desc)}</p>
            </article>
          ))}
        </div>
        <div class="mt-8 rounded-lg border border-amber-400/30 bg-amber-500/10 p-6">
          <h3 class="text-lg font-bold text-amber-100">{copy('website_live_requirement_title')}</h3>
          <p class="mt-2 max-w-4xl leading-7 text-slate-200">{copy('website_live_requirement_body')}</p>
        </div>
      </div>
    </section>

    <section id="compare" aria-labelledby="compare-title" class="scroll-mt-20 border-y border-white/10 bg-slate-900 py-16 sm:py-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold tracking-wide text-[#44BCFF] uppercase">{copy('website_live_compare_eyebrow')}</p>
          <h2 id="compare-title" class="mt-3 text-3xl font-bold text-white sm:text-4xl">
            {copy('website_live_compare_title')}
          </h2>
          <p class="mt-4 text-lg leading-8 text-slate-300">{copy('website_live_compare_desc')}</p>
        </div>
        <div class="mt-10 overflow-x-auto rounded-lg border border-white/10">
          <table class="w-full min-w-[640px] border-collapse text-left text-sm">
            <thead class="bg-white/[0.04]">
              <tr>
                <th scope="col" class="px-4 py-3 font-semibold text-slate-300">
                  {copy('website_live_table_feature')}
                </th>
                <th scope="col" class="px-4 py-3 font-semibold text-cyan-100">
                  Website Live
                </th>
                <th scope="col" class="px-4 py-3 font-semibold text-slate-300">
                  {copy('website_live_compare_full')}
                </th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr class="border-t border-white/10">
                  <th scope="row" class="px-4 py-3 font-medium text-white">
                    {copy(row.label)}
                  </th>
                  {[row.live, row.full].map((cell) => (
                    <td class="px-4 py-3 text-slate-300">
                      {typeof cell === 'string' ? (
                        copy(cell)
                      ) : cell ? (
                        <span class="inline-flex items-center gap-2 text-emerald-300">
                          <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                          </svg>
                          {copy('website_live_table_included')}
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-2 text-slate-400">
                          <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                          </svg>
                          {copy('website_live_table_not_included')}
                        </span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="not-included" aria-labelledby="not-included-title" class="bg-gray-950 py-16 sm:py-20">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
        <div>
          <h2 id="not-included-title" class="text-3xl font-bold text-white sm:text-4xl">
            {copy('website_live_not_title')}
          </h2>
          <p class="mt-4 text-lg leading-8 text-slate-300">{copy('website_live_not_desc')}</p>
          <ul class="mt-6 space-y-3">
            {notIncluded.map((key) => (
              <li class="flex items-start gap-3 text-slate-300">
                <svg class="mt-1 h-4 w-4 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
                <span>{copy(key)}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg border border-white/10 bg-white/[0.04] p-6 sm:p-8">
          <h2 class="text-2xl font-bold text-white">{copy('website_live_upgrade_title')}</h2>
          <p class="mt-4 leading-7 text-slate-300">{copy('website_live_upgrade_body')}</p>
          <a href={pricingUrl} class:list={[secondaryButton, 'mt-6']}>
            {copy('website_live_cta_secondary')}
          </a>
        </div>
      </div>
    </section>

    <SolutionFaq
      eyebrow={copy('solutions_faq_eyebrow')}
      title={copy('website_live_faq_title')}
      description={copy('website_live_faq_desc')}
      items={faqItems}
      class="border-t border-white/10 bg-slate-900"
    />

    <section id="pricing" aria-labelledby="website-live-cta-title" class="bg-gray-950 py-16 sm:py-20">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <h2 id="website-live-cta-title" class="text-3xl font-bold text-balance text-white sm:text-4xl">
          {copy('website_live_cta_title')}
        </h2>
        <p class="mt-6 flex items-end justify-center gap-1">
          <span class="text-5xl font-semibold tracking-tight text-white">$12</span>
          <span class="pb-1 text-sm font-medium text-slate-400">{copy('website_live_price_per_month')}</span>
        </p>
        <p class="mt-2 text-sm text-slate-400">{copy('website_live_price_note')}</p>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-slate-300">{copy('website_live_cta_subtitle')}</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a id="website-live-final-register" href={registerUrl} class={primaryButton}>
            {copy('website_live_cta_primary')}
          </a>
          <a href={pricingUrl} class={secondaryButton}>
            {copy('website_live_cta_secondary')}
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
