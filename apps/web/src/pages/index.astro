---
import Layout from '../layouts/Layout.astro'
import ProblemSolution from '@/components/ProblemSolution.astro'
import Testimonials from '@/components/Testimonials.astro'
import WhyCapgo from '@/components/WhyCapgo.astro'
import SharedNumbers from '@/components/SharedNumbers.astro'
import TransparencySection from '@/components/TransparencySection.astro'
import Hero from '@/components/Hero.astro'
import m from '@/copy/messages'
import HowItWorks from '@/components/HowItWorks.astro'
import PlatformOverview from '@/components/PlatformOverview.astro'
import PlatformScreens from '@/components/PlatformScreens.astro'
import GlobalInfrastructure from '@/components/GlobalInfrastructure.astro'
import { createLdJsonGraph, createServiceLdJson, createSoftwareApplicationLdJson, createWebSiteLdJson } from '@/lib/ldJson'
import AppflowShutdown from '@/components/AppflowShutdown.astro'
import AskAiSection from '@/components/AskAiSection.astro'
import RiskDebtSection from '@/components/RiskDebtSection.astro'
import AgentReadySection from '@/components/AgentReadySection.astro'

const config = Astro.locals.runtimeConfig

// Create comprehensive homepage content definition
const title = `${config.public.brand} - ${m.instant_updates_for_capacitor({}, { locale: Astro.locals.locale })}`
const description = m.ship_updates_fixes_changes_and_features({}, { locale: Astro.locals.locale })

// Create comprehensive LD+JSON for homepage
const capgoService = createServiceLdJson(config.public, {
  name: 'Capgo - Build Capacitor apps with AI, ship updates instantly',
  description:
    'Capgo gives developers and AI coding agents Capacitor skills, MCP servers, plugins, native iOS and Android cloud builds, store publishing, live updates, and release monitoring for Capacitor, Ionic, Cordova, and Electron apps.',
  url: config.public.baseUrl,
  serviceType: 'Software Development Service',
  areaServed: ['Worldwide'],
})

// Create SoftwareApplication schema for the Capgo platform
const capgoSoftware = createSoftwareApplicationLdJson(config.public, {
  name: 'Capgo',
  description:
    'AI-ready platform to build, ship, and maintain Capacitor apps. Works with Claude Code, Codex, Cursor, Copilot, and Gemini CLI through Capacitor skills and MCP, with native builds, store publishing, and live updates for iOS and Android.',
  url: config.public.baseUrl,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'AI-assisted Capacitor app development platform',
  featureList: [
    'Capacitor skills for AI coding agents (Claude Code, Codex, Cursor, Copilot, Gemini CLI)',
    'Hosted and local MCP servers for Capacitor app management',
    'Maintained Capacitor plugins for native features',
    'Migration to Capacitor and Capacitor major version upgrades',
    'Cloud native iOS and Android builds without a Mac',
    'App Store and Google Play publishing',
    'Live updates with channels, staged rollouts, and rollback',
    'Release health monitoring, device logs, and analytics',
  ],
  operatingSystem: 'Web, iOS, Android, Cordova, Electron',
  softwareVersion: '1.0',
  offers: {
    price: '12',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
})

// Create comprehensive LD+JSON graph for homepage
const content = {
  title,
  description,
  image: `${config.public.baseUrl}/capgo_social.png`,
  ldJSON: createLdJsonGraph(config.public, capgoService, {
    includeOrganization: true,
    includeBreadcrumbs: true,
    breadcrumbs: [
      {
        name: 'Home',
        url: config.public.baseUrl,
      },
      {
        name: 'Platform',
        url: `${config.public.baseUrl}/app_mobile/`,
      },
      {
        name: 'Pricing',
        url: `${config.public.baseUrl}/pricing/`,
      },
      {
        name: 'Documentation',
        url: `${config.public.baseUrl}/docs/`,
      },
    ],
    additionalEntities: [capgoSoftware, createWebSiteLdJson(config.public, { inLanguage: Astro.locals.locale })],
  }),
}
---

<Layout content={content}>
  <div>
    <Hero />
    <ProblemSolution />
    <PlatformOverview />
    <PlatformScreens />
    <AgentReadySection />
    <HowItWorks />
    <RiskDebtSection />
    <GlobalInfrastructure />
    <SharedNumbers />
    <TransparencySection />
    <WhyCapgo />
    <Testimonials />
    <AppflowShutdown />
    <AskAiSection />
  </div>

  <style is:global>
    /* Minimum required CSS for animations */
    .teleport-line-animation {
      left: -100%;
      background: rgba(56, 189, 248, 0.3);
      animation: teleport-line 5s cubic-bezier(0.1, 0.9, 0.2, 1) infinite;
    }

    @keyframes teleport-line {
      0% {
        transform: translateX(0) scaleX(0.1);
        opacity: 0;
      }
      10% {
        opacity: 0.5;
      }
      100% {
        transform: translateX(200%) scaleX(1);
        opacity: 0;
      }
    }

    /* Portal glow effect */
    .portal-glow-animation {
      background: rgba(56, 189, 248, 0.12);
      filter: blur(20px);
      animation: portal-pulse 8s ease-in-out infinite;
    }

    @keyframes portal-pulse {
      0%,
      100% {
        opacity: 0.5;
        transform: translateY(-50%) scale(1);
      }
      50% {
        opacity: 0.7;
        transform: translateY(-50%) scale(1.1);
      }
    }

    /* Vertical data streams */
    .data-stream-animation {
      top: -100%;
      background: rgba(56, 189, 248, 0.25);
      animation: data-stream 8s linear infinite;
    }

    @keyframes data-stream {
      0% {
        transform: translateY(0);
        opacity: 0;
      }
      10% {
        opacity: 0.5;
      }
      100% {
        transform: translateY(200%);
        opacity: 0;
      }
    }

    @keyframes teleport-button {
      0% {
        transform: translateX(0) skewX(-20deg);
        opacity: 0;
      }
      10% {
        opacity: 0.5;
      }
      100% {
        transform: translateX(200%) skewX(-20deg);
        opacity: 0;
      }
    }
  </style>
</Layout>
