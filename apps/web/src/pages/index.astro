---
import Layout from '../layouts/Layout.astro'
import { formatWebsiteStats, resolveWebsiteStats } from '@/lib/websiteStats'
import ProblemSolution from '@/components/ProblemSolution.astro'
import Testimonials from '@/components/Testimonials.astro'
import SharedNumbers from '@/components/SharedNumbers.astro'
import Hero from '@/components/Hero.astro'
import m from '@/copy/messages'
import HowItWorks from '@/components/HowItWorks.astro'
import PlatformOverview from '@/components/PlatformOverview.astro'
import GlobalInfrastructure from '@/components/GlobalInfrastructure.astro'
import { createLdJsonGraph, createServiceLdJson, createSoftwareApplicationLdJson, createWebSiteLdJson } from '@/lib/ldJson'
import AppflowShutdown from '@/components/AppflowShutdown.astro'
import SolutionAppExample from '@/components/solutions/SolutionAppExample.astro'
import { getRelativeLocaleUrl } from '@/services/links'

const config = Astro.locals.runtimeConfig

const rawStats = await resolveWebsiteStats(config.public.baseApiUrl)
const stats = formatWebsiteStats(rawStats)

// Create comprehensive homepage content definition
const title = `${config.public.brand} - ${m.instant_updates_for_capacitor({}, { locale: Astro.locals.locale })}`
const description = m.ship_updates_fixes_changes_and_features({}, { locale: Astro.locals.locale })

// Create comprehensive LD+JSON for homepage
const capgoService = createServiceLdJson(config.public, {
  name: 'Capgo - Live Updates for Ionic, Capacitor, and Cordova Apps',
  description:
    'Instant over-the-air / CodePush updates for Ionic, Capacitor, Cordova, and Electron applications. Deploy OTA, bug fixes, feature updates, and improvements without release delays.',
  url: config.public.baseUrl,
  serviceType: 'Software Development Service',
  areaServed: ['Worldwide'],
})

// Create SoftwareApplication schema for the Capgo platform
const capgoSoftware = createSoftwareApplicationLdJson(config.public, {
  name: 'Capgo Live Update Platform',
  description: 'Professional live update platform for Ionic, Capacitor, and hybrid app teams. Deploy updates instantly to iOS, Android, Cordova, and Electron apps.',
  url: config.public.baseUrl,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web, iOS, Android, Cordova, Electron',
  softwareVersion: '1.0',
  aggregateRating: {
    ratingValue: 4.8,
    reviewCount: rawStats.apps,
  },
  offers: {
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
})

// Create comprehensive LD+JSON graph for homepage
const content = {
  title,
  description,
  image: `${config.public.baseUrl}/capgo_social.png`,
  ldJSON: createLdJsonGraph(config.public, capgoService, {
    includeOrganization: true,
    includeBreadcrumbs: true,
    breadcrumbs: [
      {
        name: 'Home',
        url: config.public.baseUrl,
      },
      {
        name: 'Platform',
        url: `${config.public.baseUrl}/app_mobile/`,
      },
      {
        name: 'Pricing',
        url: `${config.public.baseUrl}/pricing/`,
      },
      {
        name: 'Documentation',
        url: `${config.public.baseUrl}/docs/`,
      },
    ],
    additionalEntities: [capgoSoftware, createWebSiteLdJson(config.public, { inLanguage: Astro.locals.locale })],
  }),
}
---

<Layout content={content}>
  <div>
    <Hero />
    <ProblemSolution />
    <PlatformOverview />
    <HowItWorks />
    <SolutionAppExample solution="production-updates" randomize />
    <GlobalInfrastructure />
    <SharedNumbers stats={stats} />
    <Testimonials />
    <AppflowShutdown />
    <section class="bg-[#1a1a1a] pb-16 sm:pb-20 lg:pb-24" aria-labelledby="keep-shipping-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-white/10 bg-white/5 p-8 sm:p-10">
          <h2 id="keep-shipping-title" class="text-2xl font-semibold tracking-tight text-white sm:text-3xl">Keep shipping in 2026</h2>
          <p
            class="mt-4 max-w-3xl text-base leading-7 text-gray-400 [&_a]:font-medium [&_a]:text-[#44BCFF] [&_a]:underline [&_a]:decoration-[#44BCFF]/40 [&_a]:underline-offset-4 [&_a]:transition-colors [&_a:focus-visible]:rounded-sm [&_a:focus-visible]:outline-2 [&_a:focus-visible]:outline-offset-2 [&_a:focus-visible]:outline-[#44BCFF] [@media(hover:hover)]:hover:[&_a]:text-white [@media(hover:hover)]:hover:[&_a]:decoration-white/60"
          >
            Store review queues are less predictable this year. Read <a href={getRelativeLocaleUrl(Astro.locals.locale, 'blog/mobile-app-best-practices-2026-live-updates')}
              >Mobile App Best Practices in 2026: Why Live Updates Win</a
            > — then <a href={getRelativeLocaleUrl(Astro.locals.locale, 'register')}>register</a> and ship web-layer fixes without waiting on every binary review.
          </p>
        </div>
      </div>
    </section>
  </div>

  <style is:global>
    /* Minimum required CSS for animations */
    .teleport-line-animation {
      left: -100%;
      background: rgba(56, 189, 248, 0.3);
      animation: teleport-line 5s cubic-bezier(0.1, 0.9, 0.2, 1) infinite;
    }

    @keyframes teleport-line {
      0% {
        transform: translateX(0) scaleX(0.1);
        opacity: 0;
      }
      10% {
        opacity: 0.5;
      }
      100% {
        transform: translateX(200%) scaleX(1);
        opacity: 0;
      }
    }

    /* Portal glow effect */
    .portal-glow-animation {
      background: rgba(56, 189, 248, 0.12);
      filter: blur(20px);
      animation: portal-pulse 8s ease-in-out infinite;
    }

    @keyframes portal-pulse {
      0%,
      100% {
        opacity: 0.5;
        transform: translateY(-50%) scale(1);
      }
      50% {
        opacity: 0.7;
        transform: translateY(-50%) scale(1.1);
      }
    }

    /* Vertical data streams */
    .data-stream-animation {
      top: -100%;
      background: rgba(56, 189, 248, 0.25);
      animation: data-stream 8s linear infinite;
    }

    @keyframes data-stream {
      0% {
        transform: translateY(0);
        opacity: 0;
      }
      10% {
        opacity: 0.5;
      }
      100% {
        transform: translateY(200%);
        opacity: 0;
      }
    }

    @keyframes teleport-button {
      0% {
        transform: translateX(0) skewX(-20deg);
        opacity: 0;
      }
      10% {
        opacity: 0.5;
      }
      100% {
        transform: translateX(200%) skewX(-20deg);
        opacity: 0;
      }
    }
  </style>
</Layout>
