---
import Layout from '../layouts/Layout.astro'
import ProblemSolution from '@/components/ProblemSolution.astro'
import Testimonials from '@/components/Testimonials.astro'
import WhyCapgo from '@/components/WhyCapgo.astro'
import SharedNumbers from '@/components/SharedNumbers.astro'
import TransparencySection from '@/components/TransparencySection.astro'
import Hero from '@/components/Hero.astro'
import m from '@/copy/messages'
import HowItWorks from '@/components/HowItWorks.astro'
import PlatformOverview from '@/components/PlatformOverview.astro'
import PlatformScreens from '@/components/PlatformScreens.astro'
import GlobalInfrastructure from '@/components/GlobalInfrastructure.astro'
import { createHomepageLdJsonGraph, type HomepageLdJsonOffers } from '@/lib/ldJson'
import AppflowShutdown from '@/components/AppflowShutdown.astro'
import AskAiSection from '@/components/AskAiSection.astro'
import RiskDebtSection from '@/components/RiskDebtSection.astro'
import AgentReadySection from '@/components/AgentReadySection.astro'
import AgentOnboardingSection from '@/components/AgentOnboardingSection.astro'
import { getAbsoluteLocaleUrl } from '@/services/links'
import { planMonthlyPrice, planYearlyPrice } from '@/lib/planCopy'
import { getPlans } from '@/lib/siteData'

const config = Astro.locals.runtimeConfig
const locale = Astro.locals.locale

// Create comprehensive homepage content definition
const title = `${config.public.brand} - ${m.instant_updates_for_capacitor({}, { locale })}`
const description = m.ship_updates_fixes_changes_and_features({}, { locale })

const homepageUrl = getAbsoluteLocaleUrl(config.public.baseUrl, locale, '/')
const pricingUrl = getAbsoluteLocaleUrl(config.public.baseUrl, locale, '/pricing/')

const homepageFeatureList = [
  'Capacitor skills for AI coding agents (Claude Code, Codex, Cursor, Copilot, Gemini CLI)',
  'Hosted and local MCP servers for Capacitor app management',
  'Onboarding with your AI coding agent: one prompt sets up live updates or native builds through the Capgo MCP server',
  'Maintained Capacitor plugins for native features',
  'Migration to Capacitor and Capacitor major version upgrades',
  'Cloud native iOS and Android builds',
  'App Store and Google Play publishing',
  'Live updates with channels, staged rollouts, and rollback',
  'Release health monitoring, device logs, and analytics',
]

let homepageOffers: HomepageLdJsonOffers = {
  price: '14',
  priceCurrency: 'USD',
  availability: 'https://schema.org/InStock',
  url: pricingUrl,
  priceSpecifications: [
    { price: '14', billingPeriod: 'monthly' },
    { price: '146', billingPeriod: 'yearly' },
  ],
}

const paidPlans = getPlans().filter(
  (plan) => plan.name !== 'Free' && Number.isFinite(plan.price_m) && Number.isFinite(plan.price_y),
)
if (paidPlans.length > 0) {
  const entryPlan = paidPlans.reduce((lowest, plan) => (planMonthlyPrice(plan) < planMonthlyPrice(lowest) ? plan : lowest), paidPlans[0])
  homepageOffers = {
    price: planMonthlyPrice(entryPlan).toString(),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: pricingUrl,
    priceSpecifications: [
      { price: planMonthlyPrice(entryPlan).toString(), billingPeriod: 'monthly' },
      { price: planYearlyPrice(entryPlan).toString(), billingPeriod: 'yearly' },
    ],
  }
}

// Create comprehensive LD+JSON for homepage
const content = {
  title,
  description,
  image: `${config.public.baseUrl}/capgo_social.png`,
  ldJSON: createHomepageLdJsonGraph(config.public, {
    description,
    homepageUrl,
    inLanguage: locale,
    applicationSubCategory: m.instant_updates_for_capacitor({}, { locale }),
    featureList: homepageFeatureList,
    offers: homepageOffers,
  }),
}
---

<Layout content={content}>
  <div>
    <!-- Sales narrative: promise → proof → problem → solution → product → benefits → validation → objections → CTA -->
    <Hero />
    <SharedNumbers />
    <ProblemSolution />
    <HowItWorks />
    <PlatformOverview />
    <PlatformScreens />
    <WhyCapgo />
    <Testimonials />
    <AgentReadySection showAudienceSwitch />
    <RiskDebtSection />
    <GlobalInfrastructure />
    <TransparencySection />
    <AppflowShutdown />
    <AgentOnboardingSection />
    <AskAiSection />
  </div>

  <style is:global>
    /* Minimum required CSS for animations */
    .teleport-line-animation {
      left: -100%;
      background: rgba(56, 189, 248, 0.3);
      animation: teleport-line 5s cubic-bezier(0.1, 0.9, 0.2, 1) infinite;
    }

    @keyframes teleport-line {
      0% {
        transform: translateX(0) scaleX(0.1);
        opacity: 0;
      }
      10% {
        opacity: 0.5;
      }
      100% {
        transform: translateX(200%) scaleX(1);
        opacity: 0;
      }
    }

    /* Portal glow effect */
    .portal-glow-animation {
      background: rgba(56, 189, 248, 0.12);
      filter: blur(20px);
      animation: portal-pulse 8s ease-in-out infinite;
    }

    @keyframes portal-pulse {
      0%,
      100% {
        opacity: 0.5;
        transform: translateY(-50%) scale(1);
      }
      50% {
        opacity: 0.7;
        transform: translateY(-50%) scale(1.1);
      }
    }

    /* Vertical data streams */
    .data-stream-animation {
      top: -100%;
      background: rgba(56, 189, 248, 0.25);
      animation: data-stream 8s linear infinite;
    }

    @keyframes data-stream {
      0% {
        transform: translateY(0);
        opacity: 0;
      }
      10% {
        opacity: 0.5;
      }
      100% {
        transform: translateY(200%);
        opacity: 0;
      }
    }

    @keyframes teleport-button {
      0% {
        transform: translateX(0) skewX(-20deg);
        opacity: 0;
      }
      10% {
        opacity: 0.5;
      }
      100% {
        transform: translateX(200%) skewX(-20deg);
        opacity: 0;
      }
    }
  </style>
</Layout>
