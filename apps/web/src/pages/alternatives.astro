---
import '@/styles/lu-product.css'
import '@/styles/compare-page.css'
import AppLogoStrip from '@/components/AppLogoStrip.astro'
import SignupCta from '@/components/SignupCta.astro'
import ProductTestimonials from '@/components/ProductTestimonials.astro'
import Layout from '@/layouts/Layout.astro'
import { productTestimonials } from '@/config/productTestimonials'
import m from '@/copy/messages'
import { createItemListLdJson, createLdJsonGraph, createServiceLdJson } from '@/lib/ldJson'
import { getRelativeLocaleUrl } from '@/services/links'

const locale = Astro.locals.locale
const config = Astro.locals.runtimeConfig.public
const title = m.alternatives_title({}, { locale })
const description = m.alternatives_meta_description({}, { locale })

const comparisons = [
  {
    name: 'Ionic Appflow',
    title: m.alternatives_index_card_title({ competitor: 'Ionic Appflow' }, { locale }),
    status: m.alternatives_sum_appflow_status({}, { locale }),
    text: m.compare_appflow_verdict({}, { locale }),
    href: getRelativeLocaleUrl(locale, 'alternatives/ionic-appflow'),
  },
  {
    name: 'Capawesome Cloud',
    title: m.alternatives_index_card_title({ competitor: 'Capawesome Cloud' }, { locale }),
    status: m.alternatives_sum_capawesome_status({}, { locale }),
    text: m.compare_capawesome_verdict({}, { locale }),
    href: getRelativeLocaleUrl(locale, 'alternatives/capawesome'),
  },
  {
    name: 'Microsoft CodePush',
    title: m.alternatives_index_card_title({ competitor: 'Microsoft CodePush' }, { locale }),
    status: m.alternatives_sum_codepush_status({}, { locale }),
    text: m.compare_codepush_verdict({}, { locale }),
    href: getRelativeLocaleUrl(locale, 'alternatives/codepush'),
  },
  {
    name: 'Expo Application Services',
    title: m.alternatives_index_card_title({ competitor: 'Expo (EAS)' }, { locale }),
    status: m.alternatives_sum_expo_status({}, { locale }),
    text: m.compare_expo_verdict({}, { locale }),
    href: getRelativeLocaleUrl(locale, 'alternatives/expo'),
  },
  {
    name: 'Median',
    title: m.alternatives_index_card_title({ competitor: 'Median' }, { locale }),
    status: m.alternatives_sum_median_status({}, { locale }),
    text: m.compare_median_verdict({}, { locale }),
    href: getRelativeLocaleUrl(locale, 'alternatives/median'),
  },
  {
    name: 'VoltBuilder',
    title: m.alternatives_index_card_title({ competitor: 'VoltBuilder' }, { locale }),
    status: m.alternatives_sum_voltbuilder_status({}, { locale }),
    text: m.compare_voltbuilder_verdict({}, { locale }),
    href: getRelativeLocaleUrl(locale, 'alternatives/voltbuilder'),
  },
]

const sources = [
  { label: m.compare_appflow_source_announcement({}, { locale }), href: 'https://ionic.io/blog/important-announcement-the-future-of-ionics-commercial-products' },
  { label: m.compare_appflow_source_docs({}, { locale }), href: 'https://ionic.io/docs/appflow' },
  { label: m.compare_capawesome_source_pricing({}, { locale }), href: 'https://capawesome.io/cloud/pricing/' },
  { label: m.compare_capawesome_source_cloud({}, { locale }), href: 'https://capawesome.io/cloud/' },
  { label: m.compare_codepush_source_retirement({}, { locale }), href: 'https://learn.microsoft.com/en-us/appcenter/retirement' },
  { label: m.compare_codepush_source_server({}, { locale }), href: 'https://github.com/microsoft/code-push-server' },
  { label: m.compare_expo_source_pricing({}, { locale }), href: 'https://expo.dev/pricing' },
  { label: m.compare_expo_source_services({}, { locale }), href: 'https://expo.dev/services' },
  { label: m.compare_median_source_pricing({}, { locale }), href: 'https://median.co/pricing' },
  { label: m.compare_median_source_updates({}, { locale }), href: 'https://docs.median.co/docs/app-updates' },
  { label: m.compare_voltbuilder_source_plans({}, { locale }), href: 'https://volt.build/plan/' },
  { label: m.compare_voltbuilder_source_home({}, { locale }), href: 'https://volt.build/' },
  { label: m.compare_voltbuilder_source_docs({}, { locale }), href: 'https://volt.build/docs/all/' },
]

type Cell = { text: string; sources: number[] }
const cell = (text: string, ...refs: number[]): Cell => ({ text, sources: refs })

const summary: Array<{ name: string; us?: boolean; live: Cell; builds: Cell; price: Cell; status: Cell }> = [
  {
    name: 'Capgo',
    us: true,
    live: cell(m.alternatives_sum_capgo_live({}, { locale })),
    builds: cell(m.alternatives_sum_capgo_builds({}, { locale })),
    price: cell(m.alternatives_sum_capgo_price({}, { locale })),
    status: cell(m.alternatives_sum_capgo_status({}, { locale })),
  },
  {
    name: 'Ionic Appflow',
    live: cell(m.alternatives_sum_appflow_live({}, { locale }), 2),
    builds: cell(m.alternatives_sum_appflow_builds({}, { locale }), 2),
    price: cell(m.alternatives_sum_appflow_price({}, { locale }), 1),
    status: cell(m.alternatives_sum_appflow_status({}, { locale }), 1),
  },
  {
    name: 'Capawesome Cloud',
    live: cell(m.alternatives_sum_capawesome_live({}, { locale }), 4),
    builds: cell(m.alternatives_sum_capawesome_builds({}, { locale }), 3),
    price: cell(m.alternatives_sum_capawesome_price({}, { locale }), 3),
    status: cell(m.alternatives_sum_capawesome_status({}, { locale }), 4),
  },
  {
    name: 'Microsoft CodePush',
    live: cell(m.alternatives_sum_codepush_live({}, { locale }), 6),
    builds: cell(m.alternatives_sum_codepush_builds({}, { locale }), 5),
    price: cell(m.alternatives_sum_codepush_price({}, { locale }), 6),
    status: cell(m.alternatives_sum_codepush_status({}, { locale }), 5),
  },
  {
    name: 'Expo (EAS)',
    live: cell(m.alternatives_sum_expo_live({}, { locale }), 8),
    builds: cell(m.alternatives_sum_expo_builds({}, { locale }), 8),
    price: cell(m.alternatives_sum_expo_price({}, { locale }), 7),
    status: cell(m.alternatives_sum_expo_status({}, { locale }), 8),
  },
  {
    name: 'Median',
    live: cell(m.alternatives_sum_median_live({}, { locale }), 10),
    builds: cell(m.alternatives_sum_median_builds({}, { locale }), 9),
    price: cell(m.alternatives_sum_median_price({}, { locale }), 9),
    status: cell(m.alternatives_sum_median_status({}, { locale }), 9),
  },
  {
    name: 'VoltBuilder',
    live: cell(m.alternatives_sum_voltbuilder_live({}, { locale }), 13),
    builds: cell(m.alternatives_sum_voltbuilder_builds({}, { locale }), 12),
    price: cell(m.alternatives_sum_voltbuilder_price({}, { locale }), 11),
    status: cell(m.alternatives_sum_voltbuilder_status({}, { locale }), 11),
  },
]

const summaryColumns = [
  m.compare_row_ota({}, { locale }),
  m.compare_row_native_builds({}, { locale }),
  m.alternatives_summary_col_price({}, { locale }),
  m.compare_row_company({}, { locale }),
]

const refLabel = (n: number) => m.compare_source_ref_label({ n, source: sources[n - 1]?.label ?? '' }, { locale })

const guides = [
  {
    title: m.alternatives_hub_reviews_title({}, { locale }),
    links: [
      { label: m.review_appflow_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'reviews/appflow') },
      { label: m.review_capawesome_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'reviews/capawesome') },
      { label: m.review_codepush_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'reviews/codepush') },
    ],
  },
  {
    title: m.alternatives_hub_migrate_title({}, { locale }),
    links: [
      { label: m.migrate_from_appflow_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'migrate/from-appflow') },
      { label: m.migrate_from_capawesome_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'migrate/from-capawesome') },
      { label: m.migrate_from_codepush_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'migrate/from-codepush') },
    ],
  },
  {
    title: m.alternatives_hub_best_title({}, { locale }),
    links: [
      { label: m.best_capacitor_live_updates_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'best/capacitor-live-updates') },
      { label: m.best_appflow_alternative_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'best/appflow-alternative') },
      { label: m.best_codepush_alternative_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'best/codepush-alternative') },
    ],
  },
  {
    title: m.alternatives_hub_mcp_link({}, { locale }),
    links: [{ label: m.mcp_page_title({}, { locale }), href: getRelativeLocaleUrl(locale, 'mcp') }],
  },
]

const ldJSON = createLdJsonGraph(
  config,
  createServiceLdJson(config, {
    name: title,
    description,
    url: Astro.url.href,
    serviceType: 'Software Development Service',
    areaServed: ['Worldwide'],
  }),
  {
    includeOrganization: true,
    additionalEntities: [
      createItemListLdJson(config, {
        url: Astro.url.href,
        name: m.alternatives_index_title({}, { locale }),
        description,
        items: comparisons.map((item) => ({
          name: item.title,
          url: new URL(item.href, config.baseUrl).href,
          description: item.text,
        })),
      }),
    ],
  },
)

const content = {
  title,
  description,
  image: `${config.baseUrl}/capgo_social.png`,
  keywords: 'Capgo alternatives, Expo alternative, EAS alternative, Appflow alternative, Capacitor live updates',
  ldJSON,
}
---

<Layout content={content}>
  <div class="lu bg-ad cmp">
    <section class="section cmp-hero bg-grid grain" id="top">
      <div class="shell">
        <div class="beta-badge">
          <span class="dot" aria-hidden="true"></span>
          {m.alternatives_hero_eyebrow({}, { locale })}
        </div>
        <h1 class="cmp-h1">{m.alternatives_hero_title({}, { locale })}</h1>
        <p class="lead">{m.alternatives_hero_subtitle({}, { locale })}</p>
        <div class="hero-ctas">
          <SignupCta id="alternatives-hero-signup-cta" />
          <div class="hero-cta-buttons">
            <a class="btn btn-lg btn-ghost" href="#summary">
              {m.alternatives_hero_summary_cta({}, { locale })}
            </a>
          </div>
        </div>
        <ul class="cmp-meta">
          <li>{m.compare_meta_updates({}, { locale })}</li>
          <li>{m.compare_meta_apps({}, { locale })}</li>
          <li>{m.compare_meta_founded({}, { locale })}</li>
        </ul>
      </div>
      <AppLogoStrip />
    </section>

    <section class="section" id="comparisons">
      <div class="shell">
        <div class="section-head section-head--wide">
          <div class="eyebrow eyebrow--blue">{m.alternatives_index_eyebrow({}, { locale })}</div>
          <h2 class="h2-section">{m.alternatives_index_title({}, { locale })}</h2>
          <p class="lead">{m.alternatives_index_lead({}, { locale })}</p>
        </div>
        <div class="cmp-card-grid">
          {comparisons.map((item) => (
            <article class="cmp-card">
              <span class="cmp-card-status">{item.status}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a class="cmp-card-link" href={item.href} aria-label={m.alternatives_index_link_aria({ competitor: item.name }, { locale })}>
                {m.alternatives_index_link({}, { locale })} →
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="summary">
      <div class="shell">
        <div class="section-head section-head--wide">
          <div class="eyebrow eyebrow--blue">{m.compare_table_eyebrow({}, { locale })}</div>
          <h2 class="h2-section">{m.alternatives_summary_title({}, { locale })}</h2>
          <p class="lead">{m.alternatives_summary_lead({}, { locale })}</p>
        </div>
        <div class="comp-wrap cmp-wrap-scroll">
          <table class="cmp-simple cmp-summary">
            <caption class="cmp-caption">{m.alternatives_summary_caption({}, { locale })}</caption>
            <thead>
              <tr>
                <th scope="col">{m.alternatives_summary_col_product({}, { locale })}</th>
                {summaryColumns.map((column) => (
                  <th scope="col">{column}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {summary.map((row) => (
                <tr class:list={[row.us && 'us']}>
                  <th scope="row">{row.name}</th>
                  {[row.live, row.builds, row.price, row.status].map((value, index) => (
                    <td>
                      <span class="cmp-cell-label" aria-hidden="true">
                        {summaryColumns[index]}
                      </span>
                      {value.text}
                      {value.sources.map((n) => (
                        <a class="cmp-ref" href={`#cmp-src-${n}`} aria-label={refLabel(n)}>
                          [{n}]
                        </a>
                      ))}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="cmp-sources" id="sources">
          <h3>{m.compare_sources_title({}, { locale })}</h3>
          <p>{m.compare_sources_note({}, { locale })}</p>
          <ol>
            {sources.map((source, index) => (
              <li id={`cmp-src-${index + 1}`}>
                <a href={source.href} target="_blank" rel="noopener noreferrer">
                  {source.label}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="section" id="limits">
      <div class="shell">
        <div class="section-head section-head--wide">
          <div class="eyebrow eyebrow--blue">{m.compare_better_eyebrow({}, { locale })}</div>
          <h2 class="h2-section">{m.alternatives_not_good_at_title({}, { locale })}</h2>
        </div>
        <div class="cmp-card-grid cmp-card-grid--two">
          <article class="cmp-card">
            <h3>{m.alternatives_not_good_at_ci_cd_label({}, { locale })}</h3>
            <p>{m.alternatives_not_good_at_ci_cd({}, { locale })}</p>
          </article>
          <article class="cmp-card">
            <h3>{m.alternatives_not_good_at_docs_label({}, { locale })}</h3>
            <p>{m.alternatives_not_good_at_docs({}, { locale })}</p>
          </article>
        </div>
      </div>
    </section>

    <ProductTestimonials
      variant="builder"
      accent="blue"
      eyebrow={m.compare_proof_eyebrow({}, { locale })}
      title={m.compare_proof_title({}, { locale })}
      description={m.compare_proof_lead({}, { locale })}
      testimonials={productTestimonials.liveUpdate}
      maxItems={3}
    />

    <section class="section" id="guides">
      <div class="shell">
        <div class="section-head">
          <div class="eyebrow eyebrow--blue">{m.alternatives_guides_eyebrow({}, { locale })}</div>
          <h2 class="h2-section">{m.alternatives_guides_title({}, { locale })}</h2>
        </div>
        <div class="cmp-card-grid cmp-card-grid--two">
          {guides.map((group) => (
            <nav class="cmp-card" aria-label={group.title}>
              <h3>{group.title}</h3>
              <ul class="cmp-guide-list">
                {group.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
      </div>
    </section>

    <section class="section final bg-grid grain" id="cta">
      <div class="shell">
        <h2>{m.compare_cta_title({}, { locale })}</h2>
        <p class="tagline">{m.compare_cta_subtitle({}, { locale })}</p>
        <SignupCta id="alternatives-final-signup-cta" />
        <ul class="cmp-meta">
          <li>{m.compare_meta_teams({}, { locale })}</li>
          <li>{m.compare_meta_devices({}, { locale })}</li>
          <li>{m.compare_meta_build_time({}, { locale })}</li>
        </ul>
      </div>
    </section>
  </div>
</Layout>
